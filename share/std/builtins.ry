# Explicit checked cast from `any` to a concrete type (#2315). Returns
# Ok(value) on tag match, Err(Error{message}) on mismatch. Use this in
# place of implicit assignment unwrap (`let x: T = anyVal`) to recover
# concrete values from dynamic data such as `json5.load[Map<str, any>]`
# results without crashing the process on a wrong tag.
@public
@native
fn asType<T>(value: any) -> Result<T, Error>

# Runtime type-test on an `any` value (#2315). Returns true when the
# `any` holds a value of type T for currently supported targets:
# primitives (`int` / `float` / `bool` / `str`), records (descriptor
# chain walk so `isType[Parent](anyHoldingChild)` returns true), and
# collections (`List<any>` / `Map<str, any>` / `Set<any>` — element
# types are erased so `isType[List<int>]` ≡ `isType[List<any>]`).
# `isType[any]` always returns true. `Option<T>` / `Result<T, E>` /
# organic enum targets are rejected at compile time because the
# runtime `Enum` tag cannot distinguish enum types without a
# descriptor compare; use case-based unwrap on the underlying enum
# value instead.
@public
@native
fn isType<T>(value: any) -> bool
