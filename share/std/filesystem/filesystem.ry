# Filesystem operations — file/directory manipulation
# (io module handles file content read/write; filesystem handles the files themselves)

# Directory listing (non-recursive)
@native("filesystem")
fn listDir(path: str) -> Result<List<str>, Error>

# Recursive file/directory traversal
@native("filesystem")
fn walk(path: str) -> Result<List<str>, Error>

# Glob pattern matching
@native("filesystem")
fn glob(pattern: str) -> Result<List<str>, Error>

# Copy a single file
@native("filesystem")
fn copy(src: str, dst: str) -> Result<Unit, Error>

# Move / rename a file or directory
@native("filesystem")
fn move(src: str, dst: str) -> Result<Unit, Error>

# Remove a file or empty directory
@native("filesystem")
fn remove(path: str) -> Result<Unit, Error>

# Remove a file, directory, or directory tree recursively
@native("filesystem")
fn removeAll(path: str) -> Result<Unit, Error>

# Create a single directory
@native("filesystem")
fn mkdir(path: str) -> Result<Unit, Error>

# Create a directory and all missing parents
@native("filesystem")
fn mkdirAll(path: str) -> Result<Unit, Error>

# Get file size in bytes
@native("filesystem")
fn fileSize(path: str) -> Result<int, Error>

# Check whether path is a regular file
@native("filesystem")
fn isFile(path: str) -> Result<bool, Error>

# Check whether path is a directory
@native("filesystem")
fn isDir(path: str) -> Result<bool, Error>

# Check whether path is a symbolic link
@native("filesystem")
fn isSymlink(path: str) -> Result<bool, Error>

# Change file permissions (POSIX mode, e.g. 0o755)
@native("filesystem")
fn chmod(path: str, mode: int) -> Result<Unit, Error>

# Create a symbolic link
@native("filesystem")
fn symlink(target: str, linkPath: str) -> Result<Unit, Error>

# Read the target of a symbolic link
@native("filesystem")
fn readLink(path: str) -> Result<str, Error>
