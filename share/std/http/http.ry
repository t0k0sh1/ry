# HTTP server operations
@native("http")
fn listen(host: str, port: int, handler: fn(HttpRequest) -> Result<HttpResponse, Error>) -> Result<Unit, Error>

@native("http")
fn listen(host: str, port: int, handler: fn(HttpRequest) -> Result<HttpResponse, Error>, maxRequests: int) -> Result<Unit, Error>

@native("http")
fn listen(host: str, port: int, handler: fn(HttpRequest) -> Result<HttpResponse, Error>, maxRequests: int, portCallback: fn(int) -> Unit) -> Result<Unit, Error>

@native("http")
fn method(req: HttpRequest) -> str

@native("http")
fn path(req: HttpRequest) -> str

@native("http")
fn header(req: HttpRequest, key: str) -> Result<Option<str>, Error>

@native("http")
fn body(req: HttpRequest) -> str

@native("http")
fn bodyBytes(req: HttpRequest) -> List<u8>

@native("http")
fn query(req: HttpRequest, key: str) -> Result<Option<str>, Error>

@native("http")
fn queryAll(req: HttpRequest) -> Map<str, str>

@native("http")
fn cookie(req: HttpRequest, name: str) -> Result<Option<str>, Error>

@native("http")
fn cookies(req: HttpRequest) -> Map<str, str>

@native("http")
fn formField(req: HttpRequest, name: str) -> Result<Option<str>, Error>

@native("http")
fn formFile(req: HttpRequest, name: str) -> Result<Option<Map<str, str>>, Error>

@native("http")
fn formFields(req: HttpRequest) -> Map<str, str>

@native("http")
fn response(status: int, headers: Map<str, str>, body: str) -> Result<HttpResponse, Error>

# HTTP client operations
@native("http")
fn httpGet(url: str) -> Result<HttpClientResponse, Error>

@native("http")
fn httpPost(url: str, body: str, headers: Map<str, str>) -> Result<HttpClientResponse, Error>

@native("http")
fn httpRequest(method: str, url: str, headers: Map<str, str>, body: str) -> Result<HttpClientResponse, Error>

@native("http")
fn status(response: HttpClientResponse) -> int

@native("http")
fn body(response: HttpClientResponse) -> str

@native("http")
fn bodyBytes(response: HttpClientResponse) -> List<u8>

@native("http")
fn header(response: HttpClientResponse, key: str) -> Result<Option<str>, Error>

@native("http")
fn httpClientResponseFree(response: HttpClientResponse) -> Unit
