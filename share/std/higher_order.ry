# Higher-order functions
@public
@native
fn filter(values: List<int>, predicate: fn(int) -> bool) -> List<int>

@public
@native
fn map(values: List<int>, transform: fn(int) -> int) -> List<int>

@public
@native
fn reduce(values: List<int>, reducer: fn(int, int) -> int) -> Option<int>

@public
@native
fn fold(values: List<int>, init: int, reducer: fn(int, int) -> int) -> int

@public
@native
fn any(values: List<int>, predicate: fn(int) -> bool) -> bool

@public
@native
fn all(values: List<int>, predicate: fn(int) -> bool) -> bool

# sum / min / max: the declarations below register the single-list signature,
# but dispatch is handled inline by `emitBuiltinHigherOrder`
# (src/codegen_call_higher_order.cpp), which also accepts the variadic scalar
# form `sum(a, b, ...)` / `min(a, b, ...)` / `max(a, b, ...)` and float (plus u8
# for sum) — see docs/reference/collections.md (#1886). These declarations are
# dormant documentation; they do not gate codegen.
@public
@native
fn sum(values: List<int>) -> int

@public
@native
fn min(values: List<int>) -> int

@public
@native
fn max(values: List<int>) -> int

@public
@native
fn sequence(values: List<Result<int, Error>>) -> Result<List<int>, Error>

@public
@native
fn sequence(values: List<Option<int>>) -> Option<List<int>>
