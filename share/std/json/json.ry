# JSON parsing and serialization (any-based API, #1698)
#
# The opaque `JsonValue` handle and its 13 low-level accessors (parse / get /
# at / toStr / toInt / toFloat / toBool / kind / len / keys / jsonFree / two
# stringify overloads) were removed in #1698. The new API materializes
# JSON-decoded values directly as `any`, leveraging the `any`-holds-collection
# / -record / -enum extensions from #1697 / #1797 / #1798 / #1808.
#
# Runtime panic for `stringify(value: any)` on typed collections (#1811):
# `stringify` walks the inner List/Map buffer assuming a 16-byte `RyAny[]`
# element stride. The `any` slot preserves the original collection header
# pointer untouched on wrap, so passing a value constructed from a typed
# collection (e.g. `xs: List<int>; v: any = xs; stringify(v)`) would read
# past valid storage — the source's element stride is 8 bytes, not 16.
# The runtime detects this case via a side-table populated at wrap time
# and exits with a deterministic diagnostic to stderr:
#
#   stringify: any holds typed collection 'List<int>' — use List<any> /
#   Map<str, any> / Set<any> instead
#
# followed by `exit(1)`.
#
# Safe inputs to `stringify(value: any)`:
#   - An `any`-typed value obtained by widening `load[Map<str, any>](text)` /
#     `load[List<any>](text)` (the most common JSON-decoded shapes)
#   - Primitive `any` slots (int / float / bool / str / null)
#   - `List<any>` / `Map<str, any>` constructed directly by the user
#
# Inputs that exit(1) with the side-table message:
#   - `any` constructed from typed `List<T>` (T != `any`) or typed
#     `Map<K, V>` (K != `str` or V != `any`). Examples: `List<int>`,
#     `List<str>`, `Map<str, int>`, `Map<int, any>`. Box each element
#     into `List<any>` / `Map<str, any>` first, or use the result of
#     `json.load[Map<str, any>]` / `json.load[List<any>]`.
#
# Set / Record / Enum / non-`str` Map keys still panic at runtime via the
# existing "json stringify: ..." diagnostics because JSON has no native
# representation for them — these are unrelated to the side-table guard.
#
# File handle overloads (#1854, #1887):
# `load[T](f: File)` reads a JSON document from an open `File` handle and
# returns the result coerced to `T` — equivalent to `load[T](io.readAll(f)?)?`.
# `dump(f, value, [indent])` stringifies and writes to the file in one step,
# equivalent to `io.writeText(f, stringify(value [, indent]))?`. The file must
# be opened in a writable mode for `dump`. Both overloads propagate io errors
# via the returned `Result` (`__ry_io_get_last_error` is surfaced as
# `Error.message`). `stringify`'s runtime exit(1) behavior on typed
# collections / Set / Record / Enum / non-`str` Map keys is inherited by
# `dump` unchanged.

# `stringify` / `stringifySafe` both accept an optional named argument
# `sortKeys: bool` (default `false`). When `sortKeys=true`, every
# `Map<str, any>` (including those nested inside lists or other maps)
# is emitted in byte-lexicographic key order — reproducible across
# runs regardless of insertion order. The former `stringifySorted` /
# `stringifySortedSafe` functions (added in #1853) were folded into
# this named argument in v0.0.29 (#1890) and removed as a breaking
# change. Migration: `stringifySorted(v)` → `stringify(v, sortKeys=true)`,
# `stringifySortedSafe(v, 2)` → `stringifySafe(v, 2, sortKeys=true)`.
@public
@native("json")
fn stringify(value: any) -> str

@public
@native("json")
fn stringify(value: any, indent: int) -> str

# Result-returning variant of `stringify` (#1853). Unsupported inputs
# (non-finite float, typed collection wrapped as `any`, Set / Record /
# Enum / non-`str` Map keys) surface as `Err(Error)` instead of
# trapping the process. Otherwise produces the same bytes as
# `stringify`.
@public
@native("json")
fn stringifySafe(value: any) -> Result<str, Error>

@public
@native("json")
fn stringifySafe(value: any, indent: int) -> Result<str, Error>

@public
@native("json")
fn dump(f: File, value: any) -> Result<Unit, Error>

@public
@native("json")
fn dump(f: File, value: any, indent: int) -> Result<Unit, Error>

# Typed deserialization (#1852, consolidated as the sole `load` form in #1887).
# Each call site monomorphizes per T and the JSON dispatcher intercepts
# `load[T](...)` to route through the `tryUnwrapFromAny` coerce path —
# tag/structure mismatches surface as `Err(Error)` instead of panicking via
# `_Exit(1)`. The pre-#1887 non-generic `load() -> Result<any, Error>` form
# was removed because it had no safe accessor: callers had to cast the `any`
# back into a concrete type without a type-checked path. Pick a concrete T
# at the call site instead.
#
# Supported T: primitive (int / float / str / bool), homogeneous container
# (List<int|float|str|bool>, Map<str, int|float|str|bool>), List<any> /
# Map<str, any>, user-defined records (flat and nested), typed collections
# of records (List<Record>, Map<str, Record>), and Option<T>. Missing
# fields, wrong-typed fields, and unsupported source shapes surface as
# `Err(Error{message})` with a `load[T]: ...` prefix that locates the
# failure. `T = any` is not supported (would re-introduce the untyped
# access hazard #1887 was filed to remove); use `load[Map<str, any>]` /
# `load[List<any>]` for the JSON-shape-typed equivalents. See
# docs/reference/json.md for the full T table and error message format.
@public
@native("json")
fn load<T>(text: str) -> Result<T, Error>

@public
@native("json")
fn load<T>(f: File) -> Result<T, Error>
