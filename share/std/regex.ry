# Regular expression operations
@native
fn regexMatch(text: str, pattern: str) -> bool

@native
fn regexSearch(text: str, pattern: str) -> int

@native
fn regexReplace(text: str, pattern: str, replacement: str) -> str

@native
fn regexSplit(text: str, pattern: str) -> List<str>

@native
fn regexFindAll(text: str, pattern: str) -> List<Match>

# Regex literal overloads (text-first for UFCS)
@native
fn isMatch(text: str, pattern: Regex) -> bool

@native
fn search(text: str, pattern: Regex) -> int

@native
fn replace(text: str, pattern: Regex, replacement: str) -> str

@native
fn split(text: str, pattern: Regex) -> List<str>

@native
fn findAll(text: str, pattern: Regex) -> List<Match>
