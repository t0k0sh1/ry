# Standard I/O and file operations

# Standard input
@public
@native("io")
fn readLine() -> str

@public
@native("io")
fn readAll() -> str

# File I/O
@public
@native("io")
fn readText(path: str) -> Result<str, Error>

@public
@native("io")
fn writeText(path: str, content: str) -> Result<Unit, Error>

@public
@native("io")
fn appendText(path: str, content: str) -> Result<Unit, Error>

@public
@native("io")
fn exists(path: str) -> bool

@public
@native("io")
fn deleteFile(path: str) -> Result<Unit, Error>

@public
@native("io")
fn readBytes(path: str) -> Result<List<u8>, Error>

@public
@native("io")
fn writeBytes(path: str, data: List<u8>) -> Result<Unit, Error>

# Byte conversions
@public
@native("io")
fn toBytes(string: str) -> List<u8>

@public
@native("io")
fn bytesToStr(bytes: List<u8>) -> Result<str, Error>

# File handle API
@public
@native("io")
fn open(path: str, mode: str) -> Result<File, Error>

@public
@native("io")
fn readAll(f: File) -> Result<str, Error>

@public
@native("io")
fn readLine(f: File) -> Result<Option<str>, Error>

@public
@native("io")
fn writeText(f: File, s: str) -> Result<Unit, Error>

@public
@native("io")
fn close(f: File) -> Unit
