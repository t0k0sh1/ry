# Shows reading process environment variables and CLI arguments

# env(key) returns an environment variable as Option<str>. Missing values return None
case env("PATH"):
  Some(path):

    # The value can be long, so print only the first element
    parts = split(path, ":")
    print(parts[0])
  None:
    print("PATH not set")

# Unset variables return None
print(env("RY_EXAMPLES_NONEXISTENT_XYZ"))

# The two-argument env(key, default) form returns the default directly when unset
print(env("RY_EXAMPLES_NONEXISTENT_XYZ", "fallback"))

# args() returns command-line arguments as List<str>
# Running without extra args, such as `ry run examples/builtins_env_args.ry`, returns an empty List
for arg in args():
  print(arg)
