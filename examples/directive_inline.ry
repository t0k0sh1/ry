# Use the @inline directive to request a function inlining policy

# @inline without arguments is the default, equivalent to always
@inline
fn add(a: int, b: int) -> int:
  return a + b

# mode="always" inlines at every call site
@inline(mode="always")
fn mul(a: int, b: int) -> int:
  return a * b

# mode="hint" marks an inline candidate but leaves the final decision to the compiler
@inline(mode="hint")
fn sub(a: int, b: int) -> int:
  return a - b

# mode="never" explicitly requests no inlining
@inline(mode="never")
fn negate(a: int) -> int:
  return -a

# Can also be applied to recursive functions; expansion depth is implementation-dependent
@inline
fn factorial(n: int) -> int:
  if n <= 1:
    return 1
  return n * factorial(n - 1)

print(add(3, 4))
print(mul(5, 6))
print(sub(10, 3))
print(negate(-5))
print(factorial(5))
