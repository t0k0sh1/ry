# Join paths and extract path components with the path module
from ry.path import join, basename, dirname, ext

case join("/tmp", "reports", "summary.txt"):
  Ok(path):

    # Path functions return Err for invalid input such as NUL characters
    print(basename(path)?)
    print(dirname(path)?)
    print(ext(path)?)
  Err(e):
    print(e.message)
