# Shows different for-loop iterables and destructuring
# See examples/builtins_enumerate_zip.ry for iteration with enumerate / zip

# Iterate over List<int>
for x in [10, 20, 30]:
  print(x)

# range(N), range(start, end, step), and negative steps
for i in range(5):
  print(i)

for i in range(0, 10, 3):
  print(i)

for i in range(10, 0, -3):
  print(i)

# `1..3` range syntax (inclusive endpoints)
for i in 1..3:
  print(i)

# Iterate over a Map as key, value pairs
scores = {"alice": 90, "bob": 80}
for k, v in scores:
  print(k, v)

# A List of tuples can be destructured directly
triples = [(1, 2, 3), (4, 5, 6)]
for a, b, c in triples:
  print(a, b, c)

# Use `_` for unused elements
for a, _, c in triples:
  print(a + c)
