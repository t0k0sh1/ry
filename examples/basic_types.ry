# 基本型と演算子の検証

# 整数
a: int = 42
b = -7
hex = 0xFF
bin = 0b1010
big = 100_000
print(f"int: {a}, {b}, {hex}, {bin}, {big}")

# 浮動小数点
pi: float = 3.14
e = 2.718
sci = 1.5e-3
print(f"float: {pi}, {e}, {sci}")

# 文字列
s: str = "hello"
multi = "line1\nline2"
print(s)
print(multi)

# 真偽値
t = true
f = false
print(f"bool: {t} / {f}")

# 算術演算
print(f"1 + 2 = {1 + 2}")
print(f"10 - 3 = {10 - 3}")
print(f"4 * 5 = {4 * 5}")
print(f"10 / 3 = {10 / 3}")        # float division
print(f"10 // 3 = {10 // 3}")      # floor division
print(f"10 % 3 = {10 % 3}")
print(f"2 ** 10 = {2 ** 10}")      # 浮動小数点で返る点に注意

# 比較演算
print(f"1 < 2: {1 < 2}")
print(f"1 == 1: {1 == 1}")
print(f"'abc' < 'abd': {"abc" < "abd"}")

# 論理演算
print(f"true and false: {true and false}")
print(f"true or false: {true or false}")
print(f"not true: {not true}")

# ビット演算
print(f"5 & 3 = {5 & 3}")
print(f"5 | 3 = {5 | 3}")
print(f"5 ^ 3 = {5 ^ 3}")
print(f"~5 = {~5}")
print(f"1 << 4 = {1 << 4}")
print(f"16 >> 2 = {16 >> 2}")

# 型キャスト
x = 42 as float
y = 3.14 as int
s2 = 42 as str
print(f"cast: {x} / {y} / {s2}")
