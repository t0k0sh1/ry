# Shows call-form conversions int(str)/float(str)/str(v) and ?? defaults
# See examples/type_cast_as.ry for casts using the `as` keyword

# Parse strings: success is Ok, failure is Err
case int("42"):
  Ok(v):
    print(v)
  Err(e):
    print(e.message)

case float("3.14"):
  Ok(v):
    print(v)
  Err(e):
    print(e.message)

# Fall back to a default value with ??
print(int("abc") ?? -1)

# String display for values, including int/float/bool
print(str(42))
print(str(true))

# Can be treated as a first-class function: apply int to List<str> with map
texts: List<str> = ["1", "2", "3"]
print(map(texts, int))
