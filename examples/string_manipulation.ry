# Shows string case conversion, trim, split/join, replace, and prefix/suffix checks
text = "  Hello, Ry World  "

# Remove surrounding whitespace / trim only one side
print(trim(text))
print(trimStart(text))
print(trimEnd(text))

# Case conversion
print(toUpper("hello"))
print(toLower("HELLO"))

# Substring replacement (target -> replacement)
print(replace("aaabbb", "a", "X"))

# Split by a delimiter and join back together
parts = split("one,two,three", ",")
print(parts)
print(join(parts, " | "))

# Prefix/suffix checks, including ignoreCase versions
print(startsWith("hello world", "hello"))
print(endsWith("hello world", "world"))
print(startsWith("Hello", "hello", true))
