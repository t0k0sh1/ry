# Shows embedding value expressions and displaying records with f-strings
record Point:
  x: int
  y: int

n = 42
pi = 3.14
flag = true
p = Point(3, 4)

# Embed each primitive with {}
print(f"value: {n}")
print(f"pi: {pi}")
print(f"flag: {flag}")

# Expressions inside braces
a = 1
b = 2
print(f"{a} + {b} = {a + b}")

# Records are automatically converted to str too
print(f"point = {p}")

# Literal braces in a string, not escapes
print("{braces}")
