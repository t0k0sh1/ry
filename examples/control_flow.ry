# 制御フローの検証

# if / else (文)
x = 10
if x > 5:
    print("big")
else:
    print("small")

# if 式 (=> 形式)
absVal = if x > 0 => x else -x
print(f"abs = {absVal}")

# if 式 (: 形式)
label = if x >= 5: "high" else: "low"
print(f"label = {label}")

# 三項演算子 (=> 形式) で複雑な式
score = 85
grade = if score >= 90 => "A" else if score >= 80 => "B" else "C"
print(f"grade = {grade}")

# while
i = 0
while i < 3:
    print(f"while i = {i}")
    i += 1

# break / continue
i = 0
while true:
    i += 1
    if i == 2:
        continue
    if i >= 5:
        break
    print(f"loop {i}")

# for range
sum = 0
for n in range(1, 11):
    sum += n
print(f"sum 1..10 = {sum}")

# for range with step
for n in range(0, 10, 2):
    print(f"even: {n}")

# for over list
xs = [10, 20, 30]
for v in xs:
    print(f"list: {v}")

# enumerate
for i, v in enumerate(["a", "b", "c"]):
    print(f"{i}: {v}")

# zip
for a, b in zip([1, 2, 3], ["x", "y", "z"]):
    print(f"{a} -> {b}")

# case (pattern matching - 整数)
n = 2
case n:
    1:
        print("one")
    2:
        print("two")
    3:
        print("three")
    _:
        print("other")

# case 式 (値返し: スペース + コロン形式)
status = 404
msg = case status:
    200 : "OK"
    404 : "Not Found"
    500 : "Server Error"
    _ : "Unknown"
print(f"status: {msg}")
