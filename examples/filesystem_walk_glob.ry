# Shows recursive directory traversal with walk and pattern matching with glob
from ry.filesystem import mkdirAll, walk, glob, removeAll
from ry.io import writeText
from ry.path import join

# Fixture: prepare nested directories and a few files
fn setup(root: str) -> Result<Unit, Error>:
  removeAll(root)
  mkdirAll(join(root, "sub", "deep")?)
  writeText(join(root, "a.log")?, "alpha")
  writeText(join(root, "sub", "b.log")?, "beta")
  writeText(join(root, "sub", "deep", "c.txt")?, "gamma")
  return Ok(0 as u8)

root = "/tmp/ry_examples_walk"
case setup(root):
  Ok(_):

    # walk returns every entry below the path (files and directories) as a Result
    case walk(root):
      Ok(entries):
        print(len(entries) >= 5)
      Err(e):
        print(e.message)

    # glob returns matching paths in one directory as a List
    case join(root, "*.log"):
      Ok(pattern):
        case glob(pattern):
          Ok(matches):
            print(len(matches))
          Err(e):
            print(e.message)
      Err(e):
        print(e.message)

    # No matches produce an empty List
    case glob("/tmp/ry_examples_no_match_*.zzz"):
      Ok(matches):
        print(len(matches))
      Err(e):
        print(e.message)
  Err(e):
    print(e.message)

removeAll(root)
