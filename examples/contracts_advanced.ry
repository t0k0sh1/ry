# Shows multiple require clauses, ensure postconditions, and inherited record invariants
# See examples/contracts.ry for the basic single-clause form

# All require clauses must be true
fn deposit(amount: int, balance: int) -> int:
  require:
    amount > 0
    balance >= 0
  return balance + amount

print(deposit(100, 50))

# ensure v: is a postcondition that refers to return value v
fn absVal(x: int) -> int:
  ensure v:
    v >= 0
  if x < 0:
    return -x
  return x

print(absVal(-5))
print(absVal(3))

# ensure clauses can also reference arguments
fn increment(x: int) -> int:
  ensure v:
    v == x + 1
  return x + 1

print(increment(10))

# Parent record invariants are inherited by child records
record Positive:
  value: int
  invariant:
    value > 0

record NamedPositive < Positive:
  name: str

np = NamedPositive(42, "good")
print(np.value)
print(np.name)
