# Use digits to split an integer into a List<int> of digits (little-endian order)
from ry.math import digits

# Base 10: 1234 -> [4, 3, 2, 1] (least-significant digit first)
d = digits(1234)
print(d)
print(sum(d))
print(digits(0))
print(digits(1))

# Base 2: 8 -> [0, 0, 0, 1]
print(digits(8, 2))
print(digits(13, 2))

# Base 16: 255 -> [15, 15]
print(digits(255, 16))
print(digits(4095, 16))
