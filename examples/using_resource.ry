# Use a using block to reliably release resources such as file handles
from ry.io import open, writeText, readAll, close, deleteFile

path = "/tmp/ry_examples_using.txt"

# Bind a handle with `using f = open(...)?:`; close runs automatically when the block exits
fn writeViaUsing(p: str, content: str) -> Result<Unit, Error>:
  using f = open(p, "w")?:
    case writeText(f, content):
      Ok(_):
        0
      Err(e):
        return Err(e)
  return Ok(0 as u8)

case writeViaUsing(path, "hello via using\n"):
  Ok(_):
    print("written")
  Err(e):
    print(e.message)

# Early return with ? inside a using block still calls close reliably
fn readViaUsing(p: str) -> Result<str, Error>:
  using f = open(p, "r")?:
    case readAll(f):
      Ok(s):
        return Ok(s)
      Err(e):
        return Err(e)
  return Err(Error("unreachable"))

case readViaUsing(path):
  Ok(s):
    print(s)
  Err(e):
    print(e.message)

# Nested using blocks close from the inside out
# An inner writeText(...)? propagates Err on failure while still closing the outer using resource
fn writeTwo(a: str, b: str) -> Result<Unit, Error>:
  using fa = open(a, "w")?:
    using fb = open(b, "w")?:
      writeText(fa, "A")?
      writeText(fb, "B")?
  return Ok(0 as u8)

pathA = "/tmp/ry_examples_using_a.txt"
pathB = "/tmp/ry_examples_using_b.txt"
case writeTwo(pathA, pathB):
  Ok(_):
    print("both written")
  Err(e):
    print(e.message)

deleteFile(path)
deleteFile(pathA)
deleteFile(pathB)
