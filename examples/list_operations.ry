# Shows safe List index access plus non-mutating and mutating operations
values = [10, 20, 30]

# get returns None out of range; get with a default returns the supplied value
print(get(values, 1))
print(get(values, 100, -1))

# The ? index form can also be used for safe Option lookup
print(values[-1]?)

copy = appended(values, 40)
append!(values, 50)

print(f"copy = {copy}")
print(f"values = {values}")
