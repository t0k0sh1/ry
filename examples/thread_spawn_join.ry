# Shows parallel processing with threadSpawn/threadJoin and AtomicInt
from ry.thread import threadSpawn, threadJoin, atomicIntNew, atomicIntLoad, atomicIntAdd

# The parallel work body can be an inner lambda
# AtomicInt addition is race-free, so the total is deterministic after joining
fn runParallelSum() -> int:
  counter = atomicIntNew(0)
  t1 = threadSpawn(():
    atomicIntAdd(counter, 10)
  )
  t2 = threadSpawn(():
    atomicIntAdd(counter, 20)
  )
  threadJoin(t1)
  threadJoin(t2)
  return atomicIntLoad(counter)

print(runParallelSum())
