# コレクション (List, Map, Set, Tuple) の検証

# List
xs: List<int> = [1, 2, 3, 4, 5]
print(f"xs = {xs}")
print(f"len = {len(xs)}")
print(f"xs[0] = {xs[0]}")
print(f"xs[-1] = {xs[-1]}")    # 末尾アクセスは Python ライク?

# List 操作
append!(xs, 6)
print(f"after append: {xs}")

popped = pop(xs)
print(f"popped: {popped}, xs: {xs}")

# slice (Python の [a:b] と異なり関数または .. を使う)
ys = slice(xs, 1, 4)
print(f"slice(1,4) = {ys}")
ys2 = xs[1..3]              # 範囲記法 (両端 inclusive)
print(f"xs[1..3] = {ys2}")

# in 演算子
print(f"3 in xs: {3 in xs}")
print(f"99 in xs: {99 in xs}")

# List concatenation
a = [1, 2, 3]
b = [4, 5, 6]
c = a + b
print(f"concat = {c}")

# sort
nums = [3, 1, 4, 1, 5, 9, 2, 6]
sorted_nums = sort(nums)
print(f"sorted = {sorted_nums}")

# reverse
print(f"reversed = {reverse(sorted_nums)}")

# Map
m: Map<str, int> = {"alice": 30, "bob": 25}
print(f"map = {m}")
print(f"alice = {m["alice"]}")

# Map 追加
m["carol"] = 40
print(f"after add: {m}")

# Map keys / values
print(f"keys = {keys(m)}")
print(f"values = {values(m)}")

# Map iteration
for k, v in items(m):
    print(f"  {k} -> {v}")

# Set
s: Set<int> = {1, 2, 3, 2, 1}
print(f"set = {s}")
print(f"len = {len(s)}")
print(f"2 in s: {2 in s}")

# Set 操作
add(s, 99)
print(f"after add: {s}")

# Tuple
t = (1, "hello", 3.14)
print(f"tuple = {t}")
print(f"t.0 = {t.0}")
print(f"t.1 = {t.1}")

# Tuple destructure
a2, b2, c2 = t
print(f"destructure: {a2} / {b2} / {c2}")

# ネスト
nested = [[1, 2], [3, 4], [5, 6]]
print(f"nested = {nested}")
print(f"nested[1][0] = {nested[1][0]}")
