# Constrain accepted values with literal, range, and union types
type Direction = "N" | "S" | "E" | "W"

type Month = 1..12

fn schedule(direction: Direction, month: Month) -> str:
  return f"{direction} in month {month}"

print(schedule("N", 6))

# A union type can hold any of the listed types
value: int | str = 42
print(value)
value = "forty-two"
print(value)
