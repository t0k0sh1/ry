# 関数とクロージャの検証

# 通常関数
fn add(a: int, b: int) -> int:
    return a + b
print(f"add(3,4) = {add(3, 4)}")

# 返り値型推論
fn double(x: int):
    return x * 2
print(f"double(5) = {double(5)}")

# Unit 返り値 (省略可)
fn greet(name: str):
    print(f"hello, {name}")
greet("Ry")

# 引数型省略 (any)
fn show(x):
    print(x)
show(42)
show("text")
show([1, 2, 3])

# 再帰
fn fact(n: int) -> int:
    if n <= 1:
        return 1
    return n * fact(n - 1)
print(f"fact(5) = {fact(5)}")

# 相互再帰
fn isEven(n: int) -> bool:
    if n == 0:
        return true
    return isOdd(n - 1)

fn isOdd(n: int) -> bool:
    if n == 0:
        return false
    return isEven(n - 1)
print(f"isEven(10) = {isEven(10)}")

# Lambda
square = (x: int) => x * x
print(f"square(7) = {square(7)}")

# Higher-order
fn apply(f: fn(int) -> int, x: int) -> int:
    return f(x)
print(f"apply(square, 4) = {apply(square, 4)}")

# Closure
fn makeAdder(base: int) -> fn(int) -> int:
    fn add(x: int) -> int:
        return x + base
    return add

add10 = makeAdder(10)
print(f"add10(5) = {add10(5)}")

# Map / Filter / Reduce
xs = [1, 2, 3, 4, 5]
doubled = map(xs, (n: int) => n * 2)
print(f"doubled = {doubled}")

evens = filter(xs, (n: int) => n % 2 == 0)
print(f"evens = {evens}")

total = fold(xs, 0, (acc: int, n: int) => acc + n)
print(f"sum = {total}")

# ネスト関数
fn outer() -> int:
    fn helper() -> int:
        return 42
    return helper()
print(f"outer = {outer()}")
