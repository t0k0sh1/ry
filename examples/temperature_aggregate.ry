# Sensor 読み取りを location 別に集計し min/max/avg を出す小プログラム

record Reading:
  location: str
  celsius: float

record Stats:
  location: str
  count: int
  minC: float
  maxC: float
  sumC: float

fn statAvg(s: Stats) -> float:
  if s.count == 0:
    return 0.0
  return s.sumC / (s.count as float)

fn updateStats(prev: Stats, c: float) -> Stats:
  newMin = if c < prev.minC => c else prev.minC
  newMax = if c > prev.maxC => c else prev.maxC
  return Stats(prev.location, prev.count + 1, newMin, newMax, prev.sumC + c)

fn aggregate(readings: List<Reading>) -> Map<str, Stats>:
  result: Map<str, Stats> = {}
  for r in readings:
    case get(result, r.location):
      Some(prev):
        result[r.location] = updateStats(prev, r.celsius)
      None:
        result[r.location] = Stats(r.location, 1, r.celsius, r.celsius, r.celsius)
  return result

fn locationsOrdered(stats: Map<str, Stats>) -> List<str>:
  out: List<str> = []
  for k, _ in stats:
    append!(out, k + "")
  return sort(out, (a: str, b: str) => a < b)

fn formatStats(s: Stats) -> str:
  return f"count={s.count} min={s.minC} max={s.maxC} avg={statAvg(s)}"

# --- demo ---

readings: List<Reading> = [
  Reading("tokyo", 23.5),
  Reading("osaka", 25.1),
  Reading("tokyo", 22.8),
  Reading("sapporo", 17.3),
  Reading("osaka", 26.4),
  Reading("tokyo", 24.0),
  Reading("sapporo", 16.1),
  Reading("osaka", 24.9)
]

stats = aggregate(readings)

print("readings by location:")
for loc in locationsOrdered(stats):
  case get(stats, loc):
    Some(s):
      print(f"  {loc}: {formatStats(s)}")
    None:
      print(f"  {loc}: (missing)")

# extreme finder: hottest and coldest avg
hottestAvg = -1000.0
hottest = ""
coldestAvg = 1000.0
coldest = ""
for loc, s in stats:
  avg = statAvg(s)
  if avg > hottestAvg:
    hottestAvg = avg
    hottest = loc
  if avg < coldestAvg:
    coldestAvg = avg
    coldest = loc

print(f"\nhottest avg: {hottest} ({hottestAvg})")
print(f"coldest avg: {coldest} ({coldestAvg})")

# error path: aggregate of empty list
empty: List<Reading> = []
emptyStats = aggregate(empty)
print(f"\naggregate of empty list: {len(emptyStats)} entries")
