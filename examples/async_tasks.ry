# Shows async functions, await, and blockOn from synchronous code
async fn add(a: int, b: int) -> int:
  return a + b

async fn doubledSum(a: int, b: int) -> int:
  # Inside an async function, await receives the Task result
  total = await add(a, b)
  return total * 2

task: Task<int> = doubledSum(20, 1)
print(blockOn(task))
