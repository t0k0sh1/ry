# Shows character count, byte count, search, and iteration for UTF-8 strings
text = "こんにちはRy"

# len counts Unicode code points; byteLen counts UTF-8 bytes
print(f"characters = {len(text)}")
print(f"bytes = {byteLen(text)}")
print(f"contains Ry = {contains(text, "Ry")}")
print(f"substring = {substr(text, 0, 5)}")

for character in "日本":
  print(character)
