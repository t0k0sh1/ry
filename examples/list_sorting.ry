# Shows List sorting, slicing, distinct, and flat
xs = [5, 3, 1, 4, 2]

# Default ascending sort (returns a non-mutating copy)
print(sort(xs))

# Descending order with a custom comparator
print(sort(xs, (a: int, b: int) => a > b))

# The in-place sort! form rewrites the original List
mutable = [3, 1, 2]
sort!(mutable)
print(mutable)

# slice(start, end) returns a sub-List
print(slice([10, 20, 30, 40, 50], 1, 4))

# take(n) returns up to n elements from the front
print(take([1, 2, 3, 4, 5], 3))
print(take([1, 2, 3], 10))

# distinct removes duplicates while preserving first-seen order
print(distinct([1, 2, 3, 2, 1, 4]))

# flat flattens one level of nesting
print(flat([[1, 2], [3, 4], [5]]))
