# Shows variants, equality, and case matching for enums without associated data
enum Color:
  Red
  Green
  Blue

# The same variant is equal; different variants are not equal
print(Color::Red == Color::Red)
print(Color::Red != Color::Green)

# str() returns the variant name
print(str(Color::Red))
print(str(Color::Blue))

# Branch on variants with case
fn name(c: Color) -> str:
  return case c:
    Color::Red : "red"
    Color::Green : "green"
    Color::Blue : "blue"

print(name(Color::Blue))
