# Use enumerate and zip to produce index pairs and element pairs
xs = [10, 20, 30]

# enumerate(xs) returns a List of (index, value) tuples
pairs = enumerate(xs)
print(pairs)

# Destructure them in a normal for loop
for i, x in enumerate(xs):
  print(i, x)

# zip(a, b) pairs elements at the same index
ys = ["a", "b", "c"]
combined = zip(xs, ys)
print(combined)

for n, label in zip(xs, ys):
  print(label, n)

# When lengths differ, the result is truncated to the shorter side
print(zip([1, 2, 3], [10, 20]))
print(zip([1, 2], [10, 20, 30, 40]))
