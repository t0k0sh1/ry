# Shows safe value lookup and early return with Option and ?
fn firstTwoSum(values: List<int>) -> Option<int>:
  # The first ? returns Option; the ? after whitespace early-returns None
  first = values[0]? ?
  second = values[1]? ?
  return Some(first + second)

print(firstTwoSum([10, 20]))
print(firstTwoSum([10]))

# An empty List needs a type annotation because the element type cannot be inferred
empty: List<int> = []
print(firstTwoSum(empty))
