# Shows resolve and isAbsolute from the path module
# See examples/path_components.ry for join and basename/dirname/ext
from ry.path import resolve, isAbsolute

# isAbsolute checks whether a path is absolute
print(isAbsolute("/tmp"))
print(isAbsolute("tmp/file"))
print(isAbsolute(""))

# resolve resolves a path to an absolute path when the target exists
case resolve("/tmp"):
  Ok(absolute):
    print(isAbsolute(absolute))
  Err(e):
    print(e.message)

# A missing path returns Err
case resolve("/nonexistent_path_xyz_12345_ry_example"):
  Ok(_):
    print("unexpected ok")
  Err(e):
    print(e.message)
