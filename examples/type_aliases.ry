# Give types meaningful names with type aliases; also shows union and nested aliases

# Basic primitive alias
type Meters = float

distance: Meters = 3.14
print(distance)

# Union alias of two primitives
type Pair = int | str

a: Pair = 42
b: Pair = "hello"
print(str(a))
print(str(b))

# Nested aliases are flattened
type Inner = int | str

type Outer = Inner | bool

v1: Outer = 7
v2: Outer = "ok"
v3: Outer = true
print(str(v1), str(v2), str(v3))

# Use a union alias in function parameters and return values
type Tagged = int | str

fn show(v: Tagged) -> str:
  return str(v)

fn choose(b: bool) -> Tagged:
  if b:
    return 42
  return "zero"

print(show(7))
print(show("abc"))
print(show(choose(true)))
print(show(choose(false)))
