# Shows differences between arithmetic operators for integers and floats
a = 10
b = 3

# / is float division; // is integer division rounding down
print(f"{a} / {b} = {a / b}")
print(f"{a} // {b} = {a // b}")
print(f"-{a} // {b} = {-a // b}")

# ** always returns float
print(f"2 ** 8 = {2 ** 8}")
print(f"10 % 3 = {10 % 3}")

# / on low-level integer types performs integer division of the same type
x: i32 = 10i32
y: i32 = 3i32
print(f"i32 division = {x / y}")
