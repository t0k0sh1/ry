# 整数と浮動小数点数に対する算術演算子の違いを示す
a = 10
b = 3

# / は float 除算、// は切り捨て方向の整数除算
print(f"{a} / {b} = {a / b}")
print(f"{a} // {b} = {a // b}")
print(f"-{a} // {b} = {-a // b}")

# ** は常に float を返す
print(f"2 ** 8 = {2 ** 8}")
print(f"10 % 3 = {10 % 3}")

# 低レベル整数型の / は同じ型の整数除算になる
x: i32 = 10i32
y: i32 = 3i32
print(f"i32 division = {x / y}")
