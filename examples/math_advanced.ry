# Shows trigonometric functions, log/exp/pow, and special-value checks from the math module
from ry.math import PI, E, INF, NAN, sin, cos, tan, atan2, hypot, log, log2, log10, exp, pow, isNan, isInf

# Trigonometric functions - arguments are radians
print(sin(0.0))
print(cos(0.0))
print(tan(0.0))

# 2D angle and hypotenuse
print(atan2(0.0, 1.0))
print(hypot(3.0, 4.0))

# Natural log, base-2 log, and base-10 log
print(log(1.0))
print(log2(8.0))
print(log10(100.0))

# Log with an arbitrary base
print(log(81.0, 3.0))

# Exponential e^x and integer pow
print(exp(0.0))
print(pow(2, 10))
print(pow(-2, 3))

# Special-value checks: NAN is not equal even to itself
print(isNan(NAN))
print(NAN == NAN)
print(isInf(INF))
print(isNan(log(-1.0)))
