# Shows regex* functions that take regular expressions as string patterns
# See examples/regex_literals.ry for Regex literals like `/.../`

# regexMatch returns whether the pattern matches a substring
print(regexMatch("hello", "[a-z]+"))
print(regexMatch("HELLO", "[a-z]+"))

# regexReplace replaces all matched occurrences
print(regexReplace("abc123def456", "[0-9]+", "X"))

# regexSplit splits by the pattern
print(regexSplit("a1b2c3", "[0-9]"))

# regexFindAll returns every matched substring as a List
print(regexFindAll("a1b2c3", "[0-9]"))
