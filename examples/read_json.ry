# JSON input using the stdlib json module
from ry.json import load

# Parse as a typed Map<str, any>
raw = "{\"name\": \"Alice\", \"age\": 30, \"items\": [1, 2, 3]}"
case load[Map<str,any>](raw):
  Ok(v):
    print(f"parsed (map): {v}")
    # Narrow extracted values type-safely with asType[T]
    case asType[str](v["name"]):
      Ok(name): print(f"name: {name}")
      Err(e):   print(f"name err: {e.message}")
    case asType[int](v["age"]):
      Ok(age): print(f"age: {age}")
      Err(e):  print(f"age err: {e.message}")
  Err(e):
    print(f"parse err: {e.message}")

# Parse primitive values
case load[int]("42"):
  Ok(n):
    print(f"int from json: {n}")
  Err(_):
    print("err")

case load[List<int>]("[1, 2, 3]"):
  Ok(xs):
    print(f"list from json: {xs}")
    for x in xs:
      print(f"  item: {x}")
  Err(_):
    print("err")
