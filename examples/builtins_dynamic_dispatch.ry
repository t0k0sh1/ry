# Shows safe narrowing of any values with asType[T] / isType[T]
# Standard pattern for narrowing any values from APIs such as JSON load[Map<str, any>]

# isType[T] is true when any holds type T
v: any = 42
print(isType[int](v))
print(isType[str](v))
print(isType[bool](v))

# asType[T] is a checked cast. It returns Ok on match and Err on mismatch
case asType[int](v):
  Ok(n):
    print(n)
  Err(e):
    print(e.message)

w: any = "hello"
case asType[int](w):
  Ok(_):
    print("unexpected ok")
  Err(e):
    print(e.message)

# Dispatch by trying casts against different any values in order
fn describe(value: any) -> str:
  case asType[int](value):
    Ok(n):
      return "int: " + str(n)
    Err(_):
      0
  case asType[str](value):
    Ok(s):
      return "str: " + s
    Err(_):
      0
  case asType[bool](value):
    Ok(b):
      return "bool: " + str(b)
    Err(_):
      0
  return "unknown"

asInt: any = 7
asStr: any = "ry"
asBool: any = true
print(describe(asInt))
print(describe(asStr))
print(describe(asBool))
