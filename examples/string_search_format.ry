# Shows string search, character access, counts, repetition, reversal, and substring extraction
text = "the quick brown fox"

# find: returns the first substring position as Option<int>
print(find(text, "quick"))
print(find(text, "missing"))

# charAt returns the character at the given position as str (Unicode code point units)
print(charAt("abc", 1))
print(charAt("日本語", 1))

# count: number of occurrences, including ignoreCase versions
print(count("banana", "a"))
print(count("Banana", "a", true))

# repeat and reverse
print(repeat("ab", 4))
print(reverse("hello"))

# substr(start, end) extracts a substring (Unicode code point units)
print(substr("greeting", 0, 5))
