# Shows Map keys/values/hasKey/merge/remove
scores = {"alice": 90, "bob": 80, "carol": 75}

# keys returns a List of keys; values returns a List of values
print(keys(scores))
print(values(scores))

# Use hasKey to check presence
print(hasKey(scores, "alice"))
print(hasKey(scores, "dave"))

# merge: combine maps while values from the second map overwrite matching keys from the first
defaults = {"alice": 0, "dave": 50}
updated = merge(defaults, scores)
print(updated)

# remove deletes a key in place
remove(scores, "bob")
print(scores)

# Removing a missing key is a no-op
remove(scores, "nonexistent")
print(len(scores))
