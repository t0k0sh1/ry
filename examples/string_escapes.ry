# Shows the main escape sequences in string literals
# See examples/string_unicode.ry for display length (Unicode code point count)

# Newline, tab, backslash, and quotes
print("line1\nline2")
print("col1\tcol2")
print("path: C:\\Users\\name")
print("quote: \"hello\"")

# Unicode characters can be written directly in UTF-8 literals
print("あいう")
print("こんにちは")

# Raw NUL is preserved inside strings; Ry str is byte-safe
withNul = "a\0b"
print(byteLen(withNul))

# Block strings (triple quotes) keep multiple lines without escapes
multi = """
  line A
  line B
  """

print(multi)
