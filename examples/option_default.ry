# Use the ?? operator to extract a value from Option or use a default

# Map indexing returns None for missing keys. Use ? for Option, then ?? for a default
prices: Map<str, int> = {"apple": 100, "banana": 80}
print(prices["apple"]? ?? -1)
print(prices["pear"]? ?? -1)

# List indexing works the same way. Negative indices refer from the end
nums = [10, 20, 30]
print(nums[1]? ?? 0)
print(nums[100]? ?? 0)
print(nums[-1]? ?? 0)

# This can also be used directly on return values from functions that return Option
fn firstPositive(values: List<int>) -> Option<int>:
  for n in values:
    if n > 0:
      return Some(n)
  return None

print(firstPositive([-1, -2, 3, 4]) ?? -999)
print(firstPositive([-1, -2]) ?? -999)
