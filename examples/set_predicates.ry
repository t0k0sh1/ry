# Shows Set symmetric difference, subset checks, and in-place add/remove
a = {1, 2, 3}
b = {2, 3, 4}

# symmetricDifference returns elements that appear on exactly one side
print(symmetricDifference(a, b))

# Use isSubset / isSuperset to check set relationships
small = {1, 2}
big = {1, 2, 3}
print(isSubset(small, big))
print(isSubset(big, small))
print(isSuperset(big, small))

# add inserts an element in place. Adding an existing element is a no-op
s = {1, 2, 3}
add(s, 4)
add(s, 1)
print(s)
print(len(s))

# remove deletes an element in place. Removing a missing element is a no-op
remove(s, 2)
remove(s, 999)
print(s)
