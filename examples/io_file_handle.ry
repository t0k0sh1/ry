# Shows the file-handle API with open / readAll / readLine / lines
from ry.io import open, readAll, readLine, writeText, close, deleteFile, lines

path = "/tmp/ry_examples_file_handle.txt"

# Writing: writeText writes directly to a path in one call
case writeText(path, "alpha\nbeta\ngamma\n"):
  Ok(_):
    0
  Err(e):
    print(e.message)

# Read all: open a handle, then call readAll
case open(path, "r"):
  Ok(f):
    case readAll(f):
      Ok(content):
        print(content)
      Err(e):
        print(e.message)
    close(f)
  Err(e):
    print(e.message)

# Read one line at a time: readLine returns Result<Option<str>, Error>
# EOF returns Ok(None); an available line returns Ok(Some(line))
case open(path, "r"):
  Ok(f):
    case readLine(f):
      Ok(opt):
        case opt:
          Some(line):
            print(line)
          None:
            print("EOF")
      Err(e):
        print(e.message)
    close(f)
  Err(e):
    print(e.message)

# lines() returns a line iterator that can be used directly with for ... in
case open(path, "r"):
  Ok(f):
    for line in lines(f):
      print(line)
    close(f)
  Err(e):
    print(e.message)

deleteFile(path)
