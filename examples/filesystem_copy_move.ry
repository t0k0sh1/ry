# Shows file operations with filesystem copy / move
from ry.filesystem import mkdirAll, copy, move, removeAll, isFile
from ry.io import readText, writeText
from ry.path import join

# Wrap the whole flow in a Result-valued function and keep it flat with ?
fn demo(root: str) -> Result<Unit, Error>:
  removeAll(root)
  mkdirAll(root)
  src = join(root, "source.txt")?
  writeText(src, "original content")?

  # copy duplicates contents and leaves the source file in place
  copyDst = join(root, "copy.txt")?
  copy(src, copyDst)?
  print(readText(copyDst)?)
  print(isFile(src)?)

  # move renames/moves the source file. The original path disappears
  moveDst = join(root, "moved.txt")?
  move(src, moveDst)?
  print(isFile(moveDst)?)
  print(isFile(src)?)
  return Ok(0 as u8)

root = "/tmp/ry_examples_copy_move"
case demo(root):
  Ok(_):
    0
  Err(e):
    print(e.message)

removeAll(root)
