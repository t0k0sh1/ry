# json5.load accepts config-file extensions beyond JSON
from ry.json5 import load, stringify

# JSON5 accepts inputs that strict JSON rejects, such as:
# - // and /* */ comments
# - unquoted keys and single quotes
# - trailing commas, hexadecimal integers, and leading-decimal numbers
src = "{\n  // tool config\n  name: 'ry',\n  port: 0xFF,\n  ratio: .5,\n}"

case load[Map<str,any>](src):
  Ok(config):
    print(stringify(config, sortKeys=true))
  Err(e):
    print(e.message)

# Converting back to strict JSON preserves the original meaning (round trip)
src2 = "{ a: 1, b: [1, 2, 3,], }"
case load[Map<str,any>](src2):
  Ok(v):
    print(stringify(v, sortKeys=true))
  Err(e):
    print(e.message)
