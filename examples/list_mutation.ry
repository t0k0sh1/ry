# Shows List insertion, removal, and lookup operations
xs = [1, 2, 3]

# insert(list, index, value) inserts at the specified position
insert(xs, 1, 99)
print(xs)

# removeAt(list, index) removes and returns the element at index
v = removeAt(xs, 1)
print(v)
print(xs)

# pop returns Option<T>. It returns None for an empty List
stack = [10, 20, 30]
print(pop(stack))
print(stack)

empty: List<int> = []
print(pop(empty))

# first / last return values safely as Option
print(first([100, 200, 300]))
print(last([100, 200, 300]))
print(first(empty))

# Use isEmpty to check whether the List is empty
print(isEmpty(empty))
print(isEmpty([0]))

# tap applies a side-effect function to elements while returning the original List
nums = [1, 2, 3]
echoed = tap(nums, (x: int) => x * 10)
print(echoed)

# reverse! reverses in place
ys = [1, 2, 3]
reverse!(ys)
print(ys)
