# Shows case as a value-producing expression, OR-patterns, string-literal matches, and guards

# Expression form with integer literals and wildcard
x = 2
label = case x:
  1 : "one"
  2 : "two"
  _ : "other"

print(label)

# OR-pattern: branch on values such as 1 | 2 | 3 together
fn bucket(n: int) -> str:
  return case n:
    1 | 2 | 3 : "small"
    4 | 5 | 6 : "medium"
    _ : "large"

print(bucket(3))
print(bucket(5))

# Guarded branches - the first matching arm in evaluation order is selected
score = 85
grade = case score:
  n if n >= 90 : "A"
  n if n >= 80 : "B"
  n if n >= 70 : "C"
  _ : "F"

print(grade)

# Match string literals
s = "hello"
kind = case s:
  "hello" : "greeting"
  "bye" : "farewell"
  _ : "unknown"

print(kind)

# Negative integer literals can also be matched
y = -1
sign = case y:
  -1 : "minus one"
  0 : "zero"
  _ : "other"

print(sign)
