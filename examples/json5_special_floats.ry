# json5 can read and write Infinity / NaN, which strict JSON rejects
from ry.json5 import load, stringify, stringifySafe
from ry.math import INF, NAN, isInf, isNan

# json5 accepts special float values that strict JSON returns Err for
case load[float]("Infinity"):
  Ok(v):
    print(isInf(v))
  Err(e):
    print(e.message)

case load[float]("-Infinity"):
  Ok(v):
    print(v < 0.0)
  Err(e):
    print(e.message)

case load[float]("NaN"):
  Ok(v):
    print(isNan(v))
  Err(e):
    print(e.message)

# stringify outputs "Infinity" / "-Infinity" / "NaN" as-is
posInf: any = INF
print(stringify(posInf))

negInf: any = -INF
print(stringify(negInf))

nan: any = NAN
print(stringify(nan))

# stringifySafe also allows non-finite values, unlike strict json
case stringifySafe(posInf):
  Ok(s):
    print(s)
  Err(e):
    print(e.message)
