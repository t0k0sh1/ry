# Shows the two lambda styles, => form and block-body form, plus fn type annotations

# => form: a single-expression lambda
double = (x: int) => x * 2
print(double(7))

# Block-body form: can contain multiple expressions and statements
classify = (x: int) -> str:
  if x < 0:
    return "negative"
  if x == 0:
    return "zero"
  return "positive"
print(classify(-3))
print(classify(0))
print(classify(5))

# Use an fn type as a function parameter
fn apply(f: fn(int) -> int, value: int) -> int:
  return f(value)

print(apply(double, 10))
print(apply((x: int) => x + 100, 5))

# A zero-argument fn() -> int value can be passed directly too
fn invoke(f: fn() -> int) -> int:
  return f()

print(invoke(() => 42))
