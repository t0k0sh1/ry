# Word count (Map usage and text processing)
text = "the quick brown fox jumps over the lazy dog the cat is on the mat"
words = split(text, " ")

counts: Map<str, int> = {}
for w in words:
  case get(counts, w):
    Some(c):
      counts[w] = c + 1
    None:
      counts[w] = 1

# Output: by word count (Map preserves order, but we want sorted output)
pairs = items(counts)

# pairs is List<(str, int)>. Sort descending
# The sort comparator returns bool (meaning a < b)
sorted = sort(pairs, (a: (str, int), b: (str, int)) => a.1 > b.1)

print("Word frequency (descending):")
for p in sorted:
  print(f"  {p.0}: {p.1}")
