# Shows the canonical selective import form: from ry.<module> import <name>
# Covers both implicit prelude use and explicit imports

# Import only specific names from a module
from ry.math import PI, sqrt
from ry.base64 import encode

print(sqrt(2.0))
print(PI)
print(encode("hi"))

# Another symbol from the same module may be imported on a separate line
from ry.math import abs, round

print(abs(-3))
print(round(3.7))

# The prelude (ry.lang) is available without imports. It can also be imported explicitly
from ry.lang import map, filter

nums: List<int> = [1, 2, 3, 4, 5]
print(map(nums, (n: int) => n * 10))
print(filter(nums, (n: int) => n % 2 == 0))
