# Shows transforming values with map on Option while None propagates automatically
# See examples/option_safe_access.ry for the `?` short-circuit form

# Mapping over Some transforms the value and keeps Some
some: int? = Some(42)
doubled = map(some, (x: int) => x * 2)
print(doubled)

# Mapping over None still returns None (the function is not called)
empty: int? = None
print(map(empty, (x: int) => x * 2))

# Chained map calls apply in order to the previous result
chained = map(map(some, (x: int) => x + 5), (x: int) => x * 2)
print(chained)

# map can change the type: int? to bool?
predicate = map(some, (x: int) => x > 40)
print(predicate)

# None is preserved even through a long chain
print(map(map(empty, (x: int) => x + 5), (x: int) => x * 2))
