# Use Regex literals and UFCS for search, replacement, and capture groups
from ry.regex import findAll, replace

text = "order-12 and order-34"
print(replace(text, /\d+/, "N"))

# findAll returns the full match and capture groups
for match in findAll(text, /order-(\d+)/):
  print(f"full={match.full}, id={match.groups[0]}")
