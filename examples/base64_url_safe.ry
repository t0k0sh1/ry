# Shows URL-safe base64 (encode/decodeUrlSafe) and how it differs from standard base64
from ry.base64 import encode, encodeUrlSafe, decode, decodeUrlSafe

# Standard base64 uses + and /, while URL-safe base64 uses - and _
text = "?>>"
std = encode(text)
urlSafe = encodeUrlSafe(text)
print(std)
print(urlSafe)

# The URL-safe form also omits = padding
print(encodeUrlSafe("Hello, World!"))

# Decode with the matching function: decode for standard, decodeUrlSafe for URL-safe
case decodeUrlSafe(urlSafe):
  Ok(decoded):
    print(decoded)
  Err(e):
    print(e.message)

# Invalid strings return Err
case decodeUrlSafe("!!!"):
  Ok(_):
    print("unexpected ok")
  Err(e):
    print(e.message)
