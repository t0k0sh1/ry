# Shows generic functions taking List/Map/Set, with type inference and explicit type arguments
# See examples/generic_functions.ry for the basic single-type-argument form
fn lastOf<T>(items: List<T>) -> T:
  return items[len(items) - 1]

fn mapHas<K, V>(m: Map<K, V>, key: K) -> bool:
  return contains(m, key)

fn setSize<T>(s: Set<T>) -> int:
  return len(s)

# Type inference: infer T from arguments
print(lastOf([10, 20, 30]))
print(lastOf(["alpha", "beta"]))

# Form with explicit [T]
print(lastOf[int]([10, 20, 30]))

# Generic with multiple type arguments
print(mapHas({"a": 1, "b": 2}, "a"))
print(mapHas[str,int]({"a": 1, "b": 2}, "z"))

# Set<T> works the same way
print(setSize({1, 2, 3}))
print(setSize[int]({4, 5, 6, 4}))
