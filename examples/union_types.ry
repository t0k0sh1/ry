# Use anonymous union types in function parameters and returns, then dispatch with str()
# numeric_type_constraints.ry covers annotations; this example shows dispatch
fn show(x: int | str) -> str:
  return str(x)

fn showWithFloat(x: int | float) -> str:
  return str(x)

fn pickByFlag(b: bool) -> int | str:
  if b:
    return 42
  return "zero"

print(show(42))
print(show("hello"))
print(showWithFloat(100))
print(showWithFloat(2.5))

# Return values can also be union types
print(show(pickByFlag(true)))
print(show(pickByFlag(false)))

# Collections can be union variants, so List and Map values can be held too
listOrInt: int | List<int> = [1, 2, 3]
mapOrStr: str | Map<str, int> = {"a": 1}
print(str(listOrInt))
print(str(mapOrStr))
