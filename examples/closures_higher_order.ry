# Shows closure value capture and passing closures to higher-order functions
fn makeAdder(base: int) -> fn(int) -> int:
  # The inner function captures the value of base
  fn add(value: int) -> int:
    return base + value
  return add

add10 = makeAdder(10)
values = [1, 2, 3]

# map returns a new List by applying the closure to each element
print(map(values, add10))
