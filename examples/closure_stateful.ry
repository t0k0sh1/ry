# Shows closures that capture parameters, function composition, and currying
# See examples/nested_functions.ry for sibling scopes and mutual recursion

# A closure that captures two parameters: a*x + b
fn makeLinear(a: int, b: int) -> fn(int) -> int:
  return (x: int) => a * x + b

threeXPlusTen = makeLinear(3, 10)
print(threeXPlusTen(5))

# Function composition: combine two fn(int) -> int values into one new closure
fn compose(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int:
  return (x: int) => f(g(x))

double = (x: int) => x * 2
inc = (x: int) => x + 1
doubleThenInc = compose(inc, double)
print(doubleThenInc(5))

# Return a closure that returns a closure; each level captures parameters
fn outer(a: int) -> fn(int) -> fn(int) -> int:
  fn middle(b: int) -> fn(int) -> int:
    fn inner(c: int) -> int:
      return a + b + c
    return inner
  return middle

# Calling one level at a time resolves each level of capture
f = outer(10)
g = f(20)
print(g(30))
