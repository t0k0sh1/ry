# 高度な機能 (ジェネリクス、any、union、type alias) の検証

# Type alias
type Meters = float
type StringList = List<str>
type Direction = "N" | "S" | "E" | "W"
type Month = 1..12

d: Meters = 3.14
names: StringList = ["a", "b"]
dir: Direction = "N"
m: Month = 6
print(f"alias: {d}, {names}, {dir}, {m}")

# Union 型
x: int | str = 42
print(x)
x = "hello"
print(x)

fn show(v: int | str):
    case typeOf(v):
        _:
            print(f"got: {v}")

show(1)
show("text")

# any 型
a: any = 42
print(f"any int: {a}")
a = "text"
print(f"any str: {a}")
a = true
print(f"any bool: {a}")

# any unwrap
fn getAny() -> any:
    return 99

n: int = getAny()
print(f"unwrapped: {n}")

# ジェネリック関数
fn pair<T>(x: T) -> List<T>:
    return [x, x]

print(f"int pair: {pair(42)}")
print(f"str pair: {pair("ab")}")

# typeOf
print(f"typeOf 42: {str(typeOf(42))}")
print(f"typeOf 3.14: {str(typeOf(3.14))}")
print(f"typeOf 'abc': {str(typeOf("abc"))}")
print(f"typeOf [1,2]: {str(typeOf([1,2]))}")

# 同じ型同士の比較
print(f"typeOf(1) == typeOf(2): {typeOf(1) == typeOf(2)}")
print(f"typeOf(1) == typeOf(1.0): {typeOf(1) == typeOf(1.0)}")

# 低レベル数値型 (no implicit conversion)
b: u8 = 200
print(f"u8: {b}")

i: i32 = 100
j: i32 = 3
print(f"i32 div: {i / j}")    # 整数除算 (33)

# 型キャスト
asF: float = 7 as float
print(f"int -> float: {asF}")
asI: int = 3.9 as int
print(f"float -> int (trunc): {asI}")

# Range
for i in range(1, 5):
    print(f"range: {i}")

# Range type 制約
fn setMonth(mm: 1..12) -> int:
    return mm
print(f"month: {setMonth(7)}")
