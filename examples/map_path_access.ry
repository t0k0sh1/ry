# Use getPath/setPath to manipulate nested Map<str, any> values with jq-style dot paths
# Useful for JSON data loaded with json.load[Map<str, any>]

# Prepare a nested Map<str, any>
inner: Map<str, any> = {"host": "localhost", "port": 8080}
config: Map<str, any> = {"server": inner, "debug": true}

# getPath follows dot-separated deep values and returns Option<any>
# Use the checked cast asType[T] to narrow an any value to a concrete type
case getPath(config, "server.host"):
  Some(v):
    case asType[str](v):
      Ok(host):
        print(host)
      Err(e):
        print(e.message)
  None:
    print("missing")

# Missing intermediate or leaf keys return None, which can be checked as Option<any>
print(getPath(config, "missing.host"))
print(getPath(config, "server.unknown"))

# setPath updates an existing leaf or adds a new leaf key, automatically promoting the value to any
setPath(config, "server.port", 9090)
setPath(config, "server.tls", true)

print(getPath(config, "server.port"))
print(getPath(config, "server.tls"))

# Negative index: access tail elements through a List<any> arm (#2398)
items: List<any> = [10, 20, 30]
holder: Map<str, any> = {"items": items}
print(getPath(holder, "items.-1"))    # Some(30)
print(getPath(holder, "items.-3"))    # Some(10)
print(getPath(holder, "items.-4"))    # None (out of range)

# Write to a Map leaf through a List intermediate (#2398)
alice: Map<str, any> = {"name": "alice"}
bob: Map<str, any> = {"name": "bob"}
users: List<any> = [alice, bob]
m: Map<str, any> = {"users": users}
setPath(m, "users.-1.name", "BOB!")
print(getPath(m, "users.1.name"))     # Some(BOB!)

# Map keys containing '.' (#2398): use "\." to treat it as a literal dot
dotted: Map<str, any> = {"a.b": 42}
print(getPath(dotted, "a\\.b"))       # Some(42)
print(getPath(dotted, "a.b"))         # None (unescaped dot is split)
