# Regular expression operations
@native
fn regex_match(pattern: str, text: str) -> bool

@native
fn regex_search(pattern: str, text: str) -> int

@native
fn regex_replace(pattern: str, text: str, replacement: str) -> str

@native
fn regex_split(pattern: str, text: str) -> List<str>

@native
fn regex_find_all(pattern: str, text: str) -> List<str>

# Regex literal overloads (text-first for UFCS)
@native
fn match(text: str, pattern: Regex) -> bool

@native
fn search(text: str, pattern: Regex) -> int

@native
fn replace(text: str, pattern: Regex, replacement: str) -> str

@native
fn split(text: str, pattern: Regex) -> List<str>

@native
fn find_all(text: str, pattern: Regex) -> List<str>
