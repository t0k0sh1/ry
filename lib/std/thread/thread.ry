# Thread — spawn and join OS threads
@native
fn thread_spawn(body: fn() -> Unit) -> Thread

@native
fn thread_join(thread: Thread) -> Result<Unit, Error>

# Lock (mutex)
@native
fn lock_new() -> Lock

@native
fn lock_acquire(lock: Lock) -> Result<Unit, Error>

@native
fn lock_release(lock: Lock) -> Result<Unit, Error>

# RWLock (read-write lock)
@native
fn rwlock_new() -> RWLock

@native
fn rwlock_read_lock(rwlock: RWLock) -> Result<Unit, Error>

@native
fn rwlock_write_lock(rwlock: RWLock) -> Result<Unit, Error>

@native
fn rwlock_unlock(rwlock: RWLock) -> Result<Unit, Error>

# Semaphore
@native
fn semaphore_new(count: int) -> Semaphore

@native
fn semaphore_acquire(sem: Semaphore) -> Result<Unit, Error>

@native
fn semaphore_release(sem: Semaphore) -> Result<Unit, Error>

# Barrier
@native
fn barrier_new(count: int) -> Barrier

@native
fn barrier_wait(barrier: Barrier) -> Result<Unit, Error>

# AtomicInt
@native
fn atomic_int_new(value: int) -> AtomicInt

@native
fn atomic_int_load(a: AtomicInt) -> int

@native
fn atomic_int_store(a: AtomicInt, value: int) -> Unit

@native
fn atomic_int_add(a: AtomicInt, delta: int) -> int

@native
fn atomic_int_sub(a: AtomicInt, delta: int) -> int

@native
fn atomic_int_cas(a: AtomicInt, expected: int, desired: int) -> bool

# AtomicBool
@native
fn atomic_bool_new(value: bool) -> AtomicBool

@native
fn atomic_bool_load(a: AtomicBool) -> bool

@native
fn atomic_bool_store(a: AtomicBool, value: bool) -> Unit
