# File path operations

@native
fn join(first: str, second: str) -> str

@native
fn join(first: str, second: str, third: str) -> str

@native
fn join(first: str, second: str, third: str, fourth: str) -> str

@native
fn basename(path: str) -> str

@native
fn dirname(path: str) -> str

@native
fn extension(path: str) -> str

@native
fn resolve(path: str) -> Result<str, Error>

@native
fn is_absolute(path: str) -> bool
