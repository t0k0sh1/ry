from testing import it, describe, expect, each, property

@describe("@each parameterized tests")
fn eachParameterizedTests():
  @each([(1, 2, 3), (0, 0, 0), (-1, 1, 0)])
  @it("should add {0} + {1} = {2}")
  fn shouldAdd(a: int, b: int, expected: int):
    expect(a + b).toEq(expected)

  @each([("hello", 5), ("", 0), ("ry", 2)])
  @it("should compute length of \"{0}\" as {1}")
  fn shouldComputeStringLength(s: str, expected: int):
    expect(len(s)).toEq(expected)

@describe("@property tests")
fn propertyTests():
  @property(count=100)
  @it("should verify addition is commutative")
  fn shouldVerifyAdditionIsCommutative(a: int, b: int):
    expect(a + b).toEq(b + a)

  @property(count=50)
  @it("should verify double is always even")
  fn shouldVerifyDoubleIsAlwaysEven(n: int):
    expect(n * 2 % 2).toEq(0)

  @property(count=20)
  @it("should verify bool identity")
  fn shouldVerifyBoolIdentity(x: bool):
    expect(x == x).toBeTrue()

  @property(count=20)
  @it("should verify str length is non-negative")
  fn shouldVerifyStrLengthIsNonNegative(s: str):
    expect(len(s) >= 0).toBeTrue()
