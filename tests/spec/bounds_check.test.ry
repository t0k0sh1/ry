describe("bounds checking", function():
  describe("single element list", function():
    it("access index 0", function():
      xs = [42]
      expect(xs[0]).to_eq(42)
    )
    it("negative index on single element", function():
      xs = [42]
      expect(xs[-1]).to_eq(42)
    )
  )

  describe("list negative index", function():
    it("wraps -1 to last element", function():
      xs = [10, 20, 30]
      expect(xs[-1]).to_eq(30)
    )
    it("wraps -2 to second-to-last", function():
      xs = [10, 20, 30]
      expect(xs[-2]).to_eq(20)
    )
    it("wraps -N to first element", function():
      xs = [10, 20, 30]
      expect(xs[-3]).to_eq(10)
    )
  )

  describe("list negative index assignment", function():
    it("assigns via negative index", function():
      xs = [1, 2, 3]
      xs[-1] = 99
      expect(xs[2]).to_eq(99)
    )
    it("assigns via -2", function():
      xs = [1, 2, 3]
      xs[-2] = 42
      expect(xs[1]).to_eq(42)
    )
  )

  describe("char_at bounds", function():
    it("normal index", function():
      expect(char_at("hello", 0)).to_eq("h")
      expect(char_at("hello", 4)).to_eq("o")
    )
    it("negative index wraps", function():
      expect(char_at("hello", -1)).to_eq("o")
      expect(char_at("hello", -5)).to_eq("h")
    )
    it("UTF-8 negative index", function():
      expect(char_at("あいう", -1)).to_eq("う")
      expect(char_at("あいう", 0)).to_eq("あ")
    )
  )

  describe("substring clamping", function():
    it("clamps negative start to 0", function():
      expect(substring("hello", -1, 3)).to_eq("hel")
    )
    it("clamps end beyond length", function():
      expect(substring("hello", 0, 100)).to_eq("hello")
    )
    it("returns empty when end < start after clamping", function():
      expect(substring("hello", 3, 1)).to_eq("")
    )
    it("normal substring", function():
      expect(substring("hello", 1, 4)).to_eq("ell")
    )
  )

  describe("array negative index", function():
    it("wraps -1 to last element", function():
      buf: i32[3] = [10, 20, 30]
      expect(buf[-1] as int).to_eq(30)
    )
    it("wraps -3 to first element", function():
      buf: i32[3] = [10, 20, 30]
      expect(buf[-3] as int).to_eq(10)
    )
  )

  describe("insert negative index", function():
    it("insert at -1 appends (wraps to len)", function():
      xs = [1, 2, 3]
      insert(xs, -1, 99)
      expect(xs).to_have_length(4)
      expect(xs[3]).to_eq(99)
    )
    it("insert at -(len+1) inserts at front", function():
      xs = [1, 2, 3]
      insert(xs, -4, 99)
      expect(xs[0]).to_eq(99)
      expect(xs[1]).to_eq(1)
    )
  )

  describe("remove_at negative index", function():
    it("remove_at -1 removes last element", function():
      xs = [1, 2, 3]
      v = remove_at(xs, -1)
      expect(v).to_eq(3)
      expect(xs).to_have_length(2)
    )
    it("remove_at -2 removes second-to-last", function():
      xs = [10, 20, 30]
      v = remove_at(xs, -2)
      expect(v).to_eq(20)
      expect(xs).to_have_length(2)
    )
  )
)
