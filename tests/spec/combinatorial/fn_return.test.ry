from testing import it, describe, expect

record FnReturnPoint:
  x: int
  y: int

enum FnReturnDir:
  North
  South
  East
  West

fn makeMap() -> Map<str, int>:
  m: Map<str, int> = {"a": 1, "b": 2, "c": 3}
  return m

fn makeSet() -> Set<int>:
  return {10, 20, 30}

fn makePair() -> (int, str):
  return (42, "hello")

fn flexible(flag: bool) -> int | str:
  if flag:
    return 42
  return "hello"

fn makePoint(a: int, b: int) -> FnReturnPoint:
  return FnReturnPoint(a, b)

fn pickDir(n: int) -> FnReturnDir:
  if n == 0:
    return FnReturnDir::North
  return FnReturnDir::South

@describe("fn return — Map")
fn fnReturnMapTests():
  @it("should return map from function and access by key")
  fn shouldReturnMapFromFunctionAndAccessByKey():
    m = makeMap()
    expect(m["a"]).toEq(1)
    expect(m["b"]).toEq(2)
  @it("should return map from function and check missing key")
  fn shouldReturnMapFromFunctionAndCheckMissingKey():
    m = makeMap()
    expect(m.get("z")).toBeNone()

@describe("fn return — Set")
fn fnReturnSetTests():
  @it("should return set from function and check membership")
  fn shouldReturnSetFromFunctionAndCheckMembership():
    s = makeSet()
    expect(10 in s).toBeTrue()
    expect(99 in s).toBeFalse()

@describe("fn return — tuple")
fn fnReturnTupleTests():
  @it("should return tuple from function and access elements")
  fn shouldReturnTupleFromFunctionAndAccessElements():
    t = makePair()
    expect(t.0).toEq(42)
    expect(t.1).toEq("hello")

@describe("fn return — union")
fn fnReturnUnionTests():
  @it("should return int variant from union function")
  fn shouldReturnIntVariantFromUnionFunction():
    v = flexible(true)
    expect(toStr(v)).toEq("42")
  @it("should return str variant from union function")
  fn shouldReturnStrVariantFromUnionFunction():
    v = flexible(false)
    expect(toStr(v)).toEq("hello")

@describe("fn return — record")
fn fnReturnRecordTests():
  @it("should return record from function and access fields")
  fn shouldReturnRecordFromFunctionAndAccessFields():
    p = makePoint(3, 7)
    expect(p.x).toEq(3)
    expect(p.y).toEq(7)
  @it("should mutate fields of returned record")
  fn shouldMutateFieldsOfReturnedRecord():
    p = makePoint(1, 2)
    p.x = 99
    expect(p.x).toEq(99)

@describe("fn return — enum (simple)")
fn fnReturnEnumSimpleTests():
  @it("should return North enum variant from function")
  fn shouldReturnNorthEnumVariantFromFunction():
    d = pickDir(0)
    expect(d == FnReturnDir::North).toBeTrue()
  @it("should return South enum variant from function")
  fn shouldReturnSouthEnumVariantFromFunction():
    d = pickDir(1)
    expect(d == FnReturnDir::South).toBeTrue()
