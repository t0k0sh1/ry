from ry.testing import it, describe, expect

@describe("collection element — List<List<int>>")
fn collectionElementListListIntTests():
  @it("should access multiple nested list elements")
  fn shouldAccessMultipleNestedListElements():
    xs: List<List<int>> = [[10, 20], [30, 40]]
    inner0 = xs[0]
    inner1 = xs[1]
    expect(inner0[0]).toEq(10)
    expect(inner0[1]).toEq(20)
    expect(inner1[0]).toEq(30)
