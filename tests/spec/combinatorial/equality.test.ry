from ry.testing import it, describe, expect

@describe("equality — tuple")
fn equalityTupleTests():
  @it("should consider equal int tuples equal")
  fn shouldConsiderEqualIntTuplesEqual():
    expect((1, 2)).toEq((1, 2))
  @it("should consider different int tuples unequal")
  fn shouldConsiderDifferentIntTuplesUnequal():
    expect((1, 2)).toNotEq((1, 3))
  @it("should consider mixed-type tuples equal")
  fn shouldConsiderMixedTypeTuplesEqual():
    expect((1, "a", true)).toEq((1, "a", true))
  @it("should consider mixed-type tuples with different values unequal")
  fn shouldConsiderMixedTypeTuplesWithDifferentValuesUnequal():
    expect((1, "a")).toNotEq((1, "b"))

@describe("equality — Option")
fn equalityOptionTests():
  @it("should consider Some values equal when inner values are equal")
  fn shouldConsiderSomeValuesEqualWhenInnerValuesAreEqual():
    expect(Some(42)).toEq(Some(42))
  @it("should consider None equal to None")
  fn shouldConsiderNoneEqualToNone():
    x: int? = none
    y: int? = none
    expect(x).toEq(y)
  @it("should consider Some unequal to None")
  fn shouldConsiderSomeUnequalToNone():
    x: int? = Some(1)
    y: int? = none
    expect(x).toNotEq(y)
  @it("should consider Some values with different inner values unequal")
  fn shouldConsiderSomeValuesWithDifferentInnerValuesUnequal():
    expect(Some(1)).toNotEq(Some(2))
  @it("should compare Some string values by content")
  fn shouldCompareSomeStringValuesByContent():
    expect(Some("hello")).toEq(Some("hello"))
    expect(Some("a")).toNotEq(Some("b"))
  @it("should consider typed Option equal to none when both are None")
  fn shouldConsiderTypedOptionEqualToNoneWhenBothAreNone():
    e: Error? = none
    expect(e).toEq(none)
  @it("should consider typed Option unequal to none when Some")
  fn shouldConsiderTypedOptionUnequalToNoneWhenSome():
    e: Error? = Some(Error("oops"))
    expect(e).toNotEq(none)

@describe("equality — Option with collection inner types")
fn equalityOptionWithCollectionInnerTypesTests():
  # Option<List<int>> (#982)
  @it("should consider Some equal List<int> values equal")
  fn shouldConsiderSomeEqualListIntValuesEqual():
    a: List<int>? = Some([1, 2, 3])
    b: List<int>? = Some([1, 2, 3])
    expect(a == b).toBeTrue()
  @it("should consider Some differing List<int> values unequal")
  fn shouldConsiderSomeDifferingListIntValuesUnequal():
    a: List<int>? = Some([1, 2])
    b: List<int>? = Some([9, 9])
    expect(a == b).toBeFalse()
    expect(a != b).toBeTrue()
  @it("should consider Some(list) unequal to none")
  fn shouldConsiderSomeListUnequalToNone():
    a: List<int>? = Some([1])
    b: List<int>? = none
    expect(a != b).toBeTrue()
  @it("should consider two none List<int>? equal")
  fn shouldConsiderTwoNoneListIntEqual():
    a: List<int>? = none
    b: List<int>? = none
    expect(a == b).toBeTrue()
  # Option<Map<str, int>> (#982)
  @it("should consider Some equal Map<str, int> values equal")
  fn shouldConsiderSomeEqualMapStrIntValuesEqual():
    a: Map<str, int>? = Some({"x": 1, "y": 2})
    b: Map<str, int>? = Some({"x": 1, "y": 2})
    expect(a == b).toBeTrue()
  @it("should consider Some differing Map<str, int> values unequal")
  fn shouldConsiderSomeDifferingMapStrIntValuesUnequal():
    a: Map<str, int>? = Some({"x": 1})
    b: Map<str, int>? = Some({"x": 9})
    expect(a == b).toBeFalse()
    expect(a != b).toBeTrue()
  # Option<Set<int>> (#982)
  @it("should consider Some equal Set<int> values equal")
  fn shouldConsiderSomeEqualSetIntValuesEqual():
    a: Set<int>? = Some({1, 2, 3})
    b: Set<int>? = Some({3, 2, 1})
    expect(a == b).toBeTrue()
  @it("should consider Some differing Set<int> values unequal")
  fn shouldConsiderSomeDifferingSetIntValuesUnequal():
    a: Set<int>? = Some({1, 2})
    b: Set<int>? = Some({1, 9})
    expect(a == b).toBeFalse()
    expect(a != b).toBeTrue()
  # Option<List<str>> (#982)
  @it("should consider Some equal List<str> values equal")
  fn shouldConsiderSomeEqualListStrValuesEqual():
    a: List<str>? = Some(["hello", "world"])
    b: List<str>? = Some(["hello", "world"])
    expect(a == b).toBeTrue()
  @it("should consider Some differing List<str> values unequal")
  fn shouldConsiderSomeDifferingListStrValuesUnequal():
    a: List<str>? = Some(["hello"])
    b: List<str>? = Some(["world"])
    expect(a == b).toBeFalse()
  # Matcher-level regression: toEq / toNotEq delegate to emitComparisonOp
  # and Option<Collection> was previously excluded due to the metadata-loss bug (#982)
  @it("matcher toEq works for equal Some(List<int>)")
  fn matcherToeqWorksForEqualSomeListInt():
    a: List<int>? = Some([1, 2, 3])
    b: List<int>? = Some([1, 2, 3])
    expect(a).toEq(b)
  @it("matcher toNotEq works for differing Some(List<int>)")
  fn matcherTonoteqWorksForDifferingSomeListInt():
    a: List<int>? = Some([1, 2, 3])
    expect(a).toNotEq(Some([9, 9]))

fn resOk(v: int) -> Result<int, Error>:
  return Ok(v)
fn resErr(msg: str) -> Result<int, Error>:
  return Err(Error(msg))

@describe("equality — Result")
fn equalityResultTests():
  @it("should consider Ok values equal when inner values are equal")
  fn shouldConsiderOkValuesEqualWhenInnerValuesAreEqual():
    expect(resOk(42)).toEq(resOk(42))
  @it("should consider Ok values unequal when inner values differ")
  fn shouldConsiderOkValuesUnequalWhenInnerValuesDiffer():
    expect(resOk(1)).toNotEq(resOk(2))
  @it("should consider Err values equal when messages are equal")
  fn shouldConsiderErrValuesEqualWhenMessagesAreEqual():
    expect(resErr("oops")).toEq(resErr("oops"))
  @it("should consider Err values unequal when messages differ")
  fn shouldConsiderErrValuesUnequalWhenMessagesDiffer():
    expect(resErr("foo")).toNotEq(resErr("bar"))
  @it("should consider Ok unequal to Err")
  fn shouldConsiderOkUnequalToErr():
    expect(resOk(1)).toNotEq(resErr("e"))

@describe("equality — Result with collection payloads")
fn equalityResultWithCollectionPayloadsTests():
  # Result<List<int>, Error> — Ok payload (#985), Err inline coercion (#1001)
  @it("should consider Ok equal List<int> values equal")
  fn shouldConsiderOkEqualListIntValuesEqual():
    a: Result<List<int>, Error> = Ok([1, 2, 3])
    b: Result<List<int>, Error> = Ok([1, 2, 3])
    expect(a == b).toBeTrue()
  @it("should consider Ok differing List<int> values unequal")
  fn shouldConsiderOkDifferingListIntValuesUnequal():
    a: Result<List<int>, Error> = Ok([1, 2])
    b: Result<List<int>, Error> = Ok([9, 9])
    expect(a == b).toBeFalse()
    expect(a != b).toBeTrue()
  @it("should consider Ok vs Err unequal for List<int>")
  fn shouldConsiderOkVsErrUnequalForListInt():
    a: Result<List<int>, Error> = Ok([1, 2])
    b: Result<List<int>, Error> = Err(Error("e"))
    expect(a != b).toBeTrue()
  @it("should consider two Err equal for List<int> Ok-type")
  fn shouldConsiderTwoErrEqualForListIntOkType():
    a: Result<List<int>, Error> = Err(Error("oops"))
    b: Result<List<int>, Error> = Err(Error("oops"))
    expect(a == b).toBeTrue()
  # Result<Map<str, int>, Error> — Ok payload (#985)
  @it("should consider Ok equal Map<str, int> values equal")
  fn shouldConsiderOkEqualMapStrIntValuesEqual():
    a: Result<Map<str, int>, Error> = Ok({"x": 1, "y": 2})
    b: Result<Map<str, int>, Error> = Ok({"x": 1, "y": 2})
    expect(a == b).toBeTrue()
  @it("should consider Ok differing Map<str, int> values unequal")
  fn shouldConsiderOkDifferingMapStrIntValuesUnequal():
    a: Result<Map<str, int>, Error> = Ok({"x": 1})
    b: Result<Map<str, int>, Error> = Ok({"x": 9})
    expect(a == b).toBeFalse()
    expect(a != b).toBeTrue()
  # Result<Set<int>, Error> — Ok payload (#985)
  @it("should consider Ok equal Set<int> values equal")
  fn shouldConsiderOkEqualSetIntValuesEqual():
    a: Result<Set<int>, Error> = Ok({1, 2, 3})
    b: Result<Set<int>, Error> = Ok({3, 2, 1})
    expect(a == b).toBeTrue()
  @it("should consider Ok differing Set<int> values unequal")
  fn shouldConsiderOkDifferingSetIntValuesUnequal():
    a: Result<Set<int>, Error> = Ok({1, 2})
    b: Result<Set<int>, Error> = Ok({1, 9})
    expect(a == b).toBeFalse()
    expect(a != b).toBeTrue()
  # Result<List<str>, Error> — Ok payload (#985)
  @it("should consider Ok equal List<str> values equal")
  fn shouldConsiderOkEqualListStrValuesEqual():
    a: Result<List<str>, Error> = Ok(["hello", "world"])
    b: Result<List<str>, Error> = Ok(["hello", "world"])
    expect(a == b).toBeTrue()
  @it("should consider Ok differing List<str> values unequal")
  fn shouldConsiderOkDifferingListStrValuesUnequal():
    a: Result<List<str>, Error> = Ok(["hello"])
    b: Result<List<str>, Error> = Ok(["world"])
    expect(a == b).toBeFalse()
  # Matcher-level regression (#985)
  @it("matcher toEq works for equal Ok(List<int>)")
  fn matcherToeqWorksForEqualOkListInt():
    a: Result<List<int>, Error> = Ok([1, 2, 3])
    b: Result<List<int>, Error> = Ok([1, 2, 3])
    expect(a).toEq(b)
  @it("matcher toNotEq works for differing Ok(List<int>)")
  fn matcherTonoteqWorksForDifferingOkListInt():
    a: Result<List<int>, Error> = Ok([1, 2, 3])
    expect(a).toNotEq(Ok([9, 9]))

@describe("equality — union")
fn equalityUnionTests():
  @it("should consider equal int variants equal")
  fn shouldConsiderEqualIntVariantsEqual():
    x: int|str = 42
    y: int|str = 42
    expect(x).toEq(y)
  @it("should consider different int variants unequal")
  fn shouldConsiderDifferentIntVariantsUnequal():
    x: int|str = 1
    y: int|str = 2
    expect(x).toNotEq(y)
  @it("should consider equal str variants equal")
  fn shouldConsiderEqualStrVariantsEqual():
    x: int|str = "hello"
    y: int|str = "hello"
    expect(x).toEq(y)
  @it("should consider different str variants unequal")
  fn shouldConsiderDifferentStrVariantsUnequal():
    x: int|str = "a"
    y: int|str = "b"
    expect(x).toNotEq(y)
  @it("should consider different tag variants unequal")
  fn shouldConsiderDifferentTagVariantsUnequal():
    x: int|str = 1
    y: int|str = "1"
    expect(x).toNotEq(y)
  # Collection and complex variant types (#960)
  @it("should compare equal List variants equal")
  fn shouldCompareEqualListVariantsEqual():
    x: List<int>|int = [1, 2, 3]
    y: List<int>|int = [1, 2, 3]
    expect(x).toEq(y)
  @it("should compare different List variants unequal")
  fn shouldCompareDifferentListVariantsUnequal():
    x: List<int>|int = [1, 2, 3]
    y: List<int>|int = [1, 2, 4]
    expect(x).toNotEq(y)
  @it("should compare different-tag List vs int variants unequal")
  fn shouldCompareDifferentTagListVsIntVariantsUnequal():
    x: List<int>|int = [1]
    y: List<int>|int = 1
    expect(x).toNotEq(y)
  @it("should compare equal Map variants equal")
  fn shouldCompareEqualMapVariantsEqual():
    x: Map<str, int>|str = {"a": 1, "b": 2}
    y: Map<str, int>|str = {"a": 1, "b": 2}
    expect(x).toEq(y)
  @it("should compare different Map variants unequal")
  fn shouldCompareDifferentMapVariantsUnequal():
    x: Map<str, int>|str = {"a": 1}
    y: Map<str, int>|str = {"a": 9}
    expect(x).toNotEq(y)
  @it("should compare equal Set variants equal")
  fn shouldCompareEqualSetVariantsEqual():
    x: Set<int>|int = {3, 1, 2}
    y: Set<int>|int = {1, 2, 3}
    expect(x).toEq(y)
  @it("should compare different Set variants unequal")
  fn shouldCompareDifferentSetVariantsUnequal():
    x: Set<int>|int = {1, 2}
    y: Set<int>|int = {1, 3}
    expect(x).toNotEq(y)
  @it("should compare equal nested List variants equal")
  fn shouldCompareEqualNestedListVariantsEqual():
    x: List<List<int>>|int = [[1, 2], [3, 4]]
    y: List<List<int>>|int = [[1, 2], [3, 4]]
    expect(x).toEq(y)
  @it("should compare different nested List variants unequal")
  fn shouldCompareDifferentNestedListVariantsUnequal():
    x: List<List<int>>|int = [[1, 2]]
    y: List<List<int>>|int = [[1, 9]]
    expect(x).toNotEq(y)

@describe("equality — List")
fn equalityListTests():
  @it("should consider equal int lists equal")
  fn shouldConsiderEqualIntListsEqual():
    expect([1, 2, 3]).toEq([1, 2, 3])
  @it("should consider int lists with different values unequal")
  fn shouldConsiderIntListsWithDifferentValuesUnequal():
    expect([1, 2, 3]).toNotEq([1, 2, 4])
  @it("should consider int lists of different lengths unequal")
  fn shouldConsiderIntListsOfDifferentLengthsUnequal():
    expect([1, 2]).toNotEq([1, 2, 3])
  @it("should consider empty lists equal")
  fn shouldConsiderEmptyListsEqual():
    a: List<int> = []
    b: List<int> = []
    expect(a).toEq(b)
  @it("should consider equal str lists equal")
  fn shouldConsiderEqualStrListsEqual():
    expect(["a", "b"]).toEq(["a", "b"])
  @it("should consider str lists with different values unequal")
  fn shouldConsiderStrListsWithDifferentValuesUnequal():
    expect(["a", "b"]).toNotEq(["a", "c"])

@describe("equality — Set")
fn equalitySetTests():
  @it("should consider equal int sets equal regardless of insertion order")
  fn shouldConsiderEqualIntSetsEqualRegardlessOfInsertionOrder():
    a: Set<int> = {1, 2, 3}
    b: Set<int> = {3, 2, 1}
    expect(a).toEq(b)
  @it("should consider int sets with different elements unequal")
  fn shouldConsiderIntSetsWithDifferentElementsUnequal():
    a: Set<int> = {1, 2}
    b: Set<int> = {1, 3}
    expect(a).toNotEq(b)
  @it("should consider int sets of different sizes unequal")
  fn shouldConsiderIntSetsOfDifferentSizesUnequal():
    a: Set<int> = {1, 2}
    b: Set<int> = {1, 2, 3}
    expect(a).toNotEq(b)
  @it("should consider empty sets equal")
  fn shouldConsiderEmptySetsEqual():
    a: Set<int> = {}
    b: Set<int> = {}
    expect(a).toEq(b)

@describe("equality — Map")
fn equalityMapTests():
  @it("should consider equal str->int maps equal")
  fn shouldConsiderEqualStrIntMapsEqual():
    a: Map<str, int> = {"x": 1, "y": 2}
    b: Map<str, int> = {"x": 1, "y": 2}
    expect(a).toEq(b)
  @it("should consider maps with different values unequal")
  fn shouldConsiderMapsWithDifferentValuesUnequal():
    a: Map<str, int> = {"x": 1}
    b: Map<str, int> = {"x": 2}
    expect(a).toNotEq(b)
  @it("should consider maps with different keys unequal")
  fn shouldConsiderMapsWithDifferentKeysUnequal():
    a: Map<str, int> = {"x": 1}
    b: Map<str, int> = {"y": 1}
    expect(a).toNotEq(b)
  @it("should consider empty maps equal")
  fn shouldConsiderEmptyMapsEqual():
    a: Map<str, int> = {}
    b: Map<str, int> = {}
    expect(a).toEq(b)
# Closure equality is intentionally unsupported (compile-time error).
# Uncomment to verify the compiler rejects it:
# it("should reject closure equality at compile time", ():
#   f = (x: int) => x + 1
#   g = (x: int) => x + 1
#   _ = f == g
# )

record EqPoint:
  x: int
  y: int

@describe("equality — union with record variants")
fn equalityUnionWithRecordVariantsTests():
  @it("should compare equal record variants equal")
  fn shouldCompareEqualRecordVariantsEqual():
    x: EqPoint|int = EqPoint(1, 2)
    y: EqPoint|int = EqPoint(1, 2)
    expect(x).toEq(y)
  @it("should compare different record variants unequal")
  fn shouldCompareDifferentRecordVariantsUnequal():
    x: EqPoint|int = EqPoint(1, 2)
    y: EqPoint|int = EqPoint(1, 9)
    expect(x).toNotEq(y)
  @it("should compare different-tag record vs int variants unequal")
  fn shouldCompareDifferentTagRecordVsIntVariantsUnequal():
    x: EqPoint|int = EqPoint(1, 2)
    y: EqPoint|int = 1
    expect(x).toNotEq(y)

@describe("equality — List with complex element types")
fn equalityListWithComplexElementTypesTests():
  @it("should compare List<record> equal")
  fn shouldCompareListRecordEqual():
    a: List<EqPoint> = [EqPoint(1, 2), EqPoint(3, 4)]
    b: List<EqPoint> = [EqPoint(1, 2), EqPoint(3, 4)]
    expect(a).toEq(b)
  @it("should compare List<record> unequal")
  fn shouldCompareListRecordUnequal():
    a: List<EqPoint> = [EqPoint(1, 2)]
    b: List<EqPoint> = [EqPoint(1, 9)]
    expect(a).toNotEq(b)
  @it("should compare List<tuple> equal")
  fn shouldCompareListTupleEqual():
    a: List<(int, str)> = [(1, "a"), (2, "b")]
    b: List<(int, str)> = [(1, "a"), (2, "b")]
    expect(a).toEq(b)
  @it("should compare List<tuple> unequal")
  fn shouldCompareListTupleUnequal():
    a: List<(int, str)> = [(1, "a")]
    b: List<(int, str)> = [(1, "z")]
    expect(a).toNotEq(b)
  @it("should compare List<List<int>> equal")
  fn shouldCompareListListIntEqual():
    a: List<List<int>> = [[1, 2], [3, 4]]
    b: List<List<int>> = [[1, 2], [3, 4]]
    expect(a).toEq(b)
  @it("should compare List<List<int>> unequal")
  fn shouldCompareListListIntUnequal():
    a: List<List<int>> = [[1, 2], [3, 4]]
    b: List<List<int>> = [[1, 2], [3, 5]]
    expect(a).toNotEq(b)
  @it("should compare List<List<int>> with different inner lengths unequal")
  fn shouldCompareListListIntWithDifferentInnerLengthsUnequal():
    a: List<List<int>> = [[1, 2]]
    b: List<List<int>> = [[1, 2, 3]]
    expect(a).toNotEq(b)
  @it("should compare List<List<str>> equal")
  fn shouldCompareListListStrEqual():
    a: List<List<str>> = [["x", "y"], ["z"]]
    b: List<List<str>> = [["x", "y"], ["z"]]
    expect(a).toEq(b)
  @it("should compare List<Map<str, int>> equal")
  fn shouldCompareListMapStrIntEqual():
    a: List<Map<str, int>> = [{"x": 1}, {"y": 2}]
    b: List<Map<str, int>> = [{"x": 1}, {"y": 2}]
    expect(a).toEq(b)
  @it("should compare List<Map<str, int>> unequal")
  fn shouldCompareListMapStrIntUnequal():
    a: List<Map<str, int>> = [{"x": 1}]
    b: List<Map<str, int>> = [{"x": 9}]
    expect(a).toNotEq(b)
  @it("should compare List<Set<int>> equal")
  fn shouldCompareListSetIntEqual():
    a: List<Set<int>> = [{1, 2}, {3}]
    b: List<Set<int>> = [{1, 2}, {3}]
    expect(a).toEq(b)
  @it("should compare List<Set<int>> unequal")
  fn shouldCompareListSetIntUnequal():
    a: List<Set<int>> = [{1, 2}]
    b: List<Set<int>> = [{1, 3}]
    expect(a).toNotEq(b)

@describe("equality — Map with complex value types")
fn equalityMapWithComplexValueTypesTests():
  @it("should compare Map<str, List<int>> equal")
  fn shouldCompareMapStrListIntEqual():
    a: Map<str, List<int>> = {"x": [1, 2], "y": [3]}
    b: Map<str, List<int>> = {"x": [1, 2], "y": [3]}
    expect(a).toEq(b)
  @it("should compare Map<str, List<int>> unequal")
  fn shouldCompareMapStrListIntUnequal():
    a: Map<str, List<int>> = {"x": [1, 2]}
    b: Map<str, List<int>> = {"x": [1, 9]}
    expect(a).toNotEq(b)
  @it("should compare Map<str, Map<str, int>> equal")
  fn shouldCompareMapStrMapStrIntEqual():
    a: Map<str, Map<str, int>> = {"outer": {"inner": 42}}
    b: Map<str, Map<str, int>> = {"outer": {"inner": 42}}
    expect(a).toEq(b)
  @it("should compare Map<str, Map<str, int>> unequal")
  fn shouldCompareMapStrMapStrIntUnequal():
    a: Map<str, Map<str, int>> = {"outer": {"inner": 1}}
    b: Map<str, Map<str, int>> = {"outer": {"inner": 2}}
    expect(a).toNotEq(b)
  @it("should compare Map<str, record> equal")
  fn shouldCompareMapStrRecordEqual():
    a: Map<str, EqPoint> = {"p": EqPoint(1, 2)}
    b: Map<str, EqPoint> = {"p": EqPoint(1, 2)}
    expect(a).toEq(b)
  @it("should compare Map<str, record> unequal")
  fn shouldCompareMapStrRecordUnequal():
    a: Map<str, EqPoint> = {"p": EqPoint(1, 2)}
    b: Map<str, EqPoint> = {"p": EqPoint(1, 9)}
    expect(a).toNotEq(b)

@describe("equality — Set with complex element types")
fn equalitySetWithComplexElementTypesTests():
  @it("should compare Set<record> equal")
  fn shouldCompareSetRecordEqual():
    a: Set<EqPoint> = {EqPoint(1, 2), EqPoint(3, 4)}
    b: Set<EqPoint> = {EqPoint(1, 2), EqPoint(3, 4)}
    expect(a).toEq(b)
  @it("should compare Set<record> equal regardless of insertion order")
  fn shouldCompareSetRecordEqualRegardlessOfInsertionOrder():
    a: Set<EqPoint> = {EqPoint(1, 2), EqPoint(3, 4)}
    b: Set<EqPoint> = {EqPoint(3, 4), EqPoint(1, 2)}
    expect(a).toEq(b)
  @it("should compare Set<record> unequal")
  fn shouldCompareSetRecordUnequal():
    a: Set<EqPoint> = {EqPoint(1, 2)}
    b: Set<EqPoint> = {EqPoint(1, 9)}
    expect(a).toNotEq(b)
  @it("should compare Set<record> of different sizes unequal")
  fn shouldCompareSetRecordOfDifferentSizesUnequal():
    a: Set<EqPoint> = {EqPoint(1, 2), EqPoint(3, 4)}
    b: Set<EqPoint> = {EqPoint(1, 2)}
    expect(a).toNotEq(b)
  @it("should compare empty Set<record> equal")
  fn shouldCompareEmptySetRecordEqual():
    a: Set<EqPoint> = {}
    b: Set<EqPoint> = {}
    expect(a).toEq(b)
  @it("should compare Set<tuple> equal")
  fn shouldCompareSetTupleEqual():
    a: Set<(int, str)> = {(1, "a"), (2, "b")}
    b: Set<(int, str)> = {(1, "a"), (2, "b")}
    expect(a).toEq(b)
  @it("should compare Set<tuple> equal regardless of insertion order")
  fn shouldCompareSetTupleEqualRegardlessOfInsertionOrder():
    a: Set<(int, str)> = {(1, "a"), (2, "b")}
    b: Set<(int, str)> = {(2, "b"), (1, "a")}
    expect(a).toEq(b)
  @it("should compare Set<tuple> unequal")
  fn shouldCompareSetTupleUnequal():
    a: Set<(int, str)> = {(1, "a")}
    b: Set<(int, str)> = {(1, "z")}
    expect(a).toNotEq(b)
  @it("should compare Set<List<int>> equal")
  fn shouldCompareSetListIntEqual():
    a: Set<List<int>> = {[1, 2], [3, 4]}
    b: Set<List<int>> = {[1, 2], [3, 4]}
    expect(a).toEq(b)
  @it("should compare Set<List<int>> equal regardless of insertion order")
  fn shouldCompareSetListIntEqualRegardlessOfInsertionOrder():
    a: Set<List<int>> = {[1, 2], [3, 4]}
    b: Set<List<int>> = {[3, 4], [1, 2]}
    expect(a == b).toBeTrue()
  @it("should compare Set<List<int>> equal with 3 elements reversed")
  fn shouldCompareSetListIntEqualWith3ElementsReversed():
    a: Set<List<int>> = {[1, 2], [3, 4], [5, 6]}
    b: Set<List<int>> = {[5, 6], [3, 4], [1, 2]}
    expect(a == b).toBeTrue()
  @it("should compare Set<List<int>> unequal")
  fn shouldCompareSetListIntUnequal():
    a: Set<List<int>> = {[1, 2]}
    b: Set<List<int>> = {[1, 9]}
    expect(a).toNotEq(b)
  @it("should compare Set<Map<str, int>> equal")
  fn shouldCompareSetMapStrIntEqual():
    a: Set<Map<str, int>> = {{"x": 1}, {"y": 2}}
    b: Set<Map<str, int>> = {{"x": 1}, {"y": 2}}
    expect(a).toEq(b)
  @it("should compare Set<Map<str, int>> equal regardless of insertion order")
  fn shouldCompareSetMapStrIntEqualRegardlessOfInsertionOrder():
    a: Set<Map<str, int>> = {{"x": 1}, {"y": 2}}
    b: Set<Map<str, int>> = {{"y": 2}, {"x": 1}}
    expect(a == b).toBeTrue()
  @it("should compare Set<Map<str, int>> unequal")
  fn shouldCompareSetMapStrIntUnequal():
    a: Set<Map<str, int>> = {{"x": 1}}
    b: Set<Map<str, int>> = {{"x": 9}}
    expect(a).toNotEq(b)
  @it("should compare Set<Set<int>> equal")
  fn shouldCompareSetSetIntEqual():
    a: Set<Set<int>> = {{1, 2}, {3}}
    b: Set<Set<int>> = {{1, 2}, {3}}
    expect(a).toEq(b)
  @it("should compare Set<Set<int>> equal regardless of insertion order")
  fn shouldCompareSetSetIntEqualRegardlessOfInsertionOrder():
    a: Set<Set<int>> = {{1, 2}, {3, 4}}
    b: Set<Set<int>> = {{3, 4}, {1, 2}}
    expect(a == b).toBeTrue()
  @it("should compare Set<Set<int>> unequal")
  fn shouldCompareSetSetIntUnequal():
    a: Set<Set<int>> = {{1, 2}}
    b: Set<Set<int>> = {{1, 3}}
    expect(a).toNotEq(b)
  @it("should find element in Set<List<int>> when match is not at index 0")
  fn shouldFindElementInSetListIntWhenMatchIsNotAtIndex0():
    s: Set<List<int>> = {[1, 2], [3, 4]}
    expect(isSubset({[3, 4]}, s)).toBeTrue()
  @it("should find element in Set<List<int>> using contains")
  fn shouldFindElementInSetListIntUsingContains():
    s: Set<List<int>> = {[1, 2], [3, 4]}
    expect(s.contains([3, 4])).toBeTrue()
    expect(s.contains([1, 2])).toBeTrue()
    expect(s.contains([9, 9])).toBeFalse()
  @it("should test membership of List in Set<List<int>> using in operator")
  fn shouldTestMembershipOfListInSetListIntUsingInOperator():
    s: Set<List<int>> = {[1, 2], [3, 4]}
    expect([1, 2] in s).toBeTrue()
    expect([3, 4] in s).toBeTrue()
    expect([9, 9] in s).toBeFalse()

@describe("equality — Map with complex key types")
fn equalityMapWithComplexKeyTypesTests():
  @it("should compare Map<record, int> equal")
  fn shouldCompareMapRecordIntEqual():
    a: Map<EqPoint, int> = {EqPoint(1, 2): 10, EqPoint(3, 4): 20}
    b: Map<EqPoint, int> = {EqPoint(1, 2): 10, EqPoint(3, 4): 20}
    expect(a).toEq(b)
  @it("should compare Map<record, int> unequal by value")
  fn shouldCompareMapRecordIntUnequalByValue():
    a: Map<EqPoint, int> = {EqPoint(1, 2): 10}
    b: Map<EqPoint, int> = {EqPoint(1, 2): 99}
    expect(a).toNotEq(b)
  @it("should compare Map<record, int> unequal by key")
  fn shouldCompareMapRecordIntUnequalByKey():
    a: Map<EqPoint, int> = {EqPoint(1, 2): 10}
    b: Map<EqPoint, int> = {EqPoint(9, 9): 10}
    expect(a).toNotEq(b)
  @it("should compare Map<record, int> of different sizes unequal")
  fn shouldCompareMapRecordIntOfDifferentSizesUnequal():
    a: Map<EqPoint, int> = {EqPoint(1, 2): 10, EqPoint(3, 4): 20}
    b: Map<EqPoint, int> = {EqPoint(1, 2): 10}
    expect(a).toNotEq(b)
  @it("should compare empty Map<record, int> equal")
  fn shouldCompareEmptyMapRecordIntEqual():
    a: Map<EqPoint, int> = {}
    b: Map<EqPoint, int> = {}
    expect(a).toEq(b)
  @it("should compare empty Map<record, int> unequal to non-empty")
  fn shouldCompareEmptyMapRecordIntUnequalToNonEmpty():
    a: Map<EqPoint, int> = {}
    b: Map<EqPoint, int> = {EqPoint(1, 2): 10}
    expect(a).toNotEq(b)
  @it("should compare Map<tuple, str> equal")
  fn shouldCompareMapTupleStrEqual():
    a: Map<(int, int), str> = {(1, 2): "a", (3, 4): "b"}
    b: Map<(int, int), str> = {(1, 2): "a", (3, 4): "b"}
    expect(a).toEq(b)
  @it("should compare Map<tuple, str> unequal")
  fn shouldCompareMapTupleStrUnequal():
    a: Map<(int, int), str> = {(1, 2): "a"}
    b: Map<(int, int), str> = {(1, 2): "z"}
    expect(a).toNotEq(b)
  @it("should compare Map<record, List<int>> equal (mixed complex key + value)")
  fn shouldCompareMapRecordListIntEqualMixedComplexKeyValue():
    a: Map<EqPoint, List<int>> = {EqPoint(1, 2): [10, 20], EqPoint(3, 4): [30]}
    b: Map<EqPoint, List<int>> = {EqPoint(1, 2): [10, 20], EqPoint(3, 4): [30]}
    expect(a).toEq(b)
  @it("should compare Map<record, List<int>> unequal when values differ")
  fn shouldCompareMapRecordListIntUnequalWhenValuesDiffer():
    a: Map<EqPoint, List<int>> = {EqPoint(1, 2): [10, 20]}
    b: Map<EqPoint, List<int>> = {EqPoint(1, 2): [10, 99]}
    expect(a).toNotEq(b)
  @it("should compare Map<List<int>, str> equal (pointer-backed key)")
  fn shouldCompareMapListIntStrEqualPointerBackedKey():
    a: Map<List<int>, str> = {[1, 2]: "a", [3]: "b"}
    b: Map<List<int>, str> = {[1, 2]: "a", [3]: "b"}
    expect(a).toEq(b)
  @it("should compare Map<List<int>, str> unequal by value")
  fn shouldCompareMapListIntStrUnequalByValue():
    a: Map<List<int>, str> = {[1, 2]: "a"}
    b: Map<List<int>, str> = {[1, 2]: "z"}
    expect(a).toNotEq(b)
  @it("should compare Map<List<int>, str> unequal by key")
  fn shouldCompareMapListIntStrUnequalByKey():
    a: Map<List<int>, str> = {[1, 2]: "a"}
    b: Map<List<int>, str> = {[9, 9]: "a"}
    expect(a).toNotEq(b)
