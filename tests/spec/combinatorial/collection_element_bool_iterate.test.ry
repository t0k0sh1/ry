from ry.testing import it, describe, expect

@describe("collection element — bool in List")
fn collectionElementBoolInListTests():
  @it("should iterate list of bools")
  fn shouldIterateListOfBools():
    xs: List<bool> = [true, true, false]
    count = 0
    for v in xs:
      if v:
        count = count + 1
    expect(count).toEq(2)
