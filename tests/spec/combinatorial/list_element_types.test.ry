from testing import it, describe, expect

@describe("List<Map> — element access")
fn listMapElementAccessTests():
  @it("should access map element by key after list index")
  fn shouldAccessMapElementByKeyAfterListIndex():
    xs: List<Map<str, int>> = [{"a": 1}, {"b": 2}]
    m = xs[0]
    expect(m["a"]).toEq(1)
  @it("should access map element in for loop")
  fn shouldAccessMapElementInForLoop():
    xs: List<Map<str, int>> = [{"a": 10}, {"a": 20}]
    total = 0
    for m in xs:
      total = total + m["a"]
    expect(total).toEq(30)
  @it("should access map from second element")
  fn shouldAccessMapFromSecondElement():
    xs: List<Map<str, int>> = [{"x": 1}, {"y": 99}]
    m = xs[1]
    expect(m["y"]).toEq(99)

@describe("List<Set> — element access")
fn listSetElementAccessTests():
  @it("should test membership after list index")
  fn shouldTestMembershipAfterListIndex():
    ss: List<Set<int>> = [{1, 2, 3}, {4, 5}]
    s = ss[0]
    expect(1 in s).toBeTrue()
    expect(4 in s).toBeFalse()
  @it("should test membership in for loop")
  fn shouldTestMembershipInForLoop():
    ss: List<Set<int>> = [{1, 2}, {3, 4}]
    count = 0
    for s in ss:
      if 1 in s:
        count = count + 1
    expect(count).toEq(1)

@describe("List<closure> — element access")
fn listClosureElementAccessTests():
  @it("should call closure retrieved from list by index")
  fn shouldCallClosureRetrievedFromListByIndex():
    add2 = (x: int) => x + 2
    add5 = (x: int) => x + 5
    fns = [add2, add5]
    f = fns[0]
    expect(f(10)).toEq(12)
  @it("should call second closure from list")
  fn shouldCallSecondClosureFromList():
    add2 = (x: int) => x + 2
    add5 = (x: int) => x + 5
    fns = [add2, add5]
    g = fns[1]
    expect(g(10)).toEq(15)
  @it("should call closures from annotated List<closure> in for loop")
  fn shouldCallClosuresFromAnnotatedListClosureInForLoop():
    add2 = (x: int) => x + 2
    add5 = (x: int) => x + 5
    fns: List<fn(int) -> int> = [add2, add5]
    results: List<int> = []
    for f in fns:
      results.append!(f(10))
    expect(results[0]).toEq(12)
    expect(results[1]).toEq(15)
