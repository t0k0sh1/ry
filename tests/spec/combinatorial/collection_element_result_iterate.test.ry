fn makeOkInt(v: int) -> Result<int, Error>:
  return Ok(v)

fn makeErrInt() -> Result<int, Error>:
  return Err(Error("fail"))

describe("collection element — Result in List", ():
  it("should iterate list of results and count Ok values", ():
    xs = [makeOkInt(1), makeErrInt(), makeOkInt(3)]
    ok_count = 0
    for r in xs:
      case r:
        Ok(_):
          ok_count = ok_count + 1
        Err(_):
          ok_count = ok_count
    expect(ok_count).to_eq(2)
  )
)
