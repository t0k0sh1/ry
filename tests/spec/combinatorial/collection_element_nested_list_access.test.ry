from testing import it, describe, expect

@describe("collection element — List<List<int>>")
fn collectionElementListListIntTests():
  @it("should store nested lists and access inner elements")
  fn shouldStoreNestedListsAndAccessInnerElements():
    xs: List<List<int>> = [[1, 2, 3], [4, 5, 6]]
    expect(xs[0][1]).toEq(2)
    expect(xs[1][0]).toEq(4)
