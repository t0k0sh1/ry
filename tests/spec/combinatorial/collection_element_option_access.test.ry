from ry.testing import it, describe, expect

@describe("collection element — Option in List")
fn collectionElementOptionInListTests():
  @it("should store Some and None values in list")
  fn shouldStoreSomeAndNoneValuesInList():
    xs: List<Option<int>> = [Some(1), none, Some(3)]
    expect(xs[0]).toBeSome()
    expect(xs[1]).toBeNone()
    expect(xs[2]).toBeSome()
