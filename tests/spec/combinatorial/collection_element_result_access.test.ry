from testing import it, describe, expect

fn makeOkInt(v: int) -> Result<int, Error>:
  return Ok(v)

fn makeErrInt() -> Result<int, Error>:
  return Err(Error("fail"))

@describe("collection element — Result in List")
fn collectionElementResultInListTests():
  @it("should store Ok and Err in list")
  fn shouldStoreOkAndErrInList():
    xs = [makeOkInt(1), makeErrInt(), makeOkInt(3)]
    expect(xs[0]).toBeOk()
    expect(xs[1]).toBeErr()
