# Spec for ARC retain correctness in pattern binding arms (issue #997)
#
# Each `it` block exercises a pattern arm that previously lacked an ARC retain
# call, causing either a refcount underflow (double-free for Some/Ok bindings
# that had propagateMeta but no retain) or a leak (no tracking at all).
#
# ASan / UBSan detect refcount underflows as use-after-free at scope exit.
# The tests verify functional correctness; sanitizer runs verify memory safety.

record Box:
  items: List<int>
  label: str

enum Tree:
  Leaf(List<int>)
  Node(str)

fn make_some_list() -> Option<List<int>>:
  return Some([10, 20, 30])

fn make_ok_list() -> Result<List<int>, str>:
  return Ok([1, 2, 3])

fn make_err_msg() -> Result<int, str>:
  # Use string concatenation so the payload is a heap-backed ARC string rather
  # than a compile-time constant.  A constant literal would not exercise the
  # ARC retain path even if retention were missing, so this makes the Err(msg)
  # binding actually sensitive to use-after-free under ASan.
  prefix = "fail"
  return Err(prefix + "ed")

fn make_some_str_short() -> str?:
  # Use string concatenation so the payload is a heap-backed ARC string rather
  # than a compile-time constant — same technique as make_err_msg.
  prefix = "hello"
  return Some(prefix + " world")

fn make_some_list_short() -> List<int>?:
  return Some([1, 2, 3])

describe("pattern binding ARC retain (#997)", ():
  it("Some pattern retains List<int> binding", ():
    # SomePattern: inner = ExtractValue(opt_val, 1) — was missing retain.
    opt = make_some_list()
    case opt:
      Some(xs):
        expect(xs).to_have_length(3)
        expect(xs[0]).to_eq(10)
        expect(xs[1]).to_eq(20)
        expect(xs[2]).to_eq(30)
      None:
        fail("expected Some")
  )

  it("Some pattern retains binding across multiple iterations", ():
    # Repeated extraction exercises ARC retain/release balance.
    i = 0
    while i < 5:
      opt = make_some_list()
      case opt:
        Some(xs):
          expect(xs).to_have_length(3)
        None:
          fail("expected Some")
      i = i + 1
  )

  it("Ok pattern retains List<int> binding", ():
    # OkPattern: ok_val = ExtractValue(res_val, 1) — was missing retain.
    res = make_ok_list()
    case res:
      Ok(xs):
        expect(xs).to_have_length(3)
        expect(xs[0]).to_eq(1)
        expect(xs[2]).to_eq(3)
      Err(e):
        fail("expected Ok")
  )

  it("Err pattern retains str binding", ():
    # ErrPattern: err_val = ExtractValue(res_val, 2) — was missing propagateMeta
    # and retain.
    res = make_err_msg()
    case res:
      Ok(v):
        fail("expected Err")
      Err(msg):
        expect(msg).to_eq("failed")
  )

  it("record pattern retains List<int> field binding", ():
    # RecordPattern: elem = ExtractValue(rec_load, 0) for List field — was
    # missing retain for ptr-type intermediate.
    b = Box([7, 8, 9], "mybox")
    case b:
      Box(xs, lbl):
        expect(xs).to_have_length(3)
        expect(xs[0]).to_eq(7)
        expect(xs[2]).to_eq(9)
        expect(lbl).to_eq("mybox")
  )

  it("enum constructor pattern retains List<int> field binding", ():
    # EnumConstructorPattern: fieldVal = Load(GEP(payload)) — was missing
    # propagateTypeMeta and retain.
    t = Tree::Leaf([100, 200, 300])
    case t:
      Tree::Leaf(xs):
        expect(xs).to_have_length(3)
        expect(xs[0]).to_eq(100)
        expect(xs[2]).to_eq(300)
      Tree::Node(s):
        fail("expected Leaf")
  )

  it("variable pattern retains List<int> binding from match subject", ():
    # VariablePattern: sv = Load(subjectAlloca) — was missing propagateMeta
    # and retain.
    xs = [11, 22, 33]
    case xs:
      ys:
        expect(ys).to_have_length(3)
        expect(ys[0]).to_eq(11)
        expect(ys[2]).to_eq(33)
  )

  it("tuple pattern retains List<int> element binding", ():
    # TuplePattern: each element alloca is marked ARC-managed before the
    # recursive VariablePattern binding emits the retain — was missing
    # markArcManaged on ptr-type intermediates so tryRetainArcSource could
    # detect the source alloca as ARC-managed.
    # Repeated extraction exercises retain/release balance; ASan detects
    # use-after-free if the list is freed prematurely on scope exit.
    i = 0
    while i < 5:
      items: List<int> = [10, 20, 30]
      t = (items, "tag")
      case t:
        (xs, lbl):
          expect(lbl).to_eq("tag")
      i = i + 1
  )

  it("nested Some pattern retains inner List<int>", ():
    # Nested: Some(xs) inside a function call returning Option<List<int>>.
    fn get_nested() -> Option<List<int>>:
      return Some([42, 43])
    case get_nested():
      Some(xs):
        expect(xs).to_have_length(2)
        expect(xs[0]).to_eq(42)
      None:
        fail("expected Some")
  )

  it("guard arm retains binding in guard scope and body scope", ():
    # CaseStmt calls emitPatternBindings twice per arm (guard + body scope),
    # each with its own pushScope/popScope. Both must retain independently.
    opt = Some([1, 2, 3, 4, 5])
    matched = 0
    case opt:
      Some(xs) if length(xs) > 3:
        matched = length(xs)
      Some(xs):
        matched = -1
      None:
        matched = -2
    expect(matched).to_eq(5)
  )

  it("tuple pattern does not over-retain heap str binding (#1016)", ():
    # TuplePattern: str field is ptrTy_ but NOT ARC-managed.  Without the
    # fieldTypeIsArcManaged guard, markArcManaged(tmp) was called for str,
    # causing tryRetainArcSource Case 1 to emit an ARC retain that points
    # emitArcGetHeaderFromData 16 bytes before a plain checked_malloc ptr.
    # This corrupts malloc metadata and is detected as bad-free under ASan.
    # Use heap str (concatenation) so the pointer is malloc-backed.
    i = 0
    while i < 5:
      prefix: str = "hel" + "lo"
      t = (prefix, 42)
      case t:
        (s, n):
          expect(s).to_eq("hello")
          expect(n).to_eq(42)
      i = i + 1
  )

  it("record pattern str field is correctly ARC-managed (#1016, #1046)", ():
    # RecordPattern: str field (label) in Box is ARC-managed since #1046.
    # Verify no double-free and correct value across repeated construction.
    i = 0
    while i < 5:
      lbl: str = "my" + "box"
      b = Box([7, 8, 9], lbl)
      case b:
        Box(xs, s):
          expect(xs).to_have_length(3)
          expect(s).to_eq("mybox")
      i = i + 1
  )

  it("enum constructor pattern str field is correctly ARC-managed (#1016, #1046)", ():
    # EnumConstructorPattern: Tree::Node(str) — str is ARC-managed since #1046.
    # Verify no double-free and correct value across repeated construction.
    i = 0
    while i < 5:
      payload: str = "no" + "de"
      t = Tree::Node(payload)
      case t:
        Tree::Leaf(xs):
          fail("expected Node")
        Tree::Node(s):
          expect(s).to_eq("node")
      i = i + 1
  )

  it("Some pattern binds str with T? suffix form", ():
    # str? is the T? shorthand for Option<str>.
    # extractGenericTypeArg must recognise this suffix form so the typed
    # classification path (Path 2a) is taken (#1015).
    # For `str`, Path 2a intentionally does not retain (same as Option<str>);
    # the fix prevents falling into heuristic Path 2b, which mis-balances
    # arc_backed_vars_ for non-collection T? bindings.
    case make_some_str_short():
      Some(s):
        expect(s).to_eq("hello world")
      None:
        fail("expected Some")
  )

  it("Some pattern binds List<int> with T? suffix form", ():
    # List<int>? is the T? shorthand for Option<List<int>>.
    # Ensures the typed ARC path is taken instead of the heuristic fallback.
    case make_some_list_short():
      Some(xs):
        expect(xs).to_have_length(3)
        expect(xs[0]).to_eq(1)
      None:
        fail("expected Some")
  )
)
