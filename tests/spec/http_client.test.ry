from std.net import bind, listen, accept, listener_port
from std.io import str_to_bytes, bytes_to_str
from std.http import http_get, http_post, http_request, http_client_status, http_client_body, http_client_header

describe("HTTP Client", fn():
    it("http_get returns 200 response", fn():
        fn server(ready: Channel<int>) -> str:
            match bind("127.0.0.1", 0):
                case Ok(srv):
                    match listen(srv, 1):
                        case Ok(_):
                            port = listener_port(srv)
                            send(ready, port)
                            match accept(srv):
                                case Ok(conn):
                                    match recv(conn, 4096):
                                        case Ok(data):
                                            response_str = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello"
                                            match send(conn, str_to_bytes(response_str)):
                                                case Ok(_):
                                                    ...
                                                case Err(e):
                                                    ...
                                        case Err(e):
                                            ...
                                    close(conn)
                                case Err(e):
                                    ...
                        case Err(e):
                            send(ready, 0)
                    close(srv)
                case Err(e):
                    send(ready, 0)
            return "done"

        ready: Channel<int> = channel[int]()
        t: Task<str> = spawn server(ready)
        port = recv(ready)
        url = "http://127.0.0.1:" + to_str(port) + "/test"
        match http_get(url):
            case Ok(resp):
                expect(http_client_status(resp)).to_eq(200)
                expect(http_client_body(resp)).to_eq("hello")
                match http_client_header(resp, "Content-Type"):
                    case Some(v):
                        expect(v).to_eq("text/plain")
                    case None:
                        expect(true).to_eq(false)
            case Err(e):
                expect(true).to_eq(false)
        join(t)
    )

    it("http_post sends body to server", fn():
        fn post_server(ready: Channel<int>) -> str:
            match bind("127.0.0.1", 0):
                case Ok(srv):
                    match listen(srv, 1):
                        case Ok(_):
                            port = listener_port(srv)
                            send(ready, port)
                            match accept(srv):
                                case Ok(conn):
                                    match recv(conn, 4096):
                                        case Ok(data):
                                            response_str = "HTTP/1.1 201 Created\r\nContent-Length: 2\r\n\r\nok"
                                            match send(conn, str_to_bytes(response_str)):
                                                case Ok(_):
                                                    ...
                                                case Err(e):
                                                    ...
                                        case Err(e):
                                            ...
                                    close(conn)
                                case Err(e):
                                    ...
                        case Err(e):
                            send(ready, 0)
                    close(srv)
                case Err(e):
                    send(ready, 0)
            return "done"

        ready: Channel<int> = channel[int]()
        t: Task<str> = spawn post_server(ready)
        port = recv(ready)
        url = "http://127.0.0.1:" + to_str(port) + "/data"
        headers: Map<str, str> = {}
        match http_post(url, "test body", headers):
            case Ok(resp):
                expect(http_client_status(resp)).to_eq(201)
                expect(http_client_body(resp)).to_eq("ok")
            case Err(e):
                expect(true).to_eq(false)
        join(t)
    )

    it("http_get returns Err on connection refused", fn():
        match http_get("http://127.0.0.1:1/nonexistent"):
            case Ok(resp):
                expect(true).to_eq(false)
            case Err(e):
                expect(true).to_eq(true)
    )
)
