describe("int overflow safety", ():
  it("should handle normal addition", ():
    expect(100 + 200).toEq(300)
    expect(-50 + 50).toEq(0)
    expect(0 + 0).toEq(0)
  )
  it("should handle normal subtraction", ():
    expect(200 - 100).toEq(100)
    expect(50 - 100).toEq(-50)
    expect(0 - 0).toEq(0)
  )
  it("should handle normal multiplication", ():
    expect(1000000 * 1000000).toEq(1000000000000)
    expect(-5 * 7).toEq(-35)
    expect(0 * 9223372036854775807).toEq(0)
  )
  it("should handle normal negation", ():
    expect(-42).toEq(-42)
    expect(-(-42)).toEq(42)
    expect(-0).toEq(0)
  )
  it("should handle large values within range", ():
    max = 9223372036854775807
    expect(max + 0).toEq(9223372036854775807)
    expect(max - max).toEq(0)
    expect(max * 1).toEq(9223372036854775807)
  )
  it("should handle INT64_MIN via subtraction", ():
    min = -9223372036854775807 - 1
    expect(min + 0).toEq(-9223372036854775807 - 1)
    expect(min * 1).toEq(-9223372036854775807 - 1)
    expect(min - 0).toEq(-9223372036854775807 - 1)
  )
  it("should handle compound assignment without overflow", ():
    x = 100
    x += 200
    expect(x).toEq(300)
    x -= 50
    expect(x).toEq(250)
    x *= 2
    expect(x).toEq(500)
  )
  it("should parse INT64_MIN as a direct literal", ():
    min_direct = -9223372036854775808
    expect(min_direct).toEq(-9223372036854775807 - 1)
    expect(min_direct + 1).toEq(-9223372036854775807)
    expect(min_direct - 0).toEq(-9223372036854775807 - 1)
  )
  it("should parse INT64_MIN with i64 suffix", ():
    min_i64 = -9223372036854775808i64
    expect(min_i64).toEq(-9223372036854775807 - 1)
    expect(min_i64 + 1i64).toEq(-9223372036854775807)
  )
)
