from testing import it, describe

@describe("f-string closure capture — nested named function")
fn fStringClosureCaptureNestedNamedFunctionTests():
  @it("should capture outer variable in f-string inside nested function")
  fn shouldCaptureOuterVariableInFStringInsideNestedFunction():
    fn makeGreeter(greeting: str) -> fn(str) -> str:
      fn greet(name: str) -> str:
        return f"{greeting} {name}"
      return greet

    g = makeGreeter("hi")
    expect(g("ry")).toEq("hi ry")

  @it("should capture int variable in f-string inside nested function")
  fn shouldCaptureIntVariableInFStringInsideNestedFunction():
    fn makeFormatter(prefix: str) -> fn(int) -> str:
      fn fmt(x: int) -> str:
        return f"{prefix}_{x}"
      return fmt

    f = makeFormatter("item")
    expect(f(42)).toEq("item_42")

  @it("should capture variable used in expression inside f-string")
  fn shouldCaptureVariableUsedInExpressionInsideFString():
    fn makeCalc(base: int) -> fn(int) -> str:
      fn calc(x: int) -> str:
        return f"result={base + x}"
      return calc

    f = makeCalc(10)
    expect(f(5)).toEq("result=15")

  @it("should capture multiple outer variables in f-string")
  fn shouldCaptureMultipleOuterVariablesInFString():
    fn makePairFmt(a: str, b: str) -> fn() -> str:
      fn fmt() -> str:
        return f"{a} {b}"
      return fmt

    f = makePairFmt("hello", "world")
    expect(f()).toEq("hello world")

@describe("f-string closure capture — lambda")
fn fStringClosureCaptureLambdaTests():
  @it("should capture outer variable via f-string in lambda")
  fn shouldCaptureOuterVariableViaFStringInLambda():
    fn strLen(s: str) -> int:
      return s.len()
    name = "world"
    f = () => strLen(f"hello {name}")
    expect(f()).toEq(11)

