from ry.testing import it, describe, expect

@describe("sleep")
fn sleepTests():
  @it("should complete with zero duration")
  fn shouldCompleteWithZeroDuration():
    sleep(0)
    expect(true).toEq(true)
  @it("should complete with positive duration")
  fn shouldCompleteWithPositiveDuration():
    sleep(5)
    expect(true).toEq(true)
  @it("should complete with negative duration")
  fn shouldCompleteWithNegativeDuration():
    sleep(-1)
    expect(true).toEq(true)
