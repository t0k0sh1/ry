describe("sleep", ():
  it("should complete with zero duration", ():
    sleep(0)
    expect(true).toEq(true)
  )
  it("should complete with positive duration", ():
    sleep(5)
    expect(true).toEq(true)
  )
  it("should complete with negative duration", ():
    sleep(-1)
    expect(true).toEq(true)
  )
)
