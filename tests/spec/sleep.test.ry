describe("sleep", fn():
    it("completes with zero duration", fn():
        sleep(0)
        expect(true).to_eq(true)
    )
    it("completes with positive duration", fn():
        sleep(5)
        expect(true).to_eq(true)
    )
    it("completes with negative duration", fn():
        sleep(-1)
        expect(true).to_eq(true)
    )
)
