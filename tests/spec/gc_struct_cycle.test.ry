from gc import collect, enable, set_threshold

# Record types embedded in ADT enum variants.
# This verifies that the compiler handles record types in visit function
# generation without crashes.
record Payload:
    value: int
    name: str

enum Shape:
    Circle(float)
    Tagged(Payload)

describe("Cycle Collector - Struct Visit Functions", fn():
    it("ADT enum with record payload compiles and runs", fn():
        p = Payload(42, "hello")
        s = Shape::Tagged(p)
        c = Shape::Circle(3.14)

        expect(p.value).to_eq(42)
        expect(p.name).to_eq("hello")
    )

    it("gc.collect does not crash with record-in-ADT types", fn():
        enable()
        set_threshold(10000)
        n = collect()
        expect(n >= 0).to_eq(true)
    )
)
