# --- Basic mutual recursion (isEven / isOdd) ---

fn isEven(n: int) -> bool:
  if n == 0:
    return true
  return isOdd(n - 1)

fn isOdd(n: int) -> bool:
  if n == 0:
    return false
  return isEven(n - 1)

# --- Three-way mutual recursion (A -> B -> C -> A) ---

fn phaseA(n: int) -> str:
  if n <= 0:
    return "a"
  return phaseB(n - 1)

fn phaseB(n: int) -> str:
  if n <= 0:
    return "b"
  return phaseC(n - 1)

fn phaseC(n: int) -> str:
  if n <= 0:
    return "c"
  return phaseA(n - 1)

# --- Forward reference without cycle ---

fn caller(n: int) -> int:
  return callee(n) + 1

fn callee(n: int) -> int:
  return n * 2

# --- Mutual recursion with different return types ---

fn countDown(n: int) -> int:
  if n <= 0:
    return 0
  return bounce(n - 1)

fn bounce(n: int) -> int:
  if checkZero(n):
    return 0
  return countDown(n - 1)

fn checkZero(n: int) -> bool:
  return n == 0

# --- Mutual recursion with default arguments ---

fn ping(n: int, prefix: str = "ping") -> str:
  if n <= 0:
    return prefix
  return pong(n - 1)

fn pong(n: int, prefix: str = "pong") -> str:
  if n <= 0:
    return prefix
  return ping(n - 1)

describe("mutual recursion", ():
  it("should compute is_even", ():
    expect(isEven(0)).to_be_true()
    expect(isEven(4)).to_be_true()
    expect(isEven(3)).to_be_false()
  )
  it("should compute is_odd", ():
    expect(isOdd(0)).to_be_false()
    expect(isOdd(3)).to_be_true()
    expect(isOdd(4)).to_be_false()
  )
)

describe("three-way mutual recursion", ():
  it("should cycle through A -> B -> C -> A", ():
    expect(phaseA(0)).to_eq("a")
    expect(phaseA(1)).to_eq("b")
    expect(phaseA(2)).to_eq("c")
    expect(phaseA(3)).to_eq("a")
    expect(phaseA(6)).to_eq("a")
  )
)

describe("forward reference", ():
  it("should resolve caller that references callee defined later", ():
    expect(caller(5)).to_eq(11)
    expect(caller(0)).to_eq(1)
  )
)

describe("mutual recursion with mixed return types", ():
  it("should compute count_down with bounce and check_zero", ():
    expect(countDown(0)).to_eq(0)
    expect(countDown(5)).to_eq(0)
  )
)

describe("mutual recursion with default arguments", ():
  it("should compute ping-pong", ():
    expect(ping(0)).to_eq("ping")
    expect(ping(1)).to_eq("pong")
    expect(ping(2)).to_eq("ping")
    expect(pong(0)).to_eq("pong")
    expect(pong(1)).to_eq("ping")
  )
)
