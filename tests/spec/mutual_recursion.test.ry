# --- Basic mutual recursion (isEven / isOdd) ---

from testing import it, describe, expect

fn isEven(n: int) -> bool:
  if n == 0:
    return true
  return isOdd(n - 1)

fn isOdd(n: int) -> bool:
  if n == 0:
    return false
  return isEven(n - 1)

# --- Three-way mutual recursion (A -> B -> C -> A) ---

fn phaseA(n: int) -> str:
  if n <= 0:
    return "a"
  return phaseB(n - 1)

fn phaseB(n: int) -> str:
  if n <= 0:
    return "b"
  return phaseC(n - 1)

fn phaseC(n: int) -> str:
  if n <= 0:
    return "c"
  return phaseA(n - 1)

# --- Forward reference without cycle ---

fn caller(n: int) -> int:
  return callee(n) + 1

fn callee(n: int) -> int:
  return n * 2

# --- Mutual recursion with different return types ---

fn countDown(n: int) -> int:
  if n <= 0:
    return 0
  return bounce(n - 1)

fn bounce(n: int) -> int:
  if checkZero(n):
    return 0
  return countDown(n - 1)

fn checkZero(n: int) -> bool:
  return n == 0

# --- Mutual recursion with default arguments ---

fn ping(n: int, prefix: str = "ping") -> str:
  if n <= 0:
    return prefix
  return pong(n - 1)

fn pong(n: int, prefix: str = "pong") -> str:
  if n <= 0:
    return prefix
  return ping(n - 1)

@describe("mutual recursion")
fn mutualRecursionTests():
  @it("should compute is_even")
  fn shouldComputeIsEven():
    expect(isEven(0)).toBeTrue()
    expect(isEven(4)).toBeTrue()
    expect(isEven(3)).toBeFalse()
  @it("should compute is_odd")
  fn shouldComputeIsOdd():
    expect(isOdd(0)).toBeFalse()
    expect(isOdd(3)).toBeTrue()
    expect(isOdd(4)).toBeFalse()

@describe("three-way mutual recursion")
fn threeWayMutualRecursionTests():
  @it("should cycle through A -> B -> C -> A")
  fn shouldCycleThroughABCA():
    expect(phaseA(0)).toEq("a")
    expect(phaseA(1)).toEq("b")
    expect(phaseA(2)).toEq("c")
    expect(phaseA(3)).toEq("a")
    expect(phaseA(6)).toEq("a")

@describe("forward reference")
fn forwardReferenceTests():
  @it("should resolve caller that references callee defined later")
  fn shouldResolveCallerThatReferencesCalleeDefinedLater():
    expect(caller(5)).toEq(11)
    expect(caller(0)).toEq(1)

@describe("mutual recursion with mixed return types")
fn mutualRecursionWithMixedReturnTypesTests():
  @it("should compute count_down with bounce and check_zero")
  fn shouldComputeCountDownWithBounceAndCheckZero():
    expect(countDown(0)).toEq(0)
    expect(countDown(5)).toEq(0)

@describe("mutual recursion with default arguments")
fn mutualRecursionWithDefaultArgumentsTests():
  @it("should compute ping-pong")
  fn shouldComputePingPong():
    expect(ping(0)).toEq("ping")
    expect(ping(1)).toEq("pong")
    expect(ping(2)).toEq("ping")
    expect(pong(0)).toEq("pong")
    expect(pong(1)).toEq("ping")
