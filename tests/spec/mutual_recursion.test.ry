# --- Basic mutual recursion (is_even / is_odd) ---

fn is_even(n: int) -> bool:
  if n == 0:
    return true
  return is_odd(n - 1)

fn is_odd(n: int) -> bool:
  if n == 0:
    return false
  return is_even(n - 1)

# --- Three-way mutual recursion (A -> B -> C -> A) ---

fn phase_a(n: int) -> str:
  if n <= 0:
    return "a"
  return phase_b(n - 1)

fn phase_b(n: int) -> str:
  if n <= 0:
    return "b"
  return phase_c(n - 1)

fn phase_c(n: int) -> str:
  if n <= 0:
    return "c"
  return phase_a(n - 1)

# --- Forward reference without cycle ---

fn caller(n: int) -> int:
  return callee(n) + 1

fn callee(n: int) -> int:
  return n * 2

# --- Mutual recursion with different return types ---

fn count_down(n: int) -> int:
  if n <= 0:
    return 0
  return bounce(n - 1)

fn bounce(n: int) -> int:
  if check_zero(n):
    return 0
  return count_down(n - 1)

fn check_zero(n: int) -> bool:
  return n == 0

# --- Mutual recursion with default arguments ---

fn ping(n: int, prefix: str = "ping") -> str:
  if n <= 0:
    return prefix
  return pong(n - 1)

fn pong(n: int, prefix: str = "pong") -> str:
  if n <= 0:
    return prefix
  return ping(n - 1)

describe("mutual recursion", ():
  it("should compute is_even", ():
    expect(is_even(0)).to_be_true()
    expect(is_even(4)).to_be_true()
    expect(is_even(3)).to_be_false()
  )
  it("should compute is_odd", ():
    expect(is_odd(0)).to_be_false()
    expect(is_odd(3)).to_be_true()
    expect(is_odd(4)).to_be_false()
  )
)

describe("three-way mutual recursion", ():
  it("should cycle through A -> B -> C -> A", ():
    expect(phase_a(0)).to_eq("a")
    expect(phase_a(1)).to_eq("b")
    expect(phase_a(2)).to_eq("c")
    expect(phase_a(3)).to_eq("a")
    expect(phase_a(6)).to_eq("a")
  )
)

describe("forward reference", ():
  it("should resolve caller that references callee defined later", ():
    expect(caller(5)).to_eq(11)
    expect(caller(0)).to_eq(1)
  )
)

describe("mutual recursion with mixed return types", ():
  it("should compute count_down with bounce and check_zero", ():
    expect(count_down(0)).to_eq(0)
    expect(count_down(5)).to_eq(0)
  )
)

describe("mutual recursion with default arguments", ():
  it("should compute ping-pong", ():
    expect(ping(0)).to_eq("ping")
    expect(ping(1)).to_eq("pong")
    expect(ping(2)).to_eq("ping")
    expect(pong(0)).to_eq("pong")
    expect(pong(1)).to_eq("ping")
  )
)
