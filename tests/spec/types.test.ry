describe("int"):
    it("decimal literal"):
        expect(42).to_eq(42)

    it("negative"):
        expect(-7).to_eq(-7)

    it("hex literal"):
        expect(0xFF).to_eq(255)

    it("binary literal"):
        expect(0b1010).to_eq(10)

describe("float"):
    it("basic"):
        expect(3.14).to_eq(3.14)

    it("zero point five"):
        expect(0.5).to_eq(0.5)

describe("bool"):
    it("true"):
        expect(true).to_eq(true)

    it("false"):
        expect(false).to_eq(false)

describe("str"):
    it("basic"):
        expect("hello").to_eq("hello")

    it("empty"):
        expect("").to_eq("")

    it("escape newline"):
        expect("a\nb").to_have_length(3)

    it("escape tab"):
        expect("a\tb").to_have_length(3)

    it("escape backslash"):
        expect("a\\b").to_have_length(3)

describe("byte"):
    it("as int"):
        let b: byte = 42
        expect(b as int).to_eq(42)

    it("max value"):
        let b: byte = 255
        expect(b as int).to_eq(255)

describe("Option"):
    it("Some"):
        let x: Option<int> = Some(42)
        expect(x).to_be_some()

    it("None"):
        let x: Option<int> = None
        expect(x).to_be_none()

    it("none keyword"):
        let x: int? = none
        expect(x).to_be_none()

    it("shorthand syntax"):
        let x: int? = 42
        expect(x).to_be_some()

describe("Tuple"):
    it("element access"):
        let t = (10, 3.14)
        expect(t.0).to_eq(10)

    it("second element"):
        let t = (10, 3.14)
        expect(t.1).to_eq(3.14)
