from testing import it, describe

@describe("int")
fn intTests():
  @it("should support decimal literal")
  fn shouldSupportDecimalLiteral():
    expect(42).toEq(42)
  @it("should support negative literal")
  fn shouldSupportNegativeLiteral():
    expect(-7).toEq(-7)
  @it("should support hex literal")
  fn shouldSupportHexLiteral():
    expect(255).toEq(255)
  @it("should support binary literal")
  fn shouldSupportBinaryLiteral():
    expect(10).toEq(10)

@describe("float")
fn floatTests():
  @it("should support basic float literal")
  fn shouldSupportBasicFloatLiteral():
    expect(3.14).toEq(3.14)
  @it("should support zero point five float literal")
  fn shouldSupportZeroPointFiveFloatLiteral():
    expect(0.5).toEq(0.5)

@describe("bool")
fn boolTests():
  @it("should support true literal")
  fn shouldSupportTrueLiteral():
    expect(true).toEq(true)
  @it("should support false literal")
  fn shouldSupportFalseLiteral():
    expect(false).toEq(false)

@describe("str")
fn strTests():
  @it("should support basic string literal")
  fn shouldSupportBasicStringLiteral():
    expect("hello").toEq("hello")
  @it("should support empty string literal")
  fn shouldSupportEmptyStringLiteral():
    expect("").toEq("")
  @it("should support newline escape")
  fn shouldSupportNewlineEscape():
    expect("a\nb").toHaveLen(3)
  @it("should support tab escape")
  fn shouldSupportTabEscape():
    expect("a\tb").toHaveLen(3)
  @it("should support backslash escape")
  fn shouldSupportBackslashEscape():
    expect("a\\b").toHaveLen(3)

@describe("u8")
fn u8Tests():
  @it("should cast u8 as int")
  fn shouldCastU8AsInt():
    b: u8 = 42
    expect(b as int).toEq(42)
  @it("should support max value of u8")
  fn shouldSupportMaxValueOfU8():
    b: u8 = 255
    expect(b as int).toEq(255)

@describe("Option")
fn optionTests():
  @it("should wrap value in Some")
  fn shouldWrapValueInSome():
    x: Option<int> = Some(42)
    expect(x).toBeSome()
  @it("should represent None")
  fn shouldRepresentNone():
    x: Option<int> = None
    expect(x).toBeNone()
  @it("should support none keyword")
  fn shouldSupportNoneKeyword():
    x: int? = none
    expect(x).toBeNone()
  @it("should support shorthand syntax")
  fn shouldSupportShorthandSyntax():
    x: int? = 42
    expect(x).toBeSome()
  @it("should recognize Some(0) as Some not None")
  fn shouldRecognizeSome0AsSomeNotNone():
    x: int? = Some(0)
    expect(x).toBeSome()
  @it("should recognize Some(false) as Some not None")
  fn shouldRecognizeSomeFalseAsSomeNotNone():
    x: bool? = Some(false)
    expect(x).toBeSome()
  @it("should recognize Some empty string as Some")
  fn shouldRecognizeSomeEmptyStringAsSome():
    x: str? = Some("")
    expect(x).toBeSome()

@describe("nested generic type")
fn nestedGenericTypeTests():
  @it("should support Option<Option<int>> Some(Some)")
  fn shouldSupportOptionOptionIntSomeSome():
    inner: Option<int> = Some(42)
    x: Option<Option<int>> = Some(inner)
    case x:
      Some(v):
        expect(v).toBeSome()
      None:
        expect(false).toEq(true)
  @it("should support Option<Option<int>> None")
  fn shouldSupportOptionOptionIntNone():
    x: Option<Option<int>> = None
    expect(x).toBeNone()

@describe("Tuple")
fn tupleTests():
  @it("should access first tuple element")
  fn shouldAccessFirstTupleElement():
    t = (10, 3.14)
    expect(t.0).toEq(10)
  @it("should access second tuple element")
  fn shouldAccessSecondTupleElement():
    t = (10, 3.14)
    expect(t.1).toEq(3.14)
