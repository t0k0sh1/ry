# Tests for #1569: @native stdlib functions can be referenced as
# first-class function values (assigned to vars / passed as args), not
# only used in direct CallExpr position. Before #1569, `let f = int`
# raised "undefined variable: int" because emitExprVariant(VariableExpr)
# never consulted native_fn_sigs_.

from testing import it, describe, expect, fail

from convert import int

@describe("@native first-class — direct assignment (single-overload)")
fn nativeFirstClassDirectAssignmentSingleOverloadTests():
  @it("binds int to a variable and invokes it")
  fn bindsIntToAVariableAndInvokesIt():
    f = int
    case f("42"):
      Ok(v): expect(v).toEq(42)
      Err(e): fail("int failed: " + e.message)

  @it("returns Err through the bound variable")
  fn returnsErrThroughTheBoundVariable():
    f = int
    case f("not-a-number"):
      Ok(v): fail("expected Err, got Ok(" + str(v) + ")")
      Err(e): expect(e.message).toContain("int")

  @it("propagates the binding through a chain of let-bindings")
  fn propagatesTheBindingThroughAChainOfLetBindings():
    f = int
    g = f
    case g("100"):
      Ok(v): expect(v).toEq(100)
      Err(e): fail("int failed: " + e.message)

@describe("@native first-class — passed as fn parameter")
fn nativeFirstClassPassedAsFnParameterTests():
  @it("invokes a passed @native via a user-defined higher-order fn")
  fn invokesAPassedNativeViaAUserDefinedHigherOrderFn():
    fn invoke(f: fn(str) -> Result<int, Error>, s: str) -> Result<int, Error>:
      return f(s)

    case invoke(int, "7"):
      Ok(v): expect(v).toEq(7)
      Err(e): fail("int failed: " + e.message)

  @it("xs.map(int) routes the @native through stdlib map")
  fn xsMapIntRoutesTheNativeThroughStdlibMap():
    xs: List<str> = ["1", "2", "3"]
    results = xs.map(int)
    expect(len(results)).toEq(3)
    case results[0]:
      Ok(v): expect(v).toEq(1)
      Err(e): fail("int[0] failed: " + e.message)
    case results[2]:
      Ok(v): expect(v).toEq(3)
      Err(e): fail("int[2] failed: " + e.message)

@describe("@native first-class — default args materialize as full arity")
fn nativeFirstClassDefaultArgsMaterializeAsFullArityTests():
  @it("requires every param when calling the materialized binding")
  fn requiresEveryParamWhenCallingTheMaterializedBinding():
    g = startsWith
    expect(g("hello", "he", false)).toBeTrue()
    expect(g("hello", "He", true)).toBeTrue()
    expect(g("hello", "world", false)).toBeFalse()

@describe("@native first-class — explicit import path")
fn nativeFirstClassExplicitImportPathTests():
  @it("explicit `from convert import int` round-trips through a binding")
  fn explicitFromConvertImportIntRoundTripsThroughABinding():
    f = int
    case f("99"):
      Ok(v): expect(v).toEq(99)
      Err(e): fail("int failed: " + e.message)
