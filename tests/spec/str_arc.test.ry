from testing import it, describe

from runtime_internal import arcLiveCount

# str ARC management tests (#1046)
# Verifies that dynamically-created str values are correctly managed
# by ARC: retained when stored, released when scope ends.
# Memory correctness (no leak / double-free) is enforced by ASan.

@describe("str ARC — dynamic string operations")
fn strArcDynamicStringOperationsTests():
  @it("concat result is usable after assignment")
  fn concatResultIsUsableAfterAssignment():
    a = "hello"
    b = "world"
    c = a + ", " + b
    expect(c).toEq("hello, world")

  @it("f-string interpolation result is usable")
  fn fStringInterpolationResultIsUsable():
    n = 42
    s = f"value={n}"
    expect(s).toEq("value=42")

  @it("repeat result is usable")
  fn repeatResultIsUsable():
    s = "ab".repeat(3)
    expect(s).toEq("ababab")

  @it("repeat zero produces empty string")
  fn repeatZeroProducesEmptyString():
    s = "x".repeat(0)
    expect(s).toEq("")

  @it("toUpper / toLower return valid strings")
  fn toupperTolowerReturnValidStrings():
    s = "Hello World"
    expect(s.toUpper()).toEq("HELLO WORLD")
    expect(s.toLower()).toEq("hello world")

  @it("trim returns valid string")
  fn trimReturnsValidString():
    s = "  hello  ".trim()
    expect(s).toEq("hello")

  @it("substr returns valid string")
  fn substrReturnsValidString():
    s = "hello world"
    expect(s.substr(6, 11)).toEq("world")

  @it("replace returns valid str")
  fn replaceReturnsValidStr():
    s = "hello world"
    r = s.replace("world", "Ry")
    expect(r).toEq("hello Ry")

  @it("concat loop produces correct result")
  fn concatLoopProducesCorrectResult():
    result = ""
    for i in range(5):
      result = result + (i as str)
    expect(result).toEq("01234")

  @it("str returned from function is usable")
  fn strReturnedFromFunctionIsUsable():
    fn makeGreeting(name: str) -> str:
      return "Hello, " + name + "!"
    g = makeGreeting("World")
    expect(g).toEq("Hello, World!")

  @it("str passed through multiple function calls remains valid")
  fn strPassedThroughMultipleFunctionCallsRemainsValid():
    fn double(s: str) -> str:
      return s + s
    a = "ab"
    b = double(a)
    c = double(b)
    expect(c).toEq("abababab")

@describe("str ARC — List<str> management")
fn strArcListStrManagementTests():
  @it("List<str> created with literals is correct")
  fn listStrCreatedWithLiteralsIsCorrect():
    xs = ["a", "b", "c"]
    expect(xs).toHaveLen(3)
    expect(xs[0]).toEq("a")
    expect(xs[2]).toEq("c")

  @it("List<str> with dynamic strings is correct")
  fn listStrWithDynamicStringsIsCorrect():
    a = "x" + "1"
    b = "x" + "2"
    xs = [a, b]
    expect(xs[0]).toEq("x1")
    expect(xs[1]).toEq("x2")

  @it("append to List<str> works correctly")
  fn appendToListStrWorksCorrectly():
    xs: List<str> = ["first", "second"]
    append(xs, "third")
    expect(xs).toHaveLen(3)
    expect(xs[2]).toEq("third")

  @it("append dynamic str to List<str> works correctly")
  fn appendDynamicStrToListStrWorksCorrectly():
    xs: List<str> = []
    s = "hel" + "lo"
    append(xs, s)
    expect(xs).toHaveLen(1)
    expect(xs[0]).toEq("hello")

  @it("List<str> overwrite does not leak (arcLiveCount stays constant)")
  fn listStrOverwriteDoesNotLeakArclivecountStaysConstant():
    before = arcLiveCount()
    xs: List<str> = ["a", "b", "c"]
    xs = ["d", "e", "f"]
    xs = ["g", "h", "i"]
    xs = ["j", "k", "l"]
    after = arcLiveCount()
    expect(after - before).toEq(1)

  @it("List<str> with dynamic elements does not leak on overwrite")
  fn listStrWithDynamicElementsDoesNotLeakOnOverwrite():
    # Post-#1576 delta accounting:
    #   s1, s2 dyn alloc          : +2 (makeString now contributes +1 each)
    #   xs = [s1, s2]             : +1 (list header)
    #   s1+"a", s2+"b" temps      : +2 (retained by new list, no free)
    #   new xs list header        : +1
    #   old xs release (str-aware): -1 (list buffer; elements survive on s1/s2)
    # Total: +5. Pre-#1576 baseline of +1 reflected the counter-asymmetric
    # era where str allocations were uncounted.
    before = arcLiveCount()
    s1 = "foo" + "1"
    s2 = "foo" + "2"
    xs: List<str> = [s1, s2]
    xs = [s1 + "a", s2 + "b"]
    after = arcLiveCount()
    expect(after - before).toEq(5)

  @it("List<str> copy-on-write preserves both copies")
  fn listStrCopyOnWritePreservesBothCopies():
    a = ["alpha", "beta", "gamma"]
    b = a
    c = b
    append(c, "delta")
    expect(a).toHaveLen(3)
    expect(c).toHaveLen(4)
    expect(c[3]).toEq("delta")

  @it("List<str> CoW with dynamic elements preserves both copies")
  fn listStrCowWithDynamicElementsPreservesBothCopies():
    s1 = "x" + "1"
    s2 = "x" + "2"
    a = [s1, s2]
    b = a
    append(b, "x3")
    expect(a).toHaveLen(2)
    expect(b).toHaveLen(3)
    expect(a[0]).toEq("x1")
    expect(b[2]).toEq("x3")

  @it("map() over list produces List<str> correctly")
  fn mapOverListProducesListStrCorrectly():
    nums = [1, 2, 3]
    strs = nums.map((n: int) => "n=" + (n as str))
    expect(strs[0]).toEq("n=1")
    expect(strs[1]).toEq("n=2")
    expect(strs[2]).toEq("n=3")

  @it("join on List<str> produces correct result")
  fn joinOnListStrProducesCorrectResult():
    parts = ["a", "b", "c"]
    joined = ",".join(parts)
    expect(joined).toEq("a,b,c")

@describe("str ARC — Map<str, str>")
fn strArcMapStrStrTests():
  @it("Map<str, str> stores and retrieves values")
  fn mapStrStrStoresAndRetrievesValues():
    m = {"key": "value", "foo": "bar"}
    expect(m["key"]).toEq("value")
    expect(m["foo"]).toEq("bar")

  @it("Map<str, str> with dynamic values does not leak on overwrite")
  fn mapStrStrWithDynamicValuesDoesNotLeakOnOverwrite():
    before = arcLiveCount()
    m: Map<str, str> = {"k": "v1"}
    m = {"k": "v2"}
    m = {"k": "v3"}
    after = arcLiveCount()
    expect(after - before).toEq(1)

@describe("str ARC — closure capture")
fn strArcClosureCaptureTests():
  @it("closure captures str by value")
  fn closureCapturesStrByValue():
    prefix = "hello"
    greet = (name: str) => prefix + ", " + name
    expect(greet("Alice")).toEq("hello, Alice")
    expect(greet("Bob")).toEq("hello, Bob")

  @it("closure captures dynamic str")
  fn closureCapturesDynamicStr():
    base = "x" + "y"
    f = () => base + "z"
    expect(f()).toEq("xyz")

@describe("str ARC — pattern binding")
fn strArcPatternBindingTests():
  @it("Some(str) pattern binding retains dynamic str")
  fn someStrPatternBindingRetainsDynamicStr():
    opt: Option<str> = Some("a" + "b")
    case opt:
      Some(s):
        expect(s).toEq("ab")
      None:
        expect(false).toEq(true)

  @it("Ok(str) pattern binding retains dynamic str")
  fn okStrPatternBindingRetainsDynamicStr():
    res: Result<str, str> = Ok("he" + "llo")
    case res:
      Ok(s):
        expect(s).toEq("hello")
      Err(_):
        expect(false).toEq(true)

  @it("Err(str) pattern binding retains dynamic str")
  fn errStrPatternBindingRetainsDynamicStr():
    res: Result<int, str> = Err("err" + "or")
    case res:
      Ok(_):
        expect(false).toEq(true)
      Err(e):
        expect(e).toEq("error")

  @it("nested Some(str) survives outer scope exit")
  fn nestedSomeStrSurvivesOuterScopeExit():
    outer = Some("pre" + "fix")
    result = ""
    case outer:
      Some(s):
        result = s + "_done"
      None:
        result = "none"
    expect(result).toEq("prefix_done")

# str ARC — closure capture tests (#1105)
# Verifies that closures capturing dynamic str values use the correct
# StringHeader offset (−24) for both construction retain and destructor
# release.  Memory correctness is enforced by ASan.
@describe("str ARC — closure capture")
fn strArcClosureCaptureTests2():
  @it("closure captures dynamic str and produces correct result")
  fn closureCapturesDynamicStrAndProducesCorrectResult():
    prefix = "he" + "llo"
    greet = (name: str) => prefix + ", " + name
    result = greet("world")
    expect(result).toEq("hello, world")

  @it("closure captures multiple str values")
  fn closureCapturesMultipleStrValues():
    a = "fo" + "o"
    b = "ba" + "r"
    combine = () => a + b
    expect(combine()).toEq("foobar")

  @it("closure capturing str survives reassignment of original")
  fn closureCapturingStrSurvivesReassignmentOfOriginal():
    s = "ori" + "ginal"
    captureS = () => s
    s = "new" + "value"
    expect(captureS()).toEq("original")

# str ARC — bare expression statement tests (#1105)
# Verifies that str temporaries used as bare ExprStmt are released (not
# leaked).  arcLiveCount() checks the net ARC allocation balance.
@describe("str ARC — ExprStmt release")
fn strArcExprstmtReleaseTests():
  @it("bare str method call does not leak")
  fn bareStrMethodCallDoesNotLeak():
    # Post-#1576 baseline: makeString and freeStringSlot both touch
    # g_arc_live_count, so each method allocates +1 and each bare-ExprStmt
    # release contributes -1 — net 0. Pre-#1576 read -3 because the +1
    # alloc side was uncounted while the release side already decremented
    # via the arc.free path.
    before = arcLiveCount()
    "hello".toUpper()
    "  trim me  ".trim()
    "ab".repeat(3)
    after = arcLiveCount()
    expect(after - before).toEq(0)

  @it("bare str concatenation does not leak")
  fn bareStrConcatenationDoesNotLeak():
    before = arcLiveCount()
    "foo" + "bar"
    "x" + "y" + "z"
    after = arcLiveCount()
    expect(after - before).toEq(0)

  @it("4-arg chained str concatenation does not leak")
  fn n4ArgChainedStrConcatenationDoesNotLeak():
    before = arcLiveCount()
    "a" + "b" + "c" + "d"
    after = arcLiveCount()
    expect(after - before).toEq(0)

  @it("chained str concatenation in let-binding releases intermediates")
  fn chainedStrConcatenationInLetBindingReleasesIntermediates():
    before = arcLiveCount()
    s = "x" + "y" + "z"
    after = arcLiveCount()
    expect(after - before).toEq(1)
    expect(s).toEq("xyz")
