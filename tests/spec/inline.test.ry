@inline
function add(a: int, b: int) -> int:
  return a + b

@inline(mode="always")
function mul(a: int, b: int) -> int:
  return a * b

@inline(mode="hint")
function sub(a: int, b: int) -> int:
  return a - b

@inline(mode="never")
function negate(a: int) -> int:
  return -a

@inline
function fact(n: int) -> int:
  if n <= 1:
    return 1
  return n * fact(n - 1)

describe("@inline directive", function():
  it("default (always)", function():
    expect(add(3, 4)).to_eq(7)
  )
  it("mode=always", function():
    expect(mul(5, 6)).to_eq(30)
  )
  it("mode=hint", function():
    expect(sub(10, 3)).to_eq(7)
  )
  it("mode=never", function():
    expect(negate(-5)).to_eq(5)
  )
  it("recursive", function():
    expect(fact(5)).to_eq(120)
  )
)
