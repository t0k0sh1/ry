from ry.testing import it, describe, expect

@describe("env")
fn envTests():
  @it("should return some for existing var")
  fn shouldReturnSomeForExistingVar():
    result = env("PATH")
    expect(result).toBeSome()

  @it("should return none for non-existent var")
  fn shouldReturnNoneForNonExistentVar():
    result = env("RY_TEST_NONEXISTENT_VAR_XYZ")
    expect(result).toBeNone()

  @it("should return default for non-existent var")
  fn shouldReturnDefaultForNonExistentVar():
    result = env("RY_TEST_NONEXISTENT_VAR_XYZ", "fallback")
    expect(result).toEq("fallback")

  @it("should return value over default for existing var")
  fn shouldReturnValueOverDefaultForExistingVar():
    result = env("PATH", "fallback")
    expect(result).toNotEq("fallback")

  @it("should canonicalize RY_ENV when set")
  fn shouldCanonicalizeRyEnvWhenSet():
    ryEnv = env("RY_ENV")
    case ryEnv:
      Some(v):
        expect(v).toNotEq("production")
        expect(v).toNotEq("development")
      None:
        x = 0
