from testing import it, describe

from io import readText, writeText, appendText, exists, deleteFile, readBytes, writeBytes, toBytes

@describe("nul_safety_io")
fn nulSafetyIoTests():
  @describe("readText")
  fn readtextTests():
    @it("rejects NUL in path")
    fn rejectsNulInPath():
      case readText("/tmp/ry_nul_io\0bad.txt"):
        Ok(_): fail("expected Err but got Ok")
        Err(e): expect(e.message).toContain("embedded NUL")
    @it("normal path works")
    fn normalPathWorks():
      case writeText("/tmp/ry_nul_io_rt.txt", "hello"):
        Ok(_): 0
        Err(e): fail("unexpected write error: " + e.message)
      case readText("/tmp/ry_nul_io_rt.txt"):
        Ok(s): expect(s).toEq("hello")
        Err(e): fail("unexpected read error: " + e.message)
      deleteFile("/tmp/ry_nul_io_rt.txt")

  @describe("writeText")
  fn writetextTests():
    @it("rejects NUL in path")
    fn rejectsNulInPath2():
      case writeText("/tmp/ry_nul_io\0bad.txt", "x"):
        Ok(_): fail("expected Err but got Ok")
        Err(e): expect(e.message).toContain("embedded NUL")
    @it("round-trips content with embedded NUL bytes")
    fn roundTripsContentWithEmbeddedNulBytes():
      case writeText("/tmp/ry_nul_io_ct.txt", "a\0b"):
        Ok(_): 0
        Err(e): fail("writeText failed: " + e.message)
      case readText("/tmp/ry_nul_io_ct.txt"):
        Ok(s):
          expect(len(s)).toEq(3)
          expect(s == "a\0b").toEq(true)
        Err(e): fail("readText failed: " + e.message)
      case readBytes("/tmp/ry_nul_io_ct.txt"):
        Ok(bs): expect(len(bs)).toEq(3)
        Err(e): fail("readBytes failed: " + e.message)
      deleteFile("/tmp/ry_nul_io_ct.txt")

  @describe("appendText")
  fn appendtextTests():
    @it("rejects NUL in path")
    fn rejectsNulInPath3():
      case appendText("/tmp/ry_nul_io\0bad.txt", "x"):
        Ok(_): fail("expected Err but got Ok")
        Err(e): expect(e.message).toContain("embedded NUL")
    @it("round-trips content with embedded NUL bytes")
    fn roundTripsContentWithEmbeddedNulBytes2():
      case writeText("/tmp/ry_nul_io_at.txt", "hello"):
        Ok(_): 0
        Err(e): fail("writeText failed: " + e.message)
      case appendText("/tmp/ry_nul_io_at.txt", "x\0y"):
        Ok(_): 0
        Err(e): fail("appendText failed: " + e.message)
      case readText("/tmp/ry_nul_io_at.txt"):
        Ok(s):
          expect(len(s)).toEq(8)
          expect(s == "hellox\0y").toEq(true)
        Err(e): fail("readText failed: " + e.message)
      case readBytes("/tmp/ry_nul_io_at.txt"):
        Ok(bs): expect(len(bs)).toEq(8)
        Err(e): fail("readBytes failed: " + e.message)
      deleteFile("/tmp/ry_nul_io_at.txt")

  @describe("deleteFile")
  fn deletefileTests():
    @it("rejects NUL in path")
    fn rejectsNulInPath4():
      case deleteFile("/tmp/ry_nul_io\0bad.txt"):
        Ok(_): fail("expected Err but got Ok")
        Err(e): expect(e.message).toContain("embedded NUL")

  @describe("readBytes")
  fn readbytesTests():
    @it("rejects NUL in path")
    fn rejectsNulInPath5():
      case readBytes("/tmp/ry_nul_io\0bad.bin"):
        Ok(_): fail("expected Err but got Ok")
        Err(e): expect(e.message).toContain("embedded NUL")

  @describe("writeBytes")
  fn writebytesTests():
    @it("rejects NUL in path")
    fn rejectsNulInPath6():
      data = toBytes("x")
      case writeBytes("/tmp/ry_nul_io\0bad.bin", data):
        Ok(_): fail("expected Err but got Ok")
        Err(e): expect(e.message).toContain("embedded NUL")

  @describe("exists")
  fn existsTests():
    @it("returns false for path with embedded NUL")
    fn returnsFalseForPathWithEmbeddedNul():
      expect(exists("/tmp/ry_nul_io\0bad.txt")).toEq(false)
    @it("returns true for existing file, false after delete")
    fn returnsTrueForExistingFileFalseAfterDelete():
      case writeText("/tmp/ry_nul_io_ex.txt", "x"):
        Ok(_): 0
        Err(e): fail("unexpected error: " + e.message)
      expect(exists("/tmp/ry_nul_io_ex.txt")).toEq(true)
      deleteFile("/tmp/ry_nul_io_ex.txt")
      expect(exists("/tmp/ry_nul_io_ex.txt")).toEq(false)
