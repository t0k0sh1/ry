from ry.testing import it, describe, expect

from ry.io import writeText

@describe("partial import: writeText(path, content) only (regression for #1856)")
fn ioPartialImportWriteTextTests():
  @it("should write text to path with writeText-only import (JIT resolves __ry_io_write_text)")
  fn shouldWriteTextWithWriteTextOnlyImport():
    expect(writeText("/tmp/ry_partial_import_writetext_zzzz.txt", "regression test for #1856")).toBeOk()
