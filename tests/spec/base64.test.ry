from base64 import encode, decode, encode_url_safe, decode_url_safe

describe("base64", ():
  describe("encode", ():
    it("should encode basic string", ():
      expect(encode("Hello, World!")).to_eq("SGVsbG8sIFdvcmxkIQ==")
    )
    it("should encode empty string", ():
      expect(encode("")).to_eq("")
    )
    it("should encode single character", ():
      expect(encode("A")).to_eq("QQ==")
    )
    it("should encode two characters", ():
      expect(encode("AB")).to_eq("QUI=")
    )
    it("should encode three characters", ():
      expect(encode("ABC")).to_eq("QUJD")
    )
  )

  describe("decode", ():
    it("should decode basic string", ():
      case decode("SGVsbG8sIFdvcmxkIQ=="):
        Ok(s):
          expect(s).to_eq("Hello, World!")
        Err(e):
          fail("unexpected error: " + e.message)
    )
    it("should decode empty string", ():
      case decode(""):
        Ok(s):
          expect(s).to_eq("")
        Err(e):
          fail("unexpected error: " + e.message)
    )
    it("should decode with no padding", ():
      case decode("QUJD"):
        Ok(s):
          expect(s).to_eq("ABC")
        Err(e):
          fail("unexpected error: " + e.message)
    )
    it("should return error for invalid base64", ():
      case decode("!!!invalid!!!"):
        Ok(s):
          fail("expected error but got Ok")
        Err(e):
          expect(e.message).to_contain("invalid")
    )
  )

  describe("encode_url_safe", ():
    it("should encode basic string", ():
      expect(encode_url_safe("Hello, World!")).to_eq("SGVsbG8sIFdvcmxkIQ")
    )
    it("should use - and _ instead of + and /", ():
      # "?>>" encodes to "Pz4+" in standard, "Pz4-" in URL-safe
      std_encoded = encode("?>>")
      url_encoded = encode_url_safe("?>>")
      expect(contains(std_encoded, "+")).to_eq(true)
      expect(contains(url_encoded, "+")).to_eq(false)
      expect(contains(url_encoded, "/")).to_eq(false)
    )
  )

  describe("decode_url_safe", ():
    it("should roundtrip encode/decode url safe", ():
      original = "Hello, World! subjects?_d>>"
      encoded = encode_url_safe(original)
      case decode_url_safe(encoded):
        Ok(s):
          expect(s).to_eq(original)
        Err(e):
          fail("unexpected error: " + e.message)
    )
    it("should return error for invalid input", ():
      case decode_url_safe("!!!"):
        Ok(s):
          fail("expected error but got Ok")
        Err(e):
          expect(e.message).to_contain("invalid")
    )
  )

  describe("roundtrip", ():
    it("should roundtrip standard base64", ():
      original = "The quick brown fox jumps over the lazy dog"
      case decode(encode(original)):
        Ok(s):
          expect(s).to_eq(original)
        Err(e):
          fail("unexpected error: " + e.message)
    )
    it("should roundtrip longer string", ():
      original = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
      case decode(encode(original)):
        Ok(s):
          expect(s).to_eq(original)
        Err(e):
          fail("unexpected error: " + e.message)
    )
  )

  describe("NUL safety", ():
    it("encode processes all bytes including embedded NUL", ():
      # "A\0B" = [0x41, 0x00, 0x42] = 3 bytes → 4 base64 chars (no padding since 3%3==0)
      expect(encode("A\0B")).to_eq("QQBC")
    )
    it("encode has correct length for NUL-containing input", ():
      expect(encode("A\0B")).to_have_length(4)
    )
    it("encode_url_safe processes all bytes including embedded NUL", ():
      expect(encode_url_safe("A\0B")).to_eq("QQBC")
    )
    it("decode roundtrip preserves embedded NUL", ():
      original = "A\0B"
      case decode(encode(original)):
        Ok(d):
          expect(d == original).to_eq(true)
        Err(e):
          fail("unexpected error: " + e.message)
    )
    it("decode_url_safe roundtrip preserves embedded NUL", ():
      original = "A\0B"
      case decode_url_safe(encode_url_safe(original)):
        Ok(d):
          expect(d == original).to_eq(true)
        Err(e):
          fail("unexpected error: " + e.message)
    )
    it("decode rejects input containing embedded NUL", ():
      case decode("QQBC\0garbage"):
        Ok(s):
          fail("expected Err but got Ok")
        Err(e):
          expect(e.message).to_contain("invalid")
    )
  )
)
