from ry.testing import it, describe, expect, fail

from ry.base64 import encode, decode, encodeUrlSafe, decodeUrlSafe, encodeBytes, encodeBytesUrlSafe, decodeBytes, decodeBytesUrlSafe

@describe("base64")
fn base64Tests():
  @describe("encode")
  fn encodeTests():
    @it("should encode basic string")
    fn shouldEncodeBasicString():
      expect(encode("Hello, World!")).toEq("SGVsbG8sIFdvcmxkIQ==")
    @it("should encode empty string")
    fn shouldEncodeEmptyString():
      expect(encode("")).toEq("")
    @it("should encode single character")
    fn shouldEncodeSingleCharacter():
      expect(encode("A")).toEq("QQ==")
    @it("should encode two characters")
    fn shouldEncodeTwoCharacters():
      expect(encode("AB")).toEq("QUI=")
    @it("should encode three characters")
    fn shouldEncodeThreeCharacters():
      expect(encode("ABC")).toEq("QUJD")

  @describe("decode")
  fn decodeTests():
    @it("should decode basic string")
    fn shouldDecodeBasicString():
      case decode("SGVsbG8sIFdvcmxkIQ=="):
        Ok(s):
          expect(s).toEq("Hello, World!")
        Err(e):
          fail("unexpected error: " + e.message)
    @it("should decode empty string")
    fn shouldDecodeEmptyString():
      case decode(""):
        Ok(s):
          expect(s).toEq("")
        Err(e):
          fail("unexpected error: " + e.message)
    @it("should decode with no padding")
    fn shouldDecodeWithNoPadding():
      case decode("QUJD"):
        Ok(s):
          expect(s).toEq("ABC")
        Err(e):
          fail("unexpected error: " + e.message)
    @it("should return error for invalid base64")
    fn shouldReturnErrorForInvalidBase64():
      case decode("!!!invalid!!!"):
        Ok(s):
          fail("expected error but got Ok")
        Err(e):
          expect(e.message).toContain("invalid")

  @describe("encodeUrlSafe")
  fn encodeurlsafeTests():
    @it("should encode basic string")
    fn shouldEncodeBasicString2():
      expect(encodeUrlSafe("Hello, World!")).toEq("SGVsbG8sIFdvcmxkIQ")
    @it("should use - and _ instead of + and /")
    fn shouldUseAndInsteadOfAnd():
      # "?>>" encodes to "Pz4+" in standard, "Pz4-" in URL-safe
      stdEncoded = encode("?>>")
      urlEncoded = encodeUrlSafe("?>>")
      expect(contains(stdEncoded, "+")).toEq(true)
      expect(contains(urlEncoded, "+")).toEq(false)
      expect(contains(urlEncoded, "/")).toEq(false)

  @describe("decodeUrlSafe")
  fn decodeurlsafeTests():
    @it("should roundtrip encode/decode url safe")
    fn shouldRoundtripEncodeDecodeUrlSafe():
      original = "Hello, World! subjects?_d>>"
      encoded = encodeUrlSafe(original)
      case decodeUrlSafe(encoded):
        Ok(s):
          expect(s).toEq(original)
        Err(e):
          fail("unexpected error: " + e.message)
    @it("should return error for invalid input")
    fn shouldReturnErrorForInvalidInput():
      case decodeUrlSafe("!!!"):
        Ok(s):
          fail("expected error but got Ok")
        Err(e):
          expect(e.message).toContain("invalid")

  @describe("roundtrip")
  fn roundtripTests():
    @it("should roundtrip standard base64")
    fn shouldRoundtripStandardBase64():
      original = "The quick brown fox jumps over the lazy dog"
      case decode(encode(original)):
        Ok(s):
          expect(s).toEq(original)
        Err(e):
          fail("unexpected error: " + e.message)
    @it("should roundtrip longer string")
    fn shouldRoundtripLongerString():
      original = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
      case decode(encode(original)):
        Ok(s):
          expect(s).toEq(original)
        Err(e):
          fail("unexpected error: " + e.message)

  @describe("NUL safety")
  fn nulSafetyTests():
    @it("encode processes all bytes including embedded NUL")
    fn encodeProcessesAllBytesIncludingEmbeddedNul():
      # "A\0B" = [0x41, 0x00, 0x42] = 3 bytes → 4 base64 chars (no padding since 3%3==0)
      expect(encode("A\0B")).toEq("QQBC")
    @it("encode has correct length for NUL-containing input")
    fn encodeHasCorrectLengthForNulContainingInput():
      expect(encode("A\0B")).toHaveLen(4)
    @it("encodeUrlSafe processes all bytes including embedded NUL")
    fn encodeurlsafeProcessesAllBytesIncludingEmbeddedNul():
      expect(encodeUrlSafe("A\0B")).toEq("QQBC")
    @it("decode roundtrip preserves embedded NUL")
    fn decodeRoundtripPreservesEmbeddedNul():
      original = "A\0B"
      case decode(encode(original)):
        Ok(d):
          expect(d == original).toEq(true)
        Err(e):
          fail("unexpected error: " + e.message)
    @it("decodeUrlSafe roundtrip preserves embedded NUL")
    fn decodeurlsafeRoundtripPreservesEmbeddedNul():
      original = "A\0B"
      case decodeUrlSafe(encodeUrlSafe(original)):
        Ok(d):
          expect(d == original).toEq(true)
        Err(e):
          fail("unexpected error: " + e.message)
    @it("decode rejects input containing embedded NUL")
    fn decodeRejectsInputContainingEmbeddedNul():
      case decode("QQBC\0garbage"):
        Ok(s):
          fail("expected Err but got Ok")
        Err(e):
          expect(e.message).toContain("invalid")
    @it("decodeUrlSafe rejects input containing embedded NUL")
    fn decodeurlsafeRejectsInputContainingEmbeddedNul():
      case decodeUrlSafe("QQBC\0garbage"):
        Ok(s):
          fail("expected Err but got Ok")
        Err(e):
          expect(e.message).toContain("invalid")

  @describe("encodeBytes")
  fn encodebytesTests():
    @it("should encode known byte vector")
    fn shouldEncodeKnownByteVector():
      # [0x48, 0x69] = "Hi" -> "SGk="
      expect(encodeBytes([0x48u8, 0x69u8])).toEq("SGk=")
    @it("should encode JPEG magic bytes")
    fn shouldEncodeJpegMagicBytes():
      # [0xFF, 0xD8, 0xFF, 0xE0] -> "/9j/4A=="
      expect(encodeBytes([0xFFu8, 0xD8u8, 0xFFu8, 0xE0u8])).toEq("/9j/4A==")
    @it("should encode empty list")
    fn shouldEncodeEmptyList():
      empty: List<u8> = []
      expect(encodeBytes(empty)).toEq("")
    @it("should encode NUL-containing bytes")
    fn shouldEncodeNulContainingBytes():
      # [0x00, 0xFF, 0x00] -> "AP8A"
      expect(encodeBytes([0x00u8, 0xFFu8, 0x00u8])).toEq("AP8A")

  @describe("encodeBytesUrlSafe")
  fn encodebytesurlsafeTests():
    @it("should use - and _ instead of + and /")
    fn shouldUseAndInsteadOfAnd2():
      # [0xFB, 0xFF] -> standard "+/w=", url_safe "-_w"
      b = [0xFBu8, 0xFFu8]
      stdEnc = encodeBytes(b)
      urlEnc = encodeBytesUrlSafe(b)
      expect(contains(stdEnc, "+")).toEq(true)
      expect(contains(urlEnc, "+")).toEq(false)
      expect(contains(urlEnc, "/")).toEq(false)
      expect(contains(urlEnc, "=")).toEq(false)
    @it("should encode empty list")
    fn shouldEncodeEmptyList2():
      empty: List<u8> = []
      expect(encodeBytesUrlSafe(empty)).toEq("")

  @describe("decodeBytes")
  fn decodebytesTests():
    @it("should decode to known bytes")
    fn shouldDecodeToKnownBytes():
      case decodeBytes("SGk="):
        Ok(b):
          expect(b).toEq([0x48u8, 0x69u8])
        Err(e):
          fail("unexpected error: " + e.message)
    @it("should decode NUL-containing bytes")
    fn shouldDecodeNulContainingBytes():
      case decodeBytes("AP8A"):
        Ok(b):
          expect(b).toEq([0x00u8, 0xFFu8, 0x00u8])
        Err(e):
          fail("unexpected error: " + e.message)
    @it("should decode empty string")
    fn shouldDecodeEmptyString2():
      case decodeBytes(""):
        Ok(b):
          empty: List<u8> = []
          expect(b).toEq(empty)
        Err(e):
          fail("unexpected error: " + e.message)
    @it("should return error for invalid base64")
    fn shouldReturnErrorForInvalidBase642():
      case decodeBytes("!!!"):
        Ok(b):
          fail("expected error but got Ok")
        Err(e):
          expect(e.message).toContain("invalid")

  @describe("decodeBytesUrlSafe")
  fn decodebytesurlsafeTests():
    @it("should decode url_safe encoded bytes")
    fn shouldDecodeUrlSafeEncodedBytes():
      # "-_8" is the URL-safe base64 encoding of [0xFB, 0xFF]
      case decodeBytesUrlSafe("-_8"):
        Ok(b):
          expect(b).toEq([0xFBu8, 0xFFu8])
        Err(e):
          fail("unexpected error: " + e.message)
    @it("should return error for invalid input")
    fn shouldReturnErrorForInvalidInput2():
      case decodeBytesUrlSafe("!!!"):
        Ok(b):
          fail("expected error but got Ok")
        Err(e):
          expect(e.message).toContain("invalid")

  @describe("bytes roundtrip")
  fn bytesRoundtripTests():
    @it("should roundtrip binary bytes through standard base64")
    fn shouldRoundtripBinaryBytesThroughStandardBase64():
      original: List<u8> = [0x00u8, 0x01u8, 0x7Fu8, 0x80u8, 0xFFu8]
      encoded = encodeBytes(original)
      case decodeBytes(encoded):
        Ok(b):
          expect(b).toEq(original)
        Err(e):
          fail("unexpected error: " + e.message)
    @it("should roundtrip binary bytes through url_safe base64")
    fn shouldRoundtripBinaryBytesThroughUrlSafeBase64():
      original: List<u8> = [0xFBu8, 0xFFu8, 0x00u8, 0x01u8]
      encoded = encodeBytesUrlSafe(original)
      case decodeBytesUrlSafe(encoded):
        Ok(b):
          expect(b).toEq(original)
        Err(e):
          fail("unexpected error: " + e.message)

  @describe("strict padding validation (#1594)")
  fn strictPaddingValidation1594Tests():
    @describe("decode rejects pure-padding inputs")
    fn decodeRejectsPurePaddingInputsTests():
      @it("rejects '====' (excess padding, no data)")
      fn rejectsExcessPaddingNoData():
        case decode("===="):
          Ok(s): fail("expected Err but got Ok")
          Err(e): expect(e.message).toContain("invalid")
      @it("rejects '===' (excess padding)")
      fn rejectsExcessPadding():
        case decode("==="):
          Ok(s): fail("expected Err but got Ok")
          Err(e): expect(e.message).toContain("invalid")
      @it("rejects '==' (padding only, len % 4 != 0)")
      fn rejectsPaddingOnlyLen40():
        case decode("=="):
          Ok(s): fail("expected Err but got Ok")
          Err(e): expect(e.message).toContain("invalid")
      @it("rejects '=' (padding only, len % 4 != 0)")
      fn rejectsPaddingOnlyLen402():
        case decode("="):
          Ok(s): fail("expected Err but got Ok")
          Err(e): expect(e.message).toContain("invalid")

    @describe("decode rejects trailing-padding overflow")
    fn decodeRejectsTrailingPaddingOverflowTests():
      @it("rejects 'TWFu=' (len % 4 == 1)")
      fn rejectsTwfuLen41():
        case decode("TWFu="):
          Ok(s): fail("expected Err but got Ok with value: " + s)
          Err(e): expect(e.message).toContain("invalid")
      @it("rejects 'TWFu==' (len % 4 == 2)")
      fn rejectsTwfuLen42():
        case decode("TWFu=="):
          Ok(s): fail("expected Err but got Ok with value: " + s)
          Err(e): expect(e.message).toContain("invalid")
      @it("rejects 'TWFu===' (excess padding)")
      fn rejectsTwfuExcessPadding():
        case decode("TWFu==="):
          Ok(s): fail("expected Err but got Ok with value: " + s)
          Err(e): expect(e.message).toContain("invalid")

    @describe("decodeBytes rejects invalid padding")
    fn decodebytesRejectsInvalidPaddingTests():
      @it("rejects '====' for decodeBytes")
      fn rejectsForDecodebytes():
        case decodeBytes("===="):
          Ok(b): fail("expected Err but got Ok")
          Err(e): expect(e.message).toContain("invalid")
      @it("rejects 'TWFu=' for decodeBytes")
      fn rejectsTwfuForDecodebytes():
        case decodeBytes("TWFu="):
          Ok(b): fail("expected Err but got Ok")
          Err(e): expect(e.message).toContain("invalid")

    @describe("decodeUrlSafe shares strict validation when padding present")
    fn decodeurlsafeSharesStrictValidationWhenPaddingPresentTests():
      @it("rejects '====' for decodeUrlSafe")
      fn rejectsForDecodeurlsafe():
        case decodeUrlSafe("===="):
          Ok(s): fail("expected Err but got Ok")
          Err(e): expect(e.message).toContain("invalid")
      @it("rejects 'TWFu=' for decodeUrlSafe")
      fn rejectsTwfuForDecodeurlsafe():
        case decodeUrlSafe("TWFu="):
          Ok(s): fail("expected Err but got Ok with value: " + s)
          Err(e): expect(e.message).toContain("invalid")
      @it("rejects '====' for decodeBytesUrlSafe")
      fn rejectsForDecodebytesurlsafe():
        case decodeBytesUrlSafe("===="):
          Ok(b): fail("expected Err but got Ok")
          Err(e): expect(e.message).toContain("invalid")

    @describe("regression: existing valid inputs still decode")
    fn regressionExistingValidInputsStillDecodeTests():
      @it("decode of input with valid padding still works")
      fn decodeOfInputWithValidPaddingStillWorks():
        case decode("SGVsbG8sIFdvcmxkIQ=="):
          Ok(s): expect(s).toEq("Hello, World!")
          Err(e): fail("regression: expected Ok, got Err: " + e.message)
      @it("decode of input without padding still works")
      fn decodeOfInputWithoutPaddingStillWorks():
        case decode("QUJD"):
          Ok(s): expect(s).toEq("ABC")
          Err(e): fail("regression: expected Ok, got Err: " + e.message)
      @it("decodeUrlSafe of canonical no-padding input still works")
      fn decodeurlsafeOfCanonicalNoPaddingInputStillWorks():
        case decodeUrlSafe("SGVsbG8sIFdvcmxkIQ"):
          Ok(s): expect(s).toEq("Hello, World!")
          Err(e): fail("regression: expected Ok, got Err: " + e.message)
