from ry.testing import it, describe, expect

enum Color:
  Red
  Green
  Blue

enum Shape:
  Circle(float)
  Rect(float, float)
  Point

@describe("enum return value preserves type metadata (#820)")
fn enumReturnValuePreservesTypeMetadata820Tests():
  @it("should print simple enum variant name when returned inline")
  fn shouldPrintSimpleEnumVariantNameWhenReturnedInline():
    fn getColor() -> Color:
      return Color::Red
    expect(str(getColor())).toEq("Red")

  @it("should print simple enum variant name when returned via local variable")
  fn shouldPrintSimpleEnumVariantNameWhenReturnedViaLocalVariable():
    fn getColor() -> Color:
      return Color::Green
    c = getColor()
    expect(str(c)).toEq("Green")

  @it("should print simple enum in f-string interpolation")
  fn shouldPrintSimpleEnumInFStringInterpolation():
    fn getColor() -> Color:
      return Color::Blue
    expect(f"color: {getColor()}").toEq("color: Blue")

  @it("should print ADT enum variant with payload when returned inline")
  fn shouldPrintAdtEnumVariantWithPayloadWhenReturnedInline():
    fn makeCircle() -> Shape:
      return Shape::Circle(3.14)
    expect(str(makeCircle())).toEq("Circle(3.14)")

  @it("should print ADT enum variant with payload when returned via local variable")
  fn shouldPrintAdtEnumVariantWithPayloadWhenReturnedViaLocalVariable():
    fn makeRect() -> Shape:
      return Shape::Rect(3.0, 4.0)
    s = makeRect()
    expect(str(s)).toEq("Rect(3.0, 4.0)")

  @it("should print ADT enum variant without payload when returned from function")
  fn shouldPrintAdtEnumVariantWithoutPayloadWhenReturnedFromFunction():
    fn makePoint() -> Shape:
      return Shape::Point
    expect(str(makePoint())).toEq("Point")

  @it("should match ADT enum returned from user function (regression guard)")
  fn shouldMatchAdtEnumReturnedFromUserFunctionRegressionGuard():
    fn makeCircle() -> Shape:
      return Shape::Circle(5.0)
    case makeCircle():
      Shape::Circle(r):
        expect(r).toEq(5.0)
      _:
        expect(false).toEq(true)

  @it("should propagate enum metadata through a wrapper function call chain")
  fn shouldPropagateEnumMetadataThroughAWrapperFunctionCallChain():
    fn inner() -> Color:
      return Color::Red
    fn outer() -> Color:
      return inner()
    expect(str(outer())).toEq("Red")

  @it("should print simple enum stored in list after function return")
  fn shouldPrintSimpleEnumStoredInListAfterFunctionReturn():
    fn getColor() -> Color:
      return Color::Green
    xs: List<Color> = [getColor(), Color::Red]
    expect(str(xs)).toEq("[Green, Red]")

  @it("should propagate enum metadata through a type alias in return position")
  fn shouldPropagateEnumMetadataThroughATypeAliasInReturnPosition():
    # PR #853 review: type aliases need resolution before enum lookup
    type ColorAlias = Color
    fn getAlias() -> ColorAlias:
      return Color::Red
    expect(str(getAlias())).toEq("Red")

  @it("should still print Option<int> from function (regression guard)")
  fn shouldStillPrintOptionIntFromFunctionRegressionGuard():
    fn makeSome() -> Option<int>:
      return Some(42)
    expect(str(makeSome())).toEq("Some(42)")

  @it("should still print Result<int, Error> from function (regression guard)")
  fn shouldStillPrintResultIntErrorFromFunctionRegressionGuard():
    fn makeOk() -> Result<int, Error>:
      return Ok(7)
    expect(str(makeOk())).toEq("Ok(7)")
