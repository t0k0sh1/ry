from testing import it, describe

fn makeListOpt(v: List<int>) -> List<int>?:
  return Some(v)

fn makeMapOpt(v: Map<str, int>) -> Map<str, int>?:
  return Some(v)

fn makeSetOpt(v: Set<int>) -> Set<int>?:
  return Some(v)

fn makeListNone() -> List<int>?:
  return None

@describe("T? shorthand return type — metadata propagation (#1003)")
fn tShorthandReturnTypeMetadataPropagation1003Tests():
  @it("List<int>? — len() reflects actual element count")
  fn listIntLenReflectsActualElementCount():
    opt = makeListOpt([7, 8, 9])
    case opt:
      Some(xs):
        expect(xs.len()).toEq(3)
      None:
        fail("unexpected None")

  @it("List<int>? — index access works")
  fn listIntIndexAccessWorks():
    opt = makeListOpt([7, 8, 9])
    case opt:
      Some(xs):
        expect(xs[0]).toEq(7)
        expect(xs[1]).toEq(8)
        expect(xs[2]).toEq(9)
      None:
        fail("unexpected None")

  @it("List<int>? — equality: same contents → true")
  fn listIntEqualitySameContentsTrue():
    a = makeListOpt([1, 2, 3])
    b = makeListOpt([1, 2, 3])
    expect(a == b).toBeTrue()

  @it("List<int>? — equality: different contents → false")
  fn listIntEqualityDifferentContentsFalse():
    a = makeListOpt([1, 2])
    b = makeListOpt([9, 9])
    expect(a == b).toBeFalse()

  @it("List<int>? — equality: Some vs None → false")
  fn listIntEqualitySomeVsNoneFalse():
    a = makeListOpt([1, 2])
    b = makeListNone()
    expect(a == b).toBeFalse()

  @it("Map<str,int>? — key lookup works")
  fn mapStrIntKeyLookupWorks():
    opt = makeMapOpt({"x": 42, "y": 7})
    case opt:
      Some(m):
        expect(m["x"]).toEq(42)
        expect(m["y"]).toEq(7)
      None:
        fail("unexpected None")

  @it("Set<int>? — len() and contains() work")
  fn setIntLenAndContainsWork():
    opt = makeSetOpt({10, 20, 30})
    case opt:
      Some(s):
        expect(s.len()).toEq(3)
        expect(s.contains(10)).toBeTrue()
        expect(s.contains(99)).toBeFalse()
      None:
        fail("unexpected None")
