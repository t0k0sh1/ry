from testing import it, describe, expect

record Point:
  x: int
  y: int

record Circle:
  center: Point
  radius: float

@describe("record")
fn recordTests():
  @it("should construct and access fields")
  fn shouldConstructAndAccessFields():
    p = Point(10, 20)
    expect(p.x).toEq(10)
    expect(p.y).toEq(20)
  @it("should assign to var field")
  fn shouldAssignToVarField():
    p = Point(10, 20)
    p.x = 100
    expect(p.x).toEq(100)
  @it("should support nested record")
  fn shouldSupportNestedRecord():
    c = Circle(Point(0, 0), 1.0)
    expect(c.center.x).toEq(0)
    expect(c.center.y).toEq(0)
    expect(c.radius).toEq(1.0)

@describe("record str")
fn recordTostrTests():
  @it("should generate auto str")
  fn shouldGenerateAutoTostr():
    p = Point(10, 20)
    expect(str(p)).toEq("Point(x: 10, y: 20)")
  @it("should interpolate record in f-string")
  fn shouldInterpolateRecordInFString():
    p = Point(3, 4)
    expect(f"{p}").toEq("Point(x: 3, y: 4)")
  @it("should convert nested record to string")
  fn shouldConvertNestedRecordToString():
    c = Circle(Point(1, 2), 3.14)
    expect(str(c)).toEq("Circle(center: Point(x: 1, y: 2), radius: 3.14)")
  @it("should override auto-generated str with user-defined")
  fn shouldOverrideAutoGeneratedTostrWithUserDefined():
    fn str(p: Point) -> str:
      return f"({p.x}, {p.y})"
    p = Point(5, 6)
    expect(str(p)).toEq("(5, 6)")
  @it("should convert string field to string")
  fn shouldConvertStringFieldToString():
    record Person:
      name: str
      age: int
    p = Person("Alice", 30)
    expected = "Person(name: " + "\"Alice\"" + ", age: 30)"
    expect(str(p)).toEq(expected)

record Mixed:
  name: str
  value: int
  rate: float
  active: bool

record AlwaysEqual:
  x: int

fn operator==(a: AlwaysEqual, b: AlwaysEqual) -> bool:
  return true

@describe("record equality")
fn recordEqualityTests():
  @it("should be equal with zero fields")
  fn shouldBeEqualWithZeroFields():
    expect(Point(0, 0) == Point(0, 0)).toBeTrue()
  @it("should be equal when fields match")
  fn shouldBeEqualWhenFieldsMatch():
    expect(Point(1, 2) == Point(1, 2)).toBeTrue()
  @it("should be unequal when fields differ")
  fn shouldBeUnequalWhenFieldsDiffer():
    expect(Point(1, 2) == Point(3, 4)).toBeFalse()
  @it("should support != operator")
  fn shouldSupportOperator():
    expect(Point(1, 2) != Point(3, 4)).toBeTrue()
    expect(Point(1, 2) != Point(1, 2)).toBeFalse()
  @it("should compare records with mixed field types")
  fn shouldCompareRecordsWithMixedFieldTypes():
    a = Mixed("hello", 42, 3.14, true)
    b = Mixed("hello", 42, 3.14, true)
    c = Mixed("world", 42, 3.14, true)
    expect(a == b).toBeTrue()
    expect(a != c).toBeTrue()
  @it("should compare nested records for equality")
  fn shouldCompareNestedRecordsForEquality():
    c1 = Circle(Point(0, 0), 1.0)
    c2 = Circle(Point(0, 0), 1.0)
    c3 = Circle(Point(1, 0), 1.0)
    expect(c1 == c2).toBeTrue()
    expect(c1 != c3).toBeTrue()
  @it("should use user-defined operator== over auto-generated")
  fn shouldUseUserDefinedOperatorOverAutoGenerated():
    # AlwaysEqual always returns true regardless of field values
    expect(AlwaysEqual(1) == AlwaysEqual(2)).toBeTrue()

enum Color:
  Red
  Green
  Blue

@describe("simple enum")
fn simpleEnumTests():
  @it("should access variant")
  fn shouldAccessVariant():
    c = Color::Red
    expect(c == Color::Red).toBeTrue()
  @it("should compare variants")
  fn shouldCompareVariants():
    expect(Color::Red == Color::Red).toBeTrue()
    expect(Color::Red != Color::Green).toBeTrue()
  @it("should match variant with when")
  fn shouldMatchVariantWithWhen():
    res = ""
    c = Color::Blue
    case c:
      Color::Red:
        res = "red"
      Color::Green:
        res = "green"
      Color::Blue:
        res = "blue"
    expect(res).toEq("blue")
  @it("should show variant name in str")
  fn shouldShowVariantNameInTostr():
    expect(str(Color::Red)).toEq("Red")
    expect(str(Color::Green)).toEq("Green")
    expect(str(Color::Blue)).toEq("Blue")

enum Shape:
  CircleS(float)
  RectS(float, float)
  PointS

@describe("ADT enum")
fn adtEnumTests():
  @it("should support associated data")
  fn shouldSupportAssociatedData():
    s = Shape::CircleS(3.14)
    res = 0.0
    case s:
      Shape::CircleS(r):
        res = r
      Shape::RectS(w, h):
        res = w * h
      Shape::PointS:
        res = 0.0
    expect(res).toEq(3.14)
  @it("should support multi-field pattern match")
  fn shouldSupportMultiFieldPatternMatch():
    s = Shape::RectS(4.0, 5.0)
    res = 0.0
    case s:
      Shape::CircleS(r):
        res = r
      Shape::RectS(w, h):
        res = w * h
      Shape::PointS:
        res = 0.0
    expect(res).toEq(20.0)

enum NamedShape:
  Circle(radius: float)
  Rect(width: float, height: float)
  Point

@describe("ADT enum with named fields")
fn adtEnumWithNamedFieldsTests():
  @it("should construct positionally with named fields")
  fn shouldConstructPositionallyWithNamedFields():
    s = NamedShape::Circle(3.14)
    res = 0.0
    case s:
      NamedShape::Circle(r):
        res = r
      NamedShape::Rect(w, h):
        res = w * h
      NamedShape::Point:
        res = 0.0
    expect(res).toEq(3.14)
  @it("should support multi-field named variant")
  fn shouldSupportMultiFieldNamedVariant():
    s = NamedShape::Rect(4.0, 5.0)
    res = 0.0
    case s:
      NamedShape::Circle(r):
        res = r
      NamedShape::Rect(w, h):
        res = w * h
      NamedShape::Point:
        res = 0.0
    expect(res).toEq(20.0)

enum HttpStatus:
  Ok = 200
  NotFound = 404
  InternalError = 500

enum Permission:
  Read = 1
  Write = 2
  Execute = 4

@describe("explicit enum values")
fn explicitEnumValuesTests():
  @it("should access variant with explicit value")
  fn shouldAccessVariantWithExplicitValue():
    s = HttpStatus::Ok
    expect(s == HttpStatus::Ok).toBeTrue()
  @it("should compare variants with explicit values")
  fn shouldCompareVariantsWithExplicitValues():
    expect(HttpStatus::Ok == HttpStatus::Ok).toBeTrue()
    expect(HttpStatus::Ok != HttpStatus::NotFound).toBeTrue()
  @it("should match with explicit values in when")
  fn shouldMatchWithExplicitValuesInWhen():
    res = ""
    s = HttpStatus::NotFound
    case s:
      HttpStatus::Ok:
        res = "ok"
      HttpStatus::NotFound:
        res = "not found"
      HttpStatus::InternalError:
        res = "error"
    expect(res).toEq("not found")
  @it("should show variant name when printing")
  fn shouldShowVariantNameWhenPrinting():
    s = HttpStatus::Ok
    expect(str(s)).toEq("Ok")
  @it("should support bitmask-style values")
  fn shouldSupportBitmaskStyleValues():
    p = Permission::Execute
    expect(p == Permission::Execute).toBeTrue()
    expect(p != Permission::Read).toBeTrue()

enum Wrapper:
  IntVal(int)
  StrVal(str)

@describe("ADT enum equality")
fn adtEnumEqualityTests():
  @it("same tag same payload → equal")
  fn sameTagSamePayloadEqual():
    expect(Shape::CircleS(1.0) == Shape::CircleS(1.0)).toBeTrue()
  @it("same tag different payload → not equal")
  fn sameTagDifferentPayloadNotEqual():
    expect(Shape::CircleS(1.0) == Shape::CircleS(2.0)).toBeFalse()
  @it("different tag → not equal")
  fn differentTagNotEqual():
    expect(Shape::CircleS(1.0) == Shape::PointS).toBeFalse()
    expect(Shape::PointS == Shape::CircleS(0.0)).toBeFalse()
  @it("no-payload variant → tag equality")
  fn noPayloadVariantTagEquality():
    expect(Shape::PointS == Shape::PointS).toBeTrue()
    expect(Shape::PointS != Shape::PointS).toBeFalse()
  @it("multi-field variant field-by-field")
  fn multiFieldVariantFieldByField():
    expect(Shape::RectS(1.0, 2.0) == Shape::RectS(1.0, 2.0)).toBeTrue()
    expect(Shape::RectS(1.0, 2.0) == Shape::RectS(1.0, 3.0)).toBeFalse()
    expect(Shape::RectS(1.0, 2.0) != Shape::RectS(1.0, 3.0)).toBeTrue()
  @it("pointer-typed (str) payload equality")
  fn pointerTypedStrPayloadEquality():
    expect(Wrapper::StrVal("hello") == Wrapper::StrVal("hello")).toBeTrue()
    expect(Wrapper::StrVal("hello") == Wrapper::StrVal("world")).toBeFalse()
  @it("int payload != operator")
  fn intPayloadOperator():
    expect(Wrapper::IntVal(1) != Wrapper::IntVal(2)).toBeTrue()
    expect(Wrapper::IntVal(1) != Wrapper::IntVal(1)).toBeFalse()

enum MyOption<T>:
  MySome(T)
  MyNone

@describe("ADT enum equality — generic")
fn adtEnumEqualityGenericTests():
  @it("generic same payload → equal")
  fn genericSamePayloadEqual():
    expect(MyOption<int>::MySome(42) == MyOption<int>::MySome(42)).toBeTrue()
  @it("generic different payload → not equal")
  fn genericDifferentPayloadNotEqual():
    expect(MyOption<int>::MySome(1) == MyOption<int>::MySome(2)).toBeFalse()
  @it("MySome vs MyNone → not equal")
  fn mysomeVsMynoneNotEqual():
    expect(MyOption<int>::MySome(1) == MyOption<int>::MyNone).toBeFalse()

@describe("generic enum")
fn genericEnumTests():
  @it("should support generic enum with type parameter")
  fn shouldSupportGenericEnumWithTypeParameter():
    a = MyOption<int>::MySome(42)
    res = 0
    case a:
      MyOption::MySome(v):
        res = v
      MyOption::MyNone:
        res = -1
    expect(res).toEq(42)
  @it("should support none variant in generic enum")
  fn shouldSupportNoneVariantInGenericEnum():
    b = MyOption<int>::MyNone
    res = 0
    case b:
      MyOption::MySome(v):
        res = v
      MyOption::MyNone:
        res = -1
    expect(res).toEq(-1)

record UserWithAvatar:
  name: str
  avatar: Option<str>

record MixOptInt:
  id: int
  opt: Option<str>

record OptIntField:
  count: Option<int>

record Outer:
  inner: Option<UserWithAvatar>

record BaseWithOpt:
  avatar: Option<str>

record SubWithOpt < BaseWithOpt:
  name: str

@describe("None()/none in record constructor field positions (#1186)")
fn noneNoneInRecordConstructorFieldPositions1186Tests():
  @it("None() in Option<str> field adopts correct inner")
  fn noneInOptionStrFieldAdoptsCorrectInner():
    u = UserWithAvatar("alice", None())
    expect(u.avatar).toBeNone()
  @it("bare none in Option<str> field adopts correct inner")
  fn bareNoneInOptionStrFieldAdoptsCorrectInner():
    u = UserWithAvatar("alice", none)
    expect(u.avatar).toBeNone()
  @it("Some(...) still works alongside None() support")
  fn someStillWorksAlongsideNoneSupport():
    u = UserWithAvatar("bob", Some("face.png"))
    expect(u.avatar).toBeSome()
  @it("None() in non-first position uses correct field index")
  fn noneInNonFirstPositionUsesCorrectFieldIndex():
    m = MixOptInt(42, None())
    expect(m.id).toEq(42)
    expect(m.opt).toBeNone()
  @it("Option<int> inner differs from Option<str>")
  fn optionIntInnerDiffersFromOptionStr():
    o = OptIntField(None())
    expect(o.count).toBeNone()
  @it("inline-nested: inner record's None() uses inner field hint (not outer's)")
  fn inlineNestedInnerRecordSNoneUsesInnerFieldHintNotOuterS():
    # Exercises RAII shadow/restore: Outer's field hint (UserWithAvatar) must be
    # shadowed by UserWithAvatar's own per-field loop when emitting the inner
    # constructor. Without the shadow, None() would get inner = UserWithAvatar
    # and fail the field-type check against Option<str>.
    u = Outer(Some(UserWithAvatar("carol", None())))
    case u.inner:
      Some(user):
        expect(user.avatar).toBeNone()
        expect(user.name).toEq("carol")
      None:
        expect(false).toBeTrue()
  @it("inherited Option<str> field receives hint via pre-flattened fields")
  fn inheritedOptionStrFieldReceivesHintViaPreFlattenedFields():
    s = SubWithOpt(None(), "dave")
    expect(s.avatar).toBeNone()
    expect(s.name).toEq("dave")
  @it("non-Option fields are not affected (regression guard)")
  fn nonOptionFieldsAreNotAffectedRegressionGuard():
    p = Point(10, 20)
    expect(p.x).toEq(10)
    expect(p.y).toEq(20)
