enum MyOpt<T>:
  MySome(T)
  MyNone

function unwrap_or_int(opt: MyOpt<int>, default: int) -> int:
  res = default
  case opt:
    MyOpt::MySome(v):
      res = v
    MyOpt::MyNone:
      res = default
  return res

function unwrap_or_str(opt: MyOpt<str>, default: str) -> str:
  res = default
  case opt:
    MyOpt::MySome(v):
      res = v
    MyOpt::MyNone:
      res = default
  return res

function take_opt_return_opt(opt: MyOpt<int>) -> MyOpt<int>:
  return opt

function unwrap_or<T>(opt: MyOpt<T>, default: T) -> T:
  case opt:
    MyOpt::MySome(v):
      return v
    MyOpt::MyNone:
      return default
  return default

describe("generic enum as explicit fn param type", ():
  it("unwrap_or_int with Some", ():
    expect(unwrap_or_int(MyOpt<int>::MySome(42), 0)).to_eq(42)
  )
  it("unwrap_or_int with None", ():
    expect(unwrap_or_int(MyOpt<int>::MyNone, 99)).to_eq(99)
  )
  it("unwrap_or_str with Some", ():
    expect(unwrap_or_str(MyOpt<str>::MySome("hi"), "fallback")).to_eq("hi")
  )
  it("unwrap_or_str with None", ():
    expect(unwrap_or_str(MyOpt<str>::MyNone, "fallback")).to_eq("fallback")
  )
  it("generic enum as return type round-trip", ():
    a = MyOpt<int>::MySome(7)
    r = take_opt_return_opt(a)
    res = 0
    case r:
      MyOpt::MySome(v):
        res = v
      MyOpt::MyNone:
        res = -1
    expect(res).to_eq(7)
  )
)

describe("generic enum as param type inside generic fn", ():
  it("unwrap_or<int> with Some", ():
    expect(unwrap_or[int](MyOpt<int>::MySome(5), 0)).to_eq(5)
  )
  it("unwrap_or<int> with None", ():
    expect(unwrap_or[int](MyOpt<int>::MyNone, 11)).to_eq(11)
  )
  it("unwrap_or<str> with Some", ():
    expect(unwrap_or[str](MyOpt<str>::MySome("hello"), "x")).to_eq("hello")
  )
  it("unwrap_or<str> with None", ():
    expect(unwrap_or[str](MyOpt<str>::MyNone, "fallback")).to_eq("fallback")
  )
)

describe("generic enum as let-binding type annotation", ():
  it("let binding MyOpt<int>", ():
    o: MyOpt<int> = MyOpt<int>::MySome(3)
    res = 0
    case o:
      MyOpt::MySome(v):
        res = v
      MyOpt::MyNone:
        res = -1
    expect(res).to_eq(3)
  )
)
