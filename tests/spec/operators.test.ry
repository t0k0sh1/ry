describe("arithmetic"):
    it("addition"):
        expect(1 + 2).to_eq(3)

    it("subtraction"):
        expect(5 - 3).to_eq(2)

    it("multiplication"):
        expect(4 * 3).to_eq(12)

    it("division returns float"):
        expect(7 / 2).to_eq(3.5)

    it("integer division"):
        expect(7 // 2).to_eq(3)

    it("modulo"):
        expect(7 % 3).to_eq(1)

    it("exponentiation"):
        expect(2 ** 10).to_eq(1024.0)

describe("unary"):
    it("unary minus"):
        expect(-5).to_eq(-5)

    it("unary plus"):
        expect(+5).to_eq(5)

describe("string operators"):
    it("concatenation"):
        expect("foo" + "bar").to_eq("foobar")

    it("repetition"):
        expect("ab" * 3).to_eq("ababab")

describe("comparison"):
    it("equal"):
        expect(1 == 1).to_be_true()

    it("not equal"):
        expect(1 != 2).to_be_true()

    it("less than"):
        expect(1).to_be_less_than(2)

    it("less than or equal"):
        expect(2).to_be_less_than_or_eq(2)

    it("greater than"):
        expect(3).to_be_greater_than(2)

    it("greater than or equal"):
        expect(3).to_be_greater_than_or_eq(3)

    it("string comparison"):
        expect("abc" < "abd").to_be_true()

describe("logical"):
    it("and true"):
        expect(true and true).to_be_true()

    it("and false"):
        expect(true and false).to_be_false()

    it("or true"):
        expect(false or true).to_be_true()

    it("or false"):
        expect(false or false).to_be_false()

    it("not"):
        expect(not true).to_be_false()

fn side_effect_flag() -> bool:
    return true

describe("short-circuit evaluation"):
    it("and short-circuits on false"):
        mock(side_effect_flag, fn(): true)
        let r = false and side_effect_flag()
        expect(r).to_be_false()
        expect(verify(side_effect_flag)).to_eq(0)

    it("or short-circuits on true"):
        mock(side_effect_flag, fn(): false)
        let r = true or side_effect_flag()
        expect(r).to_be_true()
        expect(verify(side_effect_flag)).to_eq(0)

describe("bitwise"):
    it("AND"):
        expect(0b1100 & 0b1010).to_eq(0b1000)

    it("OR"):
        expect(0b1100 | 0b1010).to_eq(0b1110)

    it("XOR"):
        expect(0b1100 ^ 0b1010).to_eq(0b0110)

    it("NOT"):
        expect(~0).to_eq(-1)

    it("left shift"):
        expect(1 << 4).to_eq(16)

    it("arithmetic right shift"):
        expect(16 >> 2).to_eq(4)

    it("logical right shift"):
        expect(-1 >>> 1).to_eq(9223372036854775807)

describe("ternary"):
    it("true branch"):
        expect(true ? 10 : 20).to_eq(10)

    it("false branch"):
        expect(false ? 10 : 20).to_eq(20)

describe("null coalescing"):
    it("Some value"):
        let a: int? = Some(10)
        expect(a ?? 0).to_eq(10)

    it("None value"):
        let b: int? = none
        expect(b ?? 0).to_eq(0)

describe("compound assignment"):
    it("+="):
        var x = 10
        x += 5
        expect(x).to_eq(15)

    it("-="):
        var x = 10
        x -= 3
        expect(x).to_eq(7)

    it("*="):
        var x = 4
        x *= 3
        expect(x).to_eq(12)

    it("//="):
        var x = 10
        x //= 3
        expect(x).to_eq(3)

    it("%="):
        var x = 10
        x %= 3
        expect(x).to_eq(1)

    it("&="):
        var x = 0b1100
        x &= 0b1010
        expect(x).to_eq(0b1000)

    it("|="):
        var x = 0b1100
        x |= 0b0011
        expect(x).to_eq(0b1111)

    it("^="):
        var x = 0b1100
        x ^= 0b1010
        expect(x).to_eq(0b0110)

    it("<<="):
        var x = 1
        x <<= 4
        expect(x).to_eq(16)

    it(">>="):
        var x = 16
        x >>= 2
        expect(x).to_eq(4)

describe("membership"):
    it("in Set"):
        let s = {1, 2, 3}
        expect(s).to_contain(2)

    it("not in Set"):
        let s = {1, 2, 3}
        expect(s).to_not_contain(4)

    it("in List"):
        let xs = [1, 2, 3]
        expect(xs).to_contain(2)

    it("not in List"):
        let xs = [1, 2, 3]
        expect(xs).to_not_contain(4)

    it("in Map"):
        let m = {"a": 1}
        expect(m).to_contain("a")

    it("not in Map"):
        let m = {"a": 1}
        expect(m).to_not_contain("b")

describe("increment/decrement"):
    it("x++ increments int"):
        var x = 10
        x++
        expect(x).to_eq(11)

    it("x-- decrements int"):
        var x = 10
        x--
        expect(x).to_eq(9)

    it("multiple increments"):
        var x = 0
        x++
        x++
        x++
        expect(x).to_eq(3)

    it("decrement to negative"):
        var x = 1
        x--
        x--
        expect(x).to_eq(-1)

    it("f++ increments float"):
        var f = 1.5
        f++
        expect(f).to_eq(2.5)

    it("f-- decrements float"):
        var f = 3.5
        f--
        expect(f).to_eq(2.5)

describe("range operator"):
    it("creates inclusive range"):
        let xs = 1 .. 5
        expect(xs).to_have_length(5)
        expect(xs[0]).to_eq(1)
        expect(xs[4]).to_eq(5)
