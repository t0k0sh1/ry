# --- helper functions ---

fn doubleFloat(x: float) -> float:
  return x * 2.0

fn acceptInt(x: int) -> int:
  return x

fn acceptFloat(x: float) -> float:
  return x

fn addFloats(x: float, y: float) -> float:
  return x + y

# overload: exact when should win
fn typed(x: int) -> str:
  return "int"

fn typed(x: float) -> str:
  return "float"

# overload: widening should win over any
fn preferWidening(x: float) -> str:
  return "float"

fn preferWidening(x) -> str:
  return "any"

# --- tests ---

describe("basic implicit widening", ():
  it("should widen int to float", ():
    result = doubleFloat(5)
    expect(result).toEq(10.0)
  )

  it("should widen u8 to int", ():
    b: u8 = 200
    result = acceptInt(b)
    expect(result).toEq(200)
  )

  it("should widen u8 to float", ():
    b: u8 = 42
    result = acceptFloat(b)
    expect(result).toEq(42.0)
  )
)

describe("return value correctness", ():
  it("should return float when int widened to float", ():
    result = doubleFloat(5)
    expect(result).toEq(10.0)
  )

  it("should preserve unsigned value when u8 widened to int", ():
    b: u8 = 255
    result = acceptInt(b)
    expect(result).toEq(255)
  )
)

describe("overload resolution priority", ():
  it("should prefer exact when over widening", ():
    expect(typed(5)).toEq("int")
    expect(typed(5.0)).toEq("float")
  )

  it("should prefer widening over any", ():
    expect(preferWidening(5)).toEq("float")
  )
)

describe("multi-arg widening", ():
  it("should widen both args", ():
    result = addFloats(1, 2)
    expect(result).toEq(3.0)
  )

  it("should handle mixed: one exact, one widened", ():
    result = addFloats(1, 2.0)
    expect(result).toEq(3.0)
  )
)
