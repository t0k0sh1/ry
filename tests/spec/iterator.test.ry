describe("Iterator", fn():
    it("iter and to_list on list", fn():
        xs = [1, 2, 3]
        ys = xs.iter().to_list()
        expect(ys).to_have_length(3)
        expect(ys[0]).to_eq(1)
        expect(ys[1]).to_eq(2)
        expect(ys[2]).to_eq(3)

    )
    it("iter on empty list", fn():
        xs = [1]
        empty = xs.filter(fn(x: int): x > 10)
        ys = empty.iter().to_list()
        expect(ys).to_have_length(0)

    )
    it("lazy filter", fn():
        xs = [1, 2, 3, 4, 5]
        ys = xs.iter().filter(fn(x: int): x > 2).to_list()
        expect(ys).to_have_length(3)
        expect(ys[0]).to_eq(3)
        expect(ys[1]).to_eq(4)
        expect(ys[2]).to_eq(5)

    )
    it("lazy map", fn():
        xs = [1, 2, 3]
        ys = xs.iter().map(fn(x: int): x * 10).to_list()
        expect(ys).to_have_length(3)
        expect(ys[0]).to_eq(10)
        expect(ys[1]).to_eq(20)
        expect(ys[2]).to_eq(30)

    )
    it("lazy take", fn():
        xs = [1, 2, 3, 4, 5]
        ys = xs.iter().take(3).to_list()
        expect(ys).to_have_length(3)
        expect(ys[0]).to_eq(1)
        expect(ys[1]).to_eq(2)
        expect(ys[2]).to_eq(3)

    )
    it("chained filter map take", fn():
        xs = [1, 2, 3, 4, 5]
        ys = xs.iter().filter(fn(x: int): x > 2).map(fn(x: int): x * 2).take(2).to_list()
        expect(ys).to_have_length(2)
        expect(ys[0]).to_eq(6)
        expect(ys[1]).to_eq(8)

    )
    it("take 0", fn():
        xs = [1, 2, 3]
        ys = xs.iter().take(0).to_list()
        expect(ys).to_have_length(0)

    )
    it("take more than length", fn():
        xs = [1, 2, 3]
        ys = xs.iter().take(10).to_list()
        expect(ys).to_have_length(3)
        expect(ys[0]).to_eq(1)
        expect(ys[2]).to_eq(3)

    )
    it("for loop over iterator", fn():
        xs = [10, 20, 30]
        sum = 0
        for x in xs.iter():
            sum = sum + x
        expect(sum).to_eq(60)

    )
    it("for loop with filter", fn():
        xs = [1, 2, 3, 4, 5]
        sum = 0
        for x in xs.iter().filter(fn(x: int): x > 3):
            sum = sum + x
        expect(sum).to_eq(9)

    )
    it("next returns Option", fn():
        xs = [10, 20]
        it = xs.iter()
        a = it.next()
        expect(a).to_eq(Some(10))
        b = it.next()
        expect(b).to_eq(Some(20))
        c = it.next()
        expect(c).to_be_none()

    )
    it("iter on set", fn():
        s = {1, 2, 3}
        ys = s.iter().to_list()
        expect(ys).to_have_length(3)

    )
    it("iter on map", fn():
        m = {"a": 1, "b": 2}
        count = 0
        for k, v in m.iter():
            count = count + 1
        expect(count).to_eq(2)

    )
    it("UFCS iter", fn():
        xs = [1, 2, 3]
        ys = iter(xs).to_list()
        expect(ys).to_have_length(3)
        expect(ys[0]).to_eq(1)
    )
)
