describe("word boundary \\b / \\B", ():
  it("should match \\b at word boundary", ():
    expect(regexSearch("hello world", "\\bworld\\b")).to_eq(6)
    expect(regexSearch("helloworld", "\\bword\\b")).to_eq(-1)
  )
  it("should match \\B at non-boundary", ():
    expect(regexSearch("helloworld", "\\Bworld")).to_eq(5)
    expect(regexSearch("world test", "\\Bworld")).to_eq(-1)
  )
  it("should match \\b at start and end", ():
    expect(regexSearch("hello world", "\\bhello")).to_eq(0)
    expect(regexSearch("hello world", "world\\b")).to_eq(6)
  )
  it("should match \\b with digits and underscores", ():
    expect(regexMatch("hello_123", "\\b\\w+\\b")).to_eq(true)
    expect(regexSearch("abc 123 def", "\\b123\\b")).to_eq(4)
  )
  it("should find all words with \\b", ():
    words = regexFindAll("hello world foo", "\\b\\w+\\b")
    expect(len(words)).to_eq(3)
    expect(words[0].full).to_eq("hello")
    expect(words[1].full).to_eq("world")
    expect(words[2].full).to_eq("foo")
  )
)

describe("case-insensitive (?i)", ():
  it("should match case-insensitively with (?i)", ():
    expect(regexMatch("HELLO", "(?i)hello")).to_eq(true)
    expect(regexMatch("Hello", "(?i)hello")).to_eq(true)
    expect(regexMatch("hello", "(?i)hello")).to_eq(true)
  )
  it("should match char class case-insensitively", ():
    expect(regexMatch("ABC", "(?i)[a-z]+")).to_eq(true)
    expect(regexMatch("ABCDEF", "(?i)[a-f]+")).to_eq(true)
  )
  it("should be case-sensitive by default", ():
    expect(regexMatch("HELLO", "hello")).to_eq(false)
  )
  it("should search case-insensitively", ():
    expect(regexSearch("Hello WORLD", "(?i)world")).to_eq(6)
  )
  it("should replace case-insensitively", ():
    expect(regexReplace("Hello HELLO hello", "(?i)hello", "X")).to_eq("X X X")
  )
  it("should find all matches case-insensitively", ():
    matches = regexFindAll("Hello HELLO hello", "(?i)hello")
    expect(len(matches)).to_eq(3)
    expect(matches[0].full).to_eq("Hello")
    expect(matches[1].full).to_eq("HELLO")
    expect(matches[2].full).to_eq("hello")
  )
  it("should combine (?i) with \\b", ():
    expect(regexSearch("Hello WORLD", "(?i)\\bworld\\b")).to_eq(6)
  )
)
