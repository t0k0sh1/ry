from testing import it, describe, expect, fail
from io import open, close, writeText, deleteFile

# #1702 — `try:` effect-block expression.
#
# The block's `?` operators escape to the enclosing `try:` block (not the
# enclosing function). The tail expression is implicitly wrapped in Ok(...)
# (Result context) or Some(...) (Option context). Result/Option discriminant
# comes from the enclosing fn return type.

# ===== Result context =====

fn safeDiv(a: int, b: int) -> Result<int, Error>:
  if b == 0:
    return Err(Error("division by zero"))
  return Ok(a // b)

fn tryBlockResultOk(a: int, b: int) -> Result<int, Error>:
  return try:
    x = safeDiv(a, b)?
    y = safeDiv(x, 2)?
    y + 1

fn tryBlockResultErrFirst() -> Result<int, Error>:
  return try:
    x = safeDiv(10, 0)?
    y = safeDiv(x, 2)?
    y + 1

fn tryBlockResultErrSecond() -> Result<int, Error>:
  return try:
    x = safeDiv(10, 2)?
    y = safeDiv(x, 0)?
    y + 1

fn tryBlockInlineForm(a: int, b: int) -> Result<int, Error>:
  return try: safeDiv(a, b)?

fn tryBlockEscapeHatch(a: int, b: int) -> Result<int, Error>:
  # No `?` on safeDiv — the Result flows as a value, and the case picks it.
  return try:
    r = safeDiv(a, b)
    case r:
      Ok(v): v
      Err(_): -1

# ===== Option context =====

fn safeAt(xs: List<int>, i: int) -> Option<int>:
  if i < 0 or i >= xs.len():
    return none
  return Some(xs[i])

fn tryBlockOptionSome(xs: List<int>) -> Option<int>:
  return try:
    a = safeAt(xs, 0)?
    b = safeAt(xs, 1)?
    a + b

fn tryBlockOptionNoneFirst(xs: List<int>) -> Option<int>:
  return try:
    a = safeAt(xs, 99)?
    b = safeAt(xs, 1)?
    a + b

# ===== Let-annotation context (#1702) =====
#
# `let x: Result<T,E> = try: ...` / `x: Option<T> = try: ...` resolves the
# Result/Option discriminant from the LHS type annotation, so `try:` blocks
# can be used in module-globals or in fns whose return type is unrelated.

fn tryBlockAnnotationResult() -> int:
  r: Result<int, Error> = try:
    v = safeDiv(10, 2)?
    v + 5
  case r:
    Ok(v): return v
    Err(_): return -1

fn tryBlockAnnotationOption() -> int:
  r: Option<int> = try:
    v = safeAt([10, 20, 30], 0)?
    v + 100
  case r:
    Some(v): return v
    None: return -1

# ===== Nested try: (innermost wins) =====

fn nestedInnerErrOuterOk() -> Result<int, Error>:
  # Inner try: catches the Err, outer returns Ok(99).
  return try:
    inner: Result<int, Error> = try:
      v = safeDiv(10, 0)?
      v + 1
    case inner:
      Ok(_): 99
      Err(_): 99

fn nestedInnerOkOuterErr() -> Result<int, Error>:
  # Inner try: returns Ok(50), then outer ? on safeDiv(10, 0) escapes outer.
  return try:
    inner: Result<int, Error> = try:
      v = safeDiv(10, 2)?
      v + 1
    a = inner?
    b = safeDiv(10, 0)?
    a + b

# ===== Composes with `using` =====

fn tryUsingFailOnOpen(path: str) -> Result<int, Error>:
  # path is nonexistent; ? on the open() result escapes the try: block. The
  # `using` scope was NOT pushed because the ? fires BEFORE the using binds —
  # so no double-free risk, the helper's own scope ownership is preserved.
  return try:
    using f = open(path, "r")?:
      99
    42

fn tryUsingSucceeds(path: str) -> Result<int, Error>:
  # Path exists; open returns Ok, using binds, body runs, `using` close runs at
  # block exit, the try: tail then wraps Ok(42).
  return try:
    using f = open(path, "w")?:
      case writeText(f, "x"):
        Ok(_): 0
        Err(e): return Err(e)
    42

# ===== ARC-managed str err escape =====
#
# When the Err type is `str` (ARC-managed), the ? escape path must retain the
# err value before emitScopeCleanupToDepth — otherwise the scope-owned str
# would be released before the err PHI captures it. Reading the err message
# back from the caller is the regression guard (a missing retain trips ASan
# in Docker and silently passes on macOS local with freed-but-intact memory).

fn tryStrErrEscape() -> Result<int, str>:
  return try:
    r: Result<int, str> = Err("arc-str-escape-witness")
    v = r?
    v + 1

# ===== Tests =====

@describe("try_block effect-block expression")
fn tryBlockTests():

  @it("Result: tail is wrapped in Ok")
  fn resultOkWrapped():
    case tryBlockResultOk(20, 2):
      Ok(v):
        expect(v).toEq(6)
      Err(e):
        fail("unexpected err: " + e.message)

  @it("Result: first ? Err escapes block with Err")
  fn resultFirstErrEscape():
    case tryBlockResultErrFirst():
      Ok(v):
        fail("expected Err but got Ok")
      Err(e):
        expect(e.message).toEq("division by zero")

  @it("Result: second ? Err escapes block with Err")
  fn resultSecondErrEscape():
    case tryBlockResultErrSecond():
      Ok(v):
        fail("expected Err but got Ok")
      Err(e):
        expect(e.message).toEq("division by zero")

  @it("Result: inline form `try: <expr>`")
  fn resultInlineForm():
    case tryBlockInlineForm(10, 2):
      Ok(v):
        expect(v).toEq(5)
      Err(e):
        fail("unexpected err: " + e.message)

  @it("Result: escape hatch — no ? lets value flow through")
  fn resultEscapeHatch():
    case tryBlockEscapeHatch(10, 0):
      Ok(v):
        expect(v).toEq(-1)
      Err(e):
        fail("unexpected err: " + e.message)

  @it("Option: tail is wrapped in Some")
  fn optionSomeWrapped():
    case tryBlockOptionSome([10, 20, 30]):
      Some(v):
        expect(v).toEq(30)
      None:
        fail("unexpected None")

  @it("Option: ? None escapes block with None")
  fn optionNoneEscape():
    sawNone = false
    case tryBlockOptionNoneFirst([10]):
      Some(v):
        fail("expected None")
      None:
        sawNone = true
    expect(sawNone).toEq(true)

  @it("Annotation context: let r: Result<T,E> = try: ... resolves discriminant")
  fn annotationResultContext():
    expect(tryBlockAnnotationResult()).toEq(10)

  @it("Annotation context: let r: Option<T> = try: ... resolves discriminant")
  fn annotationOptionContext():
    expect(tryBlockAnnotationOption()).toEq(110)

  @it("Nested: ? dispatches to innermost try:")
  fn nestedInnermostWins():
    # The inner try: catches the Err, outer keeps going and returns Ok(99).
    case nestedInnerErrOuterOk():
      Ok(v): expect(v).toEq(99)
      Err(e): fail("outer should not see inner's err: " + e.message)

  @it("Nested: outer block's ? escapes outer, inner Ok flows through")
  fn nestedOuterEscape():
    case nestedInnerOkOuterErr():
      Ok(v): fail("expected outer Err")
      Err(e): expect(e.message).toEq("division by zero")

  @it("using composition: ? in using init escapes the try: block")
  fn usingInitEscape():
    # /tmp path that does not exist — open returns Err, ? escapes try:.
    case tryUsingFailOnOpen("/tmp/ry_1702_nonexistent_xyz"):
      Ok(v): fail("expected Err")
      Err(_): 0

  @it("using composition: success path runs using close + Ok-wraps tail")
  fn usingSuccessClose():
    path = "/tmp/ry_1702_using_ok.txt"
    case tryUsingSucceeds(path):
      Ok(v): expect(v).toEq(42)
      Err(e): fail("unexpected err: " + e.message)
    deleteFile(path)

  @it("ARC-managed str err: retain on ? escape — message survives cleanup")
  fn arcStrErrSurvivesEscape():
    case tryStrErrEscape():
      Ok(v): fail("expected Err")
      Err(e): expect(e).toEq("arc-str-escape-witness")
