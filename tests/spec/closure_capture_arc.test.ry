describe("closure capturing ARC values — destructor should release captures (#429)", ():
  it("should capture string and keep alias valid", ():
    prefix = "hello"
    f = (x: str) => prefix + " " + x
    g = f
    expect(g("world")).toEq("hello world")
  )

  it("should capture multiple strings", ():
    a = "foo"
    b = "bar"
    f = () => a + " " + b
    expect(f()).toEq("foo bar")
  )

  it("should allow multiple closures to capture same string", ():
    greeting = "hi"
    f = (x: str) => greeting + " " + x
    g = (x: str) => greeting + "! " + x
    expect(f("a")).toEq("hi a")
    expect(g("b")).toEq("hi! b")
  )

  it("should retain captures after closure copy", ():
    prefix = "test"
    f = (x: str) => prefix + x
    g = f
    h = g
    expect(h("!")).toEq("test!")
    expect(g("?")).toEq("test?")
    expect(f(".")).toEq("test.")
  )
)
