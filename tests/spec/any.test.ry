describe("any type", fn():
  it("wrap int", fn():
    x: any = 42
    expect(true).to_eq(true)
  )
  it("wrap float", fn():
    x: any = 3.14
    expect(true).to_eq(true)
  )
  it("wrap str", fn():
    x: any = "hello"
    expect(true).to_eq(true)
  )
  it("wrap bool", fn():
    x: any = true
    expect(true).to_eq(true)
  )
)

describe("optional param type", fn():
  it("single param without type annotation", fn():
    fn add_one(x) -> int:
      return 1
    expect(add_one(42)).to_eq(1)
  )
  it("multiple params without type annotation", fn():
    fn both_any(x, y) -> bool:
      return true
    expect(both_any(1, "hello")).to_eq(true)
  )
  it("mixed: some typed, some untyped", fn():
    fn mixed(x: int, y) -> int:
      return x
    expect(mixed(10, "hello")).to_eq(10)
  )
  it("lambda without type annotation", fn():
    f = fn(x) -> bool => true
    expect(f(42)).to_eq(true)
  )
  it("param accepts int", fn():
    fn accept(v) -> bool:
      return true
    expect(accept(42)).to_eq(true)
  )
  it("param accepts float", fn():
    fn accept_f(v) -> bool:
      return true
    expect(accept_f(3.14)).to_eq(true)
  )
  it("param accepts str", fn():
    fn accept_s(v) -> bool:
      return true
    expect(accept_s("hello")).to_eq(true)
  )
  it("param accepts bool", fn():
    fn accept_b(v) -> bool:
      return true
    expect(accept_b(false)).to_eq(true)
  )
)

describe("any reassignment", fn():
  it("reassign int to float", fn():
    x: any = 42
    x = 3.14
    expect(true).to_eq(true)
  )
  it("reassign str to int", fn():
    x: any = "hello"
    x = 42
    expect(true).to_eq(true)
  )
  it("reassign bool to str", fn():
    x: any = true
    x = "world"
    expect(true).to_eq(true)
  )
)

describe("any arithmetic operators", fn():
  it("int + int", fn():
    x: any = 10
    y: any = 20
    z: any = x + y
    expect(z == 30).to_eq(true)
  )
  it("int - int", fn():
    x: any = 30
    y: any = 10
    z: any = x - y
    expect(z == 20).to_eq(true)
  )
  it("int * int", fn():
    x: any = 5
    y: any = 6
    z: any = x * y
    expect(z == 30).to_eq(true)
  )
  it("int / int", fn():
    x: any = 10
    y: any = 2
    z: any = x / y
    expect(z == 5.0).to_eq(true)
  )
  it("int % int", fn():
    x: any = 10
    y: any = 3
    z: any = x % y
    expect(z == 1).to_eq(true)
  )
  it("int // int", fn():
    x: any = 7
    y: any = 2
    z: any = x // y
    expect(z == 3).to_eq(true)
  )
  it("int ** int", fn():
    x: any = 2
    y: any = 10
    z: any = x ** y
    expect(z == 1024.0).to_eq(true)
  )
  it("float + float", fn():
    x: any = 1.5
    y: any = 2.5
    z: any = x + y
    expect(z == 4.0).to_eq(true)
  )
  it("int + float (mixed)", fn():
    x: any = 10
    y: any = 3.14
    z: any = x + y
    expect(z == 13.14).to_eq(true)
  )
  it("str + str (concat)", fn():
    x: any = "hello"
    y: any = " world"
    z: any = x + y
    expect(z == "hello world").to_eq(true)
  )
  it("concrete + any (auto-wrap lhs)", fn():
    y: any = 20
    z: any = 10 + y
    expect(z == 30).to_eq(true)
  )
  it("any + concrete (auto-wrap rhs)", fn():
    x: any = 10
    z: any = x + 20
    expect(z == 30).to_eq(true)
  )
)

describe("any comparison operators", fn():
  it("int == int (true)", fn():
    x: any = 42
    y: any = 42
    expect(x == y).to_eq(true)
  )
  it("int == int (false)", fn():
    x: any = 42
    y: any = 99
    expect(x == y).to_eq(false)
  )
  it("int != int", fn():
    x: any = 1
    y: any = 2
    expect(x != y).to_eq(true)
  )
  it("int < int", fn():
    x: any = 1
    y: any = 2
    expect(x < y).to_eq(true)
  )
  it("int <= int", fn():
    x: any = 2
    y: any = 2
    expect(x <= y).to_eq(true)
  )
  it("int > int", fn():
    x: any = 3
    y: any = 2
    expect(x > y).to_eq(true)
  )
  it("int >= int", fn():
    x: any = 2
    y: any = 2
    expect(x >= y).to_eq(true)
  )
  it("str == str", fn():
    x: any = "hello"
    y: any = "hello"
    expect(x == y).to_eq(true)
  )
  it("mixed int/float comparison", fn():
    x: any = 3
    y: any = 3.0
    expect(x == y).to_eq(true)
  )
  it("concrete == any (auto-wrap)", fn():
    y: any = 42
    expect(42 == y).to_eq(true)
  )
)

describe("any unwrap in function call", fn():
  it("pass any(int) to int param", fn():
    fn typed_int(x: int) -> int:
      return x + 1
    v: any = 42
    expect(typed_int(v)).to_eq(43)
  )
  it("pass any(float) to float param", fn():
    fn typed_float(x: float) -> float:
      return x + 1.0
    v: any = 2.5
    expect(typed_float(v)).to_eq(3.5)
  )
  it("pass any(str) to str param", fn():
    fn typed_str(x: str) -> str:
      return x
    v: any = "hello"
    expect(typed_str(v)).to_eq("hello")
  )
  it("pass any(bool) to bool param", fn():
    fn typed_bool(x: bool) -> bool:
      return x
    v: any = true
    expect(typed_bool(v)).to_eq(true)
  )
)

describe("overload resolution: concrete preferred over any", fn():
  it("concrete when wins over any when", fn():
    fn dispatch(x: int) -> str:
      return "int"
    fn dispatch(x) -> str:
      return "any"
    expect(dispatch(42)).to_eq("int")
  )
)

describe("any print", fn():
  it("print int", fn():
    x: any = 42
    print(x)
    expect(true).to_eq(true)
  )
  it("print float", fn():
    x: any = 3.14
    print(x)
    expect(true).to_eq(true)
  )
  it("print bool", fn():
    x: any = true
    print(x)
    expect(true).to_eq(true)
  )
  it("print str", fn():
    x: any = "hello"
    print(x)
    expect(true).to_eq(true)
  )
)

describe("any to_str / f-string", fn():
  it("int to_str", fn():
    x: any = 42
    expect(f"{x}").to_eq("42")
  )
  it("float to_str", fn():
    x: any = 3.14
    expect(f"{x}").to_eq("3.14")
  )
  it("bool to_str", fn():
    x: any = true
    expect(f"{x}").to_eq("true")
  )
  it("str to_str", fn():
    x: any = "hello"
    expect(f"{x}").to_eq("hello")
  )
  it("f-string with any", fn():
    x: any = 42
    expect(f"value is {x}").to_eq("value is 42")
  )
  it("unit to_str", fn():
    fn unit_fn() -> any:
      return
    x: any = unit_fn()
    expect(f"{x}").to_eq("Unit")
  )
)

describe("any unary negation", fn():
  it("negate int", fn():
    x: any = 42
    y: any = -x
    expect(y == -42).to_eq(true)
  )
  it("negate float", fn():
    x: any = 3.14
    y: any = -x
    expect(y == -3.14).to_eq(true)
  )
)

describe("any parameter computation", fn():
  it("int addition via any params", fn():
    fn add(a, b):
      return a + b
    expect(add(1, 2)).to_eq(3)
  )
  it("string concatenation via any params", fn():
    fn concat(a, b):
      return a + b
    expect(concat("hello", " world")).to_eq("hello world")
  )
  it("mixed int/float multiplication", fn():
    fn mul(a, b):
      return a * b
    expect(mul(3, 2.0)).to_eq(6.0)
  )
  it("comparison via any params", fn():
    fn greater(a, b):
      return a > b
    expect(greater(5, 3)).to_eq(true)
  )
)

describe("any identity / round-trip", fn():
  it("identity preserves int", fn():
    fn identity(x: any) -> any:
      return x
    expect(identity(42)).to_eq(42)
  )
  it("identity preserves str", fn():
    fn identity_s(x: any) -> any:
      return x
    expect(identity_s("hi")).to_eq("hi")
  )
  it("identity preserves float", fn():
    fn identity_f(x: any) -> any:
      return x
    expect(identity_f(3.14)).to_eq(3.14)
  )
  it("identity preserves bool", fn():
    fn identity_b(x: any) -> any:
      return x
    expect(identity_b(true)).to_eq(true)
  )
)

describe("any lambda computation", fn():
  it("lambda with implicit any param and return", fn():
    f = fn(x):
      return x + 1
    expect(f(10)).to_eq(11)
  )
  it("lambda returning any from computation", fn():
    f = fn(a, b):
      return a * b
    expect(f(3, 4)).to_eq(12)
  )
)

describe("any default return type", fn():
  it("function with omitted return type returns computed value", fn():
    fn double_val(x: int):
      return x * 2
    expect(double_val(5)).to_eq(10)
  )
)

describe("any to concrete conversion", fn():
  it("unwrap any(int) to int variable", fn():
    fn get_int() -> any:
      return 42
    x: int = get_int()
    expect(x).to_eq(42)
  )
  it("unwrap any(str) to str variable", fn():
    fn get_str() -> any:
      return "hello"
    x: str = get_str()
    expect(x).to_eq("hello")
  )
  it("unwrap any(float) to float variable", fn():
    fn get_float() -> any:
      return 3.14
    x: float = get_float()
    expect(x).to_eq(3.14)
  )
  it("unwrap any(bool) to bool variable", fn():
    fn get_bool() -> any:
      return true
    x: bool = get_bool()
    expect(x).to_eq(true)
  )
  it("int to float auto-promotion in unwrap", fn():
    fn get_int_any() -> any:
      return 42
    x: float = get_int_any()
    expect(x).to_eq(42.0)
  )
  it("reassign concrete variable from any value", fn():
    fn get_any() -> any:
      return 99
    x: int = 0
    x = get_any()
    expect(x).to_eq(99)
  )
)
