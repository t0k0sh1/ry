from ry.testing import it, describe, expect, fail

@describe("any type")
fn anyTypeTests():
  @it("should wrap int")
  fn shouldWrapInt():
    x: any = 42
    expect(true).toEq(true)
  @it("should wrap float")
  fn shouldWrapFloat():
    x: any = 3.14
    expect(true).toEq(true)
  @it("should wrap str")
  fn shouldWrapStr():
    x: any = "hello"
    expect(true).toEq(true)
  @it("should wrap bool")
  fn shouldWrapBool():
    x: any = true
    expect(true).toEq(true)

@describe("optional param type")
fn optionalParamTypeTests():
  @it("should accept single param without type annotation")
  fn shouldAcceptSingleParamWithoutTypeAnnotation():
    fn addOne(x) -> int:
      return 1
    expect(addOne(42)).toEq(1)
  @it("should accept multiple params without type annotation")
  fn shouldAcceptMultipleParamsWithoutTypeAnnotation():
    fn bothAny(x, y) -> bool:
      return true
    expect(bothAny(1, "hello")).toEq(true)
  @it("should accept mixed typed and untyped params")
  fn shouldAcceptMixedTypedAndUntypedParams():
    fn mixed(x: int, y) -> int:
      return x
    expect(mixed(10, "hello")).toEq(10)
  @it("should accept lambda without type annotation")
  fn shouldAcceptLambdaWithoutTypeAnnotation():
    f = (x) -> bool => true
    expect(f(42)).toEq(true)
  @it("should accept int as param")
  fn shouldAcceptIntAsParam():
    fn accept(v) -> bool:
      return true
    expect(accept(42)).toEq(true)
  @it("should accept float as param")
  fn shouldAcceptFloatAsParam():
    fn acceptF(v) -> bool:
      return true
    expect(acceptF(3.14)).toEq(true)
  @it("should accept str as param")
  fn shouldAcceptStrAsParam():
    fn acceptS(v) -> bool:
      return true
    expect(acceptS("hello")).toEq(true)
  @it("should accept bool as param")
  fn shouldAcceptBoolAsParam():
    fn acceptB(v) -> bool:
      return true
    expect(acceptB(false)).toEq(true)

@describe("any reassignment")
fn anyReassignmentTests():
  @it("should reassign int to float")
  fn shouldReassignIntToFloat():
    x: any = 42
    x = 3.14
    expect(true).toEq(true)
  @it("should reassign str to int")
  fn shouldReassignStrToInt():
    x: any = "hello"
    x = 42
    expect(true).toEq(true)
  @it("should reassign bool to str")
  fn shouldReassignBoolToStr():
    x: any = true
    x = "world"
    expect(true).toEq(true)

@describe("any arithmetic operators")
fn anyArithmeticOperatorsTests():
  @it("should support int + int")
  fn shouldSupportIntInt():
    x: any = 10
    y: any = 20
    z: any = x + y
    expect(z == 30).toEq(true)
  @it("should support int - int")
  fn shouldSupportIntInt2():
    x: any = 30
    y: any = 10
    z: any = x - y
    expect(z == 20).toEq(true)
  @it("should support int * int")
  fn shouldSupportIntInt3():
    x: any = 5
    y: any = 6
    z: any = x * y
    expect(z == 30).toEq(true)
  @it("should support int / int")
  fn shouldSupportIntInt4():
    x: any = 10
    y: any = 2
    z: any = x / y
    expect(z == 5.0).toEq(true)
  @it("should support int % int")
  fn shouldSupportIntInt5():
    x: any = 10
    y: any = 3
    z: any = x % y
    expect(z == 1).toEq(true)
  @it("should support int // int")
  fn shouldSupportIntInt6():
    x: any = 7
    y: any = 2
    z: any = x // y
    expect(z == 3).toEq(true)
  @it("should support int ** int")
  fn shouldSupportIntInt7():
    x: any = 2
    y: any = 10
    z: any = x ** y
    expect(z == 1024.0).toEq(true)
  @it("should support float + float")
  fn shouldSupportFloatFloat():
    x: any = 1.5
    y: any = 2.5
    z: any = x + y
    expect(z == 4.0).toEq(true)
  @it("should support int + float (mixed)")
  fn shouldSupportIntFloatMixed():
    x: any = 10
    y: any = 3.14
    z: any = x + y
    expect(z == 13.14).toEq(true)
  @it("should support str + str (concat)")
  fn shouldSupportStrStrConcat():
    x: any = "hello"
    y: any = " world"
    z: any = x + y
    expect(z == "hello world").toEq(true)
  @it("should support concrete + any (auto-wrap lhs)")
  fn shouldSupportConcreteAnyAutoWrapLhs():
    y: any = 20
    z: any = 10 + y
    expect(z == 30).toEq(true)
  @it("should support any + concrete (auto-wrap rhs)")
  fn shouldSupportAnyConcreteAutoWrapRhs():
    x: any = 10
    z: any = x + 20
    expect(z == 30).toEq(true)

@describe("any comparison operators")
fn anyComparisonOperatorsTests():
  @it("should compare int == int (true)")
  fn shouldCompareIntIntTrue():
    x: any = 42
    y: any = 42
    expect(x == y).toEq(true)
  @it("should compare int == int (false)")
  fn shouldCompareIntIntFalse():
    x: any = 42
    y: any = 99
    expect(x == y).toEq(false)
  @it("should support int != int")
  fn shouldSupportIntInt8():
    x: any = 1
    y: any = 2
    expect(x != y).toEq(true)
  @it("should support int < int")
  fn shouldSupportIntInt9():
    x: any = 1
    y: any = 2
    expect(x < y).toEq(true)
  @it("should support int <= int")
  fn shouldSupportIntInt10():
    x: any = 2
    y: any = 2
    expect(x <= y).toEq(true)
  @it("should support int > int")
  fn shouldSupportIntInt11():
    x: any = 3
    y: any = 2
    expect(x > y).toEq(true)
  @it("should support int >= int")
  fn shouldSupportIntInt12():
    x: any = 2
    y: any = 2
    expect(x >= y).toEq(true)
  @it("should compare str == str")
  fn shouldCompareStrStr():
    x: any = "hello"
    y: any = "hello"
    expect(x == y).toEq(true)
  @it("should handle mixed int/float comparison")
  fn shouldHandleMixedIntFloatComparison():
    x: any = 3
    y: any = 3.0
    expect(x == y).toEq(true)
  @it("should support concrete == any (auto-wrap)")
  fn shouldSupportConcreteAnyAutoWrap():
    y: any = 42
    expect(42 == y).toEq(true)

@describe("any unwrap in function call")
fn anyUnwrapInFunctionCallTests():
  @it("should pass any(int) to int param")
  fn shouldPassAnyIntToIntParam():
    fn typedInt(x: int) -> int:
      return x + 1
    v: any = 42
    expect(typedInt(v)).toEq(43)
  @it("should pass any(float) to float param")
  fn shouldPassAnyFloatToFloatParam():
    fn typedFloat(x: float) -> float:
      return x + 1.0
    v: any = 2.5
    expect(typedFloat(v)).toEq(3.5)
  @it("should pass any(str) to str param")
  fn shouldPassAnyStrToStrParam():
    fn typedStr(x: str) -> str:
      return x
    v: any = "hello"
    expect(typedStr(v)).toEq("hello")
  @it("should pass any(bool) to bool param")
  fn shouldPassAnyBoolToBoolParam():
    fn typedBool(x: bool) -> bool:
      return x
    v: any = true
    expect(typedBool(v)).toEq(true)

@describe("overload resolution: concrete preferred over any")
fn overloadResolutionConcretePreferredOverAnyTests():
  @it("should prefer concrete overload over any")
  fn shouldPreferConcreteOverloadOverAny():
    fn dispatch(x: int) -> str:
      return "int"
    fn dispatch(x) -> str:
      return "any"
    expect(dispatch(42)).toEq("int")

@describe("any print")
fn anyPrintTests():
  @it("should print int")
  fn shouldPrintInt():
    x: any = 42
    print(x)
    expect(true).toEq(true)
  @it("should print float")
  fn shouldPrintFloat():
    x: any = 3.14
    print(x)
    expect(true).toEq(true)
  @it("should print bool")
  fn shouldPrintBool():
    x: any = true
    print(x)
    expect(true).toEq(true)
  @it("should print str")
  fn shouldPrintStr():
    x: any = "hello"
    print(x)
    expect(true).toEq(true)

@describe("any str / f-string")
fn anyTostrFStringTests():
  @it("should convert int to str")
  fn shouldConvertIntToStr():
    x: any = 42
    expect(f"{x}").toEq("42")
  @it("should convert float to str")
  fn shouldConvertFloatToStr():
    x: any = 3.14
    expect(f"{x}").toEq("3.14")
  @it("should convert bool to str")
  fn shouldConvertBoolToStr():
    x: any = true
    expect(f"{x}").toEq("true")
  @it("should convert str to str")
  fn shouldConvertStrToStr():
    x: any = "hello"
    expect(f"{x}").toEq("hello")
  @it("should interpolate any in f-string")
  fn shouldInterpolateAnyInFString():
    x: any = 42
    expect(f"value is {x}").toEq("value is 42")
  @it("should convert unit to str")
  fn shouldConvertUnitToStr():
    fn unitFn() -> any:
      return
    x: any = unitFn()
    expect(f"{x}").toEq("Unit")

@describe("any unary negation")
fn anyUnaryNegationTests():
  @it("should negate int")
  fn shouldNegateInt():
    x: any = 42
    y: any = -x
    expect(y == -42).toEq(true)
  @it("should negate float")
  fn shouldNegateFloat():
    x: any = 3.14
    y: any = -x
    expect(y == -3.14).toEq(true)

@describe("any parameter computation")
fn anyParameterComputationTests():
  @it("should compute int addition via any params")
  fn shouldComputeIntAdditionViaAnyParams():
    fn add(a, b):
      return a + b
    expect(add(1, 2)).toEq(3)
  @it("should concatenate strings via any params")
  fn shouldConcatenateStringsViaAnyParams():
    fn concat(a, b):
      return a + b
    expect(concat("hello", " world")).toEq("hello world")
  @it("should multiply mixed int/float")
  fn shouldMultiplyMixedIntFloat():
    fn mul(a, b):
      return a * b
    expect(mul(3, 2.0)).toEq(6.0)
  @it("should compare via any params")
  fn shouldCompareViaAnyParams():
    fn greater(a, b):
      return a > b
    expect(greater(5, 3)).toEq(true)

@describe("any identity / round-trip")
fn anyIdentityRoundTripTests():
  @it("should preserve int through identity")
  fn shouldPreserveIntThroughIdentity():
    fn identity(x: any) -> any:
      return x
    expect(identity(42)).toEq(42)
  @it("should preserve str through identity")
  fn shouldPreserveStrThroughIdentity():
    fn identityS(x: any) -> any:
      return x
    expect(identityS("hi")).toEq("hi")
  @it("should preserve float through identity")
  fn shouldPreserveFloatThroughIdentity():
    fn identityF(x: any) -> any:
      return x
    expect(identityF(3.14)).toEq(3.14)
  @it("should preserve bool through identity")
  fn shouldPreserveBoolThroughIdentity():
    fn identityB(x: any) -> any:
      return x
    expect(identityB(true)).toEq(true)

@describe("any lambda computation")
fn anyLambdaComputationTests():
  @it("should support lambda with implicit any param and return")
  fn shouldSupportLambdaWithImplicitAnyParamAndReturn():
    f = (x):
      return x + 1
    expect(f(10)).toEq(11)
  @it("should return any from lambda computation")
  fn shouldReturnAnyFromLambdaComputation():
    f = (a, b):
      return a * b
    expect(f(3, 4)).toEq(12)

@describe("any default return type")
fn anyDefaultReturnTypeTests():
  @it("should return computed value from function with omitted return type")
  fn shouldReturnComputedValueFromFunctionWithOmittedReturnType():
    fn doubleVal(x: int):
      return x * 2
    expect(doubleVal(5)).toEq(10)

@describe("any to concrete conversion")
fn anyToConcreteConversionTests():
  @it("should unwrap any(int) to int variable")
  fn shouldUnwrapAnyIntToIntVariable():
    fn getInt() -> any:
      return 42
    x: int = getInt()
    expect(x).toEq(42)
  @it("should unwrap any(str) to str variable")
  fn shouldUnwrapAnyStrToStrVariable():
    fn getStr() -> any:
      return "hello"
    x: str = getStr()
    expect(x).toEq("hello")
  @it("should unwrap any(float) to float variable")
  fn shouldUnwrapAnyFloatToFloatVariable():
    fn getFloat() -> any:
      return 3.14
    x: float = getFloat()
    expect(x).toEq(3.14)
  @it("should unwrap any(bool) to bool variable")
  fn shouldUnwrapAnyBoolToBoolVariable():
    fn getBool() -> any:
      return true
    x: bool = getBool()
    expect(x).toEq(true)
  @it("should auto-promote int to float in unwrap")
  fn shouldAutoPromoteIntToFloatInUnwrap():
    fn getIntAny() -> any:
      return 42
    x: float = getIntAny()
    expect(x).toEq(42.0)
  @it("should reassign concrete variable from any value")
  fn shouldReassignConcreteVariableFromAnyValue():
    fn getAny() -> any:
      return 99
    x: int = 0
    x = getAny()
    expect(x).toEq(99)

@describe("any element in Map")
fn anyElementInMapTests():
  @it("should accept str value in Map<str, any>")
  fn shouldAcceptStrValueInMapStrAny():
    m: Map<str, any> = {}
    m["name"] = "Alice"
    v: str = m["name"]
    expect(v).toEq("Alice")
  @it("should accept int value in Map<str, any>")
  fn shouldAcceptIntValueInMapStrAny():
    m: Map<str, any> = {}
    m["age"] = 30
    v: int = m["age"]
    expect(v).toEq(30)
  @it("should accept float value in Map<str, any>")
  fn shouldAcceptFloatValueInMapStrAny():
    m: Map<str, any> = {}
    m["pi"] = 3.14
    v: float = m["pi"]
    expect(v).toEq(3.14)
  @it("should accept bool value in Map<str, any>")
  fn shouldAcceptBoolValueInMapStrAny():
    m: Map<str, any> = {}
    m["flag"] = true
    v: bool = m["flag"]
    expect(v).toEq(true)
  @it("should update existing key with new concrete value")
  fn shouldUpdateExistingKeyWithNewConcreteValue():
    m: Map<str, any> = {}
    m["x"] = 1
    m["x"] = "updated"
    v: str = m["x"]
    expect(v).toEq("updated")
  @it("should unwrap any value into Map<str, int>")
  fn shouldUnwrapAnyValueIntoMapStrInt():
    v: any = 42
    m: Map<str, int> = {}
    m["x"] = v
    expect(m["x"]).toEq(42)
  @it("should support 'in' with str key on Map<str, any>")
  fn shouldSupportInWithStrKeyOnMapStrAny():
    m: Map<str, any> = {}
    m["name"] = "Alice"
    expect("name" in m).toEq(true)
    expect("missing" in m).toEq(false)
    expect("missing" not in m).toEq(true)
  @it("should support 'in' with any key on concrete Map<str, int>")
  fn shouldSupportInWithAnyKeyOnConcreteMapStrInt():
    m: Map<str, int> = {}
    m["x"] = 1
    k: any = "x"
    expect(k in m).toEq(true)
  @it("should accept mixed value types in Map<str, any> literal")
  fn shouldAcceptMixedValueTypesInMapStrAnyLiteral():
    m: Map<str, any> = {"a": 1, "b": "two", "c": true}
    vi: int = m["a"]
    vs: str = m["b"]
    vb: bool = m["c"]
    expect(vi).toEq(1)
    expect(vs).toEq("two")
    expect(vb).toEq(true)

@describe("any element in List")
fn anyElementInListTests():
  @it("should append! str to List<any>")
  fn shouldAppendStrToListAny():
    xs: List<any> = []
    append!(xs, "hello")
    v: str = xs[0]
    expect(v).toEq("hello")
  @it("should append! int to List<any>")
  fn shouldAppendIntToListAny():
    xs: List<any> = []
    append!(xs, 42)
    v: int = xs[0]
    expect(v).toEq(42)
  @it("should append! float to List<any>")
  fn shouldAppendFloatToListAny():
    xs: List<any> = []
    append!(xs, 3.14)
    v: float = xs[0]
    expect(v).toEq(3.14)
  @it("should append! bool to List<any>")
  fn shouldAppendBoolToListAny():
    xs: List<any> = []
    append!(xs, true)
    v: bool = xs[0]
    expect(v).toEq(true)
  @it("should use appended with concrete value on List<any>")
  fn shouldUseAppendedWithConcreteValueOnListAny():
    xs: List<any> = []
    ys = appended(xs, "new")
    v: str = ys[0]
    expect(v).toEq("new")
  @it("should insert concrete value into List<any>")
  fn shouldInsertConcreteValueIntoListAny():
    xs: List<any> = []
    append!(xs, 99)
    insert(xs, 0, "first")
    v: str = xs[0]
    expect(v).toEq("first")
  @it("should assign concrete value at index in List<any>")
  fn shouldAssignConcreteValueAtIndexInListAny():
    xs: List<any> = []
    append!(xs, 0)
    xs[0] = 99
    v: int = xs[0]
    expect(v).toEq(99)
  @it("should unwrap any value into List<int>")
  fn shouldUnwrapAnyValueIntoListInt():
    v: any = 7
    xs: List<int> = [1, 2, 3]
    xs[0] = v
    expect(xs[0]).toEq(7)
  @it("should support compound assign += on List<any>")
  fn shouldSupportCompoundAssignOnListAny():
    xs: List<any> = []
    append!(xs, 10)
    xs[0] += 5
    v: int = xs[0]
    expect(v).toEq(15)
  @it("should support 'in' with str on List<any>")
  fn shouldSupportInWithStrOnListAny():
    xs: List<any> = []
    append!(xs, "hello")
    append!(xs, 42)
    expect("hello" in xs).toEq(true)
    expect("missing" in xs).toEq(false)
    expect("missing" not in xs).toEq(true)
  @it("should support 'in' with int on List<any>")
  fn shouldSupportInWithIntOnListAny():
    xs: List<any> = []
    append!(xs, 1)
    append!(xs, 2)
    expect(2 in xs).toEq(true)
    expect(99 not in xs).toEq(true)
  @it("should support 'in' with bool on List<any>")
  fn shouldSupportInWithBoolOnListAny():
    xs: List<any> = []
    append!(xs, true)
    expect(true in xs).toEq(true)
  @it("should support 'in' with any value on concrete List<int>")
  fn shouldSupportInWithAnyValueOnConcreteListInt():
    xs: List<int> = [1, 2, 3]
    v: any = 2
    expect(v in xs).toEq(true)
  @it("should accept mixed element types in List<any> literal")
  fn shouldAcceptMixedElementTypesInListAnyLiteral():
    xs: List<any> = [1, "x", true]
    vi: int = xs[0]
    vs: str = xs[1]
    vb: bool = xs[2]
    expect(vi).toEq(1)
    expect(vs).toEq("x")
    expect(vb).toEq(true)
  @it("should accept already-any element mixed with concrete values in List<any> literal")
  fn shouldAcceptAlreadyAnyElementInListAnyLiteral():
    a: any = 42
    xs: List<any> = [a, "x", true]
    vi: int = xs[0]
    vs: str = xs[1]
    vb: bool = xs[2]
    expect(vi).toEq(42)
    expect(vs).toEq("x")
    expect(vb).toEq(true)

@describe("any element in Set")
fn anyElementInSetTests():
  @it("should add str to Set<any>")
  fn shouldAddStrToSetAny():
    s: Set<any> = {}
    add(s, "x")
    expect(s).toHaveLen(1)
  @it("should add int to Set<any>")
  fn shouldAddIntToSetAny():
    s: Set<any> = {}
    add(s, 1)
    expect(s).toHaveLen(1)
  @it("should add float to Set<any>")
  fn shouldAddFloatToSetAny():
    s: Set<any> = {}
    add(s, 3.14)
    expect(s).toHaveLen(1)
  @it("should add bool to Set<any>")
  fn shouldAddBoolToSetAny():
    s: Set<any> = {}
    add(s, true)
    expect(s).toHaveLen(1)
  @it("should add multiple distinct concrete types to Set<any>")
  fn shouldAddMultipleDistinctConcreteTypesToSetAny():
    s: Set<any> = {}
    add(s, "x")
    add(s, 1)
    expect(s).toHaveLen(2)
  @it("should unwrap any value into Set<int>")
  fn shouldUnwrapAnyValueIntoSetInt():
    v: any = 5
    s: Set<int> = {}
    add(s, v)
    expect(5 in s).toEq(true)
  @it("should support 'in' with str on Set<any>")
  fn shouldSupportInWithStrOnSetAny():
    s: Set<any> = {}
    add(s, "x")
    expect("x" in s).toEq(true)
    expect("y" in s).toEq(false)
    expect("y" not in s).toEq(true)
  @it("should support 'in' with int on Set<any>")
  fn shouldSupportInWithIntOnSetAny():
    s: Set<any> = {}
    add(s, 1)
    expect(1 in s).toEq(true)
  @it("should support 'in' with float on Set<any>")
  fn shouldSupportInWithFloatOnSetAny():
    s: Set<any> = {}
    add(s, 3.14)
    expect(3.14 in s).toEq(true)
  @it("should support 'in' with any value on concrete Set<int>")
  fn shouldSupportInWithAnyValueOnConcreteSetInt():
    s: Set<int> = {}
    add(s, 5)
    v: any = 5
    expect(v in s).toEq(true)
  @it("should accept mixed element types in Set<any> literal")
  fn shouldAcceptMixedElementTypesInSetAnyLiteral():
    s: Set<any> = {1, "x", true}
    expect(s).toHaveLen(3)
    expect(1 in s).toEq(true)
    expect("x" in s).toEq(true)
    expect(true in s).toEq(true)

@describe("any holds collection")
fn anyHoldsCollectionTests():
  @it("should wrap List<int> in any")
  fn shouldWrapListIntInAny():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    expect(true).toEq(true)
  @it("should wrap List<str> in any")
  fn shouldWrapListStrInAny():
    xs: List<str> = ["a", "b"]
    a: any = xs
    expect(true).toEq(true)
  @it("should wrap Map<str, int> in any")
  fn shouldWrapMapStrIntInAny():
    m: Map<str, int> = {}
    m["x"] = 1
    a: any = m
    expect(true).toEq(true)
  @it("should wrap Set<int> in any")
  fn shouldWrapSetIntInAny():
    s: Set<int> = {}
    add(s, 1)
    a: any = s
    expect(true).toEq(true)
  @it("should implicit-unwrap any back to List<int>")
  fn shouldImplicitUnwrapAnyBackToListInt():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    ys: List<int> = a
    expect(ys[0]).toEq(1)
    expect(ys[1]).toEq(2)
    expect(ys[2]).toEq(3)
  @it("should implicit-unwrap any back to Map<str, int>")
  fn shouldImplicitUnwrapAnyBackToMapStrInt():
    m: Map<str, int> = {}
    m["x"] = 42
    a: any = m
    n: Map<str, int> = a
    expect(n["x"]).toEq(42)
  @it("should implicit-unwrap any back to Set<int>")
  fn shouldImplicitUnwrapAnyBackToSetInt():
    s: Set<int> = {}
    add(s, 7)
    a: any = s
    t: Set<int> = a
    expect(7 in t).toEq(true)
  @it("should preserve list contents through any roundtrip in function")
  fn shouldPreserveListThroughAnyRoundtripInFn():
    fn identityAny(v: any) -> any:
      return v
    xs: List<int> = [10, 20]
    a: any = identityAny(xs)
    ys: List<int> = a
    expect(ys[0]).toEq(10)
    expect(ys[1]).toEq(20)
  @it("should compare two any aliasing the same list with == (pointer identity)")
  fn shouldCompareTwoAnyAliasingSameListWithEq():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    b: any = xs
    expect(a == b).toEq(true)
  @it("should not consider two any holding distinct equal-content lists equal")
  fn shouldNotConsiderTwoAnyHoldingDistinctEqualListsEqual():
    xs: List<int> = [1, 2, 3]
    ys: List<int> = [1, 2, 3]
    a: any = xs
    b: any = ys
    expect(a == b).toEq(false)
  @it("should compare two any holding different lists with ==")
  fn shouldCompareTwoAnyHoldingDifferentListsWithEq():
    xs: List<int> = [1, 2, 3]
    ys: List<int> = [1, 2, 4]
    a: any = xs
    b: any = ys
    expect(a == b).toEq(false)
  @it("should compare two any aliasing the same map with ==")
  fn shouldCompareTwoAnyAliasingSameMapWithEq():
    m: Map<str, int> = {"k": 1}
    a: any = m
    b: any = m
    expect(a == b).toEq(true)
  @it("should compare two any aliasing the same set with ==")
  fn shouldCompareTwoAnyAliasingSameSetWithEq():
    s: Set<int> = {}
    add(s, 1)
    a: any = s
    b: any = s
    expect(a == b).toEq(true)
  @it("should render any holding a list as <List> marker")
  fn shouldRenderAnyHoldingAListAsMarker():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    expect(f"{a}").toEq("<List>")
  @it("should render any holding a map as <Map> marker")
  fn shouldRenderAnyHoldingAMapAsMarker():
    m: Map<str, int> = {"a": 1}
    a: any = m
    expect(f"{a}").toEq("<Map>")
  @it("should render any holding a set as <Set> marker")
  fn shouldRenderAnyHoldingASetAsMarker():
    s: Set<int> = {}
    add(s, 1)
    a: any = s
    expect(f"{a}").toEq("<Set>")
  @it("should retain payload across any-to-any copy (regression: #1697 double-free)")
  fn shouldRetainPayloadAcrossAnyToAnyCopy():
    xs: List<int> = [10, 20, 30]
    a: any = xs
    b: any = a
    ys: List<int> = b
    expect(ys[0]).toEq(10)
    expect(ys[2]).toEq(30)
  @it("should retain payload when an any holds a map and is copied to another any")
  fn shouldRetainPayloadOnAnyToAnyMapCopy():
    m: Map<str, int> = {"a": 1, "b": 2}
    a: any = m
    b: any = a
    expect(f"{b}").toEq("<Map>")
  @it("should retain payload when an any holds a set and is copied to another any")
  fn shouldRetainPayloadOnAnyToAnySetCopy():
    s: Set<int> = {}
    add(s, 7)
    add(s, 8)
    a: any = s
    b: any = a
    expect(f"{b}").toEq("<Set>")
  @it("should reassign any-to-any without leaking the prior payload")
  fn shouldReassignAnyToAnyWithoutLeak():
    xs: List<int> = [1, 2]
    ys: List<int> = [3, 4, 5]
    a: any = xs
    b: any = ys
    a = b
    zs: List<int> = a
    expect(zs[2]).toEq(5)
  @it("should retain dynamic str payload across any-to-any copy (regression: #1799)")
  fn shouldRetainDynamicStrPayloadAcrossAnyToAnyCopy():
    s: str = "hello" + " world"
    a: any = s
    b: any = a
    s = "overwritten"
    t: str = b
    expect(t).toEq("hello world")
  @it("should retain dynamic str when unwrapped from a returned any (regression: #1799)")
  fn shouldRetainDynamicStrWhenUnwrappedFromReturnedAny():
    fn wrapDynStr() -> any:
      inner: str = "hello" + " world"
      result: any = inner
      return result
    t: str = wrapDynStr()
    expect(t).toEq("hello world")
  @it("should release prior dynamic str when reassigning any to a new str (regression: #1799)")
  fn shouldReleasePriorDynamicStrWhenReassigningAny():
    s1: str = "hello" + " world"
    s2: str = "foo" + " bar"
    a: any = s1
    a = s2
    s1 = "overwritten"
    s2 = "also overwritten"
    t: str = a
    expect(t).toEq("foo bar")
  @it("should preserve dynamic str content via any after source release and reuse (regression: #1799)")
  fn shouldPreserveDynamicStrContentViaAnyAfterSourceReleaseAndReuse():
    s: str = "hello" + " world"
    a: any = s
    s = "x"
    f1: str = "AAAAA" + "BBBBBB"
    f2: str = "CCCCC" + "DDDDDD"
    t: str = a
    expect(t).toEq("hello world")

record AnyRecPoint:
  x: int
  y: int

record AnyRecUser:
  name: str
  age: int

record AnyRecPlain:
  value: int

record AnyRecAnimal:
  name: str
  legs: int

record AnyRecChildDog < AnyRecAnimal:
  breed: str

record AnyRecGuideDog < AnyRecChildDog:
  trainerId: int

@describe("any holds record")
fn anyHoldsRecordTests():
  @it("should wrap plain record in any")
  fn shouldWrapPlainRecordInAny():
    p: any = AnyRecPoint(1, 2)
    expect(true).toEq(true)
  @it("should wrap record with str field in any")
  fn shouldWrapRecordWithStrFieldInAny():
    u: any = AnyRecUser("Alice", 30)
    expect(true).toEq(true)
  @it("should implicit-unwrap any back to plain record")
  fn shouldImplicitUnwrapAnyBackToPlainRecord():
    a: any = AnyRecPoint(1, 2)
    q: AnyRecPoint = a
    expect(q.x).toEq(1)
    expect(q.y).toEq(2)
  @it("should implicit-unwrap any back to record with str field")
  fn shouldImplicitUnwrapAnyBackToRecordWithStrField():
    a: any = AnyRecUser("Alice", 30)
    u: AnyRecUser = a
    expect(u.name).toEq("Alice")
    expect(u.age).toEq(30)
  @it("should compare two any holding records with equal fields with == (deep equality)")
  fn shouldCompareTwoAnyHoldingRecordsWithEqualFieldsWithEq():
    a: any = AnyRecPoint(1, 2)
    b: any = AnyRecPoint(1, 2)
    expect(a == b).toEq(true)
  @it("should not consider two any holding records with different fields equal")
  fn shouldNotConsiderTwoAnyHoldingRecordsWithDifferentFieldsEqual():
    a: any = AnyRecPoint(1, 2)
    b: any = AnyRecPoint(1, 3)
    expect(a == b).toEq(false)
  @it("should not consider two any holding records of different types equal")
  fn shouldNotConsiderTwoAnyHoldingRecordsOfDifferentTypesEqual():
    a: any = AnyRecPoint(1, 2)
    b: any = AnyRecPlain(1)
    expect(a == b).toEq(false)
  @it("should render any holding a record as type-named marker")
  fn shouldRenderAnyHoldingARecordAsTypeNamedMarker():
    a: any = AnyRecPoint(1, 2)
    expect(f"{a}").toEq("<AnyRecPoint>")
  @it("should preserve record through any roundtrip in function return")
  fn shouldPreserveRecordThroughAnyRoundtripInFnReturn():
    fn makeAnyRec() -> any:
      return AnyRecPoint(7, 9)
    a: any = makeAnyRec()
    q: AnyRecPoint = a
    expect(q.x).toEq(7)
    expect(q.y).toEq(9)
  @it("should preserve record with str field through any-to-any copy")
  fn shouldPreserveRecordWithStrFieldThroughAnyToAnyCopy():
    a: any = AnyRecUser("Bob" + "by", 25)
    b: any = a
    a = AnyRecUser("Replaced" + "Name", 99)
    u: AnyRecUser = b
    expect(u.name).toEq("Bobby")
    expect(u.age).toEq(25)
  @it("should reassign any holding record to a different record")
  fn shouldReassignAnyHoldingRecordToDifferentRecord():
    a: any = AnyRecPoint(1, 2)
    a = AnyRecPlain(99)
    q: AnyRecPlain = a
    expect(q.value).toEq(99)
  @it("should wrap child record in any and exact-type unwrap as child (dynamic descriptor)")
  fn shouldWrapChildRecordInAnyAndExactTypeUnwrapAsChild():
    d: any = AnyRecChildDog("Rex", 4, "Labrador")
    expect(f"{d}").toEq("<AnyRecChildDog>")
    out: AnyRecChildDog = d
    expect(out.name).toEq("Rex")
    expect(out.legs).toEq(4)
    expect(out.breed).toEq("Labrador")
  @it("should unwrap any holding child record as parent type (subtype projection)")
  fn shouldUnwrapAnyHoldingChildRecordAsParentType():
    d: any = AnyRecChildDog("Rex", 4, "Labrador")
    a: AnyRecAnimal = d
    expect(a.name).toEq("Rex")
    expect(a.legs).toEq(4)
  @it("should unwrap any holding grandchild record as grandparent type (multi-level chain walk)")
  fn shouldUnwrapAnyHoldingGrandchildRecordAsGrandparentType():
    g: any = AnyRecGuideDog("Buddy", 4, "GoldenRetriever", 42)
    a: AnyRecAnimal = g
    expect(a.name).toEq("Buddy")
    expect(a.legs).toEq(4)
  @it("should unwrap any holding grandchild record as intermediate parent type")
  fn shouldUnwrapAnyHoldingGrandchildRecordAsIntermediateParentType():
    g: any = AnyRecGuideDog("Buddy", 4, "GoldenRetriever", 42)
    c: AnyRecChildDog = g
    expect(c.name).toEq("Buddy")
    expect(c.legs).toEq(4)
    expect(c.breed).toEq("GoldenRetriever")
  @it("should subtype-unwrap across function boundary (any return -> parent type)")
  fn shouldSubtypeUnwrapAcrossFunctionBoundary():
    fn makeAnyDog() -> any:
      return AnyRecChildDog("Spot", 4, "Beagle")
    a: AnyRecAnimal = makeAnyDog()
    expect(a.name).toEq("Spot")
    expect(a.legs).toEq(4)

enum AnyEnumColor:
  Red
  Green
  Blue

enum AnyEnumMode:
  On
  Off

enum AnyEnumShape:
  Circle(float)
  Rect(int, int)
  Dot

enum AnyEnumLabel:
  Tag(str)
  Empty

enum AnyEnumBag:
  Items(List<int>)
  Nothing

@describe("any holds enum")
fn anyHoldsEnumTests():
  @it("should wrap simple enum in any and unwrap back")
  fn shouldWrapSimpleEnumInAnyAndUnwrapBack():
    a: any = AnyEnumColor::Red
    c: AnyEnumColor = a
    expect(c == AnyEnumColor::Red).toEq(true)
  @it("should compare two any holding same simple enum value")
  fn shouldCompareTwoAnyHoldingSameSimpleEnumValue():
    a: any = AnyEnumColor::Green
    b: any = AnyEnumColor::Green
    expect(a == b).toEq(true)
  @it("should not consider two any holding different simple enum variants equal")
  fn shouldNotConsiderTwoAnyHoldingDifferentSimpleEnumVariantsEqual():
    a: any = AnyEnumColor::Red
    b: any = AnyEnumColor::Blue
    expect(a == b).toEq(false)
  @it("should not consider two any holding different simple enum types equal")
  fn shouldNotConsiderTwoAnyHoldingDifferentSimpleEnumTypesEqual():
    a: any = AnyEnumColor::Red
    b: any = AnyEnumMode::On
    expect(a == b).toEq(false)
  @it("should wrap ADT enum (no payload variant) in any and unwrap back")
  fn shouldWrapAdtEnumNoPayloadVariantInAnyAndUnwrapBack():
    a: any = AnyEnumShape::Dot
    s: AnyEnumShape = a
    expect(s == AnyEnumShape::Dot).toEq(true)
  @it("should wrap ADT enum with float payload in any and unwrap back")
  fn shouldWrapAdtEnumWithFloatPayloadInAnyAndUnwrapBack():
    a: any = AnyEnumShape::Circle(2.5)
    s: AnyEnumShape = a
    expect(s == AnyEnumShape::Circle(2.5)).toEq(true)
  @it("should wrap ADT enum with int-pair payload in any and unwrap back")
  fn shouldWrapAdtEnumWithIntPairPayloadInAnyAndUnwrapBack():
    a: any = AnyEnumShape::Rect(3, 4)
    s: AnyEnumShape = a
    expect(s == AnyEnumShape::Rect(3, 4)).toEq(true)
  @it("should compare two any holding equal ADT payloads as equal")
  fn shouldCompareTwoAnyHoldingEqualAdtPayloadsAsEqual():
    a: any = AnyEnumShape::Rect(5, 7)
    b: any = AnyEnumShape::Rect(5, 7)
    expect(a == b).toEq(true)
  @it("should not consider two any holding ADT with different payloads equal")
  fn shouldNotConsiderTwoAnyHoldingAdtWithDifferentPayloadsEqual():
    a: any = AnyEnumShape::Rect(5, 7)
    b: any = AnyEnumShape::Rect(5, 8)
    expect(a == b).toEq(false)
  @it("should wrap ADT enum with str payload in any and unwrap (ARC field)")
  fn shouldWrapAdtEnumWithStrPayloadInAnyAndUnwrap():
    a: any = AnyEnumLabel::Tag("hello" + "!")
    l: AnyEnumLabel = a
    expect(l == AnyEnumLabel::Tag("hello!")).toEq(true)
  @it("should preserve ADT with str payload through any-to-any copy")
  fn shouldPreserveAdtWithStrPayloadThroughAnyToAnyCopy():
    a: any = AnyEnumLabel::Tag("orig" + "Val")
    b: any = a
    a = AnyEnumLabel::Tag("replaced")
    l: AnyEnumLabel = b
    expect(l == AnyEnumLabel::Tag("origVal")).toEq(true)
  @it("should wrap ADT enum with List payload in any (ARC field)")
  fn shouldWrapAdtEnumWithListPayloadInAny():
    a: any = AnyEnumBag::Items([1, 2, 3])
    b: AnyEnumBag = a
    expect(b == AnyEnumBag::Items([1, 2, 3])).toEq(true)
  @it("should reassign any holding enum to different enum value")
  fn shouldReassignAnyHoldingEnumToDifferentEnumValue():
    a: any = AnyEnumColor::Red
    a = AnyEnumShape::Dot
    s: AnyEnumShape = a
    expect(s == AnyEnumShape::Dot).toEq(true)
  @it("should wrap Option<int> in any and unwrap back")
  fn shouldWrapOptionIntInAnyAndUnwrapBack():
    a: any = Some(42)
    o: Option<int> = a
    case o:
      Some(v): expect(v).toEq(42)
      None: fail("expected Some")
  @it("should wrap None in any and unwrap back as Option<int>")
  fn shouldWrapNoneInAnyAndUnwrapBackAsOptionInt():
    n: Option<int> = None
    a: any = n
    o: Option<int> = a
    gotNone = false
    case o:
      Some(_): fail("expected None")
      None: gotNone = true
    expect(gotNone).toEq(true)
  @it("should wrap Option<str> in any and unwrap back")
  fn shouldWrapOptionStrInAnyAndUnwrapBack():
    a: any = Some("hi" + "!")
    o: Option<str> = a
    case o:
      Some(v): expect(v).toEq("hi!")
      None: fail("expected Some")
  @it("should wrap Result Ok int in any and unwrap back")
  fn shouldWrapResultOkIntInAnyAndUnwrapBack():
    r: Result<int, str> = Ok(7)
    a: any = r
    out: Result<int, str> = a
    case out:
      Ok(v): expect(v).toEq(7)
      Err(_): fail("expected Ok")
  @it("should wrap Result Err str in any and unwrap back")
  fn shouldWrapResultErrStrInAnyAndUnwrapBack():
    r: Result<int, str> = Err("oops")
    a: any = r
    out: Result<int, str> = a
    case out:
      Ok(_): fail("expected Err")
      Err(e): expect(e).toEq("oops")
  @it("should wrap Result<List<int>, str> in any and unwrap back (ARC payload)")
  fn shouldWrapResultListIntStrInAnyAndUnwrapBack():
    r: Result<List<int>, str> = Ok([10, 20, 30])
    a: any = r
    out: Result<List<int>, str> = a
    case out:
      Ok(v):
        expect(v[0]).toEq(10)
        expect(v[1]).toEq(20)
        expect(v[2]).toEq(30)
      Err(e): fail("expected Ok: " + e)
  @it("should store enum elements in List<any>")
  fn shouldStoreEnumElementsInListAny():
    xs: List<any> = []
    append!(xs, AnyEnumColor::Red)
    append!(xs, AnyEnumShape::Dot)
    expect(xs[0] == AnyEnumColor::Red).toEq(true)
    expect(xs[1] == AnyEnumShape::Dot).toEq(true)
  @it("should store enum values in Map<str, any>")
  fn shouldStoreEnumValuesInMapStrAny():
    m: Map<str, any> = {}
    m["c"] = AnyEnumColor::Blue
    m["m"] = AnyEnumMode::Off
    expect(m["c"] == AnyEnumColor::Blue).toEq(true)
    expect(m["m"] == AnyEnumMode::Off).toEq(true)
  @it("should render any holding simple enum as type-named marker")
  fn shouldRenderAnyHoldingSimpleEnumAsTypeNamedMarker():
    a: any = AnyEnumColor::Red
    expect(f"{a}").toEq("<AnyEnumColor>")
  @it("should render any holding ADT enum as type-named marker")
  fn shouldRenderAnyHoldingAdtEnumAsTypeNamedMarker():
    a: any = AnyEnumShape::Circle(1.5)
    expect(f"{a}").toEq("<AnyEnumShape>")
  @it("should render any holding Option as type-named marker")
  fn shouldRenderAnyHoldingOptionAsTypeNamedMarker():
    a: any = Some(1)
    expect(f"{a}").toEq("<Option<int>>")
  @it("should render any holding Result as type-named marker")
  fn shouldRenderAnyHoldingResultAsTypeNamedMarker():
    r: Result<int, str> = Ok(5)
    a: any = r
    expect(f"{a}").toEq("<Result<int, str>>")
  @it("should preserve enum through any roundtrip in function return")
  fn shouldPreserveEnumThroughAnyRoundtripInFnReturn():
    fn makeAnyEnum() -> any:
      return AnyEnumShape::Rect(2, 3)
    a: any = makeAnyEnum()
    s: AnyEnumShape = a
    expect(s == AnyEnumShape::Rect(2, 3)).toEq(true)
  @it("should coerce Result Ok any to Result Ok simple enum")
  fn shouldCoerceResultOkAnyToResultOkSimpleEnum():
    e: AnyEnumColor = AnyEnumColor::Green
    a: any = e
    r: Result<AnyEnumColor, str> = Ok(a)
    case r:
      Ok(v): expect(v == AnyEnumColor::Green).toEq(true)
      Err(_): fail("expected Ok")
  @it("should coerce Result Ok any to Result Ok Option")
  fn shouldCoerceResultOkAnyToResultOkOption():
    o: Option<int> = Some(7)
    a: any = o
    r: Result<Option<int>, str> = Ok(a)
    case r:
      Ok(v):
        case v:
          Some(n): expect(n).toEq(7)
          None: fail("expected Some")
      Err(_): fail("expected Ok")
  @it("should coerce Result Ok any to Result Ok nested Result")
  fn shouldCoerceResultOkAnyToResultOkNestedResult():
    inner: Result<int, str> = Ok(42)
    a: any = inner
    r: Result<Result<int, str>, bool> = Ok(a)
    case r:
      Ok(v):
        case v:
          Ok(n): expect(n).toEq(42)
          Err(_): fail("expected inner Ok")
      Err(_): fail("expected outer Ok")

mixedAnyMapGlobal: Map<str, any> = {}

@describe("mixed any literal reassignment")
fn mixedAnyLiteralReassignmentTests():
  @it("should reassign local Map<str, any> with mixed value types via literal")
  fn shouldReassignLocalMapStrAnyWithMixedLiteral():
    m: Map<str, any> = {}
    m = {"a": 1, "b": "two", "c": true}
    vi: int = m["a"]
    vs: str = m["b"]
    vb: bool = m["c"]
    expect(vi).toEq(1)
    expect(vs).toEq("two")
    expect(vb).toEq(true)
  @it("should reassign local List<any> with mixed element types via literal")
  fn shouldReassignLocalListAnyWithMixedLiteral():
    xs: List<any> = []
    xs = [1, "x", true]
    vi: int = xs[0]
    vs: str = xs[1]
    vb: bool = xs[2]
    expect(vi).toEq(1)
    expect(vs).toEq("x")
    expect(vb).toEq(true)
  @it("should reassign module-global Map<str, any> with mixed value types via literal")
  fn shouldReassignModuleGlobalMapStrAnyWithMixedLiteral():
    mixedAnyMapGlobal = {"a": 1, "b": "two", "c": true}
    vi: int = mixedAnyMapGlobal["a"]
    vs: str = mixedAnyMapGlobal["b"]
    vb: bool = mixedAnyMapGlobal["c"]
    expect(vi).toEq(1)
    expect(vs).toEq("two")
    expect(vb).toEq(true)
  @it("should reassign local Set<any> with mixed element types via literal")
  fn shouldReassignLocalSetAnyWithMixedLiteral():
    s: Set<any> = {}
    s = {1, "x", true}
    expect(s).toHaveLen(3)
    expect(1 in s).toEq(true)
    expect("x" in s).toEq(true)
    expect(true in s).toEq(true)
  @it("should compound-assign local List<any> with mixed element types via literal")
  fn shouldCompoundAssignLocalListAnyWithMixedLiteral():
    xs: List<any> = []
    xs += [1, "x", true]
    vi: int = xs[0]
    vs: str = xs[1]
    vb: bool = xs[2]
    expect(vi).toEq(1)
    expect(vs).toEq("x")
    expect(vb).toEq(true)
  @it("should compound-assign local Map<str, any> with mixed value types via literal")
  fn shouldCompoundAssignLocalMapStrAnyWithMixedLiteral():
    m: Map<str, any> = {}
    m += {"a": 1, "b": "two"}
    vi: int = m["a"]
    vs: str = m["b"]
    expect(vi).toEq(1)
    expect(vs).toEq("two")
  @it("should compound-assign local Set<any> with mixed element types via literal")
  fn shouldCompoundAssignLocalSetAnyWithMixedLiteral():
    s: Set<any> = {}
    s += {1, "x", true}
    expect(s).toHaveLen(3)
    expect(1 in s).toEq(true)
    expect("x" in s).toEq(true)
    expect(true in s).toEq(true)

@describe("asType checked cast from any")
fn asTypeTests():
  @it("should convert any holding int to Ok(int)")
  fn shouldAsTypeIntOk():
    v: any = 42
    case asType[int](v):
      Ok(n): expect(n).toEq(42)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should return Err when any tag does not match target int")
  fn shouldAsTypeIntErrOnMismatch():
    v: any = "hello"
    case asType[int](v):
      Ok(_): fail("expected Err")
      Err(e):
        expect(e.message == "asType[int]: expected int").toEq(true)
  @it("should convert any holding str to Ok(str)")
  fn shouldAsTypeStrOk():
    v: any = "hello"
    case asType[str](v):
      Ok(s): expect(s).toEq("hello")
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding bool to Ok(bool)")
  fn shouldAsTypeBoolOk():
    v: any = true
    case asType[bool](v):
      Ok(b): expect(b).toEq(true)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding float to Ok(float)")
  fn shouldAsTypeFloatOk():
    v: any = 3.14
    case asType[float](v):
      Ok(f): expect(f).toEq(3.14)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should promote any holding int to Ok(float) matching load[float]")
  fn shouldAsTypeFloatPromoteFromInt():
    v: any = 7
    case asType[float](v):
      Ok(f): expect(f).toEq(7.0)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding record to Ok(record)")
  fn shouldAsTypeRecordOk():
    v: any = AnyRecPoint(3, 4)
    case asType[AnyRecPoint](v):
      Ok(p):
        expect(p.x).toEq(3)
        expect(p.y).toEq(4)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should accept subtype unwrap via descriptor walk (asType[Parent](child))")
  fn shouldAsTypeRecordSubtype():
    v: any = AnyRecChildDog("Rex", 4, "Labrador")
    case asType[AnyRecAnimal](v):
      Ok(a):
        expect(a.name).toEq("Rex")
        expect(a.legs).toEq(4)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should return Err when record types mismatch")
  fn shouldAsTypeRecordErrOnMismatch():
    v: any = AnyRecPoint(1, 2)
    case asType[AnyRecPlain](v):
      Ok(_): fail("expected Err")
      Err(e):
        expect(e.message == "asType[AnyRecPlain]: expected record AnyRecPlain, got a different record type").toEq(true)
  @it("should convert any holding Option<int> to Ok(Option<int>)")
  fn shouldAsTypeOptionIntOk():
    v: any = Some(42)
    case asType[Option<int>](v):
      Ok(o):
        case o:
          Some(n): expect(n).toEq(42)
          None: fail("expected Some")
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding List<any> to Ok(List<any>)")
  fn shouldAsTypeListAnyOk():
    xs: List<any> = []
    xs += [1, "two", true]
    v: any = xs
    case asType[List<any>](v):
      Ok(out):
        expect(out).toHaveLen(3)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding Map<str, any> to Ok(Map<str, any>)")
  fn shouldAsTypeMapStrAnyOk():
    m: Map<str, any> = {"k": 1}
    v: any = m
    case asType[Map<str, any>](v):
      Ok(out):
        expect(out).toHaveLen(1)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding Set<any> to Ok(Set<any>)")
  fn shouldAsTypeSetAnyOk():
    s: Set<any> = {}
    s += {1, "x", true}
    v: any = s
    case asType[Set<any>](v):
      Ok(out):
        expect(out).toHaveLen(3)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should return Err when any tag mismatches target collection")
  fn shouldAsTypeCollectionErrOnMismatch():
    v: any = 42
    case asType[List<any>](v):
      Ok(_): fail("expected Err")
      Err(e):
        expect(e.message == "asType[List<any>]: expected List<any>").toEq(true)
  @it("should extract typed values from json5-shaped Map<str, any>")
  fn shouldAsTypeFromJsonShape():
    m: Map<str, any> = {"age": 30, "name": "Alice"}
    case asType[int](m["age"]):
      Ok(n): expect(n).toEq(30)
      Err(e): fail("expected Ok, got Err: " + e.message)
    case asType[str](m["name"]):
      Ok(s): expect(s).toEq("Alice")
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should reject native typed List<int> source (typed-coll guard)")
  fn shouldAsTypeRejectNativeTypedList():
    xs: List<int> = [1, 2, 3]
    v: any = xs
    case asType[List<int>](v):
      Ok(_): fail("expected Err on native typed-coll source")
      Err(e):
        expect(e.message.contains("native typed collection")).toEq(true)
  @it("should reject native typed Map<str, int> source (typed-coll guard)")
  fn shouldAsTypeRejectNativeTypedMap():
    m: Map<str, int> = {"a": 1, "b": 2}
    v: any = m
    case asType[Map<str, int>](v):
      Ok(_): fail("expected Err on native typed-coll source")
      Err(e):
        expect(e.message.contains("native typed collection")).toEq(true)
  @it("should reject native typed Map source when target is record")
  fn shouldAsTypeRejectNativeTypedMapForRecord():
    m: Map<str, int> = {"x": 1, "y": 2}
    v: any = m
    case asType[AnyRecPoint](v):
      Ok(_): fail("expected Err on native typed-coll source")
      Err(e):
        expect(e.message.contains("native typed collection")).toEq(true)

@describe("isType type-test on any")
fn isTypeTests():
  @it("should return true for matching int tag")
  fn shouldIsTypeIntTrue():
    v: any = 42
    expect(isType[int](v)).toEq(true)
  @it("should return false for non-matching int tag")
  fn shouldIsTypeIntFalse():
    v: any = "hello"
    expect(isType[int](v)).toEq(false)
  @it("should return true for matching str tag")
  fn shouldIsTypeStrTrue():
    v: any = "hello"
    expect(isType[str](v)).toEq(true)
  @it("should return true for matching bool tag")
  fn shouldIsTypeBoolTrue():
    v: any = true
    expect(isType[bool](v)).toEq(true)
  @it("should return true for matching float tag")
  fn shouldIsTypeFloatTrue():
    v: any = 3.14
    expect(isType[float](v)).toEq(true)
  @it("should return true for matching List<any> tag")
  fn shouldIsTypeListAnyTrue():
    xs: List<any> = []
    xs += [1, 2, 3]
    v: any = xs
    expect(isType[List<any>](v)).toEq(true)
  @it("should return true for matching Map<str, any> tag")
  fn shouldIsTypeMapStrAnyTrue():
    m: Map<str, any> = {"k": 1}
    v: any = m
    expect(isType[Map<str, any>](v)).toEq(true)
  @it("should return true for matching Set<any> tag")
  fn shouldIsTypeSetAnyTrue():
    s: Set<any> = {}
    s += {1, 2}
    v: any = s
    expect(isType[Set<any>](v)).toEq(true)
  @it("should return true for exact record type match")
  fn shouldIsTypeRecordExactTrue():
    v: any = AnyRecPoint(1, 2)
    expect(isType[AnyRecPoint](v)).toEq(true)
  @it("should return false for different record type")
  fn shouldIsTypeRecordFalse():
    v: any = AnyRecPoint(1, 2)
    expect(isType[AnyRecPlain](v)).toEq(false)
  @it("should return true for record subtype via descriptor walk")
  fn shouldIsTypeRecordSubtypeTrue():
    v: any = AnyRecChildDog("Rex", 4, "Labrador")
    expect(isType[AnyRecAnimal](v)).toEq(true)
  @it("should return false when parent record is held but child requested")
  fn shouldIsTypeRecordParentNotChild():
    v: any = AnyRecAnimal("Cat", 4)
    expect(isType[AnyRecChildDog](v)).toEq(false)
  @it("should return true for isType[any] regardless of held value")
  fn shouldIsTypeAnyAlwaysTrue():
    v1: any = 42
    v2: any = "hello"
    v3: any = AnyRecPoint(1, 2)
    expect(isType[any](v1)).toEq(true)
    expect(isType[any](v2)).toEq(true)
    expect(isType[any](v3)).toEq(true)
