describe("any type", ():
  it("should wrap int", ():
    x: any = 42
    expect(true).to_eq(true)
  )
  it("should wrap float", ():
    x: any = 3.14
    expect(true).to_eq(true)
  )
  it("should wrap str", ():
    x: any = "hello"
    expect(true).to_eq(true)
  )
  it("should wrap bool", ():
    x: any = true
    expect(true).to_eq(true)
  )
)

describe("optional param type", ():
  it("should accept single param without type annotation", ():
    fn add_one(x) -> int:
      return 1
    expect(add_one(42)).to_eq(1)
  )
  it("should accept multiple params without type annotation", ():
    fn both_any(x, y) -> bool:
      return true
    expect(both_any(1, "hello")).to_eq(true)
  )
  it("should accept mixed typed and untyped params", ():
    fn mixed(x: int, y) -> int:
      return x
    expect(mixed(10, "hello")).to_eq(10)
  )
  it("should accept lambda without type annotation", ():
    f = (x) -> bool => true
    expect(f(42)).to_eq(true)
  )
  it("should accept int as param", ():
    fn accept(v) -> bool:
      return true
    expect(accept(42)).to_eq(true)
  )
  it("should accept float as param", ():
    fn accept_f(v) -> bool:
      return true
    expect(accept_f(3.14)).to_eq(true)
  )
  it("should accept str as param", ():
    fn accept_s(v) -> bool:
      return true
    expect(accept_s("hello")).to_eq(true)
  )
  it("should accept bool as param", ():
    fn accept_b(v) -> bool:
      return true
    expect(accept_b(false)).to_eq(true)
  )
)

describe("any reassignment", ():
  it("should reassign int to float", ():
    x: any = 42
    x = 3.14
    expect(true).to_eq(true)
  )
  it("should reassign str to int", ():
    x: any = "hello"
    x = 42
    expect(true).to_eq(true)
  )
  it("should reassign bool to str", ():
    x: any = true
    x = "world"
    expect(true).to_eq(true)
  )
)

describe("any arithmetic operators", ():
  it("should support int + int", ():
    x: any = 10
    y: any = 20
    z: any = x + y
    expect(z == 30).to_eq(true)
  )
  it("should support int - int", ():
    x: any = 30
    y: any = 10
    z: any = x - y
    expect(z == 20).to_eq(true)
  )
  it("should support int * int", ():
    x: any = 5
    y: any = 6
    z: any = x * y
    expect(z == 30).to_eq(true)
  )
  it("should support int / int", ():
    x: any = 10
    y: any = 2
    z: any = x / y
    expect(z == 5.0).to_eq(true)
  )
  it("should support int % int", ():
    x: any = 10
    y: any = 3
    z: any = x % y
    expect(z == 1).to_eq(true)
  )
  it("should support int // int", ():
    x: any = 7
    y: any = 2
    z: any = x // y
    expect(z == 3).to_eq(true)
  )
  it("should support int ** int", ():
    x: any = 2
    y: any = 10
    z: any = x ** y
    expect(z == 1024.0).to_eq(true)
  )
  it("should support float + float", ():
    x: any = 1.5
    y: any = 2.5
    z: any = x + y
    expect(z == 4.0).to_eq(true)
  )
  it("should support int + float (mixed)", ():
    x: any = 10
    y: any = 3.14
    z: any = x + y
    expect(z == 13.14).to_eq(true)
  )
  it("should support str + str (concat)", ():
    x: any = "hello"
    y: any = " world"
    z: any = x + y
    expect(z == "hello world").to_eq(true)
  )
  it("should support concrete + any (auto-wrap lhs)", ():
    y: any = 20
    z: any = 10 + y
    expect(z == 30).to_eq(true)
  )
  it("should support any + concrete (auto-wrap rhs)", ():
    x: any = 10
    z: any = x + 20
    expect(z == 30).to_eq(true)
  )
)

describe("any comparison operators", ():
  it("should compare int == int (true)", ():
    x: any = 42
    y: any = 42
    expect(x == y).to_eq(true)
  )
  it("should compare int == int (false)", ():
    x: any = 42
    y: any = 99
    expect(x == y).to_eq(false)
  )
  it("should support int != int", ():
    x: any = 1
    y: any = 2
    expect(x != y).to_eq(true)
  )
  it("should support int < int", ():
    x: any = 1
    y: any = 2
    expect(x < y).to_eq(true)
  )
  it("should support int <= int", ():
    x: any = 2
    y: any = 2
    expect(x <= y).to_eq(true)
  )
  it("should support int > int", ():
    x: any = 3
    y: any = 2
    expect(x > y).to_eq(true)
  )
  it("should support int >= int", ():
    x: any = 2
    y: any = 2
    expect(x >= y).to_eq(true)
  )
  it("should compare str == str", ():
    x: any = "hello"
    y: any = "hello"
    expect(x == y).to_eq(true)
  )
  it("should handle mixed int/float comparison", ():
    x: any = 3
    y: any = 3.0
    expect(x == y).to_eq(true)
  )
  it("should support concrete == any (auto-wrap)", ():
    y: any = 42
    expect(42 == y).to_eq(true)
  )
)

describe("any unwrap in function call", ():
  it("should pass any(int) to int param", ():
    fn typed_int(x: int) -> int:
      return x + 1
    v: any = 42
    expect(typed_int(v)).to_eq(43)
  )
  it("should pass any(float) to float param", ():
    fn typed_float(x: float) -> float:
      return x + 1.0
    v: any = 2.5
    expect(typed_float(v)).to_eq(3.5)
  )
  it("should pass any(str) to str param", ():
    fn typed_str(x: str) -> str:
      return x
    v: any = "hello"
    expect(typed_str(v)).to_eq("hello")
  )
  it("should pass any(bool) to bool param", ():
    fn typed_bool(x: bool) -> bool:
      return x
    v: any = true
    expect(typed_bool(v)).to_eq(true)
  )
)

describe("overload resolution: concrete preferred over any", ():
  it("should prefer concrete overload over any", ():
    fn dispatch(x: int) -> str:
      return "int"
    fn dispatch(x) -> str:
      return "any"
    expect(dispatch(42)).to_eq("int")
  )
)

describe("any print", ():
  it("should print int", ():
    x: any = 42
    print(x)
    expect(true).to_eq(true)
  )
  it("should print float", ():
    x: any = 3.14
    print(x)
    expect(true).to_eq(true)
  )
  it("should print bool", ():
    x: any = true
    print(x)
    expect(true).to_eq(true)
  )
  it("should print str", ():
    x: any = "hello"
    print(x)
    expect(true).to_eq(true)
  )
)

describe("any toStr / f-string", ():
  it("should convert int to str", ():
    x: any = 42
    expect(f"{x}").to_eq("42")
  )
  it("should convert float to str", ():
    x: any = 3.14
    expect(f"{x}").to_eq("3.14")
  )
  it("should convert bool to str", ():
    x: any = true
    expect(f"{x}").to_eq("true")
  )
  it("should convert str to str", ():
    x: any = "hello"
    expect(f"{x}").to_eq("hello")
  )
  it("should interpolate any in f-string", ():
    x: any = 42
    expect(f"value is {x}").to_eq("value is 42")
  )
  it("should convert unit to str", ():
    fn unit_fn() -> any:
      return
    x: any = unit_fn()
    expect(f"{x}").to_eq("Unit")
  )
)

describe("any unary negation", ():
  it("should negate int", ():
    x: any = 42
    y: any = -x
    expect(y == -42).to_eq(true)
  )
  it("should negate float", ():
    x: any = 3.14
    y: any = -x
    expect(y == -3.14).to_eq(true)
  )
)

describe("any parameter computation", ():
  it("should compute int addition via any params", ():
    fn add(a, b):
      return a + b
    expect(add(1, 2)).to_eq(3)
  )
  it("should concatenate strings via any params", ():
    fn concat(a, b):
      return a + b
    expect(concat("hello", " world")).to_eq("hello world")
  )
  it("should multiply mixed int/float", ():
    fn mul(a, b):
      return a * b
    expect(mul(3, 2.0)).to_eq(6.0)
  )
  it("should compare via any params", ():
    fn greater(a, b):
      return a > b
    expect(greater(5, 3)).to_eq(true)
  )
)

describe("any identity / round-trip", ():
  it("should preserve int through identity", ():
    fn identity(x: any) -> any:
      return x
    expect(identity(42)).to_eq(42)
  )
  it("should preserve str through identity", ():
    fn identity_s(x: any) -> any:
      return x
    expect(identity_s("hi")).to_eq("hi")
  )
  it("should preserve float through identity", ():
    fn identity_f(x: any) -> any:
      return x
    expect(identity_f(3.14)).to_eq(3.14)
  )
  it("should preserve bool through identity", ():
    fn identity_b(x: any) -> any:
      return x
    expect(identity_b(true)).to_eq(true)
  )
)

describe("any lambda computation", ():
  it("should support lambda with implicit any param and return", ():
    f = (x):
      return x + 1
    expect(f(10)).to_eq(11)
  )
  it("should return any from lambda computation", ():
    f = (a, b):
      return a * b
    expect(f(3, 4)).to_eq(12)
  )
)

describe("any default return type", ():
  it("should return computed value from function with omitted return type", ():
    fn double_val(x: int):
      return x * 2
    expect(double_val(5)).to_eq(10)
  )
)

describe("any to concrete conversion", ():
  it("should unwrap any(int) to int variable", ():
    fn get_int() -> any:
      return 42
    x: int = get_int()
    expect(x).to_eq(42)
  )
  it("should unwrap any(str) to str variable", ():
    fn get_str() -> any:
      return "hello"
    x: str = get_str()
    expect(x).to_eq("hello")
  )
  it("should unwrap any(float) to float variable", ():
    fn get_float() -> any:
      return 3.14
    x: float = get_float()
    expect(x).to_eq(3.14)
  )
  it("should unwrap any(bool) to bool variable", ():
    fn get_bool() -> any:
      return true
    x: bool = get_bool()
    expect(x).to_eq(true)
  )
  it("should auto-promote int to float in unwrap", ():
    fn get_int_any() -> any:
      return 42
    x: float = get_int_any()
    expect(x).to_eq(42.0)
  )
  it("should reassign concrete variable from any value", ():
    fn get_any() -> any:
      return 99
    x: int = 0
    x = get_any()
    expect(x).to_eq(99)
  )
)

describe("any element in Map", ():
  it("should accept str value in Map<str, any>", ():
    m: Map<str, any> = {}
    m["name"] = "Alice"
    v: str = m["name"]
    expect(v).to_eq("Alice")
  )
  it("should accept int value in Map<str, any>", ():
    m: Map<str, any> = {}
    m["age"] = 30
    v: int = m["age"]
    expect(v).to_eq(30)
  )
  it("should accept float value in Map<str, any>", ():
    m: Map<str, any> = {}
    m["pi"] = 3.14
    v: float = m["pi"]
    expect(v).to_eq(3.14)
  )
  it("should accept bool value in Map<str, any>", ():
    m: Map<str, any> = {}
    m["flag"] = true
    v: bool = m["flag"]
    expect(v).to_eq(true)
  )
  it("should update existing key with new concrete value", ():
    m: Map<str, any> = {}
    m["x"] = 1
    m["x"] = "updated"
    v: str = m["x"]
    expect(v).to_eq("updated")
  )
  it("should unwrap any value into Map<str, int>", ():
    v: any = 42
    m: Map<str, int> = {}
    m["x"] = v
    expect(m["x"]).to_eq(42)
  )
  it("should support 'in' with str key on Map<str, any>", ():
    m: Map<str, any> = {}
    m["name"] = "Alice"
    expect("name" in m).to_eq(true)
    expect("missing" in m).to_eq(false)
    expect("missing" not in m).to_eq(true)
  )
  it("should support 'in' with any key on concrete Map<str, int>", ():
    m: Map<str, int> = {}
    m["x"] = 1
    k: any = "x"
    expect(k in m).to_eq(true)
  )
)

describe("any element in List", ():
  it("should append! str to List<any>", ():
    xs: List<any> = []
    append!(xs, "hello")
    v: str = xs[0]
    expect(v).to_eq("hello")
  )
  it("should append! int to List<any>", ():
    xs: List<any> = []
    append!(xs, 42)
    v: int = xs[0]
    expect(v).to_eq(42)
  )
  it("should append! float to List<any>", ():
    xs: List<any> = []
    append!(xs, 3.14)
    v: float = xs[0]
    expect(v).to_eq(3.14)
  )
  it("should append! bool to List<any>", ():
    xs: List<any> = []
    append!(xs, true)
    v: bool = xs[0]
    expect(v).to_eq(true)
  )
  it("should use appended with concrete value on List<any>", ():
    xs: List<any> = []
    ys = appended(xs, "new")
    v: str = ys[0]
    expect(v).to_eq("new")
  )
  it("should insert concrete value into List<any>", ():
    xs: List<any> = []
    append!(xs, 99)
    insert(xs, 0, "first")
    v: str = xs[0]
    expect(v).to_eq("first")
  )
  it("should assign concrete value at index in List<any>", ():
    xs: List<any> = []
    append!(xs, 0)
    xs[0] = 99
    v: int = xs[0]
    expect(v).to_eq(99)
  )
  it("should unwrap any value into List<int>", ():
    v: any = 7
    xs: List<int> = [1, 2, 3]
    xs[0] = v
    expect(xs[0]).to_eq(7)
  )
  it("should support compound assign += on List<any>", ():
    xs: List<any> = []
    append!(xs, 10)
    xs[0] += 5
    v: int = xs[0]
    expect(v).to_eq(15)
  )
  it("should support 'in' with str on List<any>", ():
    xs: List<any> = []
    append!(xs, "hello")
    append!(xs, 42)
    expect("hello" in xs).to_eq(true)
    expect("missing" in xs).to_eq(false)
    expect("missing" not in xs).to_eq(true)
  )
  it("should support 'in' with int on List<any>", ():
    xs: List<any> = []
    append!(xs, 1)
    append!(xs, 2)
    expect(2 in xs).to_eq(true)
    expect(99 not in xs).to_eq(true)
  )
  it("should support 'in' with bool on List<any>", ():
    xs: List<any> = []
    append!(xs, true)
    expect(true in xs).to_eq(true)
  )
  it("should support 'in' with any value on concrete List<int>", ():
    xs: List<int> = [1, 2, 3]
    v: any = 2
    expect(v in xs).to_eq(true)
  )
)

describe("any element in Set", ():
  it("should add str to Set<any>", ():
    s: Set<any> = {}
    add(s, "x")
    expect(s).to_have_length(1)
  )
  it("should add int to Set<any>", ():
    s: Set<any> = {}
    add(s, 1)
    expect(s).to_have_length(1)
  )
  it("should add float to Set<any>", ():
    s: Set<any> = {}
    add(s, 3.14)
    expect(s).to_have_length(1)
  )
  it("should add bool to Set<any>", ():
    s: Set<any> = {}
    add(s, true)
    expect(s).to_have_length(1)
  )
  it("should add multiple distinct concrete types to Set<any>", ():
    s: Set<any> = {}
    add(s, "x")
    add(s, 1)
    expect(s).to_have_length(2)
  )
  it("should unwrap any value into Set<int>", ():
    v: any = 5
    s: Set<int> = {}
    add(s, v)
    expect(5 in s).to_eq(true)
  )
  it("should support 'in' with str on Set<any>", ():
    s: Set<any> = {}
    add(s, "x")
    expect("x" in s).to_eq(true)
    expect("y" in s).to_eq(false)
    expect("y" not in s).to_eq(true)
  )
  it("should support 'in' with int on Set<any>", ():
    s: Set<any> = {}
    add(s, 1)
    expect(1 in s).to_eq(true)
  )
  it("should support 'in' with float on Set<any>", ():
    s: Set<any> = {}
    add(s, 3.14)
    expect(3.14 in s).to_eq(true)
  )
  it("should support 'in' with any value on concrete Set<int>", ():
    s: Set<int> = {}
    add(s, 5)
    v: any = 5
    expect(v in s).to_eq(true)
  )
)
