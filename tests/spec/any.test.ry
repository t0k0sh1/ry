describe("any type", fn():
  it("wrap int", fn():
    x: any = 42
    expect(true).to_eq(true)
  )
  it("wrap float", fn():
    x: any = 3.14
    expect(true).to_eq(true)
  )
  it("wrap str", fn():
    x: any = "hello"
    expect(true).to_eq(true)
  )
  it("wrap bool", fn():
    x: any = true
    expect(true).to_eq(true)
  )
)

describe("optional param type", fn():
  it("single param without type annotation", fn():
    fn add_one(x) -> int:
      return 1
    expect(add_one(42)).to_eq(1)
  )
  it("multiple params without type annotation", fn():
    fn both_any(x, y) -> bool:
      return true
    expect(both_any(1, "hello")).to_eq(true)
  )
  it("mixed: some typed, some untyped", fn():
    fn mixed(x: int, y) -> int:
      return x
    expect(mixed(10, "hello")).to_eq(10)
  )
  it("lambda without type annotation", fn():
    f = fn(x) -> bool: true
    expect(f(42)).to_eq(true)
  )
  it("param accepts int", fn():
    fn accept(v) -> bool:
      return true
    expect(accept(42)).to_eq(true)
  )
  it("param accepts float", fn():
    fn accept_f(v) -> bool:
      return true
    expect(accept_f(3.14)).to_eq(true)
  )
  it("param accepts str", fn():
    fn accept_s(v) -> bool:
      return true
    expect(accept_s("hello")).to_eq(true)
  )
  it("param accepts bool", fn():
    fn accept_b(v) -> bool:
      return true
    expect(accept_b(false)).to_eq(true)
  )
)

describe("any reassignment", fn():
  it("reassign int to float", fn():
    x: any = 42
    x = 3.14
    expect(true).to_eq(true)
  )
  it("reassign str to int", fn():
    x: any = "hello"
    x = 42
    expect(true).to_eq(true)
  )
  it("reassign bool to str", fn():
    x: any = true
    x = "world"
    expect(true).to_eq(true)
  )
)

describe("any arithmetic operators", fn():
  it("int + int", fn():
    x: any = 10
    y: any = 20
    z: any = x + y
    expect(true).to_eq(true)
  )
  it("int - int", fn():
    x: any = 30
    y: any = 10
    z: any = x - y
    expect(true).to_eq(true)
  )
  it("int * int", fn():
    x: any = 5
    y: any = 6
    z: any = x * y
    expect(true).to_eq(true)
  )
  it("int / int", fn():
    x: any = 10
    y: any = 3
    z: any = x / y
    expect(true).to_eq(true)
  )
  it("int % int", fn():
    x: any = 10
    y: any = 3
    z: any = x % y
    expect(true).to_eq(true)
  )
  it("int // int", fn():
    x: any = 7
    y: any = 2
    z: any = x // y
    expect(true).to_eq(true)
  )
  it("int ** int", fn():
    x: any = 2
    y: any = 10
    z: any = x ** y
    expect(true).to_eq(true)
  )
  it("float + float", fn():
    x: any = 1.5
    y: any = 2.5
    z: any = x + y
    expect(true).to_eq(true)
  )
  it("int + float (mixed)", fn():
    x: any = 10
    y: any = 3.14
    z: any = x + y
    expect(true).to_eq(true)
  )
  it("str + str (concat)", fn():
    x: any = "hello"
    y: any = " world"
    z: any = x + y
    expect(true).to_eq(true)
  )
  it("concrete + any (auto-wrap lhs)", fn():
    y: any = 20
    z: any = 10 + y
    expect(true).to_eq(true)
  )
  it("any + concrete (auto-wrap rhs)", fn():
    x: any = 10
    z: any = x + 20
    expect(true).to_eq(true)
  )
)

describe("any comparison operators", fn():
  it("int == int (true)", fn():
    x: any = 42
    y: any = 42
    expect(x == y).to_eq(true)
  )
  it("int == int (false)", fn():
    x: any = 42
    y: any = 99
    expect(x == y).to_eq(false)
  )
  it("int != int", fn():
    x: any = 1
    y: any = 2
    expect(x != y).to_eq(true)
  )
  it("int < int", fn():
    x: any = 1
    y: any = 2
    expect(x < y).to_eq(true)
  )
  it("int <= int", fn():
    x: any = 2
    y: any = 2
    expect(x <= y).to_eq(true)
  )
  it("int > int", fn():
    x: any = 3
    y: any = 2
    expect(x > y).to_eq(true)
  )
  it("int >= int", fn():
    x: any = 2
    y: any = 2
    expect(x >= y).to_eq(true)
  )
  it("str == str", fn():
    x: any = "hello"
    y: any = "hello"
    expect(x == y).to_eq(true)
  )
  it("mixed int/float comparison", fn():
    x: any = 3
    y: any = 3.0
    expect(x == y).to_eq(true)
  )
  it("concrete == any (auto-wrap)", fn():
    y: any = 42
    expect(42 == y).to_eq(true)
  )
)

describe("any unary negation", fn():
  it("negate int", fn():
    x: any = 42
    y: any = -x
    expect(true).to_eq(true)
  )
  it("negate float", fn():
    x: any = 3.14
    y: any = -x
    expect(true).to_eq(true)
  )
)
