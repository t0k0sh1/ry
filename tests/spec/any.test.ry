from testing import it, describe, expect

@describe("any type")
fn anyTypeTests():
  @it("should wrap int")
  fn shouldWrapInt():
    x: any = 42
    expect(true).toEq(true)
  @it("should wrap float")
  fn shouldWrapFloat():
    x: any = 3.14
    expect(true).toEq(true)
  @it("should wrap str")
  fn shouldWrapStr():
    x: any = "hello"
    expect(true).toEq(true)
  @it("should wrap bool")
  fn shouldWrapBool():
    x: any = true
    expect(true).toEq(true)

@describe("optional param type")
fn optionalParamTypeTests():
  @it("should accept single param without type annotation")
  fn shouldAcceptSingleParamWithoutTypeAnnotation():
    fn addOne(x) -> int:
      return 1
    expect(addOne(42)).toEq(1)
  @it("should accept multiple params without type annotation")
  fn shouldAcceptMultipleParamsWithoutTypeAnnotation():
    fn bothAny(x, y) -> bool:
      return true
    expect(bothAny(1, "hello")).toEq(true)
  @it("should accept mixed typed and untyped params")
  fn shouldAcceptMixedTypedAndUntypedParams():
    fn mixed(x: int, y) -> int:
      return x
    expect(mixed(10, "hello")).toEq(10)
  @it("should accept lambda without type annotation")
  fn shouldAcceptLambdaWithoutTypeAnnotation():
    f = (x) -> bool => true
    expect(f(42)).toEq(true)
  @it("should accept int as param")
  fn shouldAcceptIntAsParam():
    fn accept(v) -> bool:
      return true
    expect(accept(42)).toEq(true)
  @it("should accept float as param")
  fn shouldAcceptFloatAsParam():
    fn acceptF(v) -> bool:
      return true
    expect(acceptF(3.14)).toEq(true)
  @it("should accept str as param")
  fn shouldAcceptStrAsParam():
    fn acceptS(v) -> bool:
      return true
    expect(acceptS("hello")).toEq(true)
  @it("should accept bool as param")
  fn shouldAcceptBoolAsParam():
    fn acceptB(v) -> bool:
      return true
    expect(acceptB(false)).toEq(true)

@describe("any reassignment")
fn anyReassignmentTests():
  @it("should reassign int to float")
  fn shouldReassignIntToFloat():
    x: any = 42
    x = 3.14
    expect(true).toEq(true)
  @it("should reassign str to int")
  fn shouldReassignStrToInt():
    x: any = "hello"
    x = 42
    expect(true).toEq(true)
  @it("should reassign bool to str")
  fn shouldReassignBoolToStr():
    x: any = true
    x = "world"
    expect(true).toEq(true)

@describe("any arithmetic operators")
fn anyArithmeticOperatorsTests():
  @it("should support int + int")
  fn shouldSupportIntInt():
    x: any = 10
    y: any = 20
    z: any = x + y
    expect(z == 30).toEq(true)
  @it("should support int - int")
  fn shouldSupportIntInt2():
    x: any = 30
    y: any = 10
    z: any = x - y
    expect(z == 20).toEq(true)
  @it("should support int * int")
  fn shouldSupportIntInt3():
    x: any = 5
    y: any = 6
    z: any = x * y
    expect(z == 30).toEq(true)
  @it("should support int / int")
  fn shouldSupportIntInt4():
    x: any = 10
    y: any = 2
    z: any = x / y
    expect(z == 5.0).toEq(true)
  @it("should support int % int")
  fn shouldSupportIntInt5():
    x: any = 10
    y: any = 3
    z: any = x % y
    expect(z == 1).toEq(true)
  @it("should support int // int")
  fn shouldSupportIntInt6():
    x: any = 7
    y: any = 2
    z: any = x // y
    expect(z == 3).toEq(true)
  @it("should support int ** int")
  fn shouldSupportIntInt7():
    x: any = 2
    y: any = 10
    z: any = x ** y
    expect(z == 1024.0).toEq(true)
  @it("should support float + float")
  fn shouldSupportFloatFloat():
    x: any = 1.5
    y: any = 2.5
    z: any = x + y
    expect(z == 4.0).toEq(true)
  @it("should support int + float (mixed)")
  fn shouldSupportIntFloatMixed():
    x: any = 10
    y: any = 3.14
    z: any = x + y
    expect(z == 13.14).toEq(true)
  @it("should support str + str (concat)")
  fn shouldSupportStrStrConcat():
    x: any = "hello"
    y: any = " world"
    z: any = x + y
    expect(z == "hello world").toEq(true)
  @it("should support concrete + any (auto-wrap lhs)")
  fn shouldSupportConcreteAnyAutoWrapLhs():
    y: any = 20
    z: any = 10 + y
    expect(z == 30).toEq(true)
  @it("should support any + concrete (auto-wrap rhs)")
  fn shouldSupportAnyConcreteAutoWrapRhs():
    x: any = 10
    z: any = x + 20
    expect(z == 30).toEq(true)

@describe("any comparison operators")
fn anyComparisonOperatorsTests():
  @it("should compare int == int (true)")
  fn shouldCompareIntIntTrue():
    x: any = 42
    y: any = 42
    expect(x == y).toEq(true)
  @it("should compare int == int (false)")
  fn shouldCompareIntIntFalse():
    x: any = 42
    y: any = 99
    expect(x == y).toEq(false)
  @it("should support int != int")
  fn shouldSupportIntInt8():
    x: any = 1
    y: any = 2
    expect(x != y).toEq(true)
  @it("should support int < int")
  fn shouldSupportIntInt9():
    x: any = 1
    y: any = 2
    expect(x < y).toEq(true)
  @it("should support int <= int")
  fn shouldSupportIntInt10():
    x: any = 2
    y: any = 2
    expect(x <= y).toEq(true)
  @it("should support int > int")
  fn shouldSupportIntInt11():
    x: any = 3
    y: any = 2
    expect(x > y).toEq(true)
  @it("should support int >= int")
  fn shouldSupportIntInt12():
    x: any = 2
    y: any = 2
    expect(x >= y).toEq(true)
  @it("should compare str == str")
  fn shouldCompareStrStr():
    x: any = "hello"
    y: any = "hello"
    expect(x == y).toEq(true)
  @it("should handle mixed int/float comparison")
  fn shouldHandleMixedIntFloatComparison():
    x: any = 3
    y: any = 3.0
    expect(x == y).toEq(true)
  @it("should support concrete == any (auto-wrap)")
  fn shouldSupportConcreteAnyAutoWrap():
    y: any = 42
    expect(42 == y).toEq(true)

@describe("any unwrap in function call")
fn anyUnwrapInFunctionCallTests():
  @it("should pass any(int) to int param")
  fn shouldPassAnyIntToIntParam():
    fn typedInt(x: int) -> int:
      return x + 1
    v: any = 42
    expect(typedInt(v)).toEq(43)
  @it("should pass any(float) to float param")
  fn shouldPassAnyFloatToFloatParam():
    fn typedFloat(x: float) -> float:
      return x + 1.0
    v: any = 2.5
    expect(typedFloat(v)).toEq(3.5)
  @it("should pass any(str) to str param")
  fn shouldPassAnyStrToStrParam():
    fn typedStr(x: str) -> str:
      return x
    v: any = "hello"
    expect(typedStr(v)).toEq("hello")
  @it("should pass any(bool) to bool param")
  fn shouldPassAnyBoolToBoolParam():
    fn typedBool(x: bool) -> bool:
      return x
    v: any = true
    expect(typedBool(v)).toEq(true)

@describe("overload resolution: concrete preferred over any")
fn overloadResolutionConcretePreferredOverAnyTests():
  @it("should prefer concrete overload over any")
  fn shouldPreferConcreteOverloadOverAny():
    fn dispatch(x: int) -> str:
      return "int"
    fn dispatch(x) -> str:
      return "any"
    expect(dispatch(42)).toEq("int")

@describe("any print")
fn anyPrintTests():
  @it("should print int")
  fn shouldPrintInt():
    x: any = 42
    print(x)
    expect(true).toEq(true)
  @it("should print float")
  fn shouldPrintFloat():
    x: any = 3.14
    print(x)
    expect(true).toEq(true)
  @it("should print bool")
  fn shouldPrintBool():
    x: any = true
    print(x)
    expect(true).toEq(true)
  @it("should print str")
  fn shouldPrintStr():
    x: any = "hello"
    print(x)
    expect(true).toEq(true)

@describe("any toStr / f-string")
fn anyTostrFStringTests():
  @it("should convert int to str")
  fn shouldConvertIntToStr():
    x: any = 42
    expect(f"{x}").toEq("42")
  @it("should convert float to str")
  fn shouldConvertFloatToStr():
    x: any = 3.14
    expect(f"{x}").toEq("3.14")
  @it("should convert bool to str")
  fn shouldConvertBoolToStr():
    x: any = true
    expect(f"{x}").toEq("true")
  @it("should convert str to str")
  fn shouldConvertStrToStr():
    x: any = "hello"
    expect(f"{x}").toEq("hello")
  @it("should interpolate any in f-string")
  fn shouldInterpolateAnyInFString():
    x: any = 42
    expect(f"value is {x}").toEq("value is 42")
  @it("should convert unit to str")
  fn shouldConvertUnitToStr():
    fn unitFn() -> any:
      return
    x: any = unitFn()
    expect(f"{x}").toEq("Unit")

@describe("any unary negation")
fn anyUnaryNegationTests():
  @it("should negate int")
  fn shouldNegateInt():
    x: any = 42
    y: any = -x
    expect(y == -42).toEq(true)
  @it("should negate float")
  fn shouldNegateFloat():
    x: any = 3.14
    y: any = -x
    expect(y == -3.14).toEq(true)

@describe("any parameter computation")
fn anyParameterComputationTests():
  @it("should compute int addition via any params")
  fn shouldComputeIntAdditionViaAnyParams():
    fn add(a, b):
      return a + b
    expect(add(1, 2)).toEq(3)
  @it("should concatenate strings via any params")
  fn shouldConcatenateStringsViaAnyParams():
    fn concat(a, b):
      return a + b
    expect(concat("hello", " world")).toEq("hello world")
  @it("should multiply mixed int/float")
  fn shouldMultiplyMixedIntFloat():
    fn mul(a, b):
      return a * b
    expect(mul(3, 2.0)).toEq(6.0)
  @it("should compare via any params")
  fn shouldCompareViaAnyParams():
    fn greater(a, b):
      return a > b
    expect(greater(5, 3)).toEq(true)

@describe("any identity / round-trip")
fn anyIdentityRoundTripTests():
  @it("should preserve int through identity")
  fn shouldPreserveIntThroughIdentity():
    fn identity(x: any) -> any:
      return x
    expect(identity(42)).toEq(42)
  @it("should preserve str through identity")
  fn shouldPreserveStrThroughIdentity():
    fn identityS(x: any) -> any:
      return x
    expect(identityS("hi")).toEq("hi")
  @it("should preserve float through identity")
  fn shouldPreserveFloatThroughIdentity():
    fn identityF(x: any) -> any:
      return x
    expect(identityF(3.14)).toEq(3.14)
  @it("should preserve bool through identity")
  fn shouldPreserveBoolThroughIdentity():
    fn identityB(x: any) -> any:
      return x
    expect(identityB(true)).toEq(true)

@describe("any lambda computation")
fn anyLambdaComputationTests():
  @it("should support lambda with implicit any param and return")
  fn shouldSupportLambdaWithImplicitAnyParamAndReturn():
    f = (x):
      return x + 1
    expect(f(10)).toEq(11)
  @it("should return any from lambda computation")
  fn shouldReturnAnyFromLambdaComputation():
    f = (a, b):
      return a * b
    expect(f(3, 4)).toEq(12)

@describe("any default return type")
fn anyDefaultReturnTypeTests():
  @it("should return computed value from function with omitted return type")
  fn shouldReturnComputedValueFromFunctionWithOmittedReturnType():
    fn doubleVal(x: int):
      return x * 2
    expect(doubleVal(5)).toEq(10)

@describe("any to concrete conversion")
fn anyToConcreteConversionTests():
  @it("should unwrap any(int) to int variable")
  fn shouldUnwrapAnyIntToIntVariable():
    fn getInt() -> any:
      return 42
    x: int = getInt()
    expect(x).toEq(42)
  @it("should unwrap any(str) to str variable")
  fn shouldUnwrapAnyStrToStrVariable():
    fn getStr() -> any:
      return "hello"
    x: str = getStr()
    expect(x).toEq("hello")
  @it("should unwrap any(float) to float variable")
  fn shouldUnwrapAnyFloatToFloatVariable():
    fn getFloat() -> any:
      return 3.14
    x: float = getFloat()
    expect(x).toEq(3.14)
  @it("should unwrap any(bool) to bool variable")
  fn shouldUnwrapAnyBoolToBoolVariable():
    fn getBool() -> any:
      return true
    x: bool = getBool()
    expect(x).toEq(true)
  @it("should auto-promote int to float in unwrap")
  fn shouldAutoPromoteIntToFloatInUnwrap():
    fn getIntAny() -> any:
      return 42
    x: float = getIntAny()
    expect(x).toEq(42.0)
  @it("should reassign concrete variable from any value")
  fn shouldReassignConcreteVariableFromAnyValue():
    fn getAny() -> any:
      return 99
    x: int = 0
    x = getAny()
    expect(x).toEq(99)

@describe("any element in Map")
fn anyElementInMapTests():
  @it("should accept str value in Map<str, any>")
  fn shouldAcceptStrValueInMapStrAny():
    m: Map<str, any> = {}
    m["name"] = "Alice"
    v: str = m["name"]
    expect(v).toEq("Alice")
  @it("should accept int value in Map<str, any>")
  fn shouldAcceptIntValueInMapStrAny():
    m: Map<str, any> = {}
    m["age"] = 30
    v: int = m["age"]
    expect(v).toEq(30)
  @it("should accept float value in Map<str, any>")
  fn shouldAcceptFloatValueInMapStrAny():
    m: Map<str, any> = {}
    m["pi"] = 3.14
    v: float = m["pi"]
    expect(v).toEq(3.14)
  @it("should accept bool value in Map<str, any>")
  fn shouldAcceptBoolValueInMapStrAny():
    m: Map<str, any> = {}
    m["flag"] = true
    v: bool = m["flag"]
    expect(v).toEq(true)
  @it("should update existing key with new concrete value")
  fn shouldUpdateExistingKeyWithNewConcreteValue():
    m: Map<str, any> = {}
    m["x"] = 1
    m["x"] = "updated"
    v: str = m["x"]
    expect(v).toEq("updated")
  @it("should unwrap any value into Map<str, int>")
  fn shouldUnwrapAnyValueIntoMapStrInt():
    v: any = 42
    m: Map<str, int> = {}
    m["x"] = v
    expect(m["x"]).toEq(42)
  @it("should support 'in' with str key on Map<str, any>")
  fn shouldSupportInWithStrKeyOnMapStrAny():
    m: Map<str, any> = {}
    m["name"] = "Alice"
    expect("name" in m).toEq(true)
    expect("missing" in m).toEq(false)
    expect("missing" not in m).toEq(true)
  @it("should support 'in' with any key on concrete Map<str, int>")
  fn shouldSupportInWithAnyKeyOnConcreteMapStrInt():
    m: Map<str, int> = {}
    m["x"] = 1
    k: any = "x"
    expect(k in m).toEq(true)

@describe("any element in List")
fn anyElementInListTests():
  @it("should append! str to List<any>")
  fn shouldAppendStrToListAny():
    xs: List<any> = []
    append!(xs, "hello")
    v: str = xs[0]
    expect(v).toEq("hello")
  @it("should append! int to List<any>")
  fn shouldAppendIntToListAny():
    xs: List<any> = []
    append!(xs, 42)
    v: int = xs[0]
    expect(v).toEq(42)
  @it("should append! float to List<any>")
  fn shouldAppendFloatToListAny():
    xs: List<any> = []
    append!(xs, 3.14)
    v: float = xs[0]
    expect(v).toEq(3.14)
  @it("should append! bool to List<any>")
  fn shouldAppendBoolToListAny():
    xs: List<any> = []
    append!(xs, true)
    v: bool = xs[0]
    expect(v).toEq(true)
  @it("should use appended with concrete value on List<any>")
  fn shouldUseAppendedWithConcreteValueOnListAny():
    xs: List<any> = []
    ys = appended(xs, "new")
    v: str = ys[0]
    expect(v).toEq("new")
  @it("should insert concrete value into List<any>")
  fn shouldInsertConcreteValueIntoListAny():
    xs: List<any> = []
    append!(xs, 99)
    insert(xs, 0, "first")
    v: str = xs[0]
    expect(v).toEq("first")
  @it("should assign concrete value at index in List<any>")
  fn shouldAssignConcreteValueAtIndexInListAny():
    xs: List<any> = []
    append!(xs, 0)
    xs[0] = 99
    v: int = xs[0]
    expect(v).toEq(99)
  @it("should unwrap any value into List<int>")
  fn shouldUnwrapAnyValueIntoListInt():
    v: any = 7
    xs: List<int> = [1, 2, 3]
    xs[0] = v
    expect(xs[0]).toEq(7)
  @it("should support compound assign += on List<any>")
  fn shouldSupportCompoundAssignOnListAny():
    xs: List<any> = []
    append!(xs, 10)
    xs[0] += 5
    v: int = xs[0]
    expect(v).toEq(15)
  @it("should support 'in' with str on List<any>")
  fn shouldSupportInWithStrOnListAny():
    xs: List<any> = []
    append!(xs, "hello")
    append!(xs, 42)
    expect("hello" in xs).toEq(true)
    expect("missing" in xs).toEq(false)
    expect("missing" not in xs).toEq(true)
  @it("should support 'in' with int on List<any>")
  fn shouldSupportInWithIntOnListAny():
    xs: List<any> = []
    append!(xs, 1)
    append!(xs, 2)
    expect(2 in xs).toEq(true)
    expect(99 not in xs).toEq(true)
  @it("should support 'in' with bool on List<any>")
  fn shouldSupportInWithBoolOnListAny():
    xs: List<any> = []
    append!(xs, true)
    expect(true in xs).toEq(true)
  @it("should support 'in' with any value on concrete List<int>")
  fn shouldSupportInWithAnyValueOnConcreteListInt():
    xs: List<int> = [1, 2, 3]
    v: any = 2
    expect(v in xs).toEq(true)

@describe("any element in Set")
fn anyElementInSetTests():
  @it("should add str to Set<any>")
  fn shouldAddStrToSetAny():
    s: Set<any> = {}
    add(s, "x")
    expect(s).toHaveLen(1)
  @it("should add int to Set<any>")
  fn shouldAddIntToSetAny():
    s: Set<any> = {}
    add(s, 1)
    expect(s).toHaveLen(1)
  @it("should add float to Set<any>")
  fn shouldAddFloatToSetAny():
    s: Set<any> = {}
    add(s, 3.14)
    expect(s).toHaveLen(1)
  @it("should add bool to Set<any>")
  fn shouldAddBoolToSetAny():
    s: Set<any> = {}
    add(s, true)
    expect(s).toHaveLen(1)
  @it("should add multiple distinct concrete types to Set<any>")
  fn shouldAddMultipleDistinctConcreteTypesToSetAny():
    s: Set<any> = {}
    add(s, "x")
    add(s, 1)
    expect(s).toHaveLen(2)
  @it("should unwrap any value into Set<int>")
  fn shouldUnwrapAnyValueIntoSetInt():
    v: any = 5
    s: Set<int> = {}
    add(s, v)
    expect(5 in s).toEq(true)
  @it("should support 'in' with str on Set<any>")
  fn shouldSupportInWithStrOnSetAny():
    s: Set<any> = {}
    add(s, "x")
    expect("x" in s).toEq(true)
    expect("y" in s).toEq(false)
    expect("y" not in s).toEq(true)
  @it("should support 'in' with int on Set<any>")
  fn shouldSupportInWithIntOnSetAny():
    s: Set<any> = {}
    add(s, 1)
    expect(1 in s).toEq(true)
  @it("should support 'in' with float on Set<any>")
  fn shouldSupportInWithFloatOnSetAny():
    s: Set<any> = {}
    add(s, 3.14)
    expect(3.14 in s).toEq(true)
  @it("should support 'in' with any value on concrete Set<int>")
  fn shouldSupportInWithAnyValueOnConcreteSetInt():
    s: Set<int> = {}
    add(s, 5)
    v: any = 5
    expect(v in s).toEq(true)

@describe("any holds collection")
fn anyHoldsCollectionTests():
  @it("should wrap List<int> in any")
  fn shouldWrapListIntInAny():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    expect(true).toEq(true)
  @it("should wrap List<str> in any")
  fn shouldWrapListStrInAny():
    xs: List<str> = ["a", "b"]
    a: any = xs
    expect(true).toEq(true)
  @it("should wrap Map<str, int> in any")
  fn shouldWrapMapStrIntInAny():
    m: Map<str, int> = {}
    m["x"] = 1
    a: any = m
    expect(true).toEq(true)
  @it("should wrap Set<int> in any")
  fn shouldWrapSetIntInAny():
    s: Set<int> = {}
    add(s, 1)
    a: any = s
    expect(true).toEq(true)
  @it("should implicit-unwrap any back to List<int>")
  fn shouldImplicitUnwrapAnyBackToListInt():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    ys: List<int> = a
    expect(ys[0]).toEq(1)
    expect(ys[1]).toEq(2)
    expect(ys[2]).toEq(3)
  @it("should implicit-unwrap any back to Map<str, int>")
  fn shouldImplicitUnwrapAnyBackToMapStrInt():
    m: Map<str, int> = {}
    m["x"] = 42
    a: any = m
    n: Map<str, int> = a
    expect(n["x"]).toEq(42)
  @it("should implicit-unwrap any back to Set<int>")
  fn shouldImplicitUnwrapAnyBackToSetInt():
    s: Set<int> = {}
    add(s, 7)
    a: any = s
    t: Set<int> = a
    expect(7 in t).toEq(true)
  @it("should preserve list contents through any roundtrip in function")
  fn shouldPreserveListThroughAnyRoundtripInFn():
    fn identityAny(v: any) -> any:
      return v
    xs: List<int> = [10, 20]
    a: any = identityAny(xs)
    ys: List<int> = a
    expect(ys[0]).toEq(10)
    expect(ys[1]).toEq(20)
  @it("should compare two any aliasing the same list with == (pointer identity)")
  fn shouldCompareTwoAnyAliasingSameListWithEq():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    b: any = xs
    expect(a == b).toEq(true)
  @it("should not consider two any holding distinct equal-content lists equal")
  fn shouldNotConsiderTwoAnyHoldingDistinctEqualListsEqual():
    xs: List<int> = [1, 2, 3]
    ys: List<int> = [1, 2, 3]
    a: any = xs
    b: any = ys
    expect(a == b).toEq(false)
  @it("should compare two any holding different lists with ==")
  fn shouldCompareTwoAnyHoldingDifferentListsWithEq():
    xs: List<int> = [1, 2, 3]
    ys: List<int> = [1, 2, 4]
    a: any = xs
    b: any = ys
    expect(a == b).toEq(false)
  @it("should compare two any aliasing the same map with ==")
  fn shouldCompareTwoAnyAliasingSameMapWithEq():
    m: Map<str, int> = {"k": 1}
    a: any = m
    b: any = m
    expect(a == b).toEq(true)
  @it("should compare two any aliasing the same set with ==")
  fn shouldCompareTwoAnyAliasingSameSetWithEq():
    s: Set<int> = {}
    add(s, 1)
    a: any = s
    b: any = s
    expect(a == b).toEq(true)
  @it("should render any holding a list as <List> marker")
  fn shouldRenderAnyHoldingAListAsMarker():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    expect(f"{a}").toEq("<List>")
  @it("should render any holding a map as <Map> marker")
  fn shouldRenderAnyHoldingAMapAsMarker():
    m: Map<str, int> = {"a": 1}
    a: any = m
    expect(f"{a}").toEq("<Map>")
  @it("should render any holding a set as <Set> marker")
  fn shouldRenderAnyHoldingASetAsMarker():
    s: Set<int> = {}
    add(s, 1)
    a: any = s
    expect(f"{a}").toEq("<Set>")
  @it("should retain payload across any-to-any copy (regression: #1697 double-free)")
  fn shouldRetainPayloadAcrossAnyToAnyCopy():
    xs: List<int> = [10, 20, 30]
    a: any = xs
    b: any = a
    ys: List<int> = b
    expect(ys[0]).toEq(10)
    expect(ys[2]).toEq(30)
  @it("should retain payload when an any holds a map and is copied to another any")
  fn shouldRetainPayloadOnAnyToAnyMapCopy():
    m: Map<str, int> = {"a": 1, "b": 2}
    a: any = m
    b: any = a
    expect(f"{b}").toEq("<Map>")
  @it("should retain payload when an any holds a set and is copied to another any")
  fn shouldRetainPayloadOnAnyToAnySetCopy():
    s: Set<int> = {}
    add(s, 7)
    add(s, 8)
    a: any = s
    b: any = a
    expect(f"{b}").toEq("<Set>")
  @it("should reassign any-to-any without leaking the prior payload")
  fn shouldReassignAnyToAnyWithoutLeak():
    xs: List<int> = [1, 2]
    ys: List<int> = [3, 4, 5]
    a: any = xs
    b: any = ys
    a = b
    zs: List<int> = a
    expect(zs[2]).toEq(5)
