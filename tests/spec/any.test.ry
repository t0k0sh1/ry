from ry.testing import it, describe, expect, fail

@describe("any type")
fn anyTypeTests():
  @it("should wrap int")
  fn shouldWrapInt():
    x: any = 42
    expect(true).toEq(true)
  @it("should wrap float")
  fn shouldWrapFloat():
    x: any = 3.14
    expect(true).toEq(true)
  @it("should wrap str")
  fn shouldWrapStr():
    x: any = "hello"
    expect(true).toEq(true)
  @it("should wrap bool")
  fn shouldWrapBool():
    x: any = true
    expect(true).toEq(true)

@describe("explicit any-typed parameters")
fn explicitAnyTypedParametersTests():
  @it("should accept single param with explicit any annotation")
  fn shouldAcceptSingleParamWithExplicitAnyAnnotation():
    fn addOne(x: any) -> int:
      return 1
    expect(addOne(42)).toEq(1)
  @it("should accept multiple params with explicit any annotation")
  fn shouldAcceptMultipleParamsWithExplicitAnyAnnotation():
    fn bothAny(x: any, y: any) -> bool:
      return true
    expect(bothAny(1, "hello")).toEq(true)
  @it("should accept mixed typed and any-typed params")
  fn shouldAcceptMixedTypedAndAnyTypedParams():
    fn mixed(x: int, y: any) -> int:
      return x
    expect(mixed(10, "hello")).toEq(10)
  @it("should accept lambda with explicit any annotation")
  fn shouldAcceptLambdaWithExplicitAnyAnnotation():
    f = (x: any) -> bool => true
    expect(f(42)).toEq(true)
  @it("should accept int as param")
  fn shouldAcceptIntAsParam():
    fn accept(v: any) -> bool:
      return true
    expect(accept(42)).toEq(true)
  @it("should accept float as param")
  fn shouldAcceptFloatAsParam():
    fn acceptF(v: any) -> bool:
      return true
    expect(acceptF(3.14)).toEq(true)
  @it("should accept str as param")
  fn shouldAcceptStrAsParam():
    fn acceptS(v: any) -> bool:
      return true
    expect(acceptS("hello")).toEq(true)
  @it("should accept bool as param")
  fn shouldAcceptBoolAsParam():
    fn acceptB(v: any) -> bool:
      return true
    expect(acceptB(false)).toEq(true)

@describe("any reassignment")
fn anyReassignmentTests():
  @it("should reassign int to float")
  fn shouldReassignIntToFloat():
    x: any = 42
    x = 3.14
    expect(true).toEq(true)
  @it("should reassign str to int")
  fn shouldReassignStrToInt():
    x: any = "hello"
    x = 42
    expect(true).toEq(true)
  @it("should reassign bool to str")
  fn shouldReassignBoolToStr():
    x: any = true
    x = "world"
    expect(true).toEq(true)

@describe("any arithmetic via asType[T] narrowing")
fn anyArithmeticViaAsTypeTests():
  # Direct arithmetic on `any` is rejected by `[strict-any/any-arithmetic]`
  # since #2322. The canonical recovery is `case asType[T](v):` narrowing —
  # one block per representative op covers the runtime side. Per-op
  # rejection is locked in by tests/test_strict_any.cpp.
  @it("should compute int + int after asType[int] narrowing")
  fn shouldComputeIntPlusIntAfterAsType():
    a: any = 10
    b: any = 20
    case asType[int](a):
      Ok(ai):
        case asType[int](b):
          Ok(bi): expect(ai + bi).toEq(30)
          Err(_): fail("b not int")
      Err(_): fail("a not int")
  @it("should compute float + float after asType[float] narrowing")
  fn shouldComputeFloatPlusFloatAfterAsType():
    a: any = 1.5
    b: any = 2.5
    case asType[float](a):
      Ok(af):
        case asType[float](b):
          Ok(bf): expect(af + bf == 4.0).toEq(true)
          Err(_): fail("b not float")
      Err(_): fail("a not float")
  @it("should concat str + str after asType[str] narrowing")
  fn shouldConcatStrPlusStrAfterAsType():
    a: any = "hello"
    b: any = " world"
    case asType[str](a):
      Ok(astr):
        case asType[str](b):
          Ok(bstr): expect(astr + bstr).toEq("hello world")
          Err(_): fail("b not str")
      Err(_): fail("a not str")

@describe("any equality operators")
fn anyEqualityOperatorsTests():
  # Equality (`==`, `!=`) stays permitted on `any` because `__ry_any_eq`
  # returns 0 on type mismatch (safe). Ordering (`<`, `<=`, `>`, `>=`) was
  # promoted to the `any-arithmetic` rule in #2322; use `asType[T]` to
  # narrow first when ordering is required (covered above).
  @it("should compare int == int (true)")
  fn shouldCompareIntIntTrue():
    x: any = 42
    y: any = 42
    expect(x == y).toEq(true)
  @it("should compare int == int (false)")
  fn shouldCompareIntIntFalse():
    x: any = 42
    y: any = 99
    expect(x == y).toEq(false)
  @it("should support int != int")
  fn shouldSupportIntInt8():
    x: any = 1
    y: any = 2
    expect(x != y).toEq(true)
  @it("should compare str == str")
  fn shouldCompareStrStr():
    x: any = "hello"
    y: any = "hello"
    expect(x == y).toEq(true)
  @it("should handle mixed int/float comparison")
  fn shouldHandleMixedIntFloatComparison():
    x: any = 3
    y: any = 3.0
    expect(x == y).toEq(true)
  @it("should support concrete == any (auto-wrap)")
  fn shouldSupportConcreteAnyAutoWrap():
    y: any = 42
    expect(42 == y).toEq(true)

# `any -> concrete` implicit unwrap is rejected by
# `[strict-any/any-implicit-unwrap]` across all Path 9 sites: variable
# decl + named-fn / lambda parameters + Result / Option slots
# (#2322, Path 9a-9d), plus reassign of typed variables, return from
# typed fn / lambda, and typed-collection mutation paths
# (#2379, Path 9e-9g — append!/appended/insert/set add/set remove/
# m[k]=/xs[i]=). Per-site rejection is locked in by
# tests/test_strict_any.cpp::AnyImplicitUnwrap*RejectedByDefault;
# canonical recovery is `case asType[T](v):` narrowing before the
# boundary. Read-only `any → concrete` paths (the `in` / `not in`
# operator and the `get(list, idx, default)` fallback) continue to
# unwrap silently — see docs/reference/strict-any.md.

@describe("any-implicit-unwrap (#2379) canonical recovery at new surfaces")
fn anyImplicitUnwrapExtendedRecoveryTests():
  # Lock in that `case asType[T](v): Ok(n): ...` works at the three
  # surfaces extended in #2379. The narrowed binding (`n`) is concrete,
  # so the downstream reassign / return / collection mutation does NOT
  # re-trigger the rule.
  @it("should reassign typed variable from any after asType narrowing")
  fn shouldReassignTypedVariableAfterAsType():
    x: int = 1
    v: any = 42
    case asType[int](v):
      Ok(n): x = n
      Err(_): fail("expected int")
    expect(x).toEq(42)
  @it("should return from typed fn after asType narrowing of any")
  fn shouldReturnFromTypedFnAfterAsType():
    fn f(v: any) -> int:
      case asType[int](v):
        Ok(n): return n
        Err(_): return -1
    expect(f(7)).toEq(7)
    expect(f("not int")).toEq(-1)
  @it("should append! after asType narrowing of any")
  fn shouldAppendAfterAsType():
    xs: List<int> = []
    v: any = 9
    case asType[int](v):
      Ok(n): append!(xs, n)
      Err(_): fail("expected int")
    expect(xs[0]).toEq(9)
  @it("should map index assign after asType narrowing of any")
  fn shouldMapIndexAssignAfterAsType():
    m: Map<str, int> = {"a": 1}
    v: any = 5
    case asType[int](v):
      Ok(n): m["a"] = n
      Err(_): fail("expected int")
    expect(m["a"]).toEq(5)

@describe("overload resolution: concrete preferred over any")
fn overloadResolutionConcretePreferredOverAnyTests():
  @it("should prefer concrete overload over any")
  fn shouldPreferConcreteOverloadOverAny():
    fn dispatch(x: int) -> str:
      return "int"
    fn dispatch(x: any) -> str:
      return "any"
    expect(dispatch(42)).toEq("int")

@describe("any print")
fn anyPrintTests():
  @it("should print int")
  fn shouldPrintInt():
    x: any = 42
    print(x)
    expect(true).toEq(true)
  @it("should print float")
  fn shouldPrintFloat():
    x: any = 3.14
    print(x)
    expect(true).toEq(true)
  @it("should print bool")
  fn shouldPrintBool():
    x: any = true
    print(x)
    expect(true).toEq(true)
  @it("should print str")
  fn shouldPrintStr():
    x: any = "hello"
    print(x)
    expect(true).toEq(true)

@describe("any str / f-string")
fn anyTostrFStringTests():
  @it("should convert int to str")
  fn shouldConvertIntToStr():
    x: any = 42
    expect(f"{x}").toEq("42")
  @it("should convert float to str")
  fn shouldConvertFloatToStr():
    x: any = 3.14
    expect(f"{x}").toEq("3.14")
  @it("should convert bool to str")
  fn shouldConvertBoolToStr():
    x: any = true
    expect(f"{x}").toEq("true")
  @it("should convert str to str")
  fn shouldConvertStrToStr():
    x: any = "hello"
    expect(f"{x}").toEq("hello")
  @it("should interpolate any in f-string")
  fn shouldInterpolateAnyInFString():
    x: any = 42
    expect(f"value is {x}").toEq("value is 42")
  @it("should convert unit to str")
  fn shouldConvertUnitToStr():
    fn unitFn() -> any:
      return
    x: any = unitFn()
    expect(f"{x}").toEq("Unit")

# Unary `-` on `any` and direct arithmetic / ordering inside fn bodies
# whose parameters are typed `any` are rejected by the
# `[strict-any/any-arithmetic]` rule since #2322. Per-op rejection lives
# in tests/test_strict_any.cpp.

@describe("any identity / round-trip")
fn anyIdentityRoundTripTests():
  @it("should preserve int through identity")
  fn shouldPreserveIntThroughIdentity():
    fn identity(x: any) -> any:
      return x
    expect(identity(42)).toEq(42)
  @it("should preserve str through identity")
  fn shouldPreserveStrThroughIdentity():
    fn identityS(x: any) -> any:
      return x
    expect(identityS("hi")).toEq("hi")
  @it("should preserve float through identity")
  fn shouldPreserveFloatThroughIdentity():
    fn identityF(x: any) -> any:
      return x
    expect(identityF(3.14)).toEq(3.14)
  @it("should preserve bool through identity")
  fn shouldPreserveBoolThroughIdentity():
    fn identityB(x: any) -> any:
      return x
    expect(identityB(true)).toEq(true)

# Lambdas with `any`-typed params can no longer compute on those params
# directly: the body's `a + b` / `a * b` hit the `any-arithmetic` rule
# (#2322). The lambda surface itself still supports `(x: any)` as an
# explicit type-erasure intake — see "any identity / round-trip" tests
# below for the canonical pattern.

@describe("any default return type")
fn anyDefaultReturnTypeTests():
  @it("should return computed value from function with omitted return type")
  fn shouldReturnComputedValueFromFunctionWithOmittedReturnType():
    fn doubleVal(x: int):
      return x * 2
    expect(doubleVal(5)).toEq(10)

@describe("any to concrete via asType[T]")
fn anyToConcreteViaAsTypeTests():
  # `x: int = anyVal` is rejected by `[strict-any/any-implicit-unwrap]`
  # (#2322). Per-site rejection is in tests/test_strict_any.cpp; the
  # blocks below cover the canonical recovery `case asType[T](v):` for
  # each scalar payload type.
  @it("should narrow any(int) to int via asType")
  fn shouldNarrowAnyIntToIntViaAsType():
    fn getInt() -> any:
      return 42
    case asType[int](getInt()):
      Ok(x): expect(x).toEq(42)
      Err(_): fail("expected int")
  @it("should narrow any(str) to str via asType")
  fn shouldNarrowAnyStrToStrViaAsType():
    fn getStr() -> any:
      return "hello"
    case asType[str](getStr()):
      Ok(x): expect(x).toEq("hello")
      Err(_): fail("expected str")
  @it("should narrow any(float) to float via asType")
  fn shouldNarrowAnyFloatToFloatViaAsType():
    fn getFloat() -> any:
      return 3.14
    case asType[float](getFloat()):
      Ok(x): expect(x == 3.14).toEq(true)
      Err(_): fail("expected float")
  @it("should narrow any(bool) to bool via asType")
  fn shouldNarrowAnyBoolToBoolViaAsType():
    fn getBool() -> any:
      return true
    case asType[bool](getBool()):
      Ok(x): expect(x).toEq(true)
      Err(_): fail("expected bool")
  @it("should surface Err from asType on type mismatch")
  fn shouldSurfaceErrFromAsTypeOnTypeMismatch():
    fn getStr() -> any:
      return "not a number"
    case asType[int](getStr()):
      Ok(_): fail("expected Err for str -> int")
      Err(_): expect(true).toEq(true)

@describe("any element in Map")
fn anyElementInMapTests():
  # `v: T = m[key]` on `Map<str, any>` is rejected by
  # `[strict-any/any-implicit-unwrap]` since #2322 — the indexed access
  # surfaces an `any` value, and the variable assignment is Path 9a.
  # Map insertion and `in` membership are unaffected and stay covered.
  @it("should narrow str value in Map<str, any> via asType")
  fn shouldNarrowStrValueInMapStrAnyViaAsType():
    m: Map<str, any> = {}
    m["name"] = "Alice"
    case asType[str](m["name"]):
      Ok(v): expect(v).toEq("Alice")
      Err(_): fail("expected str")
  @it("should narrow int value in Map<str, any> via asType")
  fn shouldNarrowIntValueInMapStrAnyViaAsType():
    m: Map<str, any> = {}
    m["age"] = 30
    case asType[int](m["age"]):
      Ok(v): expect(v).toEq(30)
      Err(_): fail("expected int")
  @it("should accept float value in Map<str, any> (membership only)")
  fn shouldAcceptFloatValueInMapStrAnyMembershipOnly():
    m: Map<str, any> = {}
    m["pi"] = 3.14
    expect("pi" in m).toEq(true)
  @it("should narrow bool value in Map<str, any> via asType")
  fn shouldNarrowBoolValueInMapStrAnyViaAsType():
    m: Map<str, any> = {}
    m["flag"] = true
    case asType[bool](m["flag"]):
      Ok(v): expect(v).toEq(true)
      Err(_): fail("expected bool")
  @it("should update existing key with new concrete value")
  fn shouldUpdateExistingKeyWithNewConcreteValue():
    m: Map<str, any> = {}
    m["x"] = 1
    m["x"] = "updated"
    case asType[str](m["x"]):
      Ok(v): expect(v).toEq("updated")
      Err(_): fail("expected str")
  @it("should support 'in' with str key on Map<str, any>")
  fn shouldSupportInWithStrKeyOnMapStrAny():
    m: Map<str, any> = {}
    m["name"] = "Alice"
    expect("name" in m).toEq(true)
    expect("missing" in m).toEq(false)
    expect("missing" not in m).toEq(true)
  @it("should support 'in' with any key on concrete Map<str, int>")
  fn shouldSupportInWithAnyKeyOnConcreteMapStrInt():
    m: Map<str, int> = {}
    m["x"] = 1
    k: any = "x"
    expect(k in m).toEq(true)
  @it("should narrow mixed value types in Map<str, any> literal via asType")
  fn shouldNarrowMixedValueTypesInMapStrAnyLiteralViaAsType():
    m: Map<str, any> = {"a": 1, "b": "two", "c": true}
    case asType[int](m["a"]):
      Ok(vi): expect(vi).toEq(1)
      Err(_): fail("a not int")
    case asType[str](m["b"]):
      Ok(vs): expect(vs).toEq("two")
      Err(_): fail("b not str")
    case asType[bool](m["c"]):
      Ok(vb): expect(vb).toEq(true)
      Err(_): fail("c not bool")

@describe("any element in List")
fn anyElementInListTests():
  # `v: T = xs[0]` on `List<any>` is Path 9a and rejected by
  # `[strict-any/any-implicit-unwrap]` (#2322). Tests below use
  # `case asType[T](xs[0])` for narrowing. Mutation on a `List<any>`
  # receiver with concrete-typed values (wrap-into-any direction) is
  # unaffected; the reverse direction — mutating a concrete-typed
  # collection with an `any` value — is rejected as of #2379. `in`
  # membership stays unchanged (read-only path).
  @it("should append! str and narrow back via asType")
  fn shouldAppendStrAndNarrowViaAsType():
    xs: List<any> = []
    append!(xs, "hello")
    case asType[str](xs[0]):
      Ok(v): expect(v).toEq("hello")
      Err(_): fail("expected str")
  @it("should append! int and narrow back via asType")
  fn shouldAppendIntAndNarrowViaAsType():
    xs: List<any> = []
    append!(xs, 42)
    case asType[int](xs[0]):
      Ok(v): expect(v).toEq(42)
      Err(_): fail("expected int")
  @it("should append! bool and narrow back via asType")
  fn shouldAppendBoolAndNarrowViaAsType():
    xs: List<any> = []
    append!(xs, true)
    case asType[bool](xs[0]):
      Ok(v): expect(v).toEq(true)
      Err(_): fail("expected bool")
  @it("should use appended with concrete value on List<any>")
  fn shouldUseAppendedWithConcreteValueOnListAny():
    xs: List<any> = []
    ys = appended(xs, "new")
    case asType[str](ys[0]):
      Ok(v): expect(v).toEq("new")
      Err(_): fail("expected str")
  @it("should insert and assign concrete values into List<any>")
  fn shouldInsertAndAssignConcreteValuesInListAny():
    xs: List<any> = []
    append!(xs, 99)
    insert(xs, 0, "first")
    case asType[str](xs[0]):
      Ok(v): expect(v).toEq("first")
      Err(_): fail("expected str")
    xs[1] = 7
    case asType[int](xs[1]):
      Ok(v): expect(v).toEq(7)
      Err(_): fail("expected int")
  @it("should support 'in' with str on List<any>")
  fn shouldSupportInWithStrOnListAny():
    xs: List<any> = []
    append!(xs, "hello")
    append!(xs, 42)
    expect("hello" in xs).toEq(true)
    expect("missing" in xs).toEq(false)
    expect("missing" not in xs).toEq(true)
  @it("should support 'in' with int on List<any>")
  fn shouldSupportInWithIntOnListAny():
    xs: List<any> = []
    append!(xs, 1)
    append!(xs, 2)
    expect(2 in xs).toEq(true)
    expect(99 not in xs).toEq(true)
  @it("should support 'in' with bool on List<any>")
  fn shouldSupportInWithBoolOnListAny():
    xs: List<any> = []
    append!(xs, true)
    expect(true in xs).toEq(true)
  @it("should support 'in' with any value on concrete List<int>")
  fn shouldSupportInWithAnyValueOnConcreteListInt():
    xs: List<int> = [1, 2, 3]
    v: any = 2
    expect(v in xs).toEq(true)
  @it("should narrow mixed element types from List<any> literal via asType")
  fn shouldNarrowMixedElementTypesFromListAnyLiteralViaAsType():
    xs: List<any> = [1, "x", true]
    case asType[int](xs[0]):
      Ok(vi): expect(vi).toEq(1)
      Err(_): fail("xs[0] not int")
    case asType[str](xs[1]):
      Ok(vs): expect(vs).toEq("x")
      Err(_): fail("xs[1] not str")
    case asType[bool](xs[2]):
      Ok(vb): expect(vb).toEq(true)
      Err(_): fail("xs[2] not bool")

@describe("any element in Set")
fn anyElementInSetTests():
  @it("should add str to Set<any>")
  fn shouldAddStrToSetAny():
    s: Set<any> = {}
    add(s, "x")
    expect(s).toHaveLen(1)
  @it("should add int to Set<any>")
  fn shouldAddIntToSetAny():
    s: Set<any> = {}
    add(s, 1)
    expect(s).toHaveLen(1)
  @it("should add float to Set<any>")
  fn shouldAddFloatToSetAny():
    s: Set<any> = {}
    add(s, 3.14)
    expect(s).toHaveLen(1)
  @it("should add bool to Set<any>")
  fn shouldAddBoolToSetAny():
    s: Set<any> = {}
    add(s, true)
    expect(s).toHaveLen(1)
  @it("should add multiple distinct concrete types to Set<any>")
  fn shouldAddMultipleDistinctConcreteTypesToSetAny():
    s: Set<any> = {}
    add(s, "x")
    add(s, 1)
    expect(s).toHaveLen(2)
  @it("should narrow any value before adding into Set<int>")
  fn shouldNarrowAnyValueBeforeAddingIntoSetInt():
    v: any = 5
    s: Set<int> = {}
    case asType[int](v):
      Ok(n): add(s, n)
      Err(_): fail("expected int")
    expect(5 in s).toEq(true)
  @it("should support 'in' with str on Set<any>")
  fn shouldSupportInWithStrOnSetAny():
    s: Set<any> = {}
    add(s, "x")
    expect("x" in s).toEq(true)
    expect("y" in s).toEq(false)
    expect("y" not in s).toEq(true)
  @it("should support 'in' with int on Set<any>")
  fn shouldSupportInWithIntOnSetAny():
    s: Set<any> = {}
    add(s, 1)
    expect(1 in s).toEq(true)
  @it("should support 'in' with float on Set<any>")
  fn shouldSupportInWithFloatOnSetAny():
    s: Set<any> = {}
    add(s, 3.14)
    expect(3.14 in s).toEq(true)
  @it("should support 'in' with any value on concrete Set<int>")
  fn shouldSupportInWithAnyValueOnConcreteSetInt():
    s: Set<int> = {}
    add(s, 5)
    v: any = 5
    expect(v in s).toEq(true)
  @it("should accept mixed element types in Set<any> literal")
  fn shouldAcceptMixedElementTypesInSetAnyLiteral():
    s: Set<any> = {1, "x", true}
    expect(s).toHaveLen(3)
    expect(1 in s).toEq(true)
    expect("x" in s).toEq(true)
    expect(true in s).toEq(true)

@describe("any holds collection")
fn anyHoldsCollectionTests():
  @it("should wrap List<int> in any")
  fn shouldWrapListIntInAny():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    expect(true).toEq(true)
  @it("should wrap List<str> in any")
  fn shouldWrapListStrInAny():
    xs: List<str> = ["a", "b"]
    a: any = xs
    expect(true).toEq(true)
  @it("should wrap Map<str, int> in any")
  fn shouldWrapMapStrIntInAny():
    m: Map<str, int> = {}
    m["x"] = 1
    a: any = m
    expect(true).toEq(true)
  @it("should wrap Set<int> in any")
  fn shouldWrapSetIntInAny():
    s: Set<int> = {}
    add(s, 1)
    a: any = s
    expect(true).toEq(true)
  # Roundtripping a *typed* collection (`List<int>` / `Map<str, int>` /
  # `Set<int>`) through `any` and recovering the original concrete type
  # was previously the `xs: List<int> = anyVal` shape. After #2322 it is
  # rejected by `[strict-any/any-implicit-unwrap]`; `asType[List<int>]`
  # accepts only JSON-shaped (`List<any>` / `Map<str, any>` / `Set<any>`)
  # sources via its `tryUnwrapFromAny` path. Reading back a native typed
  # collection from `any` is intentionally not supported on v0.0.30 — use
  # `case asType[List<any>](v)` plus per-element narrowing, or keep the
  # value statically typed and skip the `any` round-trip entirely.
  @it("should compare two any aliasing the same list with == (pointer identity)")
  fn shouldCompareTwoAnyAliasingSameListWithEq():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    b: any = xs
    expect(a == b).toEq(true)
  @it("should not consider two any holding distinct equal-content lists equal")
  fn shouldNotConsiderTwoAnyHoldingDistinctEqualListsEqual():
    xs: List<int> = [1, 2, 3]
    ys: List<int> = [1, 2, 3]
    a: any = xs
    b: any = ys
    expect(a == b).toEq(false)
  @it("should compare two any holding different lists with ==")
  fn shouldCompareTwoAnyHoldingDifferentListsWithEq():
    xs: List<int> = [1, 2, 3]
    ys: List<int> = [1, 2, 4]
    a: any = xs
    b: any = ys
    expect(a == b).toEq(false)
  @it("should compare two any aliasing the same map with ==")
  fn shouldCompareTwoAnyAliasingSameMapWithEq():
    m: Map<str, int> = {"k": 1}
    a: any = m
    b: any = m
    expect(a == b).toEq(true)
  @it("should compare two any aliasing the same set with ==")
  fn shouldCompareTwoAnyAliasingSameSetWithEq():
    s: Set<int> = {}
    add(s, 1)
    a: any = s
    b: any = s
    expect(a == b).toEq(true)
  @it("should render any holding a list as <List> marker")
  fn shouldRenderAnyHoldingAListAsMarker():
    xs: List<int> = [1, 2, 3]
    a: any = xs
    expect(f"{a}").toEq("<List>")
  @it("should render any holding a map as <Map> marker")
  fn shouldRenderAnyHoldingAMapAsMarker():
    m: Map<str, int> = {"a": 1}
    a: any = m
    expect(f"{a}").toEq("<Map>")
  @it("should render any holding a set as <Set> marker")
  fn shouldRenderAnyHoldingASetAsMarker():
    s: Set<int> = {}
    add(s, 1)
    a: any = s
    expect(f"{a}").toEq("<Set>")
  @it("should retain payload across any-to-any copy (regression: #1697 double-free)")
  fn shouldRetainPayloadAcrossAnyToAnyCopy():
    # ARC retention is the actual regression target; recovering the typed
    # List<int> back from `any` is no longer canonical (#2322). Use the
    # marker render to confirm the payload survives the alias chain.
    xs: List<int> = [10, 20, 30]
    a: any = xs
    b: any = a
    expect(f"{b}").toEq("<List>")
  @it("should retain payload when an any holds a map and is copied to another any")
  fn shouldRetainPayloadOnAnyToAnyMapCopy():
    m: Map<str, int> = {"a": 1, "b": 2}
    a: any = m
    b: any = a
    expect(f"{b}").toEq("<Map>")
  @it("should retain payload when an any holds a set and is copied to another any")
  fn shouldRetainPayloadOnAnyToAnySetCopy():
    s: Set<int> = {}
    add(s, 7)
    add(s, 8)
    a: any = s
    b: any = a
    expect(f"{b}").toEq("<Set>")
  @it("should reassign any-to-any without leaking the prior payload")
  fn shouldReassignAnyToAnyWithoutLeak():
    # Same regression-target rationale as the previous test: assert the
    # payload survives the reassign via the marker render.
    xs: List<int> = [1, 2]
    ys: List<int> = [3, 4, 5]
    a: any = xs
    b: any = ys
    a = b
    expect(f"{a}").toEq("<List>")
  @it("should retain dynamic str payload across any-to-any copy (regression: #1799)")
  fn shouldRetainDynamicStrPayloadAcrossAnyToAnyCopy():
    s: str = "hello" + " world"
    a: any = s
    b: any = a
    s = "overwritten"
    case asType[str](b):
      Ok(t): expect(t).toEq("hello world")
      Err(_): fail("expected str")
  @it("should retain dynamic str when unwrapped from a returned any (regression: #1799)")
  fn shouldRetainDynamicStrWhenUnwrappedFromReturnedAny():
    fn wrapDynStr() -> any:
      inner: str = "hello" + " world"
      result: any = inner
      return result
    case asType[str](wrapDynStr()):
      Ok(t): expect(t).toEq("hello world")
      Err(_): fail("expected str")
  @it("should release prior dynamic str when reassigning any to a new str (regression: #1799)")
  fn shouldReleasePriorDynamicStrWhenReassigningAny():
    s1: str = "hello" + " world"
    s2: str = "foo" + " bar"
    a: any = s1
    a = s2
    s1 = "overwritten"
    s2 = "also overwritten"
    case asType[str](a):
      Ok(t): expect(t).toEq("foo bar")
      Err(_): fail("expected str")
  @it("should preserve dynamic str content via any after source release and reuse (regression: #1799)")
  fn shouldPreserveDynamicStrContentViaAnyAfterSourceReleaseAndReuse():
    s: str = "hello" + " world"
    a: any = s
    s = "x"
    f1: str = "AAAAA" + "BBBBBB"
    f2: str = "CCCCC" + "DDDDDD"
    case asType[str](a):
      Ok(t): expect(t).toEq("hello world")
      Err(_): fail("expected str")

record AnyRecPoint:
  x: int
  y: int

record AnyRecUser:
  name: str
  age: int

record AnyRecPlain:
  value: int

record AnyRecAnimal:
  name: str
  legs: int

record AnyRecChildDog < AnyRecAnimal:
  breed: str

record AnyRecGuideDog < AnyRecChildDog:
  trainerId: int

@describe("any holds record")
fn anyHoldsRecordTests():
  @it("should wrap plain record in any")
  fn shouldWrapPlainRecordInAny():
    p: any = AnyRecPoint(1, 2)
    expect(true).toEq(true)
  @it("should wrap record with str field in any")
  fn shouldWrapRecordWithStrFieldInAny():
    u: any = AnyRecUser("Alice", 30)
    expect(true).toEq(true)
  @it("should narrow any back to plain record via asType")
  fn shouldNarrowAnyBackToPlainRecordViaAsType():
    a: any = AnyRecPoint(1, 2)
    case asType[AnyRecPoint](a):
      Ok(q):
        expect(q.x).toEq(1)
        expect(q.y).toEq(2)
      Err(_): fail("expected AnyRecPoint")
  @it("should narrow any back to record with str field via asType")
  fn shouldNarrowAnyBackToRecordWithStrFieldViaAsType():
    a: any = AnyRecUser("Alice", 30)
    case asType[AnyRecUser](a):
      Ok(u):
        expect(u.name).toEq("Alice")
        expect(u.age).toEq(30)
      Err(_): fail("expected AnyRecUser")
  @it("should compare two any holding records with equal fields with == (deep equality)")
  fn shouldCompareTwoAnyHoldingRecordsWithEqualFieldsWithEq():
    a: any = AnyRecPoint(1, 2)
    b: any = AnyRecPoint(1, 2)
    expect(a == b).toEq(true)
  @it("should not consider two any holding records with different fields equal")
  fn shouldNotConsiderTwoAnyHoldingRecordsWithDifferentFieldsEqual():
    a: any = AnyRecPoint(1, 2)
    b: any = AnyRecPoint(1, 3)
    expect(a == b).toEq(false)
  @it("should not consider two any holding records of different types equal")
  fn shouldNotConsiderTwoAnyHoldingRecordsOfDifferentTypesEqual():
    a: any = AnyRecPoint(1, 2)
    b: any = AnyRecPlain(1)
    expect(a == b).toEq(false)
  @it("should render any holding a record as type-named marker")
  fn shouldRenderAnyHoldingARecordAsTypeNamedMarker():
    a: any = AnyRecPoint(1, 2)
    expect(f"{a}").toEq("<AnyRecPoint>")
  @it("should preserve record through any roundtrip via asType")
  fn shouldPreserveRecordThroughAnyRoundtripViaAsType():
    fn makeAnyRec() -> any:
      return AnyRecPoint(7, 9)
    a: any = makeAnyRec()
    case asType[AnyRecPoint](a):
      Ok(q):
        expect(q.x).toEq(7)
        expect(q.y).toEq(9)
      Err(_): fail("expected AnyRecPoint")
  @it("should preserve record with str field through any-to-any copy")
  fn shouldPreserveRecordWithStrFieldThroughAnyToAnyCopy():
    a: any = AnyRecUser("Bob" + "by", 25)
    b: any = a
    a = AnyRecUser("Replaced" + "Name", 99)
    case asType[AnyRecUser](b):
      Ok(u):
        expect(u.name).toEq("Bobby")
        expect(u.age).toEq(25)
      Err(_): fail("expected AnyRecUser")
  @it("should reassign any holding record to a different record")
  fn shouldReassignAnyHoldingRecordToDifferentRecord():
    a: any = AnyRecPoint(1, 2)
    a = AnyRecPlain(99)
    case asType[AnyRecPlain](a):
      Ok(q): expect(q.value).toEq(99)
      Err(_): fail("expected AnyRecPlain")
  @it("should wrap child record in any and exact-type narrow back via asType")
  fn shouldWrapChildRecordInAnyAndExactTypeNarrowViaAsType():
    d: any = AnyRecChildDog("Rex", 4, "Labrador")
    expect(f"{d}").toEq("<AnyRecChildDog>")
    case asType[AnyRecChildDog](d):
      Ok(out):
        expect(out.name).toEq("Rex")
        expect(out.legs).toEq(4)
        expect(out.breed).toEq("Labrador")
      Err(_): fail("expected AnyRecChildDog")
  @it("should narrow any holding child record as parent type (subtype projection)")
  fn shouldNarrowAnyHoldingChildRecordAsParentType():
    d: any = AnyRecChildDog("Rex", 4, "Labrador")
    case asType[AnyRecAnimal](d):
      Ok(a):
        expect(a.name).toEq("Rex")
        expect(a.legs).toEq(4)
      Err(_): fail("expected AnyRecAnimal")
  @it("should narrow any holding grandchild record as grandparent type")
  fn shouldNarrowAnyHoldingGrandchildRecordAsGrandparentType():
    g: any = AnyRecGuideDog("Buddy", 4, "GoldenRetriever", 42)
    case asType[AnyRecAnimal](g):
      Ok(a):
        expect(a.name).toEq("Buddy")
        expect(a.legs).toEq(4)
      Err(_): fail("expected AnyRecAnimal")
  @it("should narrow any holding grandchild record as intermediate parent type")
  fn shouldNarrowAnyHoldingGrandchildRecordAsIntermediateParentType():
    g: any = AnyRecGuideDog("Buddy", 4, "GoldenRetriever", 42)
    case asType[AnyRecChildDog](g):
      Ok(c):
        expect(c.name).toEq("Buddy")
        expect(c.legs).toEq(4)
        expect(c.breed).toEq("GoldenRetriever")
      Err(_): fail("expected AnyRecChildDog")
  @it("should subtype-narrow across function boundary (any return -> parent type)")
  fn shouldSubtypeNarrowAcrossFunctionBoundary():
    fn makeAnyDog() -> any:
      return AnyRecChildDog("Spot", 4, "Beagle")
    case asType[AnyRecAnimal](makeAnyDog()):
      Ok(a):
        expect(a.name).toEq("Spot")
        expect(a.legs).toEq(4)
      Err(_): fail("expected AnyRecAnimal")

enum AnyEnumColor:
  Red
  Green
  Blue

enum AnyEnumMode:
  On
  Off

enum AnyEnumShape:
  Circle(float)
  Rect(int, int)
  Dot

enum AnyEnumLabel:
  Tag(str)
  Empty

enum AnyEnumBag:
  Items(List<int>)
  Nothing

@describe("any holds enum")
fn anyHoldsEnumTests():
  # Recovering a typed enum / `Option<T>` / `Result<T, E>` from `any` was
  # previously the `e: Color = anyVal` shape (rejected by
  # `[strict-any/any-implicit-unwrap]` since #2322). `asType[T]` rejects
  # enum / Option / Result targets ("not yet supported; use case-based
  # unwrap instead" — see codegen_call_anycast.cpp), so the canonical
  # recovery for these payloads is not available on v0.0.30. The remaining
  # tests below cover equality comparison and the marker render — both
  # remain supported without recovering the concrete type.
  @it("should compare two any holding same simple enum value")
  fn shouldCompareTwoAnyHoldingSameSimpleEnumValue():
    a: any = AnyEnumColor::Green
    b: any = AnyEnumColor::Green
    expect(a == b).toEq(true)
  @it("should not consider two any holding different simple enum variants equal")
  fn shouldNotConsiderTwoAnyHoldingDifferentSimpleEnumVariantsEqual():
    a: any = AnyEnumColor::Red
    b: any = AnyEnumColor::Blue
    expect(a == b).toEq(false)
  @it("should not consider two any holding different simple enum types equal")
  fn shouldNotConsiderTwoAnyHoldingDifferentSimpleEnumTypesEqual():
    a: any = AnyEnumColor::Red
    b: any = AnyEnumMode::On
    expect(a == b).toEq(false)
  @it("should compare two any holding equal ADT payloads as equal")
  fn shouldCompareTwoAnyHoldingEqualAdtPayloadsAsEqual():
    a: any = AnyEnumShape::Rect(5, 7)
    b: any = AnyEnumShape::Rect(5, 7)
    expect(a == b).toEq(true)
  @it("should not consider two any holding ADT with different payloads equal")
  fn shouldNotConsiderTwoAnyHoldingAdtWithDifferentPayloadsEqual():
    a: any = AnyEnumShape::Rect(5, 7)
    b: any = AnyEnumShape::Rect(5, 8)
    expect(a == b).toEq(false)
  @it("should store enum elements in List<any>")
  fn shouldStoreEnumElementsInListAny():
    xs: List<any> = []
    append!(xs, AnyEnumColor::Red)
    append!(xs, AnyEnumShape::Dot)
    expect(xs[0] == AnyEnumColor::Red).toEq(true)
    expect(xs[1] == AnyEnumShape::Dot).toEq(true)
  @it("should store enum values in Map<str, any>")
  fn shouldStoreEnumValuesInMapStrAny():
    m: Map<str, any> = {}
    m["c"] = AnyEnumColor::Blue
    m["m"] = AnyEnumMode::Off
    expect(m["c"] == AnyEnumColor::Blue).toEq(true)
    expect(m["m"] == AnyEnumMode::Off).toEq(true)
  @it("should render any holding simple enum as type-named marker")
  fn shouldRenderAnyHoldingSimpleEnumAsTypeNamedMarker():
    a: any = AnyEnumColor::Red
    expect(f"{a}").toEq("<AnyEnumColor>")
  @it("should render any holding ADT enum as type-named marker")
  fn shouldRenderAnyHoldingAdtEnumAsTypeNamedMarker():
    a: any = AnyEnumShape::Circle(1.5)
    expect(f"{a}").toEq("<AnyEnumShape>")
  @it("should render any holding Option as type-named marker")
  fn shouldRenderAnyHoldingOptionAsTypeNamedMarker():
    a: any = Some(1)
    expect(f"{a}").toEq("<Option<int>>")
  @it("should render any holding Result as type-named marker")
  fn shouldRenderAnyHoldingResultAsTypeNamedMarker():
    r: Result<int, str> = Ok(5)
    a: any = r
    expect(f"{a}").toEq("<Result<int, str>>")
  @it("should wrap Option<int> in any and narrow back via asType")
  fn shouldWrapOptionIntInAnyAndNarrowBackViaAsType():
    a: any = Some(42)
    case asType[Option<int>](a):
      Ok(o):
        case o:
          Some(v): expect(v).toEq(42)
          None: fail("expected Some")
      Err(_): fail("expected Option<int>")
  @it("should wrap None in any and narrow back as Option<int> via asType")
  fn shouldWrapNoneInAnyAndNarrowBackAsOptionIntViaAsType():
    n: Option<int> = None
    a: any = n
    gotNone = false
    case asType[Option<int>](a):
      Ok(o):
        case o:
          Some(_): fail("expected None")
          None: gotNone = true
      Err(_): fail("expected Option<int>")
    expect(gotNone).toEq(true)
  @it("should wrap Option<str> in any and narrow back via asType")
  fn shouldWrapOptionStrInAnyAndNarrowBackViaAsType():
    a: any = Some("hi" + "!")
    case asType[Option<str>](a):
      Ok(o):
        case o:
          Some(v): expect(v).toEq("hi!")
          None: fail("expected Some")
      Err(_): fail("expected Option<str>")
  # Result / simple enum / ADT enum recovery from `any` is not yet
  # available: `[strict-any/any-implicit-unwrap]` rejects the implicit
  # form, and `asType[T]` returns Err for Result / enum targets ("target
  # not yet supported"). Tracked as a follow-up to extend `asType`
  # coverage to those payloads.

mixedAnyMapGlobal: Map<str, any> = {}

@describe("mixed any literal reassignment")
fn mixedAnyLiteralReassignmentTests():
  # Reassigning `Map<str, any>` / `List<any>` / `Set<any>` with mixed literals
  # still works; only the per-element narrow back to a concrete type now goes
  # through `asType[T]`. The tests below pin the literal-reassign behaviour
  # plus one representative narrow to keep the canonical readback covered.
  @it("should reassign local Map<str, any> with mixed value types via literal")
  fn shouldReassignLocalMapStrAnyWithMixedLiteral():
    m: Map<str, any> = {}
    m = {"a": 1, "b": "two", "c": true}
    case asType[int](m["a"]):
      Ok(vi): expect(vi).toEq(1)
      Err(_): fail("a not int")
    case asType[str](m["b"]):
      Ok(vs): expect(vs).toEq("two")
      Err(_): fail("b not str")
    case asType[bool](m["c"]):
      Ok(vb): expect(vb).toEq(true)
      Err(_): fail("c not bool")
  @it("should reassign local List<any> with mixed element types via literal")
  fn shouldReassignLocalListAnyWithMixedLiteral():
    xs: List<any> = []
    xs = [1, "x", true]
    case asType[int](xs[0]):
      Ok(vi): expect(vi).toEq(1)
      Err(_): fail("xs[0] not int")
    case asType[str](xs[1]):
      Ok(vs): expect(vs).toEq("x")
      Err(_): fail("xs[1] not str")
    case asType[bool](xs[2]):
      Ok(vb): expect(vb).toEq(true)
      Err(_): fail("xs[2] not bool")
  @it("should reassign module-global Map<str, any> with mixed value types via literal")
  fn shouldReassignModuleGlobalMapStrAnyWithMixedLiteral():
    mixedAnyMapGlobal = {"a": 1, "b": "two", "c": true}
    case asType[int](mixedAnyMapGlobal["a"]):
      Ok(vi): expect(vi).toEq(1)
      Err(_): fail("a not int")
    case asType[str](mixedAnyMapGlobal["b"]):
      Ok(vs): expect(vs).toEq("two")
      Err(_): fail("b not str")
    case asType[bool](mixedAnyMapGlobal["c"]):
      Ok(vb): expect(vb).toEq(true)
      Err(_): fail("c not bool")
  @it("should reassign local Set<any> with mixed element types via literal")
  fn shouldReassignLocalSetAnyWithMixedLiteral():
    s: Set<any> = {}
    s = {1, "x", true}
    expect(s).toHaveLen(3)
    expect(1 in s).toEq(true)
    expect("x" in s).toEq(true)
    expect(true in s).toEq(true)
  @it("should compound-assign local List<any> with mixed element types via literal")
  fn shouldCompoundAssignLocalListAnyWithMixedLiteral():
    xs: List<any> = []
    xs += [1, "x", true]
    case asType[int](xs[0]):
      Ok(vi): expect(vi).toEq(1)
      Err(_): fail("xs[0] not int")
    case asType[str](xs[1]):
      Ok(vs): expect(vs).toEq("x")
      Err(_): fail("xs[1] not str")
    case asType[bool](xs[2]):
      Ok(vb): expect(vb).toEq(true)
      Err(_): fail("xs[2] not bool")
  @it("should compound-assign local Map<str, any> with mixed value types via literal")
  fn shouldCompoundAssignLocalMapStrAnyWithMixedLiteral():
    m: Map<str, any> = {}
    m += {"a": 1, "b": "two"}
    case asType[int](m["a"]):
      Ok(vi): expect(vi).toEq(1)
      Err(_): fail("a not int")
    case asType[str](m["b"]):
      Ok(vs): expect(vs).toEq("two")
      Err(_): fail("b not str")
  @it("should compound-assign local Set<any> with mixed element types via literal")
  fn shouldCompoundAssignLocalSetAnyWithMixedLiteral():
    s: Set<any> = {}
    s += {1, "x", true}
    expect(s).toHaveLen(3)
    expect(1 in s).toEq(true)
    expect("x" in s).toEq(true)
    expect(true in s).toEq(true)

@describe("asType checked cast from any")
fn asTypeTests():
  @it("should convert any holding int to Ok(int)")
  fn shouldAsTypeIntOk():
    v: any = 42
    case asType[int](v):
      Ok(n): expect(n).toEq(42)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should return Err when any tag does not match target int")
  fn shouldAsTypeIntErrOnMismatch():
    v: any = "hello"
    case asType[int](v):
      Ok(_): fail("expected Err")
      Err(e):
        expect(e.message == "asType[int]: expected int").toEq(true)
  @it("should convert any holding str to Ok(str)")
  fn shouldAsTypeStrOk():
    v: any = "hello"
    case asType[str](v):
      Ok(s): expect(s).toEq("hello")
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding bool to Ok(bool)")
  fn shouldAsTypeBoolOk():
    v: any = true
    case asType[bool](v):
      Ok(b): expect(b).toEq(true)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding float to Ok(float)")
  fn shouldAsTypeFloatOk():
    v: any = 3.14
    case asType[float](v):
      Ok(f): expect(f).toEq(3.14)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should promote any holding int to Ok(float) matching load[float]")
  fn shouldAsTypeFloatPromoteFromInt():
    v: any = 7
    case asType[float](v):
      Ok(f): expect(f).toEq(7.0)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding record to Ok(record)")
  fn shouldAsTypeRecordOk():
    v: any = AnyRecPoint(3, 4)
    case asType[AnyRecPoint](v):
      Ok(p):
        expect(p.x).toEq(3)
        expect(p.y).toEq(4)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should accept subtype unwrap via descriptor walk (asType[Parent](child))")
  fn shouldAsTypeRecordSubtype():
    v: any = AnyRecChildDog("Rex", 4, "Labrador")
    case asType[AnyRecAnimal](v):
      Ok(a):
        expect(a.name).toEq("Rex")
        expect(a.legs).toEq(4)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should return Err when record types mismatch")
  fn shouldAsTypeRecordErrOnMismatch():
    v: any = AnyRecPoint(1, 2)
    case asType[AnyRecPlain](v):
      Ok(_): fail("expected Err")
      Err(e):
        expect(e.message == "asType[AnyRecPlain]: expected record AnyRecPlain, got a different record type").toEq(true)
  @it("should convert any holding Option<int> to Ok(Option<int>)")
  fn shouldAsTypeOptionIntOk():
    v: any = Some(42)
    case asType[Option<int>](v):
      Ok(o):
        case o:
          Some(n): expect(n).toEq(42)
          None: fail("expected Some")
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding List<any> to Ok(List<any>)")
  fn shouldAsTypeListAnyOk():
    xs: List<any> = []
    xs += [1, "two", true]
    v: any = xs
    case asType[List<any>](v):
      Ok(out):
        expect(out).toHaveLen(3)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding Map<str, any> to Ok(Map<str, any>)")
  fn shouldAsTypeMapStrAnyOk():
    m: Map<str, any> = {"k": 1}
    v: any = m
    case asType[Map<str, any>](v):
      Ok(out):
        expect(out).toHaveLen(1)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should convert any holding Set<any> to Ok(Set<any>)")
  fn shouldAsTypeSetAnyOk():
    s: Set<any> = {}
    s += {1, "x", true}
    v: any = s
    case asType[Set<any>](v):
      Ok(out):
        expect(out).toHaveLen(3)
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should return Err when any tag mismatches target collection")
  fn shouldAsTypeCollectionErrOnMismatch():
    v: any = 42
    case asType[List<any>](v):
      Ok(_): fail("expected Err")
      Err(e):
        expect(e.message == "asType[List<any>]: expected List<any>").toEq(true)
  @it("should extract typed values from json5-shaped Map<str, any>")
  fn shouldAsTypeFromJsonShape():
    m: Map<str, any> = {"age": 30, "name": "Alice"}
    case asType[int](m["age"]):
      Ok(n): expect(n).toEq(30)
      Err(e): fail("expected Ok, got Err: " + e.message)
    case asType[str](m["name"]):
      Ok(s): expect(s).toEq("Alice")
      Err(e): fail("expected Ok, got Err: " + e.message)
  @it("should reject native typed List<int> source (typed-coll guard)")
  fn shouldAsTypeRejectNativeTypedList():
    xs: List<int> = [1, 2, 3]
    v: any = xs
    case asType[List<int>](v):
      Ok(_): fail("expected Err on native typed-coll source")
      Err(e):
        expect(e.message.contains("native typed collection")).toEq(true)
  @it("should reject native typed Map<str, int> source (typed-coll guard)")
  fn shouldAsTypeRejectNativeTypedMap():
    m: Map<str, int> = {"a": 1, "b": 2}
    v: any = m
    case asType[Map<str, int>](v):
      Ok(_): fail("expected Err on native typed-coll source")
      Err(e):
        expect(e.message.contains("native typed collection")).toEq(true)
  @it("should reject native typed Map source when target is record")
  fn shouldAsTypeRejectNativeTypedMapForRecord():
    m: Map<str, int> = {"x": 1, "y": 2}
    v: any = m
    case asType[AnyRecPoint](v):
      Ok(_): fail("expected Err on native typed-coll source")
      Err(e):
        expect(e.message.contains("native typed collection")).toEq(true)

@describe("isType type-test on any")
fn isTypeTests():
  @it("should return true for matching int tag")
  fn shouldIsTypeIntTrue():
    v: any = 42
    expect(isType[int](v)).toEq(true)
  @it("should return false for non-matching int tag")
  fn shouldIsTypeIntFalse():
    v: any = "hello"
    expect(isType[int](v)).toEq(false)
  @it("should return true for matching str tag")
  fn shouldIsTypeStrTrue():
    v: any = "hello"
    expect(isType[str](v)).toEq(true)
  @it("should return true for matching bool tag")
  fn shouldIsTypeBoolTrue():
    v: any = true
    expect(isType[bool](v)).toEq(true)
  @it("should return true for matching float tag")
  fn shouldIsTypeFloatTrue():
    v: any = 3.14
    expect(isType[float](v)).toEq(true)
  @it("should return true for matching List<any> tag")
  fn shouldIsTypeListAnyTrue():
    xs: List<any> = []
    xs += [1, 2, 3]
    v: any = xs
    expect(isType[List<any>](v)).toEq(true)
  @it("should return true for matching Map<str, any> tag")
  fn shouldIsTypeMapStrAnyTrue():
    m: Map<str, any> = {"k": 1}
    v: any = m
    expect(isType[Map<str, any>](v)).toEq(true)
  @it("should return true for matching Set<any> tag")
  fn shouldIsTypeSetAnyTrue():
    s: Set<any> = {}
    s += {1, 2}
    v: any = s
    expect(isType[Set<any>](v)).toEq(true)
  @it("should return true for exact record type match")
  fn shouldIsTypeRecordExactTrue():
    v: any = AnyRecPoint(1, 2)
    expect(isType[AnyRecPoint](v)).toEq(true)
  @it("should return false for different record type")
  fn shouldIsTypeRecordFalse():
    v: any = AnyRecPoint(1, 2)
    expect(isType[AnyRecPlain](v)).toEq(false)
  @it("should return true for record subtype via descriptor walk")
  fn shouldIsTypeRecordSubtypeTrue():
    v: any = AnyRecChildDog("Rex", 4, "Labrador")
    expect(isType[AnyRecAnimal](v)).toEq(true)
  @it("should return false when parent record is held but child requested")
  fn shouldIsTypeRecordParentNotChild():
    v: any = AnyRecAnimal("Cat", 4)
    expect(isType[AnyRecChildDog](v)).toEq(false)
  @it("should return true for isType[any] regardless of held value")
  fn shouldIsTypeAnyAlwaysTrue():
    v1: any = 42
    v2: any = "hello"
    v3: any = AnyRecPoint(1, 2)
    expect(isType[any](v1)).toEq(true)
    expect(isType[any](v2)).toEq(true)
    expect(isType[any](v3)).toEq(true)
