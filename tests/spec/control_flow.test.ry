from testing import it, describe

@describe("if / when")
fn ifWhenTests():
  @it("should execute if true")
  fn shouldExecuteIfTrue():
    res = 0
    if true:
      res = 1
    expect(res).toEq(1)
  @it("should go to else when if is false")
  fn shouldGoToElseWhenIfIsFalse():
    res = 0
    if false:
      res = 1
    else:
      res = 2
    expect(res).toEq(2)
  @it("should evaluate when multi-branch")
  fn shouldEvaluateWhenMultiBranch():
    res = 0
    x = 5
    case:
      x > 10:
        res = 1
      x == 5:
        res = 2
      _:
        res = 3
    expect(res).toEq(2)
  @it("should fall to else when all when branches are false")
  fn shouldFallToElseWhenAllWhenBranchesAreFalse():
    res = 0
    x = 99
    case:
      x == 1:
        res = 1
      x == 2:
        res = 2
      _:
        res = 3
    expect(res).toEq(3)
  @it("should evaluate second when branch when first is false")
  fn shouldEvaluateSecondWhenBranchWhenFirstIsFalse():
    res = 0
    x = 5
    case:
      x > 100:
        res = 1
      x > 3:
        res = 2
      _:
        res = 3
    expect(res).toEq(2)

@describe("while")
fn whileTests():
  @it("should run basic while loop")
  fn shouldRunBasicWhileLoop():
    i = 0
    sum = 0
    while i < 5:
      sum = sum + i
      i = i + 1
    expect(sum).toEq(10)
  @it("should break out of loop")
  fn shouldBreakOutOfLoop():
    i = 0
    while true:
      if i >= 3:
        break
      i = i + 1
    expect(i).toEq(3)
  @it("should continue to next iteration")
  fn shouldContinueToNextIteration():
    sum = 0
    i = 0
    while i < 5:
      i = i + 1
      if i == 3:
        continue
      sum = sum + i
    expect(sum).toEq(12)

@describe("for")
fn forTests():
  @it("should iterate over list")
  fn shouldIterateOverList():
    sum = 0
    xs = [10, 20, 30]
    for x in xs:
      sum = sum + x
    expect(sum).toEq(60)
  @it("should iterate range with 1 arg")
  fn shouldIterateRangeWith1Arg():
    sum = 0
    for i in range(5):
      sum = sum + i
    expect(sum).toEq(10)
  @it("should iterate range with 2 args")
  fn shouldIterateRangeWith2Args():
    sum = 0
    for i in range(2, 5):
      sum = sum + i
    expect(sum).toEq(9)
  @it("should iterate range with 3 args")
  fn shouldIterateRangeWith3Args():
    sum = 0
    for i in range(0, 10, 3):
      sum = sum + i
    expect(sum).toEq(18)
  @it("should iterate range with negative step")
  fn shouldIterateRangeWithNegativeStep():
    sum = 0
    for i in range(10, 0, -3):
      sum = sum + i
    expect(sum).toEq(22)
  @it("should iterate .. range")
  fn shouldIterateRange():
    sum = 0
    for i in 1..3:
      sum = sum + i
    expect(sum).toEq(6)
  @it("should iterate map key-value pairs")
  fn shouldIterateMapKeyValuePairs():
    m = {"a": 1, "b": 2}
    total = 0
    for k, v in m:
      total = total + v
    expect(total).toEq(3)
  @it("should support enumerate destructuring")
  fn shouldSupportEnumerateDestructuring():
    xs = [10, 20, 30]
    idxSum = 0
    valSum = 0
    for i, x in enumerate(xs):
      idxSum = idxSum + i
      valSum = valSum + x
    expect(idxSum).toEq(3)
    expect(valSum).toEq(60)
  @it("should support zip destructuring")
  fn shouldSupportZipDestructuring():
    sum = 0
    for a, b in zip([1, 2], [10, 20]):
      sum = sum + (a + b)
    expect(sum).toEq(33)
  @it("should support 3-element tuple destructuring")
  fn shouldSupport3ElementTupleDestructuring():
    triples = [(1, 2, 3), (4, 5, 6)]
    sumA = 0
    sumB = 0
    sumC = 0
    for a, b, c in triples:
      sumA = sumA + a
      sumB = sumB + b
      sumC = sumC + c
    expect(sumA).toEq(5)
    expect(sumB).toEq(7)
    expect(sumC).toEq(9)
  @it("should support 3-element destructuring with wildcard")
  fn shouldSupport3ElementDestructuringWithWildcard():
    triples = [(1, 2, 3), (4, 5, 6)]
    sum = 0
    for a, _, c in triples:
      sum = sum + a + c
    expect(sum).toEq(14)
  @it("should iterate empty list without executing body")
  fn shouldIterateEmptyListWithoutExecutingBody():
    sum = 0
    xs = [1]
    empty = filter(xs, (x: int) => x > 10)
    for x in empty:
      sum = sum + x
    expect(sum).toEq(0)
  @it("should treat range(0) as empty")
  fn shouldTreatRange0AsEmpty():
    sum = 0
    for i in range(0):
      sum = sum + 1
    expect(sum).toEq(0)
  @it("should treat range with equal start and end as empty")
  fn shouldTreatRangeWithEqualStartAndEndAsEmpty():
    sum = 0
    for i in range(5, 5):
      sum = sum + 1
    expect(sum).toEq(0)
  @it("should treat range reverse without step as empty")
  fn shouldTreatRangeReverseWithoutStepAsEmpty():
    sum = 0
    for i in range(5, 3):
      sum = sum + 1
    expect(sum).toEq(0)

@describe("when")
fn whenTests():
  @it("should match literal pattern")
  fn shouldMatchLiteralPattern():
    res = 0
    x = 2
    case x:
      1:
        res = 10
      2:
        res = 20
      _:
        res = 30
    expect(res).toEq(20)
  @it("should match with variable binding")
  fn shouldMatchWithVariableBinding():
    res = 0
    x = 42
    case x:
      n if n > 0:
        res = n
      _:
        res = 0
    expect(res).toEq(42)
  @it("should match with guard")
  fn shouldMatchWithGuard():
    res = ""
    x = -5
    case x:
      n if n > 0:
        res = "positive"
      n if n < 0:
        res = "negative"
      _:
        res = "zero"
    expect(res).toEq("negative")
  @it("should match OR pattern")
  fn shouldMatchOrPattern():
    res = ""
    x = 2
    case x:
      1 | 2 | 3:
        res = "small"
      _:
        res = "other"
    expect(res).toEq("small")
  @it("should match wildcard")
  fn shouldMatchWildcard():
    res = ""
    x = 999
    case x:
      0:
        res = "zero"
      _:
        res = "other"
    expect(res).toEq("other")
  @it("should match string literal pattern")
  fn shouldMatchStringLiteralPattern():
    res = ""
    s = "hello"
    case s:
      "hello":
        res = "matched"
      _:
        res = "other"
    expect(res).toEq("matched")
  @it("should match negative literal pattern")
  fn shouldMatchNegativeLiteralPattern():
    res = ""
    x = -1
    case x:
      -1:
        res = "minus one"
      0:
        res = "zero"
      _:
        res = "other"
    expect(res).toEq("minus one")
  @it("should fall back to wildcard when guard fails")
  fn shouldFallBackToWildcardWhenGuardFails():
    res = ""
    x = 5
    case x:
      n if n > 100:
        res = "big"
      n if n > 50:
        res = "medium"
      _:
        res = "small"
    expect(res).toEq("small")
  @it("should match OR pattern with many alternatives")
  fn shouldMatchOrPatternWithManyAlternatives():
    res = ""
    x = 4
    case x:
      1 | 2 | 3 | 4:
        res = "small"
      _:
        res = "other"
    expect(res).toEq("small")

@describe("when Option")
fn whenOptionTests():
  @it("should match Some")
  fn shouldMatchSome():
    res = 0
    x: Option<int> = Some(42)
    case x:
      Some(v):
        res = v
      None:
        res = -1
    expect(res).toEq(42)
  @it("should match None")
  fn shouldMatchNone():
    res = 0
    x: Option<int> = None
    case x:
      Some(v):
        res = v
      None:
        res = -1
    expect(res).toEq(-1)

enum Direction:
  North
  South
  East
  West

@describe("when enum")
fn whenEnumTests():
  @it("should match simple enum")
  fn shouldMatchSimpleEnum():
    res = ""
    d = Direction::North
    case d:
      Direction::North:
        res = "north"
      Direction::South:
        res = "south"
      Direction::East:
        res = "east"
      Direction::West:
        res = "west"
    expect(res).toEq("north")
  @it("should match last enum variant")
  fn shouldMatchLastEnumVariant():
    res = ""
    d = Direction::West
    case d:
      Direction::North:
        res = "north"
      Direction::South:
        res = "south"
      Direction::East:
        res = "east"
      Direction::West:
        res = "west"
    expect(res).toEq("west")

enum Shape:
  Circle(float)
  Rect(float, float)
  Point

@describe("when ADT enum")
fn whenAdtEnumTests():
  @it("should match ADT enum with associated data")
  fn shouldMatchAdtEnumWithAssociatedData():
    res = 0.0
    s = Shape::Circle(3.14)
    case s:
      Shape::Circle(r):
        res = r
      Shape::Rect(w, h):
        res = w * h
      Shape::Point:
        res = 0.0
    expect(res).toEq(3.14)
  @it("should match ADT enum multi-field variant")
  fn shouldMatchAdtEnumMultiFieldVariant():
    res = 0.0
    s = Shape::Rect(4.0, 5.0)
    case s:
      Shape::Circle(r):
        res = r
      Shape::Rect(w, h):
        res = w * h
      Shape::Point:
        res = 0.0
    expect(res).toEq(20.0)

@describe("nested when")
fn nestedWhenTests():
  @it("should support when inside when")
  fn shouldSupportWhenInsideWhen():
    res = ""
    x = 2
    y = 10
    case x:
      1:
        res = "one"
      2:
        case y:
          10:
            res = "two-ten"
          _:
            res = "two-other"
      _:
        res = "other"
    expect(res).toEq("two-ten")

@describe("when ADT no-data variant")
fn whenAdtNoDataVariantTests():
  @it("should match Point variant")
  fn shouldMatchPointVariant():
    res = 0.0
    s = Shape::Point
    case s:
      Shape::Circle(r):
        res = r
      Shape::Rect(w, h):
        res = w * h
      Shape::Point:
        res = -1.0
    expect(res).toEq(-1.0)

@describe("inline case body")
fn inlineCaseBodyTests():
  @it("should support basic inline case")
  fn shouldSupportBasicInlineCase():
    res = 0
    x = 2
    case x:
      1: res = 10
      2: res = 20
      _: res = 30
    expect(res).toEq(20)
  @it("should support inline and block case mixed")
  fn shouldSupportInlineAndBlockCaseMixed():
    res = 0
    x = 3
    case x:
      1: res = 10
      3:
        res = 30
      _: res = 99
    expect(res).toEq(30)
  @it("should support inline case with guard")
  fn shouldSupportInlineCaseWithGuard():
    res = ""
    x = -5
    case x:
      n if n > 0: res = "positive"
      n if n < 0: res = "negative"
      _: res = "zero"
    expect(res).toEq("negative")
  @it("should support inline case with destructuring")
  fn shouldSupportInlineCaseWithDestructuring():
    res = 0
    x: Option<int> = Some(42)
    case x:
      Some(v): res = v
      None: res = -1
    expect(res).toEq(42)

@describe("inline when body")
fn inlineWhenBodyTests():
  @it("should support inline when arm and inline else")
  fn shouldSupportInlineWhenArmAndInlineElse():
    res = 0
    x = 5
    case:
      x > 10: res = 1
      x == 5: res = 2
      _: res = 3
    expect(res).toEq(2)
  @it("should support inline when else fallback")
  fn shouldSupportInlineWhenElseFallback():
    res = 0
    x = 1
    case:
      x > 10: res = 1
      _: res = 9
    expect(res).toEq(9)

@describe("scope and shadowing")
fn scopeAndShadowingTests():
  @it("should support block scope")
  fn shouldSupportBlockScope():
    x = 10
    res = 0
    if true:
      x = 99
      res = x
    expect(res).toEq(99)
    expect(x).toEq(99)

@describe("match expression")
fn matchExpressionTests():
  @it("should match literal pattern as expression")
  fn shouldMatchLiteralPatternAsExpression():
    x = 2
    res = case x:
      1 : "one"
      2 : "two"
      _ : "other"
    expect(res).toEq("two")
  @it("should fall back to wildcard in match expression")
  fn shouldFallBackToWildcardInMatchExpression():
    x = 999
    res = case x:
      0 : "zero"
      _ : "other"
    expect(res).toEq("other")
  @it("should match with variable binding and guard in expression")
  fn shouldMatchWithVariableBindingAndGuardInExpression():
    score = 85
    grade = case score:
      n if n >= 90 : "A"
      n if n >= 80 : "B"
      n if n >= 70 : "C"
      _ : "F"
    expect(grade).toEq("B")
  @it("should match OR pattern in expression")
  fn shouldMatchOrPatternInExpression():
    x = 3
    kind = case x:
      1 | 2 | 3 : "small"
      4 | 5 | 6 : "medium"
      _ : "large"
    expect(kind).toEq("small")
  @it("should match string literal in expression")
  fn shouldMatchStringLiteralInExpression():
    s = "hello"
    res = case s:
      "hello" : "greeting"
      "bye" : "farewell"
      _ : "unknown"
    expect(res).toEq("greeting")
  @it("should match negative literal in expression")
  fn shouldMatchNegativeLiteralInExpression():
    x = -1
    res = case x:
      -1 : "minus one"
      0 : "zero"
      _ : "other"
    expect(res).toEq("minus one")
  @it("should fall back to wildcard when guard fails in expression")
  fn shouldFallBackToWildcardWhenGuardFailsInExpression():
    x = 5
    res = case x:
      n if n > 100 : "big"
      n if n > 50 : "medium"
      _ : "small"
    expect(res).toEq("small")

@describe("match expression Option")
fn matchExpressionOptionTests():
  @it("should match Some in expression")
  fn shouldMatchSomeInExpression():
    x: Option<int> = Some(42)
    res = case x:
      Some(v) : v
      None : -1
    expect(res).toEq(42)
  @it("should match None in expression")
  fn shouldMatchNoneInExpression():
    x: Option<int> = None
    res = case x:
      Some(v) : v
      None : -1
    expect(res).toEq(-1)

@describe("match expression enum")
fn matchExpressionEnumTests():
  @it("should match simple enum in expression")
  fn shouldMatchSimpleEnumInExpression():
    d = Direction::North
    res = case d:
      Direction::North : "N"
      Direction::South : "S"
      Direction::East : "E"
      Direction::West : "W"
    expect(res).toEq("N")
  @it("should match ADT enum in expression")
  fn shouldMatchAdtEnumInExpression():
    s = Shape::Rect(4.0, 5.0)
    area = case s:
      Shape::Circle(r) : r * r
      Shape::Rect(w, h) : w * h
      Shape::Point : 0.0
    expect(area).toEq(20.0)
  @it("should match ADT no-data variant in expression")
  fn shouldMatchAdtNoDataVariantInExpression():
    s = Shape::Point
    area = case s:
      Shape::Circle(r) : r * r
      Shape::Rect(w, h) : w * h
      Shape::Point : -1.0
    expect(area).toEq(-1.0)

@describe("match expression in function argument")
fn matchExpressionInFunctionArgumentTests():
  @it("should support inline match expr as function argument")
  fn shouldSupportInlineMatchExprAsFunctionArgument():
    x = 1
    expect(case x:
      1 : 100
      _ : 0
    ).toEq(100)

# --- ADT enum as function parameter (#507) ---

fn shapeArea(s: Shape) -> float:
  return case s:
    Shape::Circle(r) : 3.14 * r * r
    Shape::Rect(w, h) : w * h
    Shape::Point : 0.0

fn shapeName(s: Shape) -> str:
  return case s:
    Shape::Circle(r) : "circle"
    Shape::Rect(w, h) : "rect"
    Shape::Point : "point"

fn makeShape(kind: int) -> Shape:
  if kind == 0:
    return Shape::Circle(1.0)
  if kind == 1:
    return Shape::Rect(3.0, 4.0)
  return Shape::Point

@describe("ADT enum as function parameter (#507)")
fn adtEnumAsFunctionParameter507Tests():
  @it("should match on ADT enum parameter")
  fn shouldMatchOnAdtEnumParameter():
    expect(shapeArea(Shape::Circle(1.0))).toEq(3.14)
    expect(shapeArea(Shape::Rect(4.0, 5.0))).toEq(20.0)
    expect(shapeArea(Shape::Point)).toEq(0.0)
  @it("should support multiple functions matching same ADT enum parameter")
  fn shouldSupportMultipleFunctionsMatchingSameAdtEnumParameter():
    c = Shape::Circle(2.0)
    expect(shapeArea(c)).toEq(12.56)
    expect(shapeName(c)).toEq("circle")
    r = Shape::Rect(3.0, 4.0)
    expect(shapeArea(r)).toEq(12.0)
    expect(shapeName(r)).toEq("rect")
  @it("should support ADT enum as return type")
  fn shouldSupportAdtEnumAsReturnType():
    s = makeShape(0)
    expect(shapeName(s)).toEq("circle")
    s2 = makeShape(2)
    expect(shapeName(s2)).toEq("point")
  @it("should support ADT enum equality")
  fn shouldSupportAdtEnumEquality():
    expect(Shape::Point == Shape::Point).toEq(true)
    expect(Shape::Point != Shape::Circle(1.0)).toEq(true)
    expect(Shape::Circle(1.0) == Shape::Circle(1.0)).toEq(true)
    expect(Shape::Circle(1.0) == Shape::Circle(2.0)).toEq(false)
    expect(Shape::Circle(1.0) != Shape::Rect(1.0, 2.0)).toEq(true)
