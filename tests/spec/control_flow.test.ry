describe("if / when", ():
  it("should execute if true", ():
    res = 0
    if true:
      res = 1
    expect(res).to_eq(1)
  )
  it("should go to else when if is false", ():
    res = 0
    if false:
      res = 1
    else:
      res = 2
    expect(res).to_eq(2)
  )
  it("should evaluate when multi-branch", ():
    res = 0
    x = 5
    case:
      x > 10:
        res = 1
      x == 5:
        res = 2
      _:
        res = 3
    expect(res).to_eq(2)
  )
  it("should fall to else when all when branches are false", ():
    res = 0
    x = 99
    case:
      x == 1:
        res = 1
      x == 2:
        res = 2
      _:
        res = 3
    expect(res).to_eq(3)
  )
  it("should evaluate second when branch when first is false", ():
    res = 0
    x = 5
    case:
      x > 100:
        res = 1
      x > 3:
        res = 2
      _:
        res = 3
    expect(res).to_eq(2)
  )
)

describe("while", ():
  it("should run basic while loop", ():
    i = 0
    sum = 0
    while i < 5:
      sum = sum + i
      i = i + 1
    expect(sum).to_eq(10)
  )
  it("should break out of loop", ():
    i = 0
    while true:
      if i >= 3:
        break
      i = i + 1
    expect(i).to_eq(3)
  )
  it("should continue to next iteration", ():
    sum = 0
    i = 0
    while i < 5:
      i = i + 1
      if i == 3:
        continue
      sum = sum + i
    expect(sum).to_eq(12)
  )
)

describe("for", ():
  it("should iterate over list", ():
    sum = 0
    xs = [10, 20, 30]
    for x in xs:
      sum = sum + x
    expect(sum).to_eq(60)
  )
  it("should iterate range with 1 arg", ():
    sum = 0
    for i in range(5):
      sum = sum + i
    expect(sum).to_eq(10)
  )
  it("should iterate range with 2 args", ():
    sum = 0
    for i in range(2, 5):
      sum = sum + i
    expect(sum).to_eq(9)
  )
  it("should iterate range with 3 args", ():
    sum = 0
    for i in range(0, 10, 3):
      sum = sum + i
    expect(sum).to_eq(18)
  )
  it("should iterate range with negative step", ():
    sum = 0
    for i in range(10, 0, -3):
      sum = sum + i
    expect(sum).to_eq(22)
  )
  it("should iterate .. range", ():
    sum = 0
    for i in 1..3:
      sum = sum + i
    expect(sum).to_eq(6)
  )
  it("should iterate map key-value pairs", ():
    m = {"a": 1, "b": 2}
    total = 0
    for k, v in m:
      total = total + v
    expect(total).to_eq(3)
  )
  it("should support enumerate destructuring", ():
    xs = [10, 20, 30]
    idx_sum = 0
    val_sum = 0
    for i, x in enumerate(xs):
      idx_sum = idx_sum + i
      val_sum = val_sum + x
    expect(idx_sum).to_eq(3)
    expect(val_sum).to_eq(60)
  )
  it("should support zip destructuring", ():
    sum = 0
    for a, b in zip([1, 2], [10, 20]):
      sum = sum + (a + b)
    expect(sum).to_eq(33)
  )
  it("should support 3-element tuple destructuring", ():
    triples = [(1, 2, 3), (4, 5, 6)]
    sum_a = 0
    sum_b = 0
    sum_c = 0
    for a, b, c in triples:
      sum_a = sum_a + a
      sum_b = sum_b + b
      sum_c = sum_c + c
    expect(sum_a).to_eq(5)
    expect(sum_b).to_eq(7)
    expect(sum_c).to_eq(9)
  )
  it("should support 3-element destructuring with wildcard", ():
    triples = [(1, 2, 3), (4, 5, 6)]
    sum = 0
    for a, _, c in triples:
      sum = sum + a + c
    expect(sum).to_eq(14)
  )
  it("should iterate empty list without executing body", ():
    sum = 0
    xs = [1]
    empty = filter(xs, (x: int) => x > 10)
    for x in empty:
      sum = sum + x
    expect(sum).to_eq(0)
  )
  it("should treat range(0) as empty", ():
    sum = 0
    for i in range(0):
      sum = sum + 1
    expect(sum).to_eq(0)
  )
  it("should treat range with equal start and end as empty", ():
    sum = 0
    for i in range(5, 5):
      sum = sum + 1
    expect(sum).to_eq(0)
  )
  it("should treat range reverse without step as empty", ():
    sum = 0
    for i in range(5, 3):
      sum = sum + 1
    expect(sum).to_eq(0)
  )
)

describe("when", ():
  it("should match literal pattern", ():
    res = 0
    x = 2
    case x:
      1:
        res = 10
      2:
        res = 20
      _:
        res = 30
    expect(res).to_eq(20)
  )
  it("should match with variable binding", ():
    res = 0
    x = 42
    case x:
      n if n > 0:
        res = n
      _:
        res = 0
    expect(res).to_eq(42)
  )
  it("should match with guard", ():
    res = ""
    x = -5
    case x:
      n if n > 0:
        res = "positive"
      n if n < 0:
        res = "negative"
      _:
        res = "zero"
    expect(res).to_eq("negative")
  )
  it("should match OR pattern", ():
    res = ""
    x = 2
    case x:
      1 | 2 | 3:
        res = "small"
      _:
        res = "other"
    expect(res).to_eq("small")
  )
  it("should match wildcard", ():
    res = ""
    x = 999
    case x:
      0:
        res = "zero"
      _:
        res = "other"
    expect(res).to_eq("other")
  )
  it("should match string literal pattern", ():
    res = ""
    s = "hello"
    case s:
      "hello":
        res = "matched"
      _:
        res = "other"
    expect(res).to_eq("matched")
  )
  it("should match negative literal pattern", ():
    res = ""
    x = -1
    case x:
      -1:
        res = "minus one"
      0:
        res = "zero"
      _:
        res = "other"
    expect(res).to_eq("minus one")
  )
  it("should fall back to wildcard when guard fails", ():
    res = ""
    x = 5
    case x:
      n if n > 100:
        res = "big"
      n if n > 50:
        res = "medium"
      _:
        res = "small"
    expect(res).to_eq("small")
  )
  it("should match OR pattern with many alternatives", ():
    res = ""
    x = 4
    case x:
      1 | 2 | 3 | 4:
        res = "small"
      _:
        res = "other"
    expect(res).to_eq("small")
  )
)

describe("when Option", ():
  it("should match Some", ():
    res = 0
    x: Option<int> = Some(42)
    case x:
      Some(v):
        res = v
      None:
        res = -1
    expect(res).to_eq(42)
  )
  it("should match None", ():
    res = 0
    x: Option<int> = None
    case x:
      Some(v):
        res = v
      None:
        res = -1
    expect(res).to_eq(-1)
  )
)

enum Direction:
  North
  South
  East
  West

describe("when enum", ():
  it("should match simple enum", ():
    res = ""
    d = Direction::North
    case d:
      Direction::North:
        res = "north"
      Direction::South:
        res = "south"
      Direction::East:
        res = "east"
      Direction::West:
        res = "west"
    expect(res).to_eq("north")
  )
  it("should match last enum variant", ():
    res = ""
    d = Direction::West
    case d:
      Direction::North:
        res = "north"
      Direction::South:
        res = "south"
      Direction::East:
        res = "east"
      Direction::West:
        res = "west"
    expect(res).to_eq("west")
  )
)

enum Shape:
  Circle(float)
  Rect(float, float)
  Point

describe("when ADT enum", ():
  it("should match ADT enum with associated data", ():
    res = 0.0
    s = Shape::Circle(3.14)
    case s:
      Shape::Circle(r):
        res = r
      Shape::Rect(w, h):
        res = w * h
      Shape::Point:
        res = 0.0
    expect(res).to_eq(3.14)
  )
  it("should match ADT enum multi-field variant", ():
    res = 0.0
    s = Shape::Rect(4.0, 5.0)
    case s:
      Shape::Circle(r):
        res = r
      Shape::Rect(w, h):
        res = w * h
      Shape::Point:
        res = 0.0
    expect(res).to_eq(20.0)
  )
)

describe("nested when", ():
  it("should support when inside when", ():
    res = ""
    x = 2
    y = 10
    case x:
      1:
        res = "one"
      2:
        case y:
          10:
            res = "two-ten"
          _:
            res = "two-other"
      _:
        res = "other"
    expect(res).to_eq("two-ten")
  )
)

describe("when ADT no-data variant", ():
  it("should match Point variant", ():
    res = 0.0
    s = Shape::Point
    case s:
      Shape::Circle(r):
        res = r
      Shape::Rect(w, h):
        res = w * h
      Shape::Point:
        res = -1.0
    expect(res).to_eq(-1.0)
  )
)

describe("inline case body", ():
  it("should support basic inline case", ():
    res = 0
    x = 2
    case x:
      1: res = 10
      2: res = 20
      _: res = 30
    expect(res).to_eq(20)
  )
  it("should support inline and block case mixed", ():
    res = 0
    x = 3
    case x:
      1: res = 10
      3:
        res = 30
      _: res = 99
    expect(res).to_eq(30)
  )
  it("should support inline case with guard", ():
    res = ""
    x = -5
    case x:
      n if n > 0: res = "positive"
      n if n < 0: res = "negative"
      _: res = "zero"
    expect(res).to_eq("negative")
  )
  it("should support inline case with destructuring", ():
    res = 0
    x: Option<int> = Some(42)
    case x:
      Some(v): res = v
      None: res = -1
    expect(res).to_eq(42)
  )
)

describe("inline when body", ():
  it("should support inline when arm and inline else", ():
    res = 0
    x = 5
    case:
      x > 10: res = 1
      x == 5: res = 2
      _: res = 3
    expect(res).to_eq(2)
  )
  it("should support inline when else fallback", ():
    res = 0
    x = 1
    case:
      x > 10: res = 1
      _: res = 9
    expect(res).to_eq(9)
  )
)

describe("scope and shadowing", ():
  it("should support block scope", ():
    x = 10
    res = 0
    if true:
      x = 99
      res = x
    expect(res).to_eq(99)
    expect(x).to_eq(99)
  )
)

describe("match expression", ():
  it("should match literal pattern as expression", ():
    x = 2
    res = case x:
      1 : "one"
      2 : "two"
      _ : "other"
    expect(res).to_eq("two")
  )
  it("should fall back to wildcard in match expression", ():
    x = 999
    res = case x:
      0 : "zero"
      _ : "other"
    expect(res).to_eq("other")
  )
  it("should match with variable binding and guard in expression", ():
    score = 85
    grade = case score:
      n if n >= 90 : "A"
      n if n >= 80 : "B"
      n if n >= 70 : "C"
      _ : "F"
    expect(grade).to_eq("B")
  )
  it("should match OR pattern in expression", ():
    x = 3
    kind = case x:
      1 | 2 | 3 : "small"
      4 | 5 | 6 : "medium"
      _ : "large"
    expect(kind).to_eq("small")
  )
  it("should match string literal in expression", ():
    s = "hello"
    res = case s:
      "hello" : "greeting"
      "bye" : "farewell"
      _ : "unknown"
    expect(res).to_eq("greeting")
  )
  it("should match negative literal in expression", ():
    x = -1
    res = case x:
      -1 : "minus one"
      0 : "zero"
      _ : "other"
    expect(res).to_eq("minus one")
  )
  it("should fall back to wildcard when guard fails in expression", ():
    x = 5
    res = case x:
      n if n > 100 : "big"
      n if n > 50 : "medium"
      _ : "small"
    expect(res).to_eq("small")
  )
)

describe("match expression Option", ():
  it("should match Some in expression", ():
    x: Option<int> = Some(42)
    res = case x:
      Some(v) : v
      None : -1
    expect(res).to_eq(42)
  )
  it("should match None in expression", ():
    x: Option<int> = None
    res = case x:
      Some(v) : v
      None : -1
    expect(res).to_eq(-1)
  )
)

describe("match expression enum", ():
  it("should match simple enum in expression", ():
    d = Direction::North
    res = case d:
      Direction::North : "N"
      Direction::South : "S"
      Direction::East : "E"
      Direction::West : "W"
    expect(res).to_eq("N")
  )
  it("should match ADT enum in expression", ():
    s = Shape::Rect(4.0, 5.0)
    area = case s:
      Shape::Circle(r) : r * r
      Shape::Rect(w, h) : w * h
      Shape::Point : 0.0
    expect(area).to_eq(20.0)
  )
  it("should match ADT no-data variant in expression", ():
    s = Shape::Point
    area = case s:
      Shape::Circle(r) : r * r
      Shape::Rect(w, h) : w * h
      Shape::Point : -1.0
    expect(area).to_eq(-1.0)
  )
)

describe("match expression in function argument", ():
  it("should support inline match expr as function argument", ():
    x = 1
    expect(case x:
      1 : 100
      _ : 0
    ).to_eq(100)
  )
)

# --- ADT enum as function parameter (#507) ---

fn shape_area(s: Shape) -> float:
  return case s:
    Shape::Circle(r) : 3.14 * r * r
    Shape::Rect(w, h) : w * h
    Shape::Point : 0.0

fn shape_name(s: Shape) -> str:
  return case s:
    Shape::Circle(r) : "circle"
    Shape::Rect(w, h) : "rect"
    Shape::Point : "point"

fn make_shape(kind: int) -> Shape:
  if kind == 0:
    return Shape::Circle(1.0)
  if kind == 1:
    return Shape::Rect(3.0, 4.0)
  return Shape::Point

describe("ADT enum as function parameter (#507)", ():
  it("should match on ADT enum parameter", ():
    expect(shape_area(Shape::Circle(1.0))).to_eq(3.14)
    expect(shape_area(Shape::Rect(4.0, 5.0))).to_eq(20.0)
    expect(shape_area(Shape::Point)).to_eq(0.0)
  )
  it("should support multiple functions matching same ADT enum parameter", ():
    c = Shape::Circle(2.0)
    expect(shape_area(c)).to_eq(12.56)
    expect(shape_name(c)).to_eq("circle")
    r = Shape::Rect(3.0, 4.0)
    expect(shape_area(r)).to_eq(12.0)
    expect(shape_name(r)).to_eq("rect")
  )
  it("should support ADT enum as return type", ():
    s = make_shape(0)
    expect(shape_name(s)).to_eq("circle")
    s2 = make_shape(2)
    expect(shape_name(s2)).to_eq("point")
  )
  it("should support ADT enum equality", ():
    expect(Shape::Point == Shape::Point).to_eq(true)
    expect(Shape::Point != Shape::Circle(1.0)).to_eq(true)
    expect(Shape::Circle(1.0) == Shape::Circle(1.0)).to_eq(true)
    expect(Shape::Circle(1.0) == Shape::Circle(2.0)).to_eq(false)
    expect(Shape::Circle(1.0) != Shape::Rect(1.0, 2.0)).to_eq(true)
  )
)
