describe("if/elif/else", fn():
    it("if true", fn():
        var res = 0
        if true:
            res = 1
        expect(res).to_eq(1)

    )
    it("if false goes to else", fn():
        var res = 0
        if false:
            res = 1
        else:
            res = 2
        expect(res).to_eq(2)

    )
    it("elif", fn():
        var res = 0
        let x = 5
        if x > 10:
            res = 1
        elif x == 5:
            res = 2
        else:
            res = 3
        expect(res).to_eq(2)

    )
)
describe("while", fn():
    it("basic loop", fn():
        var i = 0
        var sum = 0
        while i < 5:
            sum += i
            i += 1
        expect(sum).to_eq(10)

    )
    it("break", fn():
        var i = 0
        while true:
            if i >= 3:
                break
            i += 1
        expect(i).to_eq(3)

    )
    it("continue", fn():
        var sum = 0
        var i = 0
        while i < 5:
            i += 1
            if i == 3:
                continue
            sum += i
        expect(sum).to_eq(12)

    )
)
describe("for", fn():
    it("list iteration", fn():
        var sum = 0
        let xs = [10, 20, 30]
        for x in xs:
            sum += x
        expect(sum).to_eq(60)

    )
    it("range 1 arg", fn():
        var sum = 0
        for i in range(5):
            sum += i
        expect(sum).to_eq(10)

    )
    it("range 2 args", fn():
        var sum = 0
        for i in range(2, 5):
            sum += i
        expect(sum).to_eq(9)

    )
    it("range 3 args", fn():
        var sum = 0
        for i in range(0, 10, 3):
            sum += i
        expect(sum).to_eq(18)

    )
    it("range negative step", fn():
        var sum = 0
        for i in range(10, 0, -3):
            sum += i
        expect(sum).to_eq(22)

    )
    it(".. range", fn():
        var sum = 0
        for i in 1 .. 3:
            sum += i
        expect(sum).to_eq(6)

    )
    it("map key-value", fn():
        let m = {"a": 1, "b": 2}
        var total = 0
        for k, v in m:
            total += v
        expect(total).to_eq(3)

    )
    it("enumerate destructuring", fn():
        let xs = [10, 20, 30]
        var idx_sum = 0
        var val_sum = 0
        for i, x in enumerate(xs):
            idx_sum += i
            val_sum += x
        expect(idx_sum).to_eq(3)
        expect(val_sum).to_eq(60)

    )
    it("zip destructuring", fn():
        var sum = 0
        for a, b in zip([1, 2], [10, 20]):
            sum += a + b
        expect(sum).to_eq(33)

    )
)
describe("match", fn():
    it("literal pattern", fn():
        var res = 0
        let x = 2
        match x:
            case 1:
                res = 10
            case 2:
                res = 20
            case _:
                res = 30
        expect(res).to_eq(20)

    )
    it("variable binding", fn():
        var res = 0
        let x = 42
        match x:
            case n if n > 0:
                res = n
            case _:
                res = 0
        expect(res).to_eq(42)

    )
    it("guard", fn():
        var res = ""
        let x = -5
        match x:
            case n if n > 0:
                res = "positive"
            case n if n < 0:
                res = "negative"
            case _:
                res = "zero"
        expect(res).to_eq("negative")

    )
    it("OR pattern", fn():
        var res = ""
        let x = 2
        match x:
            case 1 | 2 | 3:
                res = "small"
            case _:
                res = "other"
        expect(res).to_eq("small")

    )
    it("wildcard", fn():
        var res = ""
        let x = 999
        match x:
            case 0:
                res = "zero"
            case _:
                res = "other"
        expect(res).to_eq("other")

    )
)
describe("match Option", fn():
    it("Some", fn():
        var res = 0
        let x: Option<int> = Some(42)
        match x:
            case Some(v):
                res = v
            case None:
                res = -1
        expect(res).to_eq(42)

    )
    it("None", fn():
        var res = 0
        let x: Option<int> = None
        match x:
            case Some(v):
                res = v
            case None:
                res = -1
        expect(res).to_eq(-1)

    )
)
enum Direction:
    North
    South
    East
    West

describe("match enum", fn():
    it("simple enum", fn():
        var res = ""
        let d = Direction::North
        match d:
            case Direction::North:
                res = "north"
            case Direction::South:
                res = "south"
            case Direction::East:
                res = "east"
            case Direction::West:
                res = "west"
        expect(res).to_eq("north")

    )
)
enum Shape:
    Circle(float)
    Rect(float, float)
    Point

describe("match ADT enum", fn():
    it("with associated data", fn():
        var res = 0.0
        let s = Shape::Circle(3.14)
        match s:
            case Shape::Circle(r):
                res = r
            case Shape::Rect(w, h):
                res = w * h
            case Shape::Point:
                res = 0.0
        expect(res).to_eq(3.14)

    )
    it("multi-field variant", fn():
        var res = 0.0
        let s = Shape::Rect(4.0, 5.0)
        match s:
            case Shape::Circle(r):
                res = r
            case Shape::Rect(w, h):
                res = w * h
            case Shape::Point:
                res = 0.0
        expect(res).to_eq(20.0)

    )
)
describe("scope and shadowing", fn():
    it("block scope", fn():
        let x = 10
        var res = 0
        if true:
            let x = 99
            res = x
        expect(res).to_eq(99)
        expect(x).to_eq(10)
    )
)
