describe("if / when", ():
  it("if true", ():
    res = 0
    if true:
      res = 1
    expect(res).to_eq(1)
  )
  it("if false goes to else", ():
    res = 0
    if false:
      res = 1
    else:
      res = 2
    expect(res).to_eq(2)
  )
  it("when multi-branch", ():
    res = 0
    x = 5
    when:
      x > 10:
        res = 1
      x == 5:
        res = 2
      else:
        res = 3
    expect(res).to_eq(2)
  )
  it("when all false falls to else", ():
    res = 0
    x = 99
    when:
      x == 1:
        res = 1
      x == 2:
        res = 2
      else:
        res = 3
    expect(res).to_eq(3)
  )
  it("when first false second true", ():
    res = 0
    x = 5
    when:
      x > 100:
        res = 1
      x > 3:
        res = 2
      else:
        res = 3
    expect(res).to_eq(2)
  )
)

describe("while", ():
  it("basic loop", ():
    i = 0
    sum = 0
    while i < 5:
      sum = sum + i
      i = i + 1
    expect(sum).to_eq(10)
  )
  it("break", ():
    i = 0
    while true:
      if i >= 3:
        break
      i = i + 1
    expect(i).to_eq(3)
  )
  it("continue", ():
    sum = 0
    i = 0
    while i < 5:
      i = i + 1
      if i == 3:
        continue
      sum = sum + i
    expect(sum).to_eq(12)
  )
)

describe("for", ():
  it("list iteration", ():
    sum = 0
    xs = [10, 20, 30]
    for x in xs:
      sum = sum + x
    expect(sum).to_eq(60)
  )
  it("range 1 arg", ():
    sum = 0
    for i in range(5):
      sum = sum + i
    expect(sum).to_eq(10)
  )
  it("range 2 args", ():
    sum = 0
    for i in range(2, 5):
      sum = sum + i
    expect(sum).to_eq(9)
  )
  it("range 3 args", ():
    sum = 0
    for i in range(0, 10, 3):
      sum = sum + i
    expect(sum).to_eq(18)
  )
  it("range negative step", ():
    sum = 0
    for i in range(10, 0, -3):
      sum = sum + i
    expect(sum).to_eq(22)
  )
  it(".. range", ():
    sum = 0
    for i in 1..3:
      sum = sum + i
    expect(sum).to_eq(6)
  )
  it("map key-value", ():
    m = {"a": 1, "b": 2}
    total = 0
    for k, v in m:
      total = total + v
    expect(total).to_eq(3)
  )
  it("enumerate destructuring", ():
    xs = [10, 20, 30]
    idx_sum = 0
    val_sum = 0
    for i, x in enumerate(xs):
      idx_sum = idx_sum + i
      val_sum = val_sum + x
    expect(idx_sum).to_eq(3)
    expect(val_sum).to_eq(60)
  )
  it("zip destructuring", ():
    sum = 0
    for a, b in zip([1, 2], [10, 20]):
      sum = sum + (a + b)
    expect(sum).to_eq(33)
  )
  it("3-element tuple destructuring", ():
    triples = [(1, 2, 3), (4, 5, 6)]
    sum_a = 0
    sum_b = 0
    sum_c = 0
    for a, b, c in triples:
      sum_a = sum_a + a
      sum_b = sum_b + b
      sum_c = sum_c + c
    expect(sum_a).to_eq(5)
    expect(sum_b).to_eq(7)
    expect(sum_c).to_eq(9)
  )
  it("3-element destructuring with wildcard", ():
    triples = [(1, 2, 3), (4, 5, 6)]
    sum = 0
    for a, _, c in triples:
      sum = sum + a + c
    expect(sum).to_eq(14)
  )
  it("empty list iteration", ():
    sum = 0
    xs = [1]
    empty = filter(xs, (x: int) => x > 10)
    for x in empty:
      sum = sum + x
    expect(sum).to_eq(0)
  )
  it("range(0) is empty", ():
    sum = 0
    for i in range(0):
      sum = sum + 1
    expect(sum).to_eq(0)
  )
  it("range with equal start and end", ():
    sum = 0
    for i in range(5, 5):
      sum = sum + 1
    expect(sum).to_eq(0)
  )
  it("range reverse without step", ():
    sum = 0
    for i in range(5, 3):
      sum = sum + 1
    expect(sum).to_eq(0)
  )
)

describe("when", ():
  it("literal pattern", ():
    res = 0
    x = 2
    match x:
      case 1:
        res = 10
      case 2:
        res = 20
      case _:
        res = 30
    expect(res).to_eq(20)
  )
  it("variable binding", ():
    res = 0
    x = 42
    match x:
      case n if n > 0:
        res = n
      case _:
        res = 0
    expect(res).to_eq(42)
  )
  it("guard", ():
    res = ""
    x = -5
    match x:
      case n if n > 0:
        res = "positive"
      case n if n < 0:
        res = "negative"
      case _:
        res = "zero"
    expect(res).to_eq("negative")
  )
  it("OR pattern", ():
    res = ""
    x = 2
    match x:
      case 1 | 2 | 3:
        res = "small"
      case _:
        res = "other"
    expect(res).to_eq("small")
  )
  it("wildcard", ():
    res = ""
    x = 999
    match x:
      case 0:
        res = "zero"
      case _:
        res = "other"
    expect(res).to_eq("other")
  )
  it("string literal pattern", ():
    res = ""
    s = "hello"
    match s:
      case "hello":
        res = "matched"
      case _:
        res = "other"
    expect(res).to_eq("matched")
  )
  it("negative literal pattern", ():
    res = ""
    x = -1
    match x:
      case -1:
        res = "minus one"
      case 0:
        res = "zero"
      case _:
        res = "other"
    expect(res).to_eq("minus one")
  )
  it("guard fallback to wildcard", ():
    res = ""
    x = 5
    match x:
      case n if n > 100:
        res = "big"
      case n if n > 50:
        res = "medium"
      case _:
        res = "small"
    expect(res).to_eq("small")
  )
  it("OR pattern with many alternatives", ():
    res = ""
    x = 4
    match x:
      case 1 | 2 | 3 | 4:
        res = "small"
      case _:
        res = "other"
    expect(res).to_eq("small")
  )
)

describe("when Option", ():
  it("Some", ():
    res = 0
    x: Option<int> = Some(42)
    match x:
      case Some(v):
        res = v
      case None:
        res = -1
    expect(res).to_eq(42)
  )
  it("None", ():
    res = 0
    x: Option<int> = None
    match x:
      case Some(v):
        res = v
      case None:
        res = -1
    expect(res).to_eq(-1)
  )
)

enum Direction:
  North
  South
  East
  West

describe("when enum", ():
  it("simple enum", ():
    res = ""
    d = Direction::North
    match d:
      case Direction::North:
        res = "north"
      case Direction::South:
        res = "south"
      case Direction::East:
        res = "east"
      case Direction::West:
        res = "west"
    expect(res).to_eq("north")
  )
  it("last enum variant matches", ():
    res = ""
    d = Direction::West
    match d:
      case Direction::North:
        res = "north"
      case Direction::South:
        res = "south"
      case Direction::East:
        res = "east"
      case Direction::West:
        res = "west"
    expect(res).to_eq("west")
  )
)

enum Shape:
  Circle(float)
  Rect(float, float)
  Point

describe("when ADT enum", ():
  it("with associated data", ():
    res = 0.0
    s = Shape::Circle(3.14)
    match s:
      case Shape::Circle(r):
        res = r
      case Shape::Rect(w, h):
        res = w * h
      case Shape::Point:
        res = 0.0
    expect(res).to_eq(3.14)
  )
  it("multi-field variant", ():
    res = 0.0
    s = Shape::Rect(4.0, 5.0)
    match s:
      case Shape::Circle(r):
        res = r
      case Shape::Rect(w, h):
        res = w * h
      case Shape::Point:
        res = 0.0
    expect(res).to_eq(20.0)
  )
)

describe("nested when", ():
  it("when inside when", ():
    res = ""
    x = 2
    y = 10
    match x:
      case 1:
        res = "one"
      case 2:
        match y:
          case 10:
            res = "two-ten"
          case _:
            res = "two-other"
      case _:
        res = "other"
    expect(res).to_eq("two-ten")
  )
)

describe("when ADT no-data variant", ():
  it("matches Point variant", ():
    res = 0.0
    s = Shape::Point
    match s:
      case Shape::Circle(r):
        res = r
      case Shape::Rect(w, h):
        res = w * h
      case Shape::Point:
        res = -1.0
    expect(res).to_eq(-1.0)
  )
)

describe("scope and shadowing", ():
  it("block scope", ():
    x = 10
    res = 0
    if true:
      x = 99
      res = x
    expect(res).to_eq(99)
    expect(x).to_eq(99)
  )
)

describe("match expression", ():
  it("literal pattern", ():
    x = 2
    res = match x:
      case 1 => "one"
      case 2 => "two"
      case _ => "other"
    expect(res).to_eq("two")
  )
  it("wildcard fallback", ():
    x = 999
    res = match x:
      case 0 => "zero"
      case _ => "other"
    expect(res).to_eq("other")
  )
  it("variable binding with guard", ():
    score = 85
    grade = match score:
      case n if n >= 90 => "A"
      case n if n >= 80 => "B"
      case n if n >= 70 => "C"
      case _ => "F"
    expect(grade).to_eq("B")
  )
  it("OR pattern", ():
    x = 3
    kind = match x:
      case 1 | 2 | 3 => "small"
      case 4 | 5 | 6 => "medium"
      case _ => "large"
    expect(kind).to_eq("small")
  )
  it("string literal", ():
    s = "hello"
    res = match s:
      case "hello" => "greeting"
      case "bye" => "farewell"
      case _ => "unknown"
    expect(res).to_eq("greeting")
  )
  it("negative literal", ():
    x = -1
    res = match x:
      case -1 => "minus one"
      case 0 => "zero"
      case _ => "other"
    expect(res).to_eq("minus one")
  )
  it("guard fallback to wildcard", ():
    x = 5
    res = match x:
      case n if n > 100 => "big"
      case n if n > 50 => "medium"
      case _ => "small"
    expect(res).to_eq("small")
  )
)

describe("match expression Option", ():
  it("Some", ():
    x: Option<int> = Some(42)
    res = match x:
      case Some(v) => v
      case None => -1
    expect(res).to_eq(42)
  )
  it("None", ():
    x: Option<int> = None
    res = match x:
      case Some(v) => v
      case None => -1
    expect(res).to_eq(-1)
  )
)

describe("match expression enum", ():
  it("simple enum", ():
    d = Direction::North
    res = match d:
      case Direction::North => "N"
      case Direction::South => "S"
      case Direction::East => "E"
      case Direction::West => "W"
    expect(res).to_eq("N")
  )
  it("ADT enum", ():
    s = Shape::Rect(4.0, 5.0)
    area = match s:
      case Shape::Circle(r) => r * r
      case Shape::Rect(w, h) => w * h
      case Shape::Point => 0.0
    expect(area).to_eq(20.0)
  )
  it("ADT no-data variant", ():
    s = Shape::Point
    area = match s:
      case Shape::Circle(r) => r * r
      case Shape::Rect(w, h) => w * h
      case Shape::Point => -1.0
    expect(area).to_eq(-1.0)
  )
)

describe("match expression in function argument", ():
  it("inline match expr", ():
    x = 1
    expect(match x:
      case 1 => 100
      case _ => 0
    ).to_eq(100)
  )
)

# --- ADT enum as function parameter (#507) ---

function shape_area(s: Shape) -> float:
  return match s:
    case Shape::Circle(r) => 3.14 * r * r
    case Shape::Rect(w, h) => w * h
    case Shape::Point => 0.0

function shape_name(s: Shape) -> str:
  return match s:
    case Shape::Circle(r) => "circle"
    case Shape::Rect(w, h) => "rect"
    case Shape::Point => "point"

function make_shape(kind: int) -> Shape:
  if kind == 0:
    return Shape::Circle(1.0)
  if kind == 1:
    return Shape::Rect(3.0, 4.0)
  return Shape::Point

describe("ADT enum as function parameter (#507)", ():
  it("match on ADT enum parameter", ():
    expect(shape_area(Shape::Circle(1.0))).to_eq(3.14)
    expect(shape_area(Shape::Rect(4.0, 5.0))).to_eq(20.0)
    expect(shape_area(Shape::Point)).to_eq(0.0)
  )
  it("multiple functions matching same ADT enum parameter", ():
    c = Shape::Circle(2.0)
    expect(shape_area(c)).to_eq(12.56)
    expect(shape_name(c)).to_eq("circle")
    r = Shape::Rect(3.0, 4.0)
    expect(shape_area(r)).to_eq(12.0)
    expect(shape_name(r)).to_eq("rect")
  )
  it("ADT enum as return type", ():
    s = make_shape(0)
    expect(shape_name(s)).to_eq("circle")
    s2 = make_shape(2)
    expect(shape_name(s2)).to_eq("point")
  )
  it("ADT enum equality", ():
    expect(Shape::Point == Shape::Point).to_eq(true)
    expect(Shape::Point != Shape::Circle(1.0)).to_eq(true)
    expect(Shape::Circle(1.0) == Shape::Circle(2.0)).to_eq(true)
    expect(Shape::Circle(1.0) != Shape::Rect(1.0, 2.0)).to_eq(true)
  )
)
