from ry.testing import it, describe, expect

@describe("fixed-length array")
fn fixedLengthArrayTests():
  @it("should support declaration and index read")
  fn shouldSupportDeclarationAndIndexRead():
    buf: i32[4] = [1, 2, 3, 4]
    expect(buf[0] as int).toEq(1)
    expect(buf[1] as int).toEq(2)
    expect(buf[3] as int).toEq(4)
  @it("should support index write")
  fn shouldSupportIndexWrite():
    buf: i32[3] = [0, 0, 0]
    buf[1] = 42
    expect(buf[1] as int).toEq(42)
  @it("should return length")
  fn shouldReturnLength():
    buf: u8[8] = [1, 2, 3, 4, 5, 6, 7, 8]
    expect(len(buf)).toEq(8)
  @it("should support u8 array")
  fn shouldSupportU8Array():
    buf: u8[3] = [65, 66, 67]
    expect(buf[0] as int).toEq(65)
    expect(buf[2] as int).toEq(67)
  @it("should support f32 array")
  fn shouldSupportF32Array():
    buf: f32[2] = [1.5, 2.5]
    expect(buf[0] as float).toEq(1.5)
    expect(buf[1] as float).toEq(2.5)
  @it("should support i16 array")
  fn shouldSupportI16Array():
    buf: i16[2] = [100, 200]
    expect(buf[0] as int).toEq(100)
    expect(buf[1] as int).toEq(200)
