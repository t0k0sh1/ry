from testing import it, describe, expect, fail

from json import load, loadAs, stringify, stringifySafe, stringifySorted, stringifySortedSafe, dump
from str import contains, repeat, byteLen
from io import open, close, writeText, readText
from math import NAN, INF

@describe("json load — primitives")
fn jsonLoadPrimitivesTests():
  @it("should load null as any")
  fn shouldLoadNullAsAny():
    case load("null"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("null")
      Err(e):
        fail("load null failed: " + e.message)

  @it("should load true as any")
  fn shouldLoadTrueAsAny():
    case load("true"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("true")
      Err(e):
        fail("load true failed: " + e.message)

  @it("should load false as any")
  fn shouldLoadFalseAsAny():
    case load("false"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("false")
      Err(e):
        fail("load false failed: " + e.message)

  @it("should load int as any")
  fn shouldLoadIntAsAny():
    case load("42"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("42")
      Err(e):
        fail("load int failed: " + e.message)

  @it("should load negative int as any")
  fn shouldLoadNegativeIntAsAny():
    case load("-7"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("-7")
      Err(e):
        fail("load negative int failed: " + e.message)

  @it("should load float as any")
  fn shouldLoadFloatAsAny():
    case load("3.5"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("3.5")
      Err(e):
        fail("load float failed: " + e.message)

  @it("should load str as any")
  fn shouldLoadStrAsAny():
    case load("\"hi\""):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("\"hi\"")
      Err(e):
        fail("load str failed: " + e.message)

  @it("should reject malformed input")
  fn shouldRejectMalformedInput():
    case load("{not json}"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "expected string key")).toEq(true)

  @it("should reject trailing content")
  fn shouldRejectTrailingContent():
    case load("42 extra"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "trailing")).toEq(true)

  @it("should reject raw NUL inside a string")
  fn shouldRejectRawNulInsideString():
    case load("\"a\0b\""):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(byteLen(e.message) > 0).toEq(true)

  @it("should reject raw newline inside a string")
  fn shouldRejectRawNewlineInsideString():
    case load("\"a\nb\""):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(byteLen(e.message) > 0).toEq(true)

@describe("json load — array")
fn jsonLoadArrayTests():
  @it("should load empty array")
  fn shouldLoadEmptyArray():
    case load("[]"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("[]")
      Err(e):
        fail("load empty array failed: " + e.message)

  @it("should load array of ints")
  fn shouldLoadArrayOfInts():
    case load("[1, 2, 3]"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("[1,2,3]")
      Err(e):
        fail("load array failed: " + e.message)

  @it("should load mixed-type array round-trip")
  fn shouldLoadMixedArrayRoundTrip():
    case load("[1, \"two\", true, null]"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("[1,\"two\",true,null]")
      Err(e):
        fail("load mixed array failed: " + e.message)

  @it("should load nested array")
  fn shouldLoadNestedArray():
    case load("[[1, 2], [3]]"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("[[1,2],[3]]")
      Err(e):
        fail("load nested array failed: " + e.message)

@describe("json load — object")
fn jsonLoadObjectTests():
  @it("should load empty object")
  fn shouldLoadEmptyObject():
    case load("{}"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("{}")
      Err(e):
        fail("load empty object failed: " + e.message)

  @it("should load object round-trip preserving insertion order")
  fn shouldLoadObjectRoundTrip():
    case load("{\"a\": 1, \"b\": 2}"):
      Ok(v):
        s: str = stringify(v)
        # Map iteration order = insertion order, so a-then-b
        expect(s).toEq("{\"a\":1,\"b\":2}")
      Err(e):
        fail("load object failed: " + e.message)

  @it("should load nested object round-trip")
  fn shouldLoadNestedObjectRoundTrip():
    case load("{\"outer\": {\"inner\": 7}}"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("{\"outer\":{\"inner\":7}}")
      Err(e):
        fail("load nested object failed: " + e.message)

@describe("json load — nested mixed")
fn jsonLoadNestedMixedTests():
  @it("should load object containing array round-trip")
  fn shouldLoadObjectContainingArrayRoundTrip():
    case load("{\"xs\": [1, 2, 3]}"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("{\"xs\":[1,2,3]}")
      Err(e):
        fail("load object-array failed: " + e.message)

  @it("should load array containing object round-trip")
  fn shouldLoadArrayContainingObjectRoundTrip():
    case load("[{\"k\": 1}, {\"k\": 2}]"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("[{\"k\":1},{\"k\":2}]")
      Err(e):
        fail("load array-object failed: " + e.message)

@describe("json stringify — primitives")
fn jsonStringifyAnyPrimitivesTests():
  @it("should round-trip int via load and stringify")
  fn shouldRoundTripIntPrimitive():
    case load("123"):
      Ok(v):
        expect(stringify(v)).toEq("123")
      Err(e):
        fail("load 123 failed: " + e.message)

  @it("should round-trip float via load and stringify")
  fn shouldRoundTripFloatPrimitive():
    case load("1.5"):
      Ok(v):
        expect(stringify(v)).toEq("1.5")
      Err(e):
        fail("load 1.5 failed: " + e.message)

  @it("should round-trip bool via load and stringify")
  fn shouldRoundTripBoolPrimitive():
    case load("true"):
      Ok(v):
        expect(stringify(v)).toEq("true")
      Err(e):
        fail("load true failed: " + e.message)

@describe("json stringify — pretty (indent)")
fn jsonStringifyAnyPrettyTests():
  @it("should pretty-print array with indent=2")
  fn shouldPrettyPrintArray():
    case load("[1, 2]"):
      Ok(v):
        # 2-space indent
        expected = "[\n  1,\n  2\n]"
        expect(stringify(v, 2)).toEq(expected)
      Err(e):
        fail("load [1,2] failed: " + e.message)

  @it("should pretty-print object with indent=2")
  fn shouldPrettyPrintObject():
    case load("{\"a\": 1}"):
      Ok(v):
        expected = "{\n  \"a\": 1\n}"
        expect(stringify(v, 2)).toEq(expected)
      Err(e):
        fail("load {a:1} failed: " + e.message)

  @it("should fall back to compact form when indent is negative")
  fn shouldCompactWhenIndentNegative():
    case load("[1, 2]"):
      Ok(v):
        expect(stringify(v, -1)).toEq("[1,2]")
        expect(stringify(v, -100)).toEq("[1,2]")
      Err(e):
        fail("load [1,2] failed: " + e.message)

@describe("json loadAs<T> — primitives")
fn jsonLoadAsPrimitiveTests():
  @it("should parse int directly via loadAs<int>")
  fn shouldLoadAsInt():
    case loadAs[int]("42"):
      Ok(n):
        expect(n).toEq(42)
      Err(e):
        fail("loadAs<int> failed: " + e.message)

  @it("should parse negative int via loadAs<int>")
  fn shouldLoadAsNegativeInt():
    case loadAs[int]("-7"):
      Ok(n):
        expect(n).toEq(-7)
      Err(e):
        fail("loadAs<int> -7 failed: " + e.message)

  @it("should parse float via loadAs<float>")
  fn shouldLoadAsFloat():
    case loadAs[float]("3.5"):
      Ok(f):
        expect(f).toEq(3.5)
      Err(e):
        fail("loadAs<float> failed: " + e.message)

  @it("should parse str via loadAs<str>")
  fn shouldLoadAsStr():
    case loadAs[str]("\"hello\""):
      Ok(s):
        expect(s).toEq("hello")
      Err(e):
        fail("loadAs<str> failed: " + e.message)

  @it("should parse bool true via loadAs<bool>")
  fn shouldLoadAsBoolTrue():
    case loadAs[bool]("true"):
      Ok(b):
        expect(b).toEq(true)
      Err(e):
        fail("loadAs<bool> true failed: " + e.message)

  @it("should parse bool false via loadAs<bool>")
  fn shouldLoadAsBoolFalse():
    case loadAs[bool]("false"):
      Ok(b):
        expect(b).toEq(false)
      Err(e):
        fail("loadAs<bool> false failed: " + e.message)

  @it("should propagate parse error via loadAs<int>")
  fn shouldPropagateParseError():
    case loadAs[int]("{not json}"):
      Ok(_):
        fail("expected parse error for invalid JSON")
      Err(e):
        # loadAs propagates the load() error via `?`, so the message
        # comes from the parser. Only assert that an error returned
        # with a non-empty message.
        expect(byteLen(e.message) > 0).toEq(true)

@describe("json loadAs<T> — collections")
fn jsonLoadAsCollectionTests():
  @it("should parse List<any> via loadAs")
  fn shouldLoadAsListOfAny():
    case loadAs[List<any>]("[1, 2, 3]"):
      Ok(xs):
        expect(len(xs)).toEq(3)
      Err(e):
        fail("loadAs<List<any>> failed: " + e.message)

  @it("should parse empty List<any> via loadAs")
  fn shouldLoadAsEmptyList():
    case loadAs[List<any>]("[]"):
      Ok(xs):
        expect(len(xs)).toEq(0)
      Err(e):
        fail("loadAs<List<any>> [] failed: " + e.message)

  @it("should parse Map<str, any> via loadAs")
  fn shouldLoadAsMapStrAny():
    case loadAs[Map<str, any>]("{\"a\": 1, \"b\": 2}"):
      Ok(m):
        expect(len(m)).toEq(2)
      Err(e):
        fail("loadAs<Map<str, any>> failed: " + e.message)

  @it("should parse empty Map<str, any> via loadAs")
  fn shouldLoadAsEmptyMap():
    case loadAs[Map<str, any>]("{}"):
      Ok(m):
        expect(len(m)).toEq(0)
      Err(e):
        fail("loadAs<Map<str, any>> {} failed: " + e.message)

@describe("json NUL round-trip")
fn jsonNulRoundTripTests():
  @it("should parse \\u0000 in a string value via loadAs<str>")
  fn shouldParseU0000InAStringValue():
    case loadAs[str]("\"a\\u0000b\""):
      Ok(s):
        expect(byteLen(s)).toEq(3)
        expect(s == "a\0b").toEq(true)
      Err(e):
        fail("loadAs<str> failed: " + e.message)

  @it("should stringify NUL back to \\u0000")
  fn shouldStringifyNulBackToU0000():
    case load("\"a\\u0000b\""):
      Ok(v):
        expect(stringify(v)).toEq("\"a\\u0000b\"")
      Err(e):
        fail("load failed: " + e.message)

  @it("should round-trip NUL in object value")
  fn shouldRoundTripNulInObjectValue():
    case load("{\"k\":\"a\\u0000b\"}"):
      Ok(v):
        expect(stringify(v)).toEq("{\"k\":\"a\\u0000b\"}")
      Err(e):
        fail("load failed: " + e.message)

  @it("should round-trip NUL in object key")
  fn shouldRoundTripNulInObjectKey():
    case load("{\"k\\u0000x\":1}"):
      Ok(v):
        expect(stringify(v)).toEq("{\"k\\u0000x\":1}")
      Err(e):
        fail("load failed: " + e.message)

  @it("should round-trip NUL in array element")
  fn shouldRoundTripNulInArrayElement():
    case load("[\"a\\u0000b\",\"c\"]"):
      Ok(v):
        expect(stringify(v)).toEq("[\"a\\u0000b\",\"c\"]")
      Err(e):
        fail("load failed: " + e.message)

  @it("should disambiguate keys that share prefix up to NUL")
  fn shouldDisambiguateKeysThatSharePrefixUpToNul():
    case loadAs[Map<str, any>]("{\"k\\u0000a\":1,\"k\\u0000b\":2}"):
      Ok(m):
        expect(len(m)).toEq(2)
      Err(e):
        fail("loadAs<Map<str, any>> failed: " + e.message)

@describe("json parse depth limit")
fn jsonParseDepthLimitTests():
  @it("should reject deeply nested arrays")
  fn shouldRejectDeeplyNestedArrays():
    # depth 257 = MAX_NESTING_DEPTH (256) + 1
    deep = repeat("[", 257) + repeat("]", 257)
    case load(deep):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "json: maximum nesting depth exceeded")).toEq(true)

  @it("should reject deeply nested objects")
  fn shouldRejectDeeplyNestedObjects():
    # depth 257 of {"a": ... } nesting
    deep = repeat("{\"a\":", 257) + "1" + repeat("}", 257)
    case load(deep):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "json: maximum nesting depth exceeded")).toEq(true)

  @it("should reject mixed array and object nesting that exceeds the limit")
  fn shouldRejectMixedArrayAndObjectNestingThatExceedsTheLimit():
    # alternating [{ pairs: each pair contributes depth 2; 129 pairs = depth 258 > 256
    pairs = 129
    open = repeat("[{\"a\":", pairs)
    close = repeat("}]", pairs)
    deep = open + "1" + close
    case load(deep):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "json: maximum nesting depth exceeded")).toEq(true)

  @it("should accept nesting at exactly the depth limit")
  fn shouldAcceptNestingAtExactlyTheDepthLimit():
    # depth 256 = MAX_NESTING_DEPTH (boundary - 1, inclusive)
    deep = repeat("[", 256) + repeat("]", 256)
    case load(deep):
      Ok(_):
        0
      Err(e):
        fail("expected Ok at depth 256 but got Err: " + e.message)

@describe("json load — error position (line:column)")
fn jsonLoadErrorPositionTests():
  @it("should report line/column/offset for malformed input")
  fn shouldReportLineColumnOffsetForMalformedInput():
    # {not json}: parse_object sees 'n' at byte offset 1 (column 2)
    case load("{not json}"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "line 1, column 2")).toEq(true)
        expect(contains(e.message, "offset 1")).toEq(true)

  @it("should report line 3 for multi-line malformed input")
  fn shouldReportLine3ForMultiLineMalformedInput():
    # 'invalid' starts at byte 13, on line 3, column 3
    case load("{\n  \"key\":\n  invalid\n}"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "line 3")).toEq(true)
        expect(contains(e.message, "column 3")).toEq(true)
        expect(contains(e.message, "offset 13")).toEq(true)

  @it("should count column in codepoints not bytes")
  fn shouldCountColumnInCodepointsNotBytes():
    # ["日本語", invalid]
    # codepoint columns: [ " 日 本 語 " , space i → 'i' at column 9
    # byte offset: 0 1 2-4 5-7 8-10 11 12 13 14 → 'i' at byte 14
    case load("[\"日本語\", invalid]"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "column 9")).toEq(true)
        expect(contains(e.message, "offset 14")).toEq(true)

  @it("should report line 1 column 1 offset 0 at start of input")
  fn shouldReportLine1Column1Offset0AtStartOfInput():
    case load("x"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "line 1, column 1")).toEq(true)
        expect(contains(e.message, "offset 0")).toEq(true)

@describe("json File overloads — #1854")
fn jsonFileOverloadsTests():
  @it("should load JSON object from a File handle")
  fn shouldLoadObjectFromFileHandle():
    case writeText("/tmp/ry_1854_load_object.json", "{\"name\":\"alice\",\"age\":30}"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_load_object.json", "r"):
      Ok(file):
        case load(file):
          Ok(v):
            s: str = stringify(v)
            expect(s).toEq("{\"name\":\"alice\",\"age\":30}")
            close(file)
          Err(e):
            close(file)
            fail("load(File) failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should load JSON array from a File handle")
  fn shouldLoadArrayFromFileHandle():
    case writeText("/tmp/ry_1854_load_array.json", "[1,2,3]"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_load_array.json", "r"):
      Ok(file):
        case load(file):
          Ok(v):
            s: str = stringify(v)
            expect(s).toEq("[1,2,3]")
            close(file)
          Err(e):
            close(file)
            fail("load(File) array failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should propagate parser line/column error from a File handle")
  fn shouldPropagateParserErrorFromFileHandle():
    case writeText("/tmp/ry_1854_load_bad.json", "{\n  invalid\n}"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_load_bad.json", "r"):
      Ok(file):
        case load(file):
          Ok(_):
            close(file)
            fail("expected Err but got Ok")
          Err(e):
            close(file)
            expect(contains(e.message, "line 2")).toEq(true)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should reject load on a closed File handle")
  fn shouldRejectLoadOnClosedHandle():
    case writeText("/tmp/ry_1854_closed.json", "{}"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_closed.json", "r"):
      Ok(file):
        close(file)
        case load(file):
          Ok(_):
            fail("expected Err but got Ok after close")
          Err(e):
            expect(contains(e.message, "not open")).toEq(true)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should dump value compactly to a File handle")
  fn shouldDumpCompactToFileHandle():
    case open("/tmp/ry_1854_dump_compact.json", "w"):
      Ok(file):
        v: Map<str, any> = {}
        v["k"] = "v"
        case dump(file, v):
          Ok(_):
            close(file)
          Err(e):
            close(file)
            fail("dump compact failed: " + e.message)
      Err(e):
        fail("open w failed: " + e.message)
    case readText("/tmp/ry_1854_dump_compact.json"):
      Ok(s):
        expect(s).toEq("{\"k\":\"v\"}")
      Err(e):
        fail("verify readText failed: " + e.message)

  @it("should dump value pretty-printed when indent > 0")
  fn shouldDumpPrettyWhenIndentGiven():
    case open("/tmp/ry_1854_dump_pretty.json", "w"):
      Ok(file):
        v: List<any> = []
        append!(v, 1)
        append!(v, 2)
        case dump(file, v, 2):
          Ok(_):
            close(file)
          Err(e):
            close(file)
            fail("dump pretty failed: " + e.message)
      Err(e):
        fail("open w failed: " + e.message)
    case readText("/tmp/ry_1854_dump_pretty.json"):
      Ok(s):
        # Pretty output contains newlines and indented elements.
        expect(contains(s, "\n")).toEq(true)
        expect(contains(s, "  1")).toEq(true)
      Err(e):
        fail("verify readText failed: " + e.message)

  @it("should round-trip via dump then load")
  fn shouldRoundTripDumpThenLoad():
    case open("/tmp/ry_1854_roundtrip.json", "w"):
      Ok(file):
        original: Map<str, any> = {}
        original["hello"] = "world"
        original["name"] = "alice"
        case dump(file, original):
          Ok(_):
            close(file)
          Err(e):
            close(file)
            fail("dump failed: " + e.message)
      Err(e):
        fail("open w failed: " + e.message)
    case open("/tmp/ry_1854_roundtrip.json", "r"):
      Ok(file):
        case load(file):
          Ok(v):
            s: str = stringify(v)
            expect(s).toEq("{\"hello\":\"world\",\"name\":\"alice\"}")
            close(file)
          Err(e):
            close(file)
            fail("load roundtrip failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

@describe("json loadAs<T> — File overloads (#1854 + #1874)")
fn jsonLoadAsFileOverloadsTests():
  @it("should parse int directly via loadAs<int>(File)")
  fn shouldLoadAsIntFromFile():
    case writeText("/tmp/ry_1854_loadas_int.json", "42"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_loadas_int.json", "r"):
      Ok(file):
        case loadAs[int](file):
          Ok(n):
            expect(n).toEq(42)
            close(file)
          Err(e):
            close(file)
            fail("loadAs<int>(File) failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should parse str via loadAs<str>(File)")
  fn shouldLoadAsStrFromFile():
    case writeText("/tmp/ry_1854_loadas_str.json", "\"hello\""):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_loadas_str.json", "r"):
      Ok(file):
        case loadAs[str](file):
          Ok(s):
            expect(s).toEq("hello")
            close(file)
          Err(e):
            close(file)
            fail("loadAs<str>(File) failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should parse Map<str, any> via loadAs<Map<str, any>>(File)")
  fn shouldLoadAsMapFromFile():
    case writeText("/tmp/ry_1854_loadas_map.json", "{\"name\":\"alice\",\"age\":30}"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_loadas_map.json", "r"):
      Ok(file):
        case loadAs[Map<str, any>](file):
          Ok(m):
            s: str = stringify(m)
            expect(s).toEq("{\"name\":\"alice\",\"age\":30}")
            close(file)
          Err(e):
            close(file)
            fail("loadAs<Map>(File) failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should propagate parse error from File via loadAs<int>(File)")
  fn shouldPropagateParseErrorViaLoadAsFile():
    case writeText("/tmp/ry_1854_loadas_bad.json", "{not json}"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_loadas_bad.json", "r"):
      Ok(file):
        case loadAs[int](file):
          Ok(_):
            close(file)
            fail("expected Err but got Ok")
          Err(e):
            close(file)
            expect(contains(e.message, "line 1")).toEq(true)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should keep loadAs<T>(str) overload working alongside File overload")
  fn shouldRouteStrOverloadAlongsideFileOverload():
    case loadAs[int]("99"):
      Ok(n):
        expect(n).toEq(99)
      Err(e):
        fail("loadAs<int>(str) regression: " + e.message)

# Diagnostic non-generic wrapper to isolate whether the bug is in
# generic monomorphization or in @native overload-by-arg-type resolution
# within an ordinary fn body.
fn diagLoadIntFromFile(f: File) -> Result<int, Error>:
  v: int = load(f)?
  return Ok(v)

@describe("json diag — load(File) from non-generic fn body")
fn jsonDiagLoadFromFnBodyTests():
  @it("should resolve load(f: File) when called from a non-generic fn body")
  fn shouldResolveLoadFileFromFnBody():
    case writeText("/tmp/ry_1854_diag.json", "777"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_diag.json", "r"):
      Ok(file):
        case diagLoadIntFromFile(file):
          Ok(n):
            expect(n).toEq(777)
            close(file)
          Err(e):
            close(file)
            fail("diagLoadIntFromFile failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

# Records for #1852 — loadAs<T> reconstruction of user-defined records and
# typed collections. Prefixed with Json1852 to avoid colliding with other
# record names in this file or in tests imported alongside it.

record Json1852Person:
  name: str
  age: int

record Json1852Address:
  person: Json1852Person
  city: str

@describe("json loadAs<T> — flat record reconstruction (#1852)")
fn jsonLoadAsFlatRecordTests():
  @it("should reconstruct a flat record from a JSON object")
  fn shouldReconstructFlatRecord():
    case loadAs[Json1852Person]("{\"name\": \"alice\", \"age\": 30}"):
      Ok(p):
        expect(p.name).toEq("alice")
        expect(p.age).toEq(30)
      Err(e):
        fail("loadAs<Json1852Person> failed: " + e.message)

  @it("should accept fields in any order")
  fn shouldAcceptFieldsInAnyOrder():
    case loadAs[Json1852Person]("{\"age\": 7, \"name\": \"bob\"}"):
      Ok(p):
        expect(p.name).toEq("bob")
        expect(p.age).toEq(7)
      Err(e):
        fail("loadAs<Json1852Person> reorder failed: " + e.message)

  @it("should return Err when a required field is missing")
  fn shouldReturnErrWhenRequiredFieldMissing():
    case loadAs[Json1852Person]("{\"name\": \"carol\"}"):
      Ok(_):
        fail("expected Err for missing 'age' field")
      Err(e):
        expect(e.message).toContain("'age'")
        expect(e.message).toContain("missing")

  @it("should return Err when a field has the wrong type")
  fn shouldReturnErrWhenFieldHasWrongType():
    case loadAs[Json1852Person]("{\"name\": 42, \"age\": 1}"):
      Ok(_):
        fail("expected Err for wrong-typed 'name' field")
      Err(e):
        expect(e.message).toContain("'name'")

  @it("should return Err when input is not a JSON object")
  fn shouldReturnErrWhenInputNotObject():
    case loadAs[Json1852Person]("[1, 2, 3]"):
      Ok(_):
        fail("expected Err for array input")
      Err(e):
        expect(e.message).toContain("JSON object")

  @it("should return Err when input is a primitive")
  fn shouldReturnErrWhenInputIsPrimitive():
    case loadAs[Json1852Person]("42"):
      Ok(_):
        fail("expected Err for primitive input")
      Err(e):
        expect(e.message).toContain("JSON object")

@describe("json loadAs<T> — nested record reconstruction (#1852)")
fn jsonLoadAsNestedRecordTests():
  @it("should reconstruct a record whose field is itself a record")
  fn shouldReconstructNestedRecord():
    text = "{\"person\": {\"name\": \"dan\", \"age\": 9}, \"city\": \"tokyo\"}"
    case loadAs[Json1852Address](text):
      Ok(a):
        expect(a.city).toEq("tokyo")
        expect(a.person.name).toEq("dan")
        expect(a.person.age).toEq(9)
      Err(e):
        fail("loadAs<Json1852Address> failed: " + e.message)

  @it("should return Err when the nested record is missing a field")
  fn shouldReturnErrWhenNestedFieldMissing():
    text = "{\"person\": {\"name\": \"eve\"}, \"city\": \"tokyo\"}"
    case loadAs[Json1852Address](text):
      Ok(_):
        fail("expected Err for nested missing 'age'")
      Err(e):
        expect(e.message).toContain("'age'")
        expect(e.message).toContain("missing")

  @it("should return Err when the nested record is the wrong shape")
  fn shouldReturnErrWhenNestedRecordWrongShape():
    text = "{\"person\": [1, 2], \"city\": \"tokyo\"}"
    case loadAs[Json1852Address](text):
      Ok(_):
        fail("expected Err for non-object nested 'person'")
      Err(e):
        expect(e.message).toContain("'person'")

  @it("should return Err when the outer field is missing")
  fn shouldReturnErrWhenOuterFieldMissing():
    text = "{\"person\": {\"name\": \"fay\", \"age\": 1}}"
    case loadAs[Json1852Address](text):
      Ok(_):
        fail("expected Err for missing 'city'")
      Err(e):
        expect(e.message).toContain("'city'")
        expect(e.message).toContain("missing")

@describe("json loadAs<T> — typed List<Record> (#1852)")
fn jsonLoadAsListRecordTests():
  @it("should reconstruct a List<Record> from a JSON array of objects")
  fn shouldReconstructListOfRecords():
    text = "[{\"name\":\"a\",\"age\":1},{\"name\":\"b\",\"age\":2}]"
    case loadAs[List<Json1852Person>](text):
      Ok(xs):
        expect(len(xs)).toEq(2)
        expect(xs[0].name).toEq("a")
        expect(xs[0].age).toEq(1)
        expect(xs[1].name).toEq("b")
        expect(xs[1].age).toEq(2)
      Err(e):
        fail("loadAs<List<Json1852Person>> failed: " + e.message)

  @it("should reconstruct an empty List<Record>")
  fn shouldReconstructEmptyListOfRecords():
    case loadAs[List<Json1852Person>]("[]"):
      Ok(xs):
        expect(len(xs)).toEq(0)
      Err(e):
        fail("loadAs<List<Json1852Person>> [] failed: " + e.message)

  @it("should return Err when an element is missing a field")
  fn shouldReturnErrWhenListElementMissingField():
    text = "[{\"name\":\"a\",\"age\":1},{\"name\":\"b\"}]"
    case loadAs[List<Json1852Person>](text):
      Ok(_):
        fail("expected Err for element missing 'age'")
      Err(e):
        expect(e.message).toContain("'age'")
        expect(e.message).toContain("missing")

  @it("should return Err when the JSON value is not an array")
  fn shouldReturnErrWhenInputNotArrayForListOfRecord():
    case loadAs[List<Json1852Person>]("{\"name\":\"a\",\"age\":1}"):
      Ok(_):
        fail("expected Err for non-array input")
      Err(e):
        expect(e.message).toContain("JSON array")

@describe("json loadAs<T> — typed Map<str, Record> (#1852)")
fn jsonLoadAsMapRecordTests():
  @it("should reconstruct a Map<str, Record> from a JSON object of objects")
  fn shouldReconstructMapOfRecords():
    text = "{\"x\":{\"name\":\"a\",\"age\":1},\"y\":{\"name\":\"b\",\"age\":2}}"
    case loadAs[Map<str, Json1852Person>](text):
      Ok(m):
        expect(len(m)).toEq(2)
        expect(m["x"].name).toEq("a")
        expect(m["x"].age).toEq(1)
        expect(m["y"].name).toEq("b")
        expect(m["y"].age).toEq(2)
      Err(e):
        fail("loadAs<Map<str, Json1852Person>> failed: " + e.message)

  @it("should reconstruct an empty Map<str, Record>")
  fn shouldReconstructEmptyMapOfRecords():
    case loadAs[Map<str, Json1852Person>]("{}"):
      Ok(m):
        expect(len(m)).toEq(0)
      Err(e):
        fail("loadAs<Map<str, Json1852Person>> {} failed: " + e.message)

  @it("should return Err when a value is missing a field")
  fn shouldReturnErrWhenMapValueMissingField():
    text = "{\"x\":{\"name\":\"a\",\"age\":1},\"y\":{\"name\":\"b\"}}"
    case loadAs[Map<str, Json1852Person>](text):
      Ok(_):
        fail("expected Err for value missing 'age'")
      Err(e):
        expect(e.message).toContain("'age'")
        expect(e.message).toContain("missing")

  @it("should return Err when the JSON value is not an object")
  fn shouldReturnErrWhenInputNotObjectForMapOfRecord():
    case loadAs[Map<str, Json1852Person>]("[1, 2, 3]"):
      Ok(_):
        fail("expected Err for non-object input")
      Err(e):
        expect(e.message).toContain("JSON object")

@describe("json loadAs<T> — Option<Record> (#1852)")
fn jsonLoadAsOptionRecordTests():
  @it("should reconstruct Some(Record) when JSON value is an object")
  fn shouldReconstructSomeRecord():
    case loadAs[Option<Json1852Person>]("{\"name\":\"a\",\"age\":1}"):
      Ok(opt):
        gotSome = false
        case opt:
          Some(p):
            gotSome = true
            expect(p.name).toEq("a")
            expect(p.age).toEq(1)
          None:
            fail("expected Some(...) but got None")
        expect(gotSome).toEq(true)
      Err(e):
        fail("loadAs<Option<Json1852Person>> failed: " + e.message)

  @it("should reconstruct None when JSON value is null")
  fn shouldReconstructNoneFromNull():
    case loadAs[Option<Json1852Person>]("null"):
      Ok(opt):
        gotNone = false
        case opt:
          Some(_):
            fail("expected None but got Some(...)")
          None:
            gotNone = true
        expect(gotNone).toEq(true)
      Err(e):
        fail("loadAs<Option<Json1852Person>> null failed: " + e.message)

  @it("should return Err when JSON value is neither object nor null")
  fn shouldReturnErrWhenInputNeitherObjectNorNullForOption():
    case loadAs[Option<Json1852Person>]("42"):
      Ok(_):
        fail("expected Err for primitive input")
      Err(e):
        expect(e.message).toContain("null")
        expect(e.message).toContain("JSON object")

  @it("should return Err when the inner object is missing a field")
  fn shouldReturnErrWhenInnerOptionRecordMissingField():
    case loadAs[Option<Json1852Person>]("{\"name\":\"a\"}"):
      Ok(_):
        fail("expected Err for inner missing 'age'")
      Err(e):
        expect(e.message).toContain("'age'")
        expect(e.message).toContain("missing")

# #1853 — stringifySafe / stringifySorted / stringifySortedSafe.
#
# Safe variants return Result<str, Error> instead of trapping on inputs
# that have no JSON representation (non-finite float, typed collection
# wrapped in `any`, Set / Record / Enum). Sorted variants emit Map keys
# in byte-lexicographic order so the output is reproducible regardless
# of insertion order.

@describe("json stringifySafe — happy path matches stringify")
fn jsonStringifySafeHappyPathTests():
  @it("should Ok with same output as stringify for primitives")
  fn shouldStringifySafeMatchPrimitive():
    v: any = 42
    case stringifySafe(v):
      Ok(s): expect(s).toEq("42")
      Err(e): fail("stringifySafe int failed: " + e.message)

  @it("should Ok with same output as stringify for str")
  fn shouldStringifySafeMatchStr():
    v: any = "hello"
    case stringifySafe(v):
      Ok(s): expect(s).toEq("\"hello\"")
      Err(e): fail("stringifySafe str failed: " + e.message)

  @it("should Ok with same output as stringify for finite float")
  fn shouldStringifySafeMatchFiniteFloat():
    v: any = 1.5
    case stringifySafe(v):
      Ok(s): expect(s).toEq("1.5")
      Err(e): fail("stringifySafe float failed: " + e.message)

  @it("should Ok for List<any> matching stringify")
  fn shouldStringifySafeMatchListAny():
    case load("[1,2,3]"):
      Ok(v):
        case stringifySafe(v):
          Ok(s): expect(s).toEq(stringify(v))
          Err(e): fail("stringifySafe list failed: " + e.message)
      Err(e):
        fail("load failed: " + e.message)

  @it("should Ok for Map<str, any> matching stringify")
  fn shouldStringifySafeMatchMapAny():
    case load("{\"a\":1,\"b\":2}"):
      Ok(v):
        case stringifySafe(v):
          Ok(s): expect(s).toEq(stringify(v))
          Err(e): fail("stringifySafe map failed: " + e.message)
      Err(e):
        fail("load failed: " + e.message)

  @it("should accept indent argument like stringify")
  fn shouldStringifySafeAcceptIndent():
    case load("[1,2]"):
      Ok(v):
        case stringifySafe(v, 2):
          Ok(s): expect(s).toEq("[\n  1,\n  2\n]")
          Err(e): fail("stringifySafe indent failed: " + e.message)
      Err(e):
        fail("load failed: " + e.message)

@describe("json stringifySafe — rejects non-finite floats")
fn jsonStringifySafeNonFiniteTests():
  @it("should Err on NaN")
  fn shouldErrOnNaN():
    v: any = NAN
    case stringifySafe(v):
      Ok(_): fail("expected Err for NaN")
      Err(e):
        expect(e.message).toContain("non-finite")

  @it("should Err on positive Infinity")
  fn shouldErrOnPositiveInfinity():
    v: any = INF
    case stringifySafe(v):
      Ok(_): fail("expected Err for +Inf")
      Err(e):
        expect(e.message).toContain("non-finite")

  @it("should Err on negative Infinity")
  fn shouldErrOnNegativeInfinity():
    v: any = -INF
    case stringifySafe(v):
      Ok(_): fail("expected Err for -Inf")
      Err(e):
        expect(e.message).toContain("non-finite")

  @it("should Err on NaN buried inside a List<any>")
  fn shouldErrOnNaNInList():
    inner: any = NAN
    xs: List<any> = [inner]
    v: any = xs
    case stringifySafe(v):
      Ok(_): fail("expected Err for NaN inside list")
      Err(e):
        expect(e.message).toContain("non-finite")

@describe("json stringifySafe — rejects typed collections and unsupported types")
fn jsonStringifySafeUnsupportedTests():
  @it("should Err on typed List<int> wrapped as any")
  fn shouldErrOnTypedListInt():
    xs: List<int> = [1, 2, 3]
    v: any = xs
    case stringifySafe(v):
      Ok(_): fail("expected Err for typed List<int>")
      Err(e):
        expect(e.message).toContain("typed collection")

  @it("should Err on typed Map<str, int> wrapped as any")
  fn shouldErrOnTypedMapStrInt():
    m: Map<str, int> = {"a": 1}
    v: any = m
    case stringifySafe(v):
      Ok(_): fail("expected Err for typed Map<str, int>")
      Err(e):
        expect(e.message).toContain("typed collection")

  @it("should Err on Set wrapped as any")
  fn shouldErrOnSet():
    s: Set<int> = {1, 2}
    v: any = s
    case stringifySafe(v):
      Ok(_): fail("expected Err for Set")
      Err(e):
        expect(e.message).toContain("Set")

  @it("should Err on Record wrapped as any")
  fn shouldErrOnRecord():
    p: Json1852Person = Json1852Person("x", 1)
    v: any = p
    case stringifySafe(v):
      Ok(_): fail("expected Err for Record")
      Err(e):
        expect(e.message).toContain("record")

@describe("json stringifySorted — sorts Map keys")
fn jsonStringifySortedTests():
  @it("should sort top-level Map keys by byte order")
  fn shouldSortTopLevelKeys():
    case load("{\"c\":1,\"a\":2,\"b\":3}"):
      Ok(v):
        expect(stringifySorted(v)).toEq("{\"a\":2,\"b\":3,\"c\":1}")
      Err(e):
        fail("load failed: " + e.message)

  @it("should sort nested Map keys recursively")
  fn shouldSortNestedKeys():
    case load("{\"z\":{\"y\":1,\"x\":2},\"a\":1}"):
      Ok(v):
        expect(stringifySorted(v)).toEq("{\"a\":1,\"z\":{\"x\":2,\"y\":1}}")
      Err(e):
        fail("load failed: " + e.message)

  @it("should sort keys inside list elements")
  fn shouldSortInsideListElements():
    case load("[{\"b\":1,\"a\":2},{\"d\":3,\"c\":4}]"):
      Ok(v):
        expect(stringifySorted(v)).toEq("[{\"a\":2,\"b\":1},{\"c\":4,\"d\":3}]")
      Err(e):
        fail("load failed: " + e.message)

  @it("should preserve sorted order under pretty-print indent")
  fn shouldSortUnderIndent():
    case load("{\"b\":1,\"a\":2}"):
      Ok(v):
        expect(stringifySorted(v, 2)).toEq("{\n  \"a\": 2,\n  \"b\": 1\n}")
      Err(e):
        fail("load failed: " + e.message)

  @it("should leave empty map as {}")
  fn shouldEmptyMap():
    case load("{}"):
      Ok(v):
        expect(stringifySorted(v)).toEq("{}")
      Err(e):
        fail("load failed: " + e.message)

  @it("should preserve list element order")
  fn shouldPreserveListOrder():
    case load("[3,1,2]"):
      Ok(v):
        expect(stringifySorted(v)).toEq("[3,1,2]")
      Err(e):
        fail("load failed: " + e.message)

  @it("should match stringify for primitives (no Map to sort)")
  fn shouldMatchStringifyForPrimitives():
    v: any = 42
    expect(stringifySorted(v)).toEq("42")

  @it("should sort keys that share a NUL-containing prefix")
  fn shouldSortKeysWithNul():
    # NUL byte sorts before regular ASCII; "k\0a" < "k\0b".
    case load("{\"k\\u0000b\":1,\"k\\u0000a\":2}"):
      Ok(v):
        expect(stringifySorted(v)).toEq("{\"k\\u0000a\":2,\"k\\u0000b\":1}")
      Err(e):
        fail("load failed: " + e.message)

@describe("json stringifySortedSafe — combines Safe and Sorted")
fn jsonStringifySortedSafeTests():
  @it("should Ok with sorted output for normal input")
  fn shouldSortedSafeOk():
    case load("{\"c\":1,\"a\":2}"):
      Ok(v):
        case stringifySortedSafe(v):
          Ok(s): expect(s).toEq("{\"a\":2,\"c\":1}")
          Err(e): fail("stringifySortedSafe failed: " + e.message)
      Err(e):
        fail("load failed: " + e.message)

  @it("should Err on NaN buried in an out-of-order Map")
  fn shouldSortedSafeErrOnNaN():
    bad: any = NAN
    good: any = 1
    m: Map<str, any> = {"c": bad, "a": good}
    v: any = m
    case stringifySortedSafe(v):
      Ok(_): fail("expected Err for NaN inside sorted map")
      Err(e):
        expect(e.message).toContain("non-finite")

  @it("should Ok with indent and sorted keys")
  fn shouldSortedSafeIndent():
    case load("{\"b\":1,\"a\":2}"):
      Ok(v):
        case stringifySortedSafe(v, 2):
          Ok(s): expect(s).toEq("{\n  \"a\": 2,\n  \"b\": 1\n}")
          Err(e): fail("stringifySortedSafe indent failed: " + e.message)
      Err(e):
        fail("load failed: " + e.message)

@describe("json load — error position coverage (#1882)")
fn jsonLoadErrorPositionCoverageTests():
  @it("should report position for unexpected end of input")
  fn shouldReportPositionForUnexpectedEndOfInput():
    case load(""):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "unexpected end of input at")).toEq(true)
        expect(contains(e.message, "line 1")).toEq(true)
        expect(contains(e.message, "offset 0")).toEq(true)

  @it("should report position for unterminated string escape")
  fn shouldReportPositionForUnterminatedStringEscape():
    case load("\"\\"):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "unterminated string escape at")).toEq(true)
        expect(contains(e.message, "offset 1")).toEq(true)

  @it("should report position for incomplete unicode escape")
  fn shouldReportPositionForIncompleteUnicodeEscape():
    case load("\"\\u00\""):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "incomplete unicode escape at")).toEq(true)
        expect(contains(e.message, "offset 3")).toEq(true)

  @it("should report position for invalid hex digit in unicode escape")
  fn shouldReportPositionForInvalidHexDigitInUnicodeEscape():
    case load("\"\\uZZZZ\""):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "invalid hex digit in unicode escape at")).toEq(true)
        expect(contains(e.message, "offset 3")).toEq(true)

  @it("should report position for unpaired high surrogate")
  fn shouldReportPositionForUnpairedHighSurrogate():
    case load("\"\\uD800\""):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "unpaired high surrogate in unicode escape at")).toEq(true)
        expect(contains(e.message, "offset 7")).toEq(true)

  @it("should report position for invalid low surrogate")
  fn shouldReportPositionForInvalidLowSurrogate():
    case load("\"\\uD800\\u0041\""):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "invalid low surrogate in unicode escape at")).toEq(true)
        expect(contains(e.message, "offset 13")).toEq(true)

  @it("should report position for unpaired low surrogate")
  fn shouldReportPositionForUnpairedLowSurrogate():
    case load("\"\\uDC00\""):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "unpaired low surrogate in unicode escape at")).toEq(true)
        expect(contains(e.message, "offset 7")).toEq(true)

  @it("should report position for invalid escape character")
  fn shouldReportPositionForInvalidEscapeCharacter():
    case load("\"\\q\""):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "invalid escape character")).toEq(true)
        expect(contains(e.message, "offset 1")).toEq(true)

  @it("should report position for unterminated string")
  fn shouldReportPositionForUnterminatedString():
    case load("\"hello"):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "unterminated string at")).toEq(true)
        expect(contains(e.message, "offset 0")).toEq(true)

  @it("should report position for invalid number missing digit after decimal point")
  fn shouldReportPositionForInvalidNumberDecimal():
    case load("1."):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "expected digit after decimal point at")).toEq(true)
        expect(contains(e.message, "offset 0")).toEq(true)

  @it("should report position for invalid number missing digit in exponent")
  fn shouldReportPositionForInvalidNumberExponent():
    case load("1e"):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "expected digit in exponent at")).toEq(true)
        expect(contains(e.message, "offset 0")).toEq(true)

  @it("should report position for maximum nesting depth exceeded")
  fn shouldReportPositionForMaxNestingDepth():
    deep: str = repeat("[", 257)
    case load(deep):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "maximum nesting depth exceeded at")).toEq(true)
        expect(contains(e.message, "offset 256")).toEq(true)

  @it("should report position for unterminated array")
  fn shouldReportPositionForUnterminatedArray():
    case load("[1, 2"):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "unterminated array at")).toEq(true)
        expect(contains(e.message, "offset 0")).toEq(true)

  @it("should report position for unterminated object")
  fn shouldReportPositionForUnterminatedObject():
    case load("{\"k\": 1"):
      Ok(_): fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "unterminated object at")).toEq(true)
        expect(contains(e.message, "offset 0")).toEq(true)

