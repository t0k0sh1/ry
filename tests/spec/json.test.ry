from json import parse, stringify, kind, get, at, to_str, to_int, to_float, to_bool, length, keys, json_free
from str import contains

describe("json parse", function():
  it("parses an object", function():
    when parse("{\"name\": \"Alice\", \"age\": 30}"):
      case Ok(data):
        expect(kind(data)).to_eq("object")
        json_free(data)
      case Err(e):
        fail("parse failed: " + e.message)
  )

  it("parses an array", function():
    when parse("[1, 2, 3]"):
      case Ok(data):
        expect(kind(data)).to_eq("array")
        expect(length(data)).to_eq(3)
        json_free(data)
      case Err(e):
        fail("parse failed: " + e.message)
  )

  it("returns Err for invalid JSON", function():
    expect(parse("{invalid}")).to_be_err()
  )

  it("returns Err for trailing content", function():
    expect(parse("123 456")).to_be_err()
  )
)

describe("json access", function():
  it("gets string field", function():
    when parse("{\"name\": \"Alice\"}"):
      case Ok(data):
        when get(data, "name"):
          case Ok(val):
            when to_str(val):
              case Ok(name):
                expect(name).to_eq("Alice")
              case Err(e):
                fail("json_str failed")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("gets int field", function():
    when parse("{\"age\": 30}"):
      case Ok(data):
        when get(data, "age"):
          case Ok(val):
            when to_int(val):
              case Ok(age):
                expect(age).to_eq(30)
              case Err(e):
                fail("json_int failed")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("gets float field", function():
    when parse("{\"pi\": 3.14}"):
      case Ok(data):
        when get(data, "pi"):
          case Ok(val):
            when to_float(val):
              case Ok(pi):
                expect(pi > 3.13).to_be_true()
                expect(pi < 3.15).to_be_true()
              case Err(e):
                fail("json_float failed")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("gets bool field", function():
    when parse("{\"active\": true}"):
      case Ok(data):
        when get(data, "active"):
          case Ok(val):
            when to_bool(val):
              case Ok(b):
                expect(b).to_be_true()
              case Err(e):
                fail("json_bool failed")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("gets null type", function():
    when parse("{\"value\": null}"):
      case Ok(data):
        when get(data, "value"):
          case Ok(val):
            expect(kind(val)).to_eq("null")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("accesses array by index", function():
    when parse("[10, 20, 30]"):
      case Ok(data):
        when at(data, 0):
          case Ok(first):
            when to_int(first):
              case Ok(n):
                expect(n).to_eq(10)
              case Err(e):
                fail("json_int failed")
          case Err(e):
            fail("json_at failed")
        when at(data, 2):
          case Ok(last):
            when to_int(last):
              case Ok(n):
                expect(n).to_eq(30)
              case Err(e):
                fail("json_int failed")
          case Err(e):
            fail("json_at failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("returns Err for missing key", function():
    when parse("{\"a\": 1}"):
      case Ok(data):
        expect(get(data, "missing")).to_be_err()
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("returns Err for out-of-bounds index", function():
    when parse("[1, 2]"):
      case Ok(data):
        expect(at(data, 5)).to_be_err()
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("returns Err for type mismatch", function():
    when parse("{\"name\": \"Alice\"}"):
      case Ok(data):
        when get(data, "name"):
          case Ok(val):
            expect(to_int(val)).to_be_err()
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)

describe("json nested", function():
  it("accesses nested objects", function():
    when parse("{\"user\": {\"name\": \"Bob\", \"age\": 25}}"):
      case Ok(data):
        when get(data, "user"):
          case Ok(user):
            when get(user, "name"):
              case Ok(name_val):
                when to_str(name_val):
                  case Ok(name):
                    expect(name).to_eq("Bob")
                  case Err(e):
                    fail("json_str failed")
              case Err(e):
                fail("json_get name failed")
            when get(user, "age"):
              case Ok(age_val):
                when to_int(age_val):
                  case Ok(age):
                    expect(age).to_eq(25)
                  case Err(e):
                    fail("json_int failed")
              case Err(e):
                fail("json_get age failed")
          case Err(e):
            fail("json_get user failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("accesses array of objects", function():
    when parse("[{\"id\": 1}, {\"id\": 2}]"):
      case Ok(data):
        when at(data, 1):
          case Ok(second):
            when get(second, "id"):
              case Ok(id_val):
                when to_int(id_val):
                  case Ok(id):
                    expect(id).to_eq(2)
                  case Err(e):
                    fail("json_int failed")
              case Err(e):
                fail("json_get failed")
          case Err(e):
            fail("json_at failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)

describe("json keys and len", function():
  it("gets object keys", function():
    when parse("{\"a\": 1, \"b\": 2}"):
      case Ok(data):
        ks = keys(data)
        expect(length(ks)).to_eq(2)
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("gets object len", function():
    when parse("{\"x\": 1, \"y\": 2, \"z\": 3}"):
      case Ok(data):
        expect(length(data)).to_eq(3)
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)

describe("json stringify", function():
  it("round-trips an object", function():
    when parse("{\"name\":\"Alice\",\"age\":30}"):
      case Ok(data):
        text = stringify(data)
        when parse(text):
          case Ok(data2):
            when get(data2, "name"):
              case Ok(name_val):
                when to_str(name_val):
                  case Ok(name):
                    expect(name).to_eq("Alice")
                  case Err(e):
                    fail("json_str failed")
              case Err(e):
                fail("json_get failed")
            json_free(data2)
          case Err(e):
            fail("re-parse failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("pretty prints with indent", function():
    when parse("{\"a\":1}"):
      case Ok(data):
        text = stringify(data, 2)
        expect(contains(text, "\n")).to_be_true()
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)

describe("json type checks", function():
  it("identifies string type", function():
    when parse("\"hello\""):
      case Ok(data):
        expect(kind(data)).to_eq("string")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("identifies number type", function():
    when parse("42"):
      case Ok(data):
        expect(kind(data)).to_eq("number")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("identifies boolean type", function():
    when parse("true"):
      case Ok(data):
        expect(kind(data)).to_eq("boolean")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("identifies null type", function():
    when parse("null"):
      case Ok(data):
        expect(kind(data)).to_eq("null")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)
