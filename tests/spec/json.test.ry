from testing import it, describe, expect, fail

from json import load, loadAs, stringify, dump
from str import contains, repeat, byteLen
from io import open, close, writeText, readText

@describe("json load — primitives")
fn jsonLoadPrimitivesTests():
  @it("should load null as any")
  fn shouldLoadNullAsAny():
    case load("null"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("null")
      Err(e):
        fail("load null failed: " + e.message)

  @it("should load true as any")
  fn shouldLoadTrueAsAny():
    case load("true"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("true")
      Err(e):
        fail("load true failed: " + e.message)

  @it("should load false as any")
  fn shouldLoadFalseAsAny():
    case load("false"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("false")
      Err(e):
        fail("load false failed: " + e.message)

  @it("should load int as any")
  fn shouldLoadIntAsAny():
    case load("42"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("42")
      Err(e):
        fail("load int failed: " + e.message)

  @it("should load negative int as any")
  fn shouldLoadNegativeIntAsAny():
    case load("-7"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("-7")
      Err(e):
        fail("load negative int failed: " + e.message)

  @it("should load float as any")
  fn shouldLoadFloatAsAny():
    case load("3.5"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("3.5")
      Err(e):
        fail("load float failed: " + e.message)

  @it("should load str as any")
  fn shouldLoadStrAsAny():
    case load("\"hi\""):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("\"hi\"")
      Err(e):
        fail("load str failed: " + e.message)

  @it("should reject malformed input")
  fn shouldRejectMalformedInput():
    case load("{not json}"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "expected string key")).toEq(true)

  @it("should reject trailing content")
  fn shouldRejectTrailingContent():
    case load("42 extra"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "trailing")).toEq(true)

  @it("should reject raw NUL inside a string")
  fn shouldRejectRawNulInsideString():
    case load("\"a\0b\""):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(byteLen(e.message) > 0).toEq(true)

  @it("should reject raw newline inside a string")
  fn shouldRejectRawNewlineInsideString():
    case load("\"a\nb\""):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(byteLen(e.message) > 0).toEq(true)

@describe("json load — array")
fn jsonLoadArrayTests():
  @it("should load empty array")
  fn shouldLoadEmptyArray():
    case load("[]"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("[]")
      Err(e):
        fail("load empty array failed: " + e.message)

  @it("should load array of ints")
  fn shouldLoadArrayOfInts():
    case load("[1, 2, 3]"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("[1,2,3]")
      Err(e):
        fail("load array failed: " + e.message)

  @it("should load mixed-type array round-trip")
  fn shouldLoadMixedArrayRoundTrip():
    case load("[1, \"two\", true, null]"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("[1,\"two\",true,null]")
      Err(e):
        fail("load mixed array failed: " + e.message)

  @it("should load nested array")
  fn shouldLoadNestedArray():
    case load("[[1, 2], [3]]"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("[[1,2],[3]]")
      Err(e):
        fail("load nested array failed: " + e.message)

@describe("json load — object")
fn jsonLoadObjectTests():
  @it("should load empty object")
  fn shouldLoadEmptyObject():
    case load("{}"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("{}")
      Err(e):
        fail("load empty object failed: " + e.message)

  @it("should load object round-trip preserving insertion order")
  fn shouldLoadObjectRoundTrip():
    case load("{\"a\": 1, \"b\": 2}"):
      Ok(v):
        s: str = stringify(v)
        # Map iteration order = insertion order, so a-then-b
        expect(s).toEq("{\"a\":1,\"b\":2}")
      Err(e):
        fail("load object failed: " + e.message)

  @it("should load nested object round-trip")
  fn shouldLoadNestedObjectRoundTrip():
    case load("{\"outer\": {\"inner\": 7}}"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("{\"outer\":{\"inner\":7}}")
      Err(e):
        fail("load nested object failed: " + e.message)

@describe("json load — nested mixed")
fn jsonLoadNestedMixedTests():
  @it("should load object containing array round-trip")
  fn shouldLoadObjectContainingArrayRoundTrip():
    case load("{\"xs\": [1, 2, 3]}"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("{\"xs\":[1,2,3]}")
      Err(e):
        fail("load object-array failed: " + e.message)

  @it("should load array containing object round-trip")
  fn shouldLoadArrayContainingObjectRoundTrip():
    case load("[{\"k\": 1}, {\"k\": 2}]"):
      Ok(v):
        s: str = stringify(v)
        expect(s).toEq("[{\"k\":1},{\"k\":2}]")
      Err(e):
        fail("load array-object failed: " + e.message)

@describe("json stringify — primitives")
fn jsonStringifyAnyPrimitivesTests():
  @it("should round-trip int via load and stringify")
  fn shouldRoundTripIntPrimitive():
    case load("123"):
      Ok(v):
        expect(stringify(v)).toEq("123")
      Err(e):
        fail("load 123 failed: " + e.message)

  @it("should round-trip float via load and stringify")
  fn shouldRoundTripFloatPrimitive():
    case load("1.5"):
      Ok(v):
        expect(stringify(v)).toEq("1.5")
      Err(e):
        fail("load 1.5 failed: " + e.message)

  @it("should round-trip bool via load and stringify")
  fn shouldRoundTripBoolPrimitive():
    case load("true"):
      Ok(v):
        expect(stringify(v)).toEq("true")
      Err(e):
        fail("load true failed: " + e.message)

@describe("json stringify — pretty (indent)")
fn jsonStringifyAnyPrettyTests():
  @it("should pretty-print array with indent=2")
  fn shouldPrettyPrintArray():
    case load("[1, 2]"):
      Ok(v):
        # 2-space indent
        expected = "[\n  1,\n  2\n]"
        expect(stringify(v, 2)).toEq(expected)
      Err(e):
        fail("load [1,2] failed: " + e.message)

  @it("should pretty-print object with indent=2")
  fn shouldPrettyPrintObject():
    case load("{\"a\": 1}"):
      Ok(v):
        expected = "{\n  \"a\": 1\n}"
        expect(stringify(v, 2)).toEq(expected)
      Err(e):
        fail("load {a:1} failed: " + e.message)

  @it("should fall back to compact form when indent is negative")
  fn shouldCompactWhenIndentNegative():
    case load("[1, 2]"):
      Ok(v):
        expect(stringify(v, -1)).toEq("[1,2]")
        expect(stringify(v, -100)).toEq("[1,2]")
      Err(e):
        fail("load [1,2] failed: " + e.message)

@describe("json loadAs<T> — primitives")
fn jsonLoadAsPrimitiveTests():
  @it("should parse int directly via loadAs<int>")
  fn shouldLoadAsInt():
    case loadAs[int]("42"):
      Ok(n):
        expect(n).toEq(42)
      Err(e):
        fail("loadAs<int> failed: " + e.message)

  @it("should parse negative int via loadAs<int>")
  fn shouldLoadAsNegativeInt():
    case loadAs[int]("-7"):
      Ok(n):
        expect(n).toEq(-7)
      Err(e):
        fail("loadAs<int> -7 failed: " + e.message)

  @it("should parse float via loadAs<float>")
  fn shouldLoadAsFloat():
    case loadAs[float]("3.5"):
      Ok(f):
        expect(f).toEq(3.5)
      Err(e):
        fail("loadAs<float> failed: " + e.message)

  @it("should parse str via loadAs<str>")
  fn shouldLoadAsStr():
    case loadAs[str]("\"hello\""):
      Ok(s):
        expect(s).toEq("hello")
      Err(e):
        fail("loadAs<str> failed: " + e.message)

  @it("should parse bool true via loadAs<bool>")
  fn shouldLoadAsBoolTrue():
    case loadAs[bool]("true"):
      Ok(b):
        expect(b).toEq(true)
      Err(e):
        fail("loadAs<bool> true failed: " + e.message)

  @it("should parse bool false via loadAs<bool>")
  fn shouldLoadAsBoolFalse():
    case loadAs[bool]("false"):
      Ok(b):
        expect(b).toEq(false)
      Err(e):
        fail("loadAs<bool> false failed: " + e.message)

  @it("should propagate parse error via loadAs<int>")
  fn shouldPropagateParseError():
    case loadAs[int]("{not json}"):
      Ok(_):
        fail("expected parse error for invalid JSON")
      Err(e):
        # loadAs propagates the load() error via `?`, so the message
        # comes from the parser. Only assert that an error returned
        # with a non-empty message.
        expect(byteLen(e.message) > 0).toEq(true)

@describe("json loadAs<T> — collections")
fn jsonLoadAsCollectionTests():
  @it("should parse List<any> via loadAs")
  fn shouldLoadAsListOfAny():
    case loadAs[List<any>]("[1, 2, 3]"):
      Ok(xs):
        expect(len(xs)).toEq(3)
      Err(e):
        fail("loadAs<List<any>> failed: " + e.message)

  @it("should parse empty List<any> via loadAs")
  fn shouldLoadAsEmptyList():
    case loadAs[List<any>]("[]"):
      Ok(xs):
        expect(len(xs)).toEq(0)
      Err(e):
        fail("loadAs<List<any>> [] failed: " + e.message)

  @it("should parse Map<str, any> via loadAs")
  fn shouldLoadAsMapStrAny():
    case loadAs[Map<str, any>]("{\"a\": 1, \"b\": 2}"):
      Ok(m):
        expect(len(m)).toEq(2)
      Err(e):
        fail("loadAs<Map<str, any>> failed: " + e.message)

  @it("should parse empty Map<str, any> via loadAs")
  fn shouldLoadAsEmptyMap():
    case loadAs[Map<str, any>]("{}"):
      Ok(m):
        expect(len(m)).toEq(0)
      Err(e):
        fail("loadAs<Map<str, any>> {} failed: " + e.message)

@describe("json NUL round-trip")
fn jsonNulRoundTripTests():
  @it("should parse \\u0000 in a string value via loadAs<str>")
  fn shouldParseU0000InAStringValue():
    case loadAs[str]("\"a\\u0000b\""):
      Ok(s):
        expect(byteLen(s)).toEq(3)
        expect(s == "a\0b").toEq(true)
      Err(e):
        fail("loadAs<str> failed: " + e.message)

  @it("should stringify NUL back to \\u0000")
  fn shouldStringifyNulBackToU0000():
    case load("\"a\\u0000b\""):
      Ok(v):
        expect(stringify(v)).toEq("\"a\\u0000b\"")
      Err(e):
        fail("load failed: " + e.message)

  @it("should round-trip NUL in object value")
  fn shouldRoundTripNulInObjectValue():
    case load("{\"k\":\"a\\u0000b\"}"):
      Ok(v):
        expect(stringify(v)).toEq("{\"k\":\"a\\u0000b\"}")
      Err(e):
        fail("load failed: " + e.message)

  @it("should round-trip NUL in object key")
  fn shouldRoundTripNulInObjectKey():
    case load("{\"k\\u0000x\":1}"):
      Ok(v):
        expect(stringify(v)).toEq("{\"k\\u0000x\":1}")
      Err(e):
        fail("load failed: " + e.message)

  @it("should round-trip NUL in array element")
  fn shouldRoundTripNulInArrayElement():
    case load("[\"a\\u0000b\",\"c\"]"):
      Ok(v):
        expect(stringify(v)).toEq("[\"a\\u0000b\",\"c\"]")
      Err(e):
        fail("load failed: " + e.message)

  @it("should disambiguate keys that share prefix up to NUL")
  fn shouldDisambiguateKeysThatSharePrefixUpToNul():
    case loadAs[Map<str, any>]("{\"k\\u0000a\":1,\"k\\u0000b\":2}"):
      Ok(m):
        expect(len(m)).toEq(2)
      Err(e):
        fail("loadAs<Map<str, any>> failed: " + e.message)

@describe("json parse depth limit")
fn jsonParseDepthLimitTests():
  @it("should reject deeply nested arrays")
  fn shouldRejectDeeplyNestedArrays():
    # depth 257 = MAX_NESTING_DEPTH (256) + 1
    deep = repeat("[", 257) + repeat("]", 257)
    case load(deep):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "json: maximum nesting depth exceeded")).toEq(true)

  @it("should reject deeply nested objects")
  fn shouldRejectDeeplyNestedObjects():
    # depth 257 of {"a": ... } nesting
    deep = repeat("{\"a\":", 257) + "1" + repeat("}", 257)
    case load(deep):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "json: maximum nesting depth exceeded")).toEq(true)

  @it("should reject mixed array and object nesting that exceeds the limit")
  fn shouldRejectMixedArrayAndObjectNestingThatExceedsTheLimit():
    # alternating [{ pairs: each pair contributes depth 2; 129 pairs = depth 258 > 256
    pairs = 129
    open = repeat("[{\"a\":", pairs)
    close = repeat("}]", pairs)
    deep = open + "1" + close
    case load(deep):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "json: maximum nesting depth exceeded")).toEq(true)

  @it("should accept nesting at exactly the depth limit")
  fn shouldAcceptNestingAtExactlyTheDepthLimit():
    # depth 256 = MAX_NESTING_DEPTH (boundary - 1, inclusive)
    deep = repeat("[", 256) + repeat("]", 256)
    case load(deep):
      Ok(_):
        0
      Err(e):
        fail("expected Ok at depth 256 but got Err: " + e.message)

@describe("json load — error position (line:column)")
fn jsonLoadErrorPositionTests():
  @it("should report line/column/offset for malformed input")
  fn shouldReportLineColumnOffsetForMalformedInput():
    # {not json}: parse_object sees 'n' at byte offset 1 (column 2)
    case load("{not json}"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "line 1, column 2")).toEq(true)
        expect(contains(e.message, "offset 1")).toEq(true)

  @it("should report line 3 for multi-line malformed input")
  fn shouldReportLine3ForMultiLineMalformedInput():
    # 'invalid' starts at byte 13, on line 3, column 3
    case load("{\n  \"key\":\n  invalid\n}"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "line 3")).toEq(true)
        expect(contains(e.message, "column 3")).toEq(true)
        expect(contains(e.message, "offset 13")).toEq(true)

  @it("should count column in codepoints not bytes")
  fn shouldCountColumnInCodepointsNotBytes():
    # ["日本語", invalid]
    # codepoint columns: [ " 日 本 語 " , space i → 'i' at column 9
    # byte offset: 0 1 2-4 5-7 8-10 11 12 13 14 → 'i' at byte 14
    case load("[\"日本語\", invalid]"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "column 9")).toEq(true)
        expect(contains(e.message, "offset 14")).toEq(true)

  @it("should report line 1 column 1 offset 0 at start of input")
  fn shouldReportLine1Column1Offset0AtStartOfInput():
    case load("x"):
      Ok(_):
        fail("expected Err but got Ok")
      Err(e):
        expect(contains(e.message, "line 1, column 1")).toEq(true)
        expect(contains(e.message, "offset 0")).toEq(true)

@describe("json File overloads — #1854")
fn jsonFileOverloadsTests():
  @it("should load JSON object from a File handle")
  fn shouldLoadObjectFromFileHandle():
    case writeText("/tmp/ry_1854_load_object.json", "{\"name\":\"alice\",\"age\":30}"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_load_object.json", "r"):
      Ok(file):
        case load(file):
          Ok(v):
            s: str = stringify(v)
            expect(s).toEq("{\"name\":\"alice\",\"age\":30}")
            close(file)
          Err(e):
            close(file)
            fail("load(File) failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should load JSON array from a File handle")
  fn shouldLoadArrayFromFileHandle():
    case writeText("/tmp/ry_1854_load_array.json", "[1,2,3]"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_load_array.json", "r"):
      Ok(file):
        case load(file):
          Ok(v):
            s: str = stringify(v)
            expect(s).toEq("[1,2,3]")
            close(file)
          Err(e):
            close(file)
            fail("load(File) array failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should propagate parser line/column error from a File handle")
  fn shouldPropagateParserErrorFromFileHandle():
    case writeText("/tmp/ry_1854_load_bad.json", "{\n  invalid\n}"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_load_bad.json", "r"):
      Ok(file):
        case load(file):
          Ok(_):
            close(file)
            fail("expected Err but got Ok")
          Err(e):
            close(file)
            expect(contains(e.message, "line 2")).toEq(true)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should reject load on a closed File handle")
  fn shouldRejectLoadOnClosedHandle():
    case writeText("/tmp/ry_1854_closed.json", "{}"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_closed.json", "r"):
      Ok(file):
        close(file)
        case load(file):
          Ok(_):
            fail("expected Err but got Ok after close")
          Err(e):
            expect(contains(e.message, "not open")).toEq(true)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should dump value compactly to a File handle")
  fn shouldDumpCompactToFileHandle():
    case open("/tmp/ry_1854_dump_compact.json", "w"):
      Ok(file):
        v: Map<str, any> = {}
        v["k"] = "v"
        case dump(file, v):
          Ok(_):
            close(file)
          Err(e):
            close(file)
            fail("dump compact failed: " + e.message)
      Err(e):
        fail("open w failed: " + e.message)
    case readText("/tmp/ry_1854_dump_compact.json"):
      Ok(s):
        expect(s).toEq("{\"k\":\"v\"}")
      Err(e):
        fail("verify readText failed: " + e.message)

  @it("should dump value pretty-printed when indent > 0")
  fn shouldDumpPrettyWhenIndentGiven():
    case open("/tmp/ry_1854_dump_pretty.json", "w"):
      Ok(file):
        v: List<any> = []
        append!(v, 1)
        append!(v, 2)
        case dump(file, v, 2):
          Ok(_):
            close(file)
          Err(e):
            close(file)
            fail("dump pretty failed: " + e.message)
      Err(e):
        fail("open w failed: " + e.message)
    case readText("/tmp/ry_1854_dump_pretty.json"):
      Ok(s):
        # Pretty output contains newlines and indented elements.
        expect(contains(s, "\n")).toEq(true)
        expect(contains(s, "  1")).toEq(true)
      Err(e):
        fail("verify readText failed: " + e.message)

  @it("should round-trip via dump then load")
  fn shouldRoundTripDumpThenLoad():
    case open("/tmp/ry_1854_roundtrip.json", "w"):
      Ok(file):
        original: Map<str, any> = {}
        original["hello"] = "world"
        original["name"] = "alice"
        case dump(file, original):
          Ok(_):
            close(file)
          Err(e):
            close(file)
            fail("dump failed: " + e.message)
      Err(e):
        fail("open w failed: " + e.message)
    case open("/tmp/ry_1854_roundtrip.json", "r"):
      Ok(file):
        case load(file):
          Ok(v):
            s: str = stringify(v)
            expect(s).toEq("{\"hello\":\"world\",\"name\":\"alice\"}")
            close(file)
          Err(e):
            close(file)
            fail("load roundtrip failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

@describe("json loadAs<T> — File overloads (#1854 + #1874)")
fn jsonLoadAsFileOverloadsTests():
  @it("should parse int directly via loadAs<int>(File)")
  fn shouldLoadAsIntFromFile():
    case writeText("/tmp/ry_1854_loadas_int.json", "42"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_loadas_int.json", "r"):
      Ok(file):
        case loadAs[int](file):
          Ok(n):
            expect(n).toEq(42)
            close(file)
          Err(e):
            close(file)
            fail("loadAs<int>(File) failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should parse str via loadAs<str>(File)")
  fn shouldLoadAsStrFromFile():
    case writeText("/tmp/ry_1854_loadas_str.json", "\"hello\""):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_loadas_str.json", "r"):
      Ok(file):
        case loadAs[str](file):
          Ok(s):
            expect(s).toEq("hello")
            close(file)
          Err(e):
            close(file)
            fail("loadAs<str>(File) failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should parse Map<str, any> via loadAs<Map<str, any>>(File)")
  fn shouldLoadAsMapFromFile():
    case writeText("/tmp/ry_1854_loadas_map.json", "{\"name\":\"alice\",\"age\":30}"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_loadas_map.json", "r"):
      Ok(file):
        case loadAs[Map<str, any>](file):
          Ok(m):
            s: str = stringify(m)
            expect(s).toEq("{\"name\":\"alice\",\"age\":30}")
            close(file)
          Err(e):
            close(file)
            fail("loadAs<Map>(File) failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should propagate parse error from File via loadAs<int>(File)")
  fn shouldPropagateParseErrorViaLoadAsFile():
    case writeText("/tmp/ry_1854_loadas_bad.json", "{not json}"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_loadas_bad.json", "r"):
      Ok(file):
        case loadAs[int](file):
          Ok(_):
            close(file)
            fail("expected Err but got Ok")
          Err(e):
            close(file)
            expect(contains(e.message, "line 1")).toEq(true)
      Err(e):
        fail("open r failed: " + e.message)

  @it("should keep loadAs<T>(str) overload working alongside File overload")
  fn shouldRouteStrOverloadAlongsideFileOverload():
    case loadAs[int]("99"):
      Ok(n):
        expect(n).toEq(99)
      Err(e):
        fail("loadAs<int>(str) regression: " + e.message)

# Diagnostic non-generic wrapper to isolate whether the bug is in
# generic monomorphization or in @native overload-by-arg-type resolution
# within an ordinary fn body.
fn diagLoadIntFromFile(f: File) -> Result<int, Error>:
  v: int = load(f)?
  return Ok(v)

@describe("json diag — load(File) from non-generic fn body")
fn jsonDiagLoadFromFnBodyTests():
  @it("should resolve load(f: File) when called from a non-generic fn body")
  fn shouldResolveLoadFileFromFnBody():
    case writeText("/tmp/ry_1854_diag.json", "777"):
      Ok(_): 0
      Err(e): fail("setup writeText failed: " + e.message)
    case open("/tmp/ry_1854_diag.json", "r"):
      Ok(file):
        case diagLoadIntFromFile(file):
          Ok(n):
            expect(n).toEq(777)
            close(file)
          Err(e):
            close(file)
            fail("diagLoadIntFromFile failed: " + e.message)
      Err(e):
        fail("open r failed: " + e.message)

