from json import parse, stringify, kind, get, at, toStr, toInt, toFloat, toBool, len, keys, jsonFree
from str import contains

describe("json parse", ():
  it("should parse an object", ():
    case parse("{\"name\": \"Alice\", \"age\": 30}"):
      Ok(data):
        expect(kind(data)).toEq("object")
        jsonFree(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should parse an array", ():
    case parse("[1, 2, 3]"):
      Ok(data):
        expect(kind(data)).toEq("array")
        expect(len(data)).toEq(3)
        jsonFree(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should return Err for invalid JSON", ():
    expect(parse("{invalid}")).toBeErr()
  )

  it("should return Err for trailing content", ():
    expect(parse("123 456")).toBeErr()
  )

  it("should return Err for raw control character in string", ():
    expect(parse("\"a\0b\"")).toBeErr()
    expect(parse("\"a\nb\"")).toBeErr()
  )
  it("should preserve JsonValue metadata through helper-returned Result", ():
    fn parseObj() -> Result<JsonValue, Error>:
      return parse("{\"x\": 42}")

    case parseObj():
      Ok(data):
        expect(kind(data)).toEq("object")
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )
  it("should preserve JsonValue metadata through helper-returned Option", ():
    fn maybeObj() -> Option<JsonValue>:
      case parse("{\"x\": 7}"):
        Ok(data):
          return Some(data)
        Err(e):
          return None()

    case maybeObj():
      Some(data):
        expect(kind(data)).toEq("object")
        jsonFree(data)
      None:
        fail("unexpected None")
  )

  it("should accept lambda typed as fn() -> Result<JsonValue, Error>", ():
    parseObj: fn() -> Result<JsonValue, Error> = () => parse("{\"x\": 1}")

    case parseObj():
      Ok(data):
        expect(kind(data)).toEq("object")
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should preserve JsonValue metadata through Result.andThen", ():
    fn parseObj() -> Result<JsonValue, Error>:
      return parse("{\"x\": 42}")

    r = parseObj().andThen((v: JsonValue) -> Result<JsonValue, Error>:
      expect(kind(v)).toEq("object")
      return Ok(v)
    )

    case r:
      Ok(v):
        expect(kind(v)).toEq("object")
        jsonFree(v)
      Err(e):
        fail("andThen failed: " + e.message)
  )

  it("should preserve JsonValue metadata through Result.map", ():
    fn parseObj() -> Result<JsonValue, Error>:
      return parse("{\"x\": 42}")

    r = parseObj().map((v: JsonValue) -> JsonValue:
      expect(kind(v)).toEq("object")
      return v
    )

    case r:
      Ok(v):
        expect(kind(v)).toEq("object")
        jsonFree(v)
      Err(e):
        fail("map failed: " + e.message)
  )

  it("should preserve JsonValue metadata through closure capture", ():
    fn parseObj() -> Result<JsonValue, Error>:
      return parse("{\"x\": 42}")

    case parseObj():
      Ok(v):
        f = () => v
        x = f()
        expect(kind(x)).toEq("object")
        jsonFree(x)
      Err(e):
        fail("parse failed: " + e.message)
  )
)

describe("json access", ():
  it("should get string field", ():
    case parse("{\"name\": \"Alice\"}"):
      Ok(data):
        case get(data, "name"):
          Ok(val):
            case toStr(val):
              Ok(name):
                expect(name).toEq("Alice")
              Err(e):
                fail("toStr failed: " + e.message)
          Err(e):
            fail("get failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should get int field", ():
    case parse("{\"age\": 30}"):
      Ok(data):
        case get(data, "age"):
          Ok(val):
            case toInt(val):
              Ok(age):
                expect(age).toEq(30)
              Err(e):
                fail("toInt failed: " + e.message)
          Err(e):
            fail("get failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should get float field", ():
    case parse("{\"pi\": 3.14}"):
      Ok(data):
        case get(data, "pi"):
          Ok(val):
            case toFloat(val):
              Ok(pi):
                expect(pi > 3.13).toBeTrue()
                expect(pi < 3.15).toBeTrue()
              Err(e):
                fail("toFloat failed: " + e.message)
          Err(e):
            fail("get failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should get bool field", ():
    case parse("{\"active\": true}"):
      Ok(data):
        case get(data, "active"):
          Ok(val):
            case toBool(val):
              Ok(b):
                expect(b).toBeTrue()
              Err(e):
                fail("toBool failed: " + e.message)
          Err(e):
            fail("get failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should get null type", ():
    case parse("{\"value\": null}"):
      Ok(data):
        case get(data, "value"):
          Ok(val):
            expect(kind(val)).toEq("null")
          Err(e):
            fail("get failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should access array by index", ():
    case parse("[10, 20, 30]"):
      Ok(data):
        case at(data, 0):
          Ok(first):
            case toInt(first):
              Ok(n):
                expect(n).toEq(10)
              Err(e):
                fail("toInt failed: " + e.message)
          Err(e):
            fail("at failed: " + e.message)
        case at(data, 2):
          Ok(last):
            case toInt(last):
              Ok(n):
                expect(n).toEq(30)
              Err(e):
                fail("toInt failed: " + e.message)
          Err(e):
            fail("at failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should return Err for missing key", ():
    case parse("{\"a\": 1}"):
      Ok(data):
        expect(get(data, "missing")).toBeErr()
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should return Err for out-of-bounds index", ():
    case parse("[1, 2]"):
      Ok(data):
        expect(at(data, 5)).toBeErr()
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should return Err for type mismatch", ():
    case parse("{\"name\": \"Alice\"}"):
      Ok(data):
        case get(data, "name"):
          Ok(val):
            expect(toInt(val)).toBeErr()
          Err(e):
            fail("get failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json nested", ():
  it("should access nested objects", ():
    case parse("{\"user\": {\"name\": \"Bob\", \"age\": 25}}"):
      Ok(data):
        case get(data, "user"):
          Ok(user):
            case get(user, "name"):
              Ok(name_val):
                case toStr(name_val):
                  Ok(name):
                    expect(name).toEq("Bob")
                  Err(e):
                    fail("toStr failed: " + e.message)
              Err(e):
                fail("get(name) failed: " + e.message)
            case get(user, "age"):
              Ok(age_val):
                case toInt(age_val):
                  Ok(age):
                    expect(age).toEq(25)
                  Err(e):
                    fail("toInt failed: " + e.message)
              Err(e):
                fail("get(age) failed: " + e.message)
          Err(e):
            fail("get(user) failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should access array of objects", ():
    case parse("[{\"id\": 1}, {\"id\": 2}]"):
      Ok(data):
        case at(data, 1):
          Ok(second):
            case get(second, "id"):
              Ok(id_val):
                case toInt(id_val):
                  Ok(id):
                    expect(id).toEq(2)
                  Err(e):
                    fail("toInt failed: " + e.message)
              Err(e):
                fail("get failed: " + e.message)
          Err(e):
            fail("at failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json keys and len", ():
  it("should get object keys", ():
    case parse("{\"a\": 1, \"b\": 2}"):
      Ok(data):
        case keys(data):
          Ok(ks):
            expect(len(ks)).toEq(2)
            expect(ks[0]).toEq("a")
            expect(ks[1]).toEq("b")
          Err(e):
            fail("keys failed")
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should return Err for non-object keys", ():
    case parse("[1, 2, 3]"):
      Ok(data):
        case keys(data):
          Ok(ks):
            fail("expected Err for non-object")
          Err(e):
            expect(e.message).toEq("json_keys: value is not an object")
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should get object len", ():
    case parse("{\"x\": 1, \"y\": 2, \"z\": 3}"):
      Ok(data):
        expect(len(data)).toEq(3)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json stringify", ():
  it("should round-trip an object", ():
    case parse("{\"name\":\"Alice\",\"age\":30}"):
      Ok(data):
        text = stringify(data)
        case parse(text):
          Ok(data2):
            case get(data2, "name"):
              Ok(name_val):
                case toStr(name_val):
                  Ok(name):
                    expect(name).toEq("Alice")
                  Err(e):
                    fail("toStr failed: " + e.message)
              Err(e):
                fail("get failed: " + e.message)
            jsonFree(data2)
          Err(e):
            fail("re-parse failed")
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should pretty print with indent", ():
    case parse("{\"a\":1}"):
      Ok(data):
        text = stringify(data, 2)
        expect(contains(text, "\n")).toBeTrue()
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json child value ownership", ():
  it("should not cause double-free on scope exit for get() child", ():
    case parse("{\"name\": \"Alice\", \"age\": 30}"):
      Ok(data):
        case get(data, "name"):
          Ok(val):
            case toStr(val):
              Ok(name):
                expect(name).toEq("Alice")
              Err(e):
                fail("toStr failed")
          Err(e):
            fail("get failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should not cause double-free on scope exit for at() child", ():
    case parse("[\"hello\", \"world\"]"):
      Ok(data):
        case at(data, 0):
          Ok(val):
            case toStr(val):
              Ok(s):
                expect(s).toEq("hello")
              Err(e):
                fail("toStr failed")
          Err(e):
            fail("at failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should not cause double-free on scope exit for nested get() children", ():
    case parse("{\"user\": {\"name\": \"Bob\"}}"):
      Ok(data):
        case get(data, "user"):
          Ok(user):
            case get(user, "name"):
              Ok(name_val):
                case toStr(name_val):
                  Ok(name):
                    expect(name).toEq("Bob")
                  Err(e):
                    fail("toStr failed")
              Err(e):
                fail("get(name) failed: " + e.message)
          Err(e):
            fail("get(user) failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json type checks", ():
  it("should identify string type", ():
    case parse("\"hello\""):
      Ok(data):
        expect(kind(data)).toEq("string")
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should identify number type", ():
    case parse("42"):
      Ok(data):
        expect(kind(data)).toEq("number")
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should identify boolean type", ():
    case parse("true"):
      Ok(data):
        expect(kind(data)).toEq("boolean")
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )

  it("should identify null type", ():
    case parse("null"):
      Ok(data):
        expect(kind(data)).toEq("null")
        jsonFree(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json NUL round-trip", ():
  it("should parse \\u0000 in a string value", ():
    case parse("\"a\\u0000b\""):
      Ok(data):
        case toStr(data):
          Ok(s):
            expect(byteLen(s)).toEq(3)
            expect(s == "a\0b").toEq(true)
          Err(e):
            fail("toStr failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should stringify NUL back to \\u0000", ():
    case parse("\"a\\u0000b\""):
      Ok(data):
        expect(stringify(data)).toEq("\"a\\u0000b\"")
        jsonFree(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should round-trip NUL in object value", ():
    case parse("{\"k\":\"a\\u0000b\"}"):
      Ok(data):
        expect(stringify(data)).toEq("{\"k\":\"a\\u0000b\"}")
        jsonFree(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should round-trip NUL in object key", ():
    case parse("{\"k\\u0000x\":1}"):
      Ok(data):
        expect(stringify(data)).toEq("{\"k\\u0000x\":1}")
        case keys(data):
          Ok(ks):
            expect(byteLen(ks[0])).toEq(3)
            expect(ks[0] == "k\0x").toEq(true)
          Err(e):
            fail("keys failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should look up a NUL-containing key with get()", ():
    case parse("{\"k\\u0000x\":42}"):
      Ok(data):
        case keys(data):
          Ok(ks):
            case get(data, ks[0]):
              Ok(val):
                case toInt(val):
                  Ok(n):
                    expect(n).toEq(42)
                  Err(e):
                    fail("toInt failed")
              Err(e):
                fail("get failed: " + e.message)
          Err(e):
            fail("keys failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should round-trip NUL in array element", ():
    case parse("[\"a\\u0000b\",\"c\"]"):
      Ok(data):
        expect(stringify(data)).toEq("[\"a\\u0000b\",\"c\"]")
        jsonFree(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should disambiguate keys that share prefix up to NUL", ():
    case parse("{\"k\\u0000a\":1,\"k\\u0000b\":2}"):
      Ok(data):
        case keys(data):
          Ok(ks):
            expect(len(ks)).toEq(2)
            case get(data, ks[0]):
              Ok(v0):
                case toInt(v0):
                  Ok(n):
                    expect(n).toEq(1)
                  Err(e):
                    fail("toInt ks[0] failed")
              Err(e):
                fail("get ks[0] failed: " + e.message)
            case get(data, ks[1]):
              Ok(v1):
                case toInt(v1):
                  Ok(n):
                    expect(n).toEq(2)
                  Err(e):
                    fail("toInt ks[1] failed")
              Err(e):
                fail("get ks[1] failed: " + e.message)
          Err(e):
            fail("keys failed: " + e.message)
        jsonFree(data)
      Err(e):
        fail("parse failed: " + e.message)
  )
)
