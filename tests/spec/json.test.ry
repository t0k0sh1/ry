from json import parse, stringify, kind, get, at, to_str, to_int, to_float, to_bool, length, keys, json_free
from str import contains

describe("json parse", ():
  it("should parse an object", ():
    case parse("{\"name\": \"Alice\", \"age\": 30}"):
      Ok(data):
        expect(kind(data)).to_eq("object")
        json_free(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should parse an array", ():
    case parse("[1, 2, 3]"):
      Ok(data):
        expect(kind(data)).to_eq("array")
        expect(length(data)).to_eq(3)
        json_free(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should return Err for invalid JSON", ():
    expect(parse("{invalid}")).to_be_err()
  )

  it("should return Err for trailing content", ():
    expect(parse("123 456")).to_be_err()
  )

  it("should return Err for raw control character in string", ():
    expect(parse("\"a\0b\"")).to_be_err()
    expect(parse("\"a\nb\"")).to_be_err()
  )
)

describe("json access", ():
  it("should get string field", ():
    case parse("{\"name\": \"Alice\"}"):
      Ok(data):
        case get(data, "name"):
          Ok(val):
            case to_str(val):
              Ok(name):
                expect(name).to_eq("Alice")
              Err(e):
                fail("json_str failed")
          Err(e):
            fail("json_get failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should get int field", ():
    case parse("{\"age\": 30}"):
      Ok(data):
        case get(data, "age"):
          Ok(val):
            case to_int(val):
              Ok(age):
                expect(age).to_eq(30)
              Err(e):
                fail("json_int failed")
          Err(e):
            fail("json_get failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should get float field", ():
    case parse("{\"pi\": 3.14}"):
      Ok(data):
        case get(data, "pi"):
          Ok(val):
            case to_float(val):
              Ok(pi):
                expect(pi > 3.13).to_be_true()
                expect(pi < 3.15).to_be_true()
              Err(e):
                fail("json_float failed")
          Err(e):
            fail("json_get failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should get bool field", ():
    case parse("{\"active\": true}"):
      Ok(data):
        case get(data, "active"):
          Ok(val):
            case to_bool(val):
              Ok(b):
                expect(b).to_be_true()
              Err(e):
                fail("json_bool failed")
          Err(e):
            fail("json_get failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should get null type", ():
    case parse("{\"value\": null}"):
      Ok(data):
        case get(data, "value"):
          Ok(val):
            expect(kind(val)).to_eq("null")
          Err(e):
            fail("json_get failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should access array by index", ():
    case parse("[10, 20, 30]"):
      Ok(data):
        case at(data, 0):
          Ok(first):
            case to_int(first):
              Ok(n):
                expect(n).to_eq(10)
              Err(e):
                fail("json_int failed")
          Err(e):
            fail("json_at failed")
        case at(data, 2):
          Ok(last):
            case to_int(last):
              Ok(n):
                expect(n).to_eq(30)
              Err(e):
                fail("json_int failed")
          Err(e):
            fail("json_at failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should return Err for missing key", ():
    case parse("{\"a\": 1}"):
      Ok(data):
        expect(get(data, "missing")).to_be_err()
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should return Err for out-of-bounds index", ():
    case parse("[1, 2]"):
      Ok(data):
        expect(at(data, 5)).to_be_err()
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should return Err for type mismatch", ():
    case parse("{\"name\": \"Alice\"}"):
      Ok(data):
        case get(data, "name"):
          Ok(val):
            expect(to_int(val)).to_be_err()
          Err(e):
            fail("json_get failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json nested", ():
  it("should access nested objects", ():
    case parse("{\"user\": {\"name\": \"Bob\", \"age\": 25}}"):
      Ok(data):
        case get(data, "user"):
          Ok(user):
            case get(user, "name"):
              Ok(name_val):
                case to_str(name_val):
                  Ok(name):
                    expect(name).to_eq("Bob")
                  Err(e):
                    fail("json_str failed")
              Err(e):
                fail("json_get name failed")
            case get(user, "age"):
              Ok(age_val):
                case to_int(age_val):
                  Ok(age):
                    expect(age).to_eq(25)
                  Err(e):
                    fail("json_int failed")
              Err(e):
                fail("json_get age failed")
          Err(e):
            fail("json_get user failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should access array of objects", ():
    case parse("[{\"id\": 1}, {\"id\": 2}]"):
      Ok(data):
        case at(data, 1):
          Ok(second):
            case get(second, "id"):
              Ok(id_val):
                case to_int(id_val):
                  Ok(id):
                    expect(id).to_eq(2)
                  Err(e):
                    fail("json_int failed")
              Err(e):
                fail("json_get failed")
          Err(e):
            fail("json_at failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json keys and len", ():
  it("should get object keys", ():
    case parse("{\"a\": 1, \"b\": 2}"):
      Ok(data):
        case keys(data):
          Ok(ks):
            expect(length(ks)).to_eq(2)
            expect(ks[0]).to_eq("a")
            expect(ks[1]).to_eq("b")
          Err(e):
            fail("keys failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should return Err for non-object keys", ():
    case parse("[1, 2, 3]"):
      Ok(data):
        case keys(data):
          Ok(ks):
            fail("expected Err for non-object")
          Err(e):
            expect(e.message).to_eq("json_keys: value is not an object")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should get object len", ():
    case parse("{\"x\": 1, \"y\": 2, \"z\": 3}"):
      Ok(data):
        expect(length(data)).to_eq(3)
        json_free(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json stringify", ():
  it("should round-trip an object", ():
    case parse("{\"name\":\"Alice\",\"age\":30}"):
      Ok(data):
        text = stringify(data)
        case parse(text):
          Ok(data2):
            case get(data2, "name"):
              Ok(name_val):
                case to_str(name_val):
                  Ok(name):
                    expect(name).to_eq("Alice")
                  Err(e):
                    fail("json_str failed")
              Err(e):
                fail("json_get failed")
            json_free(data2)
          Err(e):
            fail("re-parse failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should pretty print with indent", ():
    case parse("{\"a\":1}"):
      Ok(data):
        text = stringify(data, 2)
        expect(contains(text, "\n")).to_be_true()
        json_free(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json child value ownership", ():
  it("should not cause double-free on scope exit for get() child", ():
    case parse("{\"name\": \"Alice\", \"age\": 30}"):
      Ok(data):
        case get(data, "name"):
          Ok(val):
            case to_str(val):
              Ok(name):
                expect(name).to_eq("Alice")
              Err(e):
                fail("to_str failed")
          Err(e):
            fail("json_get failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should not cause double-free on scope exit for at() child", ():
    case parse("[\"hello\", \"world\"]"):
      Ok(data):
        case at(data, 0):
          Ok(val):
            case to_str(val):
              Ok(s):
                expect(s).to_eq("hello")
              Err(e):
                fail("to_str failed")
          Err(e):
            fail("json_at failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should not cause double-free on scope exit for nested get() children", ():
    case parse("{\"user\": {\"name\": \"Bob\"}}"):
      Ok(data):
        case get(data, "user"):
          Ok(user):
            case get(user, "name"):
              Ok(name_val):
                case to_str(name_val):
                  Ok(name):
                    expect(name).to_eq("Bob")
                  Err(e):
                    fail("to_str failed")
              Err(e):
                fail("json_get name failed")
          Err(e):
            fail("json_get user failed")
        json_free(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json type checks", ():
  it("should identify string type", ():
    case parse("\"hello\""):
      Ok(data):
        expect(kind(data)).to_eq("string")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should identify number type", ():
    case parse("42"):
      Ok(data):
        expect(kind(data)).to_eq("number")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should identify boolean type", ():
    case parse("true"):
      Ok(data):
        expect(kind(data)).to_eq("boolean")
        json_free(data)
      Err(e):
        fail("parse failed")
  )

  it("should identify null type", ():
    case parse("null"):
      Ok(data):
        expect(kind(data)).to_eq("null")
        json_free(data)
      Err(e):
        fail("parse failed")
  )
)

describe("json NUL round-trip", ():
  it("should parse \\u0000 in a string value", ():
    case parse("\"a\\u0000b\""):
      Ok(data):
        case to_str(data):
          Ok(s):
            expect(byte_len(s)).to_eq(3)
            expect(s == "a\0b").to_eq(true)
          Err(e):
            fail("to_str failed: " + e.message)
        json_free(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should stringify NUL back to \\u0000", ():
    case parse("\"a\\u0000b\""):
      Ok(data):
        expect(stringify(data)).to_eq("\"a\\u0000b\"")
        json_free(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should round-trip NUL in object value", ():
    case parse("{\"k\":\"a\\u0000b\"}"):
      Ok(data):
        expect(stringify(data)).to_eq("{\"k\":\"a\\u0000b\"}")
        json_free(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should round-trip NUL in object key", ():
    case parse("{\"k\\u0000x\":1}"):
      Ok(data):
        expect(stringify(data)).to_eq("{\"k\\u0000x\":1}")
        case keys(data):
          Ok(ks):
            expect(byte_len(ks[0])).to_eq(3)
            expect(ks[0] == "k\0x").to_eq(true)
          Err(e):
            fail("keys failed: " + e.message)
        json_free(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should look up a NUL-containing key with get()", ():
    case parse("{\"k\\u0000x\":42}"):
      Ok(data):
        case keys(data):
          Ok(ks):
            case get(data, ks[0]):
              Ok(val):
                case to_int(val):
                  Ok(n):
                    expect(n).to_eq(42)
                  Err(e):
                    fail("to_int failed")
              Err(e):
                fail("get failed: " + e.message)
          Err(e):
            fail("keys failed: " + e.message)
        json_free(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should round-trip NUL in array element", ():
    case parse("[\"a\\u0000b\",\"c\"]"):
      Ok(data):
        expect(stringify(data)).to_eq("[\"a\\u0000b\",\"c\"]")
        json_free(data)
      Err(e):
        fail("parse failed: " + e.message)
  )

  it("should disambiguate keys that share prefix up to NUL", ():
    case parse("{\"k\\u0000a\":1,\"k\\u0000b\":2}"):
      Ok(data):
        case keys(data):
          Ok(ks):
            expect(length(ks)).to_eq(2)
            case get(data, ks[0]):
              Ok(v0):
                case to_int(v0):
                  Ok(n):
                    expect(n).to_eq(1)
                  Err(e):
                    fail("to_int ks[0] failed")
              Err(e):
                fail("get ks[0] failed: " + e.message)
            case get(data, ks[1]):
              Ok(v1):
                case to_int(v1):
                  Ok(n):
                    expect(n).to_eq(2)
                  Err(e):
                    fail("to_int ks[1] failed")
              Err(e):
                fail("get ks[1] failed: " + e.message)
          Err(e):
            fail("keys failed: " + e.message)
        json_free(data)
      Err(e):
        fail("parse failed: " + e.message)
  )
)
