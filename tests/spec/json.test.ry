from json import parse, stringify, kind, get, at, to_str, to_int, to_float, to_bool, length, keys, json_free
from str import contains

describe("json parse", ():
  it("should parse an object", ():
    match parse("{\"name\": \"Alice\", \"age\": 30}"):
      case Ok(data):
        expect(kind(data)).to_eq("object")
        json_free(data)
      case Err(e):
        fail("parse failed: " + e.message)
  )

  it("should parse an array", ():
    match parse("[1, 2, 3]"):
      case Ok(data):
        expect(kind(data)).to_eq("array")
        expect(length(data)).to_eq(3)
        json_free(data)
      case Err(e):
        fail("parse failed: " + e.message)
  )

  it("should return Err for invalid JSON", ():
    expect(parse("{invalid}")).to_be_err()
  )

  it("should return Err for trailing content", ():
    expect(parse("123 456")).to_be_err()
  )
)

describe("json access", ():
  it("should get string field", ():
    match parse("{\"name\": \"Alice\"}"):
      case Ok(data):
        match get(data, "name"):
          case Ok(val):
            match to_str(val):
              case Ok(name):
                expect(name).to_eq("Alice")
              case Err(e):
                fail("json_str failed")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should get int field", ():
    match parse("{\"age\": 30}"):
      case Ok(data):
        match get(data, "age"):
          case Ok(val):
            match to_int(val):
              case Ok(age):
                expect(age).to_eq(30)
              case Err(e):
                fail("json_int failed")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should get float field", ():
    match parse("{\"pi\": 3.14}"):
      case Ok(data):
        match get(data, "pi"):
          case Ok(val):
            match to_float(val):
              case Ok(pi):
                expect(pi > 3.13).to_be_true()
                expect(pi < 3.15).to_be_true()
              case Err(e):
                fail("json_float failed")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should get bool field", ():
    match parse("{\"active\": true}"):
      case Ok(data):
        match get(data, "active"):
          case Ok(val):
            match to_bool(val):
              case Ok(b):
                expect(b).to_be_true()
              case Err(e):
                fail("json_bool failed")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should get null type", ():
    match parse("{\"value\": null}"):
      case Ok(data):
        match get(data, "value"):
          case Ok(val):
            expect(kind(val)).to_eq("null")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should access array by index", ():
    match parse("[10, 20, 30]"):
      case Ok(data):
        match at(data, 0):
          case Ok(first):
            match to_int(first):
              case Ok(n):
                expect(n).to_eq(10)
              case Err(e):
                fail("json_int failed")
          case Err(e):
            fail("json_at failed")
        match at(data, 2):
          case Ok(last):
            match to_int(last):
              case Ok(n):
                expect(n).to_eq(30)
              case Err(e):
                fail("json_int failed")
          case Err(e):
            fail("json_at failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should return Err for missing key", ():
    match parse("{\"a\": 1}"):
      case Ok(data):
        expect(get(data, "missing")).to_be_err()
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should return Err for out-of-bounds index", ():
    match parse("[1, 2]"):
      case Ok(data):
        expect(at(data, 5)).to_be_err()
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should return Err for type mismatch", ():
    match parse("{\"name\": \"Alice\"}"):
      case Ok(data):
        match get(data, "name"):
          case Ok(val):
            expect(to_int(val)).to_be_err()
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)

describe("json nested", ():
  it("should access nested objects", ():
    match parse("{\"user\": {\"name\": \"Bob\", \"age\": 25}}"):
      case Ok(data):
        match get(data, "user"):
          case Ok(user):
            match get(user, "name"):
              case Ok(name_val):
                match to_str(name_val):
                  case Ok(name):
                    expect(name).to_eq("Bob")
                  case Err(e):
                    fail("json_str failed")
              case Err(e):
                fail("json_get name failed")
            match get(user, "age"):
              case Ok(age_val):
                match to_int(age_val):
                  case Ok(age):
                    expect(age).to_eq(25)
                  case Err(e):
                    fail("json_int failed")
              case Err(e):
                fail("json_get age failed")
          case Err(e):
            fail("json_get user failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should access array of objects", ():
    match parse("[{\"id\": 1}, {\"id\": 2}]"):
      case Ok(data):
        match at(data, 1):
          case Ok(second):
            match get(second, "id"):
              case Ok(id_val):
                match to_int(id_val):
                  case Ok(id):
                    expect(id).to_eq(2)
                  case Err(e):
                    fail("json_int failed")
              case Err(e):
                fail("json_get failed")
          case Err(e):
            fail("json_at failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)

describe("json keys and len", ():
  it("should get object keys", ():
    match parse("{\"a\": 1, \"b\": 2}"):
      case Ok(data):
        match keys(data):
          case Ok(ks):
            expect(length(ks)).to_eq(2)
            expect(ks[0]).to_eq("a")
            expect(ks[1]).to_eq("b")
          case Err(e):
            fail("keys failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should return Err for non-object keys", ():
    match parse("[1, 2, 3]"):
      case Ok(data):
        match keys(data):
          case Ok(ks):
            fail("expected Err for non-object")
          case Err(e):
            expect(e.message).to_eq("json_keys: value is not an object")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should get object len", ():
    match parse("{\"x\": 1, \"y\": 2, \"z\": 3}"):
      case Ok(data):
        expect(length(data)).to_eq(3)
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)

describe("json stringify", ():
  it("should round-trip an object", ():
    match parse("{\"name\":\"Alice\",\"age\":30}"):
      case Ok(data):
        text = stringify(data)
        match parse(text):
          case Ok(data2):
            match get(data2, "name"):
              case Ok(name_val):
                match to_str(name_val):
                  case Ok(name):
                    expect(name).to_eq("Alice")
                  case Err(e):
                    fail("json_str failed")
              case Err(e):
                fail("json_get failed")
            json_free(data2)
          case Err(e):
            fail("re-parse failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should pretty print with indent", ():
    match parse("{\"a\":1}"):
      case Ok(data):
        text = stringify(data, 2)
        expect(contains(text, "\n")).to_be_true()
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)

describe("json child value ownership", ():
  it("should not cause double-free on scope exit for get() child", ():
    match parse("{\"name\": \"Alice\", \"age\": 30}"):
      case Ok(data):
        match get(data, "name"):
          case Ok(val):
            match to_str(val):
              case Ok(name):
                expect(name).to_eq("Alice")
              case Err(e):
                fail("to_str failed")
          case Err(e):
            fail("json_get failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should not cause double-free on scope exit for at() child", ():
    match parse("[\"hello\", \"world\"]"):
      case Ok(data):
        match at(data, 0):
          case Ok(val):
            match to_str(val):
              case Ok(s):
                expect(s).to_eq("hello")
              case Err(e):
                fail("to_str failed")
          case Err(e):
            fail("json_at failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should not cause double-free on scope exit for nested get() children", ():
    match parse("{\"user\": {\"name\": \"Bob\"}}"):
      case Ok(data):
        match get(data, "user"):
          case Ok(user):
            match get(user, "name"):
              case Ok(name_val):
                match to_str(name_val):
                  case Ok(name):
                    expect(name).to_eq("Bob")
                  case Err(e):
                    fail("to_str failed")
              case Err(e):
                fail("json_get name failed")
          case Err(e):
            fail("json_get user failed")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)

describe("json type checks", ():
  it("should identify string type", ():
    match parse("\"hello\""):
      case Ok(data):
        expect(kind(data)).to_eq("string")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should identify number type", ():
    match parse("42"):
      case Ok(data):
        expect(kind(data)).to_eq("number")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should identify boolean type", ():
    match parse("true"):
      case Ok(data):
        expect(kind(data)).to_eq("boolean")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )

  it("should identify null type", ():
    match parse("null"):
      case Ok(data):
        expect(kind(data)).to_eq("null")
        json_free(data)
      case Err(e):
        fail("parse failed")
  )
)
