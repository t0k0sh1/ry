from filesystem import list_dir, walk, glob_files, copy, move, remove, remove_all, make_dir, make_dir_all, file_size, is_file, is_dir, is_symlink, chmod, symlink, read_link
from io import write_text, read_text, exists
from path import join

describe("make_dir / make_dir_all", ():
  it("should create a single directory", ():
    d = "/tmp/ry_fs_test/single_dir"
    if is_dir(d):
      remove_all(d)
    make_dir_all("/tmp/ry_fs_test")
    case make_dir(d):
      Ok(_):
        expect(is_dir(d)).to_be_true()
      Err(e):
        fail("make_dir failed: " + e.message)
  )

  it("should fail on existing directory", ():
    d = "/tmp/ry_fs_test/single_dir"
    result = make_dir(d)
    expect(result).to_be_err()
  )

  it("should create nested directories", ():
    d = "/tmp/ry_fs_test/a/b/c"
    case make_dir_all(d):
      Ok(_):
        expect(is_dir(d)).to_be_true()
      Err(e):
        fail("make_dir_all failed: " + e.message)
  )
)

describe("is_file / is_dir / is_symlink", ():
  it("should detect a regular file", ():
    f = "/tmp/ry_fs_test/test_file.txt"
    case write_text(f, "hello"):
      Ok(_):
        expect(is_file(f)).to_be_true()
        expect(is_dir(f)).to_be_false()
        expect(is_symlink(f)).to_be_false()
      Err(e):
        fail("write_text failed: " + e.message)
  )

  it("should detect a directory", ():
    expect(is_dir("/tmp/ry_fs_test")).to_be_true()
    expect(is_file("/tmp/ry_fs_test")).to_be_false()
  )

  it("should return false for non-existent path", ():
    expect(is_file("/tmp/ry_fs_test_nonexistent_xyz")).to_be_false()
    expect(is_dir("/tmp/ry_fs_test_nonexistent_xyz")).to_be_false()
    expect(is_symlink("/tmp/ry_fs_test_nonexistent_xyz")).to_be_false()
  )
)

describe("list_dir", ():
  it("should list directory entries", ():
    d = "/tmp/ry_fs_test/listdir_test"
    if is_dir(d):
      remove_all(d)
    make_dir(d)
    case join(d, "a.txt"):
      Ok(pa): write_text(pa, "a")
      Err(e): fail("join failed: " + e.message)
    case join(d, "b.txt"):
      Ok(pb): write_text(pb, "b")
      Err(e): fail("join failed: " + e.message)
    case join(d, "subdir"):
      Ok(ps): make_dir(ps)
      Err(e): fail("join failed: " + e.message)
    case list_dir(d):
      Ok(entries):
        expect(entries).to_have_length(3)
      Err(e):
        fail("list_dir failed: " + e.message)
  )

  it("should return error for non-existent dir", ():
    result = list_dir("/tmp/ry_fs_test_no_such_dir")
    expect(result).to_be_err()
  )
)

describe("walk", ():
  it("should recursively list files and directories", ():
    d = "/tmp/ry_fs_test/walk_test"
    if is_dir(d):
      remove_all(d)
    case join(d, "sub1", "sub2"):
      Ok(p): make_dir_all(p)
      Err(e): fail("join failed: " + e.message)
    case join(d, "root.txt"):
      Ok(p): write_text(p, "r")
      Err(e): fail("join failed: " + e.message)
    case join(d, "sub1", "mid.txt"):
      Ok(p): write_text(p, "m")
      Err(e): fail("join failed: " + e.message)
    case join(d, "sub1", "sub2", "deep.txt"):
      Ok(p): write_text(p, "d")
      Err(e): fail("join failed: " + e.message)
    case walk(d):
      Ok(entries):
        expect(length(entries) >= 5).to_be_true()
      Err(e):
        fail("walk failed: " + e.message)
  )

  it("should return error for non-existent dir in walk", ():
    result = walk("/tmp/ry_fs_test_no_such_dir")
    expect(result).to_be_err()
  )
)

describe("glob_files", ():
  it("should match files by pattern", ():
    d = "/tmp/ry_fs_test/glob_test"
    if is_dir(d):
      remove_all(d)
    make_dir(d)
    case join(d, "file1.log"):
      Ok(p): write_text(p, "1")
      Err(e): fail("join failed: " + e.message)
    case join(d, "file2.log"):
      Ok(p): write_text(p, "2")
      Err(e): fail("join failed: " + e.message)
    case join(d, "file3.txt"):
      Ok(p): write_text(p, "3")
      Err(e): fail("join failed: " + e.message)
    case join(d, "*.log"):
      Ok(pattern):
        case glob_files(pattern):
          Ok(matches):
            expect(matches).to_have_length(2)
          Err(e):
            fail("glob_files failed: " + e.message)
      Err(e): fail("join failed: " + e.message)
  )

  it("should return empty list when nothing matches", ():
    case glob_files("/tmp/ry_fs_test_nomatch_*.zzz"):
      Ok(matches):
        expect(matches).to_have_length(0)
      Err(e):
        fail("glob_files failed: " + e.message)
  )
)

describe("copy", ():
  it("should copy file content", ():
    src = "/tmp/ry_fs_test/copy_src.txt"
    dst = "/tmp/ry_fs_test/copy_dst.txt"
    write_text(src, "copy me")
    case copy(src, dst):
      Ok(_):
        case read_text(dst):
          Ok(content):
            expect(content).to_eq("copy me")
          Err(e):
            fail("read_text failed: " + e.message)
      Err(e):
        fail("copy failed: " + e.message)
  )

  it("should return error for non-existent source", ():
    result = copy("/tmp/ry_fs_test_nosrc.txt", "/tmp/ry_fs_test_nodst.txt")
    expect(result).to_be_err()
  )
)

describe("move", ():
  it("should move a file", ():
    src = "/tmp/ry_fs_test/move_src.txt"
    dst = "/tmp/ry_fs_test/move_dst.txt"
    write_text(src, "move me")
    case move(src, dst):
      Ok(_):
        expect(exists(src)).to_be_false()
        case read_text(dst):
          Ok(content):
            expect(content).to_eq("move me")
          Err(e):
            fail("read_text failed: " + e.message)
      Err(e):
        fail("move failed: " + e.message)
  )
)

describe("remove / remove_all", ():
  it("should remove a file", ():
    f = "/tmp/ry_fs_test/remove_me.txt"
    write_text(f, "bye")
    case remove(f):
      Ok(_):
        expect(exists(f)).to_be_false()
      Err(e):
        fail("remove failed: " + e.message)
  )

  it("should fail to remove non-empty directory", ():
    d = "/tmp/ry_fs_test/nonempty_dir"
    make_dir(d)
    case join(d, "child.txt"):
      Ok(p): write_text(p, "x")
      Err(e): fail("join failed: " + e.message)
    result = remove(d)
    expect(result).to_be_err()
    remove_all(d)
  )

  it("should remove directory tree with remove_all", ():
    d = "/tmp/ry_fs_test/tree_to_remove"
    case join(d, "a", "b"):
      Ok(p): make_dir_all(p)
      Err(e): fail("join failed: " + e.message)
    case join(d, "a", "b", "file.txt"):
      Ok(p): write_text(p, "x")
      Err(e): fail("join failed: " + e.message)
    case remove_all(d):
      Ok(_):
        expect(is_dir(d)).to_be_false()
      Err(e):
        fail("remove_all failed: " + e.message)
  )
)

describe("file_size", ():
  it("should return correct file size", ():
    f = "/tmp/ry_fs_test/size_test.txt"
    write_text(f, "12345")
    case file_size(f):
      Ok(sz):
        expect(sz).to_eq(5)
      Err(e):
        fail("file_size failed: " + e.message)
  )

  it("should return error for non-existent file", ():
    result = file_size("/tmp/ry_fs_test_no_file.txt")
    expect(result).to_be_err()
  )
)

describe("chmod", ():
  it("should change file permissions", ():
    f = "/tmp/ry_fs_test/chmod_test.txt"
    write_text(f, "x")
    case chmod(f, 420):
      Ok(_):
        expect(is_file(f)).to_be_true()
      Err(e):
        fail("chmod failed: " + e.message)
  )
)

describe("symlink / read_link / is_symlink", ():
  it("should create and read a symbolic link", ():
    target = "/tmp/ry_fs_test/symlink_target.txt"
    link = "/tmp/ry_fs_test/symlink_link.txt"
    if is_symlink(link):
      remove(link)
    write_text(target, "target content")
    case symlink(target, link):
      Ok(_):
        expect(is_symlink(link)).to_be_true()
        expect(is_file(link)).to_be_true()
        case read_link(link):
          Ok(t):
            expect(t).to_eq(target)
          Err(e):
            fail("read_link failed: " + e.message)
      Err(e):
        fail("symlink failed: " + e.message)
  )

  it("should fail read_link on non-symlink", ():
    f = "/tmp/ry_fs_test/not_a_link.txt"
    write_text(f, "x")
    result = read_link(f)
    expect(result).to_be_err()
  )
)

# Cleanup
remove_all("/tmp/ry_fs_test")
