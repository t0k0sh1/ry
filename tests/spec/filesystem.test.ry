from filesystem import listDir, walk, glob, copy, move, remove, removeAll, mkdir, mkdirAll, fileSize, isFile, isDir, isSymlink, chmod, symlink, readLink
from io import writeText, readText, exists
from path import join

describe("mkdir / mkdirAll", ():
  it("should create a single directory", ():
    d = "/tmp/ry_fs_test/single_dir"
    removeAll(d)
    mkdirAll("/tmp/ry_fs_test")
    case mkdir(d):
      Ok(_):
        case isDir(d):
          Ok(v): expect(v).to_be_true()
          Err(e): fail("isDir failed: " + e.message)
      Err(e):
        fail("mkdir failed: " + e.message)
  )

  it("should fail on existing directory", ():
    d = "/tmp/ry_fs_test/single_dir"
    result = mkdir(d)
    expect(result).to_be_err()
  )

  it("should create nested directories", ():
    d = "/tmp/ry_fs_test/a/b/c"
    case mkdirAll(d):
      Ok(_):
        case isDir(d):
          Ok(v): expect(v).to_be_true()
          Err(e): fail("isDir failed: " + e.message)
      Err(e):
        fail("mkdirAll failed: " + e.message)
  )
)

describe("isFile / isDir / isSymlink", ():
  it("should detect a regular file", ():
    f = "/tmp/ry_fs_test/test_file.txt"
    case writeText(f, "hello"):
      Ok(_):
        case isFile(f):
          Ok(v): expect(v).to_be_true()
          Err(e): fail("isFile failed: " + e.message)
        case isDir(f):
          Ok(v): expect(v).to_be_false()
          Err(e): fail("isDir failed: " + e.message)
        case isSymlink(f):
          Ok(v): expect(v).to_be_false()
          Err(e): fail("isSymlink failed: " + e.message)
      Err(e):
        fail("writeText failed: " + e.message)
  )

  it("should detect a directory", ():
    case isDir("/tmp/ry_fs_test"):
      Ok(v): expect(v).to_be_true()
      Err(e): fail("isDir failed: " + e.message)
    case isFile("/tmp/ry_fs_test"):
      Ok(v): expect(v).to_be_false()
      Err(e): fail("isFile failed: " + e.message)
  )

  it("should return false for non-existent path", ():
    case isFile("/tmp/ry_fs_test_nonexistent_xyz"):
      Ok(v): expect(v).to_be_false()
      Err(e): fail("isFile failed: " + e.message)
    case isDir("/tmp/ry_fs_test_nonexistent_xyz"):
      Ok(v): expect(v).to_be_false()
      Err(e): fail("isDir failed: " + e.message)
    case isSymlink("/tmp/ry_fs_test_nonexistent_xyz"):
      Ok(v): expect(v).to_be_false()
      Err(e): fail("isSymlink failed: " + e.message)
  )
)

describe("listDir", ():
  it("should list directory entries", ():
    d = "/tmp/ry_fs_test/listdir_test"
    removeAll(d)
    mkdir(d)
    case join(d, "a.txt"):
      Ok(pa): writeText(pa, "a")
      Err(e): fail("join failed: " + e.message)
    case join(d, "b.txt"):
      Ok(pb): writeText(pb, "b")
      Err(e): fail("join failed: " + e.message)
    case join(d, "subdir"):
      Ok(ps): mkdir(ps)
      Err(e): fail("join failed: " + e.message)
    case listDir(d):
      Ok(entries):
        expect(entries).to_have_length(3)
      Err(e):
        fail("listDir failed: " + e.message)
  )

  it("should return error for non-existent dir", ():
    result = listDir("/tmp/ry_fs_test_no_such_dir")
    expect(result).to_be_err()
  )
)

describe("walk", ():
  it("should recursively list files and directories", ():
    d = "/tmp/ry_fs_test/walk_test"
    removeAll(d)
    case join(d, "sub1", "sub2"):
      Ok(p): mkdirAll(p)
      Err(e): fail("join failed: " + e.message)
    case join(d, "root.txt"):
      Ok(p): writeText(p, "r")
      Err(e): fail("join failed: " + e.message)
    case join(d, "sub1", "mid.txt"):
      Ok(p): writeText(p, "m")
      Err(e): fail("join failed: " + e.message)
    case join(d, "sub1", "sub2", "deep.txt"):
      Ok(p): writeText(p, "d")
      Err(e): fail("join failed: " + e.message)
    case walk(d):
      Ok(entries):
        expect(len(entries) >= 5).to_be_true()
      Err(e):
        fail("walk failed: " + e.message)
  )

  it("should return error for non-existent dir in walk", ():
    result = walk("/tmp/ry_fs_test_no_such_dir")
    expect(result).to_be_err()
  )
)

describe("glob", ():
  it("should match files by pattern", ():
    d = "/tmp/ry_fs_test/glob_test"
    removeAll(d)
    mkdir(d)
    case join(d, "file1.log"):
      Ok(p): writeText(p, "1")
      Err(e): fail("join failed: " + e.message)
    case join(d, "file2.log"):
      Ok(p): writeText(p, "2")
      Err(e): fail("join failed: " + e.message)
    case join(d, "file3.txt"):
      Ok(p): writeText(p, "3")
      Err(e): fail("join failed: " + e.message)
    case join(d, "*.log"):
      Ok(pattern):
        case glob(pattern):
          Ok(matches):
            expect(matches).to_have_length(2)
          Err(e):
            fail("glob failed: " + e.message)
      Err(e): fail("join failed: " + e.message)
  )

  it("should return empty list when nothing matches", ():
    case glob("/tmp/ry_fs_test_nomatch_*.zzz"):
      Ok(matches):
        expect(matches).to_have_length(0)
      Err(e):
        fail("glob failed: " + e.message)
  )
)

describe("copy", ():
  it("should copy file content", ():
    src = "/tmp/ry_fs_test/copy_src.txt"
    dst = "/tmp/ry_fs_test/copy_dst.txt"
    writeText(src, "copy me")
    case copy(src, dst):
      Ok(_):
        case readText(dst):
          Ok(content):
            expect(content).to_eq("copy me")
          Err(e):
            fail("readText failed: " + e.message)
      Err(e):
        fail("copy failed: " + e.message)
  )

  it("should return error for non-existent source", ():
    result = copy("/tmp/ry_fs_test_nosrc.txt", "/tmp/ry_fs_test_nodst.txt")
    expect(result).to_be_err()
  )
)

describe("move", ():
  it("should move a file", ():
    src = "/tmp/ry_fs_test/move_src.txt"
    dst = "/tmp/ry_fs_test/move_dst.txt"
    writeText(src, "move me")
    case move(src, dst):
      Ok(_):
        expect(exists(src)).to_be_false()
        case readText(dst):
          Ok(content):
            expect(content).to_eq("move me")
          Err(e):
            fail("readText failed: " + e.message)
      Err(e):
        fail("move failed: " + e.message)
  )
)

describe("remove / removeAll", ():
  it("should remove a file", ():
    f = "/tmp/ry_fs_test/remove_me.txt"
    writeText(f, "bye")
    case remove(f):
      Ok(_):
        expect(exists(f)).to_be_false()
      Err(e):
        fail("remove failed: " + e.message)
  )

  it("should fail to remove non-empty directory", ():
    d = "/tmp/ry_fs_test/nonempty_dir"
    mkdir(d)
    case join(d, "child.txt"):
      Ok(p): writeText(p, "x")
      Err(e): fail("join failed: " + e.message)
    result = remove(d)
    expect(result).to_be_err()
    removeAll(d)
  )

  it("should remove directory tree with removeAll", ():
    d = "/tmp/ry_fs_test/tree_to_remove"
    case join(d, "a", "b"):
      Ok(p): mkdirAll(p)
      Err(e): fail("join failed: " + e.message)
    case join(d, "a", "b", "file.txt"):
      Ok(p): writeText(p, "x")
      Err(e): fail("join failed: " + e.message)
    case removeAll(d):
      Ok(_):
        case isDir(d):
          Ok(v): expect(v).to_be_false()
          Err(e): fail("isDir failed: " + e.message)
      Err(e):
        fail("removeAll failed: " + e.message)
  )
)

describe("fileSize", ():
  it("should return correct file size", ():
    f = "/tmp/ry_fs_test/size_test.txt"
    writeText(f, "12345")
    case fileSize(f):
      Ok(sz):
        expect(sz).to_eq(5)
      Err(e):
        fail("fileSize failed: " + e.message)
  )

  it("should return error for non-existent file", ():
    result = fileSize("/tmp/ry_fs_test_no_file.txt")
    expect(result).to_be_err()
  )
)

describe("chmod", ():
  it("should change file permissions", ():
    f = "/tmp/ry_fs_test/chmod_test.txt"
    writeText(f, "x")
    case chmod(f, 420):
      Ok(_):
        case isFile(f):
          Ok(v): expect(v).to_be_true()
          Err(e): fail("isFile failed: " + e.message)
      Err(e):
        fail("chmod failed: " + e.message)
  )
)

describe("symlink / readLink / isSymlink", ():
  it("should create and read a symbolic link", ():
    target = "/tmp/ry_fs_test/symlink_target.txt"
    link = "/tmp/ry_fs_test/symlink_link.txt"
    remove(link)
    writeText(target, "target content")
    case symlink(target, link):
      Ok(_):
        case isSymlink(link):
          Ok(v): expect(v).to_be_true()
          Err(e): fail("isSymlink failed: " + e.message)
        case isFile(link):
          Ok(v): expect(v).to_be_true()
          Err(e): fail("isFile failed: " + e.message)
        case readLink(link):
          Ok(t):
            expect(t).to_eq(target)
          Err(e):
            fail("readLink failed: " + e.message)
      Err(e):
        fail("symlink failed: " + e.message)
  )

  it("should fail readLink on non-symlink", ():
    f = "/tmp/ry_fs_test/not_a_link.txt"
    writeText(f, "x")
    result = readLink(f)
    expect(result).to_be_err()
  )
)

# Cleanup
removeAll("/tmp/ry_fs_test")
