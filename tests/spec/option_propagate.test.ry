from testing import it, describe, expect, fail

fn safeGet(xs: List<int>, i: int) -> Option<int>:
  if i < 0 or i >= xs.len():
    return none
  return Some(xs[i])

fn firstPlusSecond(xs: List<int>) -> Option<int>:
  a = safeGet(xs, 0)?
  b = safeGet(xs, 1)?
  return Some(a + b)

fn firstPlusSecondBang(xs: List<int>) -> Option<int>:
  a = safeGet(xs, 0)?
  b = safeGet(xs, 1)?
  return Some(a + b)

fn inlineExpr(xs: List<int>) -> Option<int>:
  return Some(safeGet(xs, 0)? + 1)

fn inlineExprAlwaysNone() -> Option<int>:
  # safeGet on index 99 of a 1-element list always returns None, so the
  # `?` inside the expression position short-circuits to `None`.
  return Some(safeGet([1], 99)? + 1)

fn wrapBang(r: Option<int>) -> Option<int>:
  return Some(r?)

fn addOneBang(v: Option<int>) -> Option<int>:
  return Some(v? + 1)

fn addOneBangNone() -> Option<int>:
  x: Option<int> = none
  return Some(x? + 1)

@describe("Option error propagation")
fn optionErrorPropagationTests():
  @it("should unwrap Some value with ?")
  fn shouldUnwrapSomeValueWith():
    case firstPlusSecond([10, 20, 30]):
      Some(v):
        expect(v).toEq(30)
      None:
        fail("unexpected none")
  @it("should propagate None with ?")
  fn shouldPropagateNoneWith():
    case firstPlusSecond([10]):
      Some(v):
        fail("expected None but got Some")
      None:
        expect(true).toEq(true)
  @it("should support ? on Option (alternate function)")
  fn shouldSupportOnOptionAlternateFunction():
    case firstPlusSecondBang([1, 2]):
      Some(v):
        expect(v).toEq(3)
      None:
        fail("unexpected none")
  @it("should propagate None through ?")
  fn shouldPropagateNoneThrough():
    case firstPlusSecondBang([7]):
      Some(v):
        fail("expected None but got Some")
      None:
        expect(true).toEq(true)
  @it("should support ? in expression position")
  fn shouldSupportInExpressionPosition():
    case inlineExpr([41]):
      Some(v):
        expect(v).toEq(42)
      None:
        fail("unexpected none")
  @it("should propagate None from ? in expression position")
  fn shouldPropagateNoneFromInExpressionPosition():
    case inlineExprAlwaysNone():
      Some(v):
        fail("expected None but got Some")
      None:
        expect(true).toEq(true)
  @it("should support ? on identifier inside call argument")
  fn shouldSupportOnIdentifierInsideCallArgument():
    case wrapBang(Some(42)):
      Some(v):
        expect(v).toEq(42)
      None:
        fail("unexpected none")
  @it("should propagate None via ? on identifier inside call argument")
  fn shouldPropagateNoneViaOnIdentifierInsideCallArgument():
    case wrapBang(none):
      Some(v):
        fail("expected None but got Some")
      None:
        expect(true).toEq(true)
  @it("should support ? on identifier in arithmetic expression")
  fn shouldSupportOnIdentifierInArithmeticExpression():
    case addOneBang(Some(41)):
      Some(v):
        expect(v).toEq(42)
      None:
        fail("unexpected none")
  @it("should propagate None via ? on identifier in arithmetic expression")
  fn shouldPropagateNoneViaOnIdentifierInArithmeticExpression():
    case addOneBangNone():
      Some(v):
        fail("expected None but got Some")
      None:
        expect(true).toEq(true)
