from .helper import greet
from .mymath import add, sub

describe("relative import", function():
    it("import from sibling module", function():
        expect(greet()).to_eq("hello")
    )
    it("import from subdirectory package (multiple files)", function():
        expect(add(2, 3)).to_eq(5)
        expect(sub(10, 4)).to_eq(6)
    )
)
