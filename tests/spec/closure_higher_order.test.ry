from testing import it, describe, expect

@describe("closure — returned from function")
fn closureReturnedFromFunctionTests():
  @it("should return callable closure from make_adder")
  fn shouldReturnCallableClosureFromMakeAdder():
    fn makeAdder(base: int) -> fn(int) -> int:
      return (x: int) => x + base

    add5 = makeAdder(5)
    expect(add5(3)).toEq(8)

  @it("should support returned closure with multiple captures")
  fn shouldSupportReturnedClosureWithMultipleCaptures():
    fn makeLinear(a: int, b: int) -> fn(int) -> int:
      return (x: int) => a * x + b

    f = makeLinear(3, 10)
    expect(f(5)).toEq(25)

  @it("should support returned no-capture lambda")
  fn shouldSupportReturnedNoCaptureLambda():
    fn makeDoubler() -> fn(int) -> int:
      return (x: int) => x * 2

    double = makeDoubler()
    expect(double(7)).toEq(14)

@describe("closure — function-type parameter capture")
fn closureFunctionTypeParameterCaptureTests():
  @it("should compose two captured function params")
  fn shouldComposeTwoCapturedFunctionParams():
    fn compose(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int:
      return (x: int) => f(g(x))

    double = (x: int) => x * 2
    inc = (x: int) => x + 1
    doubleThenInc = compose(inc, double)
    expect(doubleThenInc(5)).toEq(11)

  @it("should capture function param in apply_twice")
  fn shouldCaptureFunctionParamInApplyTwice():
    fn applyTwice(f: fn(int) -> int, x: int) -> int:
      g = (v: int) => f(f(v))
      return g(x)

    result = applyTwice((x: int) => x + 1, 5)
    expect(result).toEq(7)

  @it("should return fn() -> int param bound to local and invoke it")
  fn shouldReturnFnIntParamBoundToLocalAndInvokeIt():
    fn pickInt(f: fn() -> int) -> fn() -> int:
      return f

    g = pickInt(() => 42)
    expect(g()).toEq(42)

  @it("should return fn() -> Unit param bound to local and invoke it")
  fn shouldReturnFnUnitParamBoundToLocalAndInvokeIt():
    fn pickUnit(f: fn() -> Unit) -> fn() -> Unit:
      return f

    g = pickUnit(():
      return
    )
    g()

  @it("should return capturing fn() -> int param bound to local and invoke it")
  fn shouldReturnCapturingFnIntParamBoundToLocalAndInvokeIt():
    fn pickInt(f: fn() -> int) -> fn() -> int:
      return f

    base = 100
    g = pickInt(() => base + 5)
    expect(g()).toEq(105)

  @it("should pass a local fn-typed value through pickInt without UAF")
  fn shouldPassLocalFnTypedValueThroughPickIntWithoutUaf():
    fn pickInt(f: fn() -> int) -> fn() -> int:
      return f

    g = () => 7
    h = pickInt(g)
    expect(h()).toEq(7)
    expect(g()).toEq(7)

  @it("should chain pickInt through a two-level wrapper")
  fn shouldChainPickIntThroughTwoLevelWrapper():
    fn inner(f: fn() -> int) -> fn() -> int:
      return f

    fn outer(f: fn() -> int) -> fn() -> int:
      return inner(f)

    g = outer(() => 99)
    expect(g()).toEq(99)
