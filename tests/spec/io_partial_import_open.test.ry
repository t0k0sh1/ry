from testing import it, describe, expect

from io import open

@describe("partial import: open only (regression for #1856)")
fn ioPartialImportOpenTests():
  @it("should return Err when opening nonexistent file with open-only import (JIT resolves __ry_io_file_open)")
  fn shouldReturnErrWhenOpeningNonexistentFileWithOpenOnlyImport():
    expect(open("/tmp/ry_partial_import_open_no_such_file_zzzz.txt", "r")).toBeErr()
