fn make_strong() -> str:
  return "hello"

describe("Weak references", fn():
  it("weak ref upgrade returns Some when strong ref is alive", fn():
    s = "alive"
    w: weak str = weak s
    match w:
      case Some(v):
        expect(v).to_eq("alive")
      case None:
        fail("expected Some but got None")
  )

  it("weak ref upgrade returns None after strong ref is gone", fn():
    w: weak str = weak make_strong()
    # The strong ref from make_strong() is not retained by anything,
    # so it gets released. But we need to be careful here —
    # the temporary return value may still be alive in this scope.
    # A more reliable test needs inner scope.
    match w:
      case Some(v):
        # The temporary might still be alive; that's OK
        expect(v).to_eq("hello")
      case None:
        # Also acceptable — the temporary was released
        expect(true).to_be_true()
  )

  it("weak ref pattern matching with Some", fn():
    data = "pattern_test"
    ref: weak str = weak data
    result = ""
    match ref:
      case Some(v):
        result = v
      case None:
        result = "dead"
    expect(result).to_eq("pattern_test")
  )

  it("weak ref with coalesce operator", fn():
    s = "coalesce"
    w: weak str = weak s
    val = w ?? "default"
    expect(val).to_eq("coalesce")
  )

  it("weak ref reassignment", fn():
    a = "first"
    b = "second"
    w: weak str = weak a
    match w:
      case Some(v):
        expect(v).to_eq("first")
      case None:
        fail("expected Some")
    w = weak b
    match w:
      case Some(v):
        expect(v).to_eq("second")
      case None:
        fail("expected Some after reassignment")
  )
)
