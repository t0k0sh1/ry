describe("Copy-on-Write", function():
  describe("List", function():
    it("append preserves original when shared", function():
      a = [1, 2, 3]
      b = a
      append(b, 4)
      expect(a).to_have_length(3)
      expect(b).to_have_length(4)
      expect(b[3]).to_eq(4)
    )
    it("append mutates in-place when unique", function():
      a = [1, 2, 3]
      append(a, 4)
      expect(a).to_have_length(4)
      expect(a[3]).to_eq(4)
    )
    it("index assignment preserves original when shared", function():
      a = [1, 2, 3]
      b = a
      b[0] = 99
      expect(a[0]).to_eq(1)
      expect(b[0]).to_eq(99)
    )
    it("remove preserves original when shared", function():
      a = [1, 2, 3]
      b = a
      remove(b, 2)
      expect(a).to_have_length(3)
      expect(b).to_have_length(2)
    )
    it("pop preserves original when shared", function():
      a = [1, 2, 3]
      b = a
      v = pop(b)
      expect(v).to_eq(Some(3))
      expect(a).to_have_length(3)
      expect(b).to_have_length(2)
    )
    it("insert preserves original when shared", function():
      a = [1, 3]
      b = a
      insert(b, 1, 2)
      expect(a).to_have_length(2)
      expect(b).to_have_length(3)
      expect(b[1]).to_eq(2)
    )
    it("remove_at preserves original when shared", function():
      a = [1, 2, 3]
      b = a
      remove_at(b, 1)
      expect(a).to_have_length(3)
      expect(b).to_have_length(2)
      expect(b[1]).to_eq(3)
    )
    it("sort! preserves original when shared", function():
      a = [3, 1, 2]
      b = a
      sort!(b)
      expect(a[0]).to_eq(3)
      expect(a[1]).to_eq(1)
      expect(a[2]).to_eq(2)
      expect(b[0]).to_eq(1)
      expect(b[1]).to_eq(2)
      expect(b[2]).to_eq(3)
    )
    it("reverse! preserves original when shared", function():
      a = [1, 2, 3]
      b = a
      reverse!(b)
      expect(a[0]).to_eq(1)
      expect(a[1]).to_eq(2)
      expect(a[2]).to_eq(3)
      expect(b[0]).to_eq(3)
      expect(b[1]).to_eq(2)
      expect(b[2]).to_eq(1)
    )
  )
  describe("Map", function():
    it("index assignment preserves original when shared", function():
      a = {"x": 1}
      b = a
      b["y"] = 2
      expect(a).to_have_length(1)
      expect(b).to_have_length(2)
    )
    it("remove preserves original when shared", function():
      a = {"x": 1, "y": 2}
      b = a
      remove(b, "x")
      expect(a).to_have_length(2)
      expect(b).to_have_length(1)
    )
  )
  describe("Set", function():
    it("add preserves original when shared", function():
      a = {1, 2}
      b = a
      add(b, 3)
      expect(a).to_have_length(2)
      expect(b).to_have_length(3)
    )
    it("remove preserves original when shared", function():
      a = {1, 2, 3}
      b = a
      remove(b, 2)
      expect(a).to_have_length(3)
      expect(b).to_have_length(2)
    )
  )
)
