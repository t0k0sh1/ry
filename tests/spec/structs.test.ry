record Point:
  x: int
  y: int

record Circle:
  center: Point
  radius: float

describe("record", fn():
  it("constructor and field access", fn():
    p = Point(10, 20)
    expect(p.x).to_eq(10)
    expect(p.y).to_eq(20)
  )
  it("var field assignment", fn():
    p = Point(10, 20)
    p.x = 100
    expect(p.x).to_eq(100)
  )
  it("nested record", fn():
    c = Circle(Point(0, 0), 1.0)
    expect(c.center.x).to_eq(0)
    expect(c.center.y).to_eq(0)
    expect(c.radius).to_eq(1.0)
  )
)

record Mixed:
  name: str
  value: int
  rate: float
  active: bool

record AlwaysEqual:
  x: int

fn operator==(a: AlwaysEqual, b: AlwaysEqual) -> bool:
  return true

describe("record equality", fn():
  it("equal records", fn():
    expect(Point(1, 2) == Point(1, 2)).to_be_true()
  )
  it("unequal records", fn():
    expect(Point(1, 2) == Point(3, 4)).to_be_false()
  )
  it("!= operator", fn():
    expect(Point(1, 2) != Point(3, 4)).to_be_true()
    expect(Point(1, 2) != Point(1, 2)).to_be_false()
  )
  it("mixed field types", fn():
    a = Mixed("hello", 42, 3.14, true)
    b = Mixed("hello", 42, 3.14, true)
    c = Mixed("world", 42, 3.14, true)
    expect(a == b).to_be_true()
    expect(a != c).to_be_true()
  )
  it("nested record equality", fn():
    c1 = Circle(Point(0, 0), 1.0)
    c2 = Circle(Point(0, 0), 1.0)
    c3 = Circle(Point(1, 0), 1.0)
    expect(c1 == c2).to_be_true()
    expect(c1 != c3).to_be_true()
  )
  it("user-defined operator== takes precedence", fn():
    # AlwaysEqual always returns true regardless of field values
    expect(AlwaysEqual(1) == AlwaysEqual(2)).to_be_true()
  )
)

enum Color:
  Red
  Green
  Blue

describe("simple enum", fn():
  it("variant access", fn():
    c = Color::Red
    expect(c == Color::Red).to_be_true()
  )
  it("comparison", fn():
    expect(Color::Red == Color::Red).to_be_true()
    expect(Color::Red != Color::Green).to_be_true()
  )
  it("match", fn():
    res = ""
    c = Color::Blue
    match c:
      case Color::Red:
        res = "red"
      case Color::Green:
        res = "green"
      case Color::Blue:
        res = "blue"
    expect(res).to_eq("blue")
  )
)

enum Shape:
  CircleS(float)
  RectS(float, float)
  PointS

describe("ADT enum", fn():
  it("associated data", fn():
    s = Shape::CircleS(3.14)
    res = 0.0
    match s:
      case Shape::CircleS(r):
        res = r
      case Shape::RectS(w, h):
        res = w * h
      case Shape::PointS:
        res = 0.0
    expect(res).to_eq(3.14)
  )
  it("multi-field pattern match", fn():
    s = Shape::RectS(4.0, 5.0)
    res = 0.0
    match s:
      case Shape::CircleS(r):
        res = r
      case Shape::RectS(w, h):
        res = w * h
      case Shape::PointS:
        res = 0.0
    expect(res).to_eq(20.0)
  )
)

enum MyOption<T>:
  MySome(T)
  MyNone

describe("generic enum", fn():
  it("with type parameter", fn():
    a = MyOption<int>::MySome(42)
    res = 0
    match a:
      case MyOption::MySome(v):
        res = v
      case MyOption::MyNone:
        res = -1
    expect(res).to_eq(42)
  )
  it("none variant", fn():
    b = MyOption<int>::MyNone
    res = 0
    match b:
      case MyOption::MySome(v):
        res = v
      case MyOption::MyNone:
        res = -1
    expect(res).to_eq(-1)
  )
)
