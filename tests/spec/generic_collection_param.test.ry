fn firstItem<T>(items: List<T>) -> T:
    return items[0]

fn secondItem<T>(items: List<T>) -> T:
    return items[1]

fn mapHas<K, V>(m: Map<K, V>, key: K) -> bool:
    return m.contains(key)

fn setCount<T>(s: Set<T>) -> int:
    return 1

describe("generic function with collection params", ():
  it("should return List int first item", ():
    expect(firstItem[int]([10, 20, 30])).toEq(10)
  )
  it("should return List int second item", ():
    expect(secondItem[int]([10, 20, 30])).toEq(20)
  )
  it("should return List str first item", ():
    expect(firstItem[str](["hello", "world"])).toEq("hello")
  )
  it("should return List str second item", ():
    expect(secondItem[str](["hello", "world"])).toEq("world")
  )
  it("should support Set int parameter", ():
    expect(setCount[int]({1, 2, 3})).toEq(1)
  )
  it("should check Map contains via generic param", ():
    expect(mapHas[str, int]({"a": 1, "b": 2}, "a")).toBeTrue()
    expect(mapHas[str, int]({"a": 1, "b": 2}, "z")).toBeFalse()
  )
)
