from testing import it, describe

@describe("record_field_index")
fn recordFieldIndexTests():

  @it("should access list field by index")
  fn shouldAccessListFieldByIndex():
    record Container:
      items: List<int>

    c = Container([10, 20, 30])
    expect(c.items[0]).toEq(10)
    expect(c.items[1]).toEq(20)
    expect(c.items[2]).toEq(30)

  @it("should index list field after assignment to variable")
  fn shouldIndexListFieldAfterAssignmentToVariable():
    record Holder:
      data: List<int>

    h = Holder([100, 200, 300])
    xs = h.data
    expect(xs[0]).toEq(100)
    expect(xs[2]).toEq(300)

  @it("should access map field by index")
  fn shouldAccessMapFieldByIndex():
    record Config:
      settings: Map<str, str>

    cfg = Config({"host": "localhost", "port": "8080"})
    expect(cfg.settings["host"]).toEq("localhost")
    expect(cfg.settings["port"]).toEq("8080")

  @it("should access list field by index in function")
  fn shouldAccessListFieldByIndexInFunction():
    record Matrix:
      data: List<int>

    fn getElement(m: Matrix, idx: int) -> int:
      return m.data[idx]

    mat = Matrix([5, 10, 15, 20])
    expect(getElement(mat, 0)).toEq(5)
    expect(getElement(mat, 3)).toEq(20)

  @it("should access nested list field by index")
  fn shouldAccessNestedListFieldByIndex():
    record Grid:
      rows: List<List<int>>

    g = Grid([[1, 2], [3, 4], [5, 6]])
    row = g.rows[0]
    expect(row[0]).toEq(1)
    expect(row[1]).toEq(2)

  @it("should access list field with negative index")
  fn shouldAccessListFieldWithNegativeIndex():
    record Bag:
      items: List<int>

    b = Bag([10, 20, 30])
    expect(b.items[-1]).toEq(30)
    expect(b.items[-3]).toEq(10)

  @it("should support operator overload using record list field")
  fn shouldSupportOperatorOverloadUsingRecordListField():
    record Vec:
      elems: List<int>

    fn operator[](v: Vec, idx: int) -> int:
      return v.elems[idx]

    v = Vec([7, 8, 9])
    expect(v[0]).toEq(7)
    expect(v[2]).toEq(9)
