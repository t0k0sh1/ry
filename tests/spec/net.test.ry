from std.net import bind, listen, accept, connect, listener_port, set_timeout, set_recv_timeout, set_send_timeout, tls_connect
from std.io import str_to_bytes, bytes_to_str

describe("TCP socket API", fn():
  it("bind returns Ok on valid address", fn():
    match bind("127.0.0.1", 0):
      case Ok(server):
        close(server)
        expect(true).to_eq(true)
      case Err(e):
        expect(true).to_eq(false)
  )
  it("listen returns Ok on valid listener", fn():
    match bind("127.0.0.1", 0):
      case Ok(server):
        match listen(server, 1):
          case Ok(_):
            expect(true).to_eq(true)
          case Err(e):
            expect(true).to_eq(false)
        close(server)
      case Err(e):
        expect(true).to_eq(false)
  )
  it("tls_connect to closed port returns Err", fn():
    match tls_connect("127.0.0.1", 19991):
      case Ok(conn):
        close(conn)
        expect(true).to_eq(false)
      case Err(e):
        expect(true).to_eq(true)
  )
  it("connect to closed port returns Err", fn():
    match connect("127.0.0.1", 19998):
      case Ok(conn):
        close(conn)
        expect(true).to_eq(false)
      case Err(e):
        expect(true).to_eq(true)
  )
  it("set_recv_timeout causes recv to return Err on timeout", fn():
    fn timeout_server(ready: Channel<int>) -> str:
      match bind("127.0.0.1", 0):
        case Ok(server):
          match listen(server, 1):
            case Ok(_):
              port = listener_port(server)
              send(ready, port)
              match accept(server):
                case Ok(conn):
                  sleep(500)
                  close(conn)
                case Err(e):
                  ...
            case Err(e):
              send(ready, 0)
          close(server)
        case Err(e):
          send(ready, 0)
      return "done"
    ready: Channel<int> = channel[int]()
    t: Task<str> = spawn timeout_server(ready)
    port = recv(ready)
    match connect("127.0.0.1", port):
      case Ok(conn):
        set_recv_timeout(conn, 100)
        match recv(conn, 4096):
          case Ok(data):
            expect(true).to_eq(false)
          case Err(e):
            expect(true).to_eq(true)
        close(conn)
      case Err(e):
        expect(true).to_eq(false)
    join(t)
  )
  it("echo round-trip with spawn", fn():
    fn run_server(ready: Channel<int>) -> str:
      match bind("127.0.0.1", 0):
        case Ok(server):
          match listen(server, 1):
            case Ok(_):
              port = listener_port(server)
              send(ready, port)
              match accept(server):
                case Ok(conn):
                  match recv(conn, 4096):
                    case Ok(data):
                      match bytes_to_str(data):
                        case Ok(msg):
                          match send(conn, str_to_bytes("echo:" + msg)):
                            case Ok(_):
                              ...
                            case Err(e):
                              ...
                        case Err(e):
                          ...
                    case Err(e):
                      ...
                  close(conn)
                case Err(e):
                  ...
            case Err(e):
              send(ready, 0)
          close(server)
        case Err(e):
          send(ready, 0)
      return "done"
    fn run_client(port: int) -> str:
      match connect("127.0.0.1", port):
        case Ok(conn):
          match send(conn, str_to_bytes("hello")):
            case Ok(_):
              ...
            case Err(e):
              ...
          match recv(conn, 4096):
            case Ok(resp):
              match bytes_to_str(resp):
                case Ok(msg):
                  close(conn)
                  return msg
                case Err(e):
                  ...
            case Err(e):
              ...
          close(conn)
          return "fail"
        case Err(e):
          return "fail"
    ready: Channel<int> = channel[int]()
    t: Task<str> = spawn run_server(ready)
    port = recv(ready)
    resp_msg = run_client(port)
    expect(resp_msg).to_eq("echo:hello")
    join(t)
  )
)
