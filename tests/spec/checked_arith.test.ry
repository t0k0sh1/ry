describe("checked arithmetic", fn():
  it("checked_add ok", fn():
    r = checked_add(10i32, 20i32)
    when r:
      case Ok(v):
        expect(v as int).to_eq(30)
      case Err(e):
        expect(true).to_eq(false)
  )
  it("checked_add overflow", fn():
    r = checked_add(2147483647i32, 1i32)
    when r:
      case Ok(v):
        expect(true).to_eq(false)
      case Err(e):
        expect(true).to_eq(true)
  )
  it("checked_sub ok", fn():
    r = checked_sub(100i32, 50i32)
    when r:
      case Ok(v):
        expect(v as int).to_eq(50)
      case Err(e):
        expect(true).to_eq(false)
  )
  it("checked_mul ok", fn():
    r = checked_mul(6i32, 7i32)
    when r:
      case Ok(v):
        expect(v as int).to_eq(42)
      case Err(e):
        expect(true).to_eq(false)
  )
  it("saturating_add clamps to max", fn():
    v = saturating_add(2147483647i32, 100i32)
    expect(v as int).to_eq(2147483647)
  )
  it("saturating_sub clamps to min", fn():
    v = saturating_sub(-2147483648i32, 1i32)
    expect(v as int).to_eq(-2147483648)
  )
  it("saturating_mul clamps to max", fn():
    v = saturating_mul(100000i32, 100000i32)
    expect(v as int).to_eq(2147483647)
  )
  it("wrapping_add wraps", fn():
    v = wrapping_add(2147483647i32, 1i32)
    expect(v as int).to_eq(-2147483648)
  )
  it("wrapping_sub unsigned wraps", fn():
    v = wrapping_sub(0u8, 1u8)
    expect(v as int).to_eq(255)
  )
)
