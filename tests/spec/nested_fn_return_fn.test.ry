from testing import it, describe

@describe("two-level nested function return (#752)")
fn twoLevelNestedFunctionReturn752Tests():
  @it("should return and call a two-level nested function with type annotations")
  fn shouldReturnAndCallATwoLevelNestedFunctionWithTypeAnnotations():
    fn outer() -> fn() -> fn() -> int:
      fn middle() -> fn() -> int:
        fn inner() -> int:
          return 42
        return inner
      return middle

    f: fn() -> fn() -> int = outer()
    g: fn() -> int = f()
    expect(g()).toEq(42)

  @it("should return and call a two-level nested function without type annotations")
  fn shouldReturnAndCallATwoLevelNestedFunctionWithoutTypeAnnotations():
    fn outer() -> fn() -> fn() -> int:
      fn middle() -> fn() -> int:
        fn inner() -> int:
          return 42
        return inner
      return middle

    f = outer()
    g = f()
    expect(g()).toEq(42)

  @it("should support chained calls via intermediate variables")
  fn shouldSupportChainedCallsViaIntermediateVariables():
    fn make() -> fn() -> fn() -> int:
      fn mid() -> fn() -> int:
        fn leaf() -> int:
          return 99
        return leaf
      return mid

    a = make()
    b = a()
    expect(b()).toEq(99)

  @it("should work with lambdas returning nested functions")
  fn shouldWorkWithLambdasReturningNestedFunctions():
    make = () -> fn() -> fn() -> int:
      mid = () -> fn() -> int:
        leaf = () -> int:
          return 42
        return leaf
      return mid

    f = make()
    g = f()
    expect(g()).toEq(42)

  @it("should work with type aliases for nested function returns")
  fn shouldWorkWithTypeAliasesForNestedFunctionReturns():
    type Inner = fn() -> int
    type Outer = fn() -> Inner

    fn make() -> Outer:
      fn mid() -> Inner:
        fn leaf() -> int:
          return 42
        return leaf
      return mid

    f: Outer = make()
    g: Inner = f()
    expect(g()).toEq(42)

  @it("should work with parameters at each level")
  fn shouldWorkWithParametersAtEachLevel():
    fn outer(a: int) -> fn(int) -> fn(int) -> int:
      fn middle(b: int) -> fn(int) -> int:
        fn inner(c: int) -> int:
          return a + b + c
        return inner
      return middle

    f = outer(10)
    g = f(20)
    expect(g(30)).toEq(60)
