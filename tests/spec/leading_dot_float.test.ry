describe("leading-dot float literals", function():
  it(".5 equals 0.5", function():
    x = .5
    expect(x).to_eq(0.5)
  )
  it(".01 equals 0.01", function():
    x = .01
    expect(x).to_eq(0.01)
  )
  it("arithmetic with leading-dot floats", function():
    x = .5 + .25
    expect(x).to_eq(0.75)
  )
)
