from ry.testing import it, describe, expect

# #2115: multiline UFCS chains with continuation lines starting with `.`.
# Isolated into its own spec file so the tree-sitter grammar gap
# (editor/tree-sitter/grammar.js does not yet accept the optional NEWLINE
# between a postfix expression and `.`) is contained to this single file
# in editor/tree-sitter/expected-fail.txt instead of degrading the editor
# view of the entire expr_stmt.test.ry suite.

# #2138 fixtures: helper returning a fresh List<int> so the direct-call
# CallStmt-leader chain test can exercise the runtime path without
# depending on side-effect plumbing the discarded chain result would
# need to observe.
fn buildList() -> List<int>:
  return [1, 2, 3]

@describe("multiline UFCS chain")
fn multilineUfcsChainTests():
  @it("should run iterator pipeline across multiple lines")
  fn shouldRunIteratorPipelineAcrossMultipleLines():
    result = [1, 2, 3, 4, 5]
        .iter()
        .filter((x: int) => x > 2)
        .map((x: int) => x * 2)
        .take(2)
        .toList()
    expect(result).toEq([6, 8])
  @it("should support multiline UFCS chain on bare ident")
  fn shouldSupportMultilineUfcsChainOnBareIdent():
    xs = [1, 2, 3]
    result = xs
        .iter()
        .toList()
    expect(result).toEq([1, 2, 3])
  @it("should support multiline UFCS chain as statement")
  fn shouldSupportMultilineUfcsChainAsStatement():
    [1, 2, 3]
        .iter()
        .toList()
  @it("should allow multiline UFCS chain in if condition")
  fn shouldAllowMultilineUfcsChainInIfCondition():
    xs = [1, 2, 3]
    seen = 0
    if xs
        .len() > 0:
        seen = 1
    expect(seen).toEq(1)
  @it("should allow multiline UFCS chain in assignment RHS followed by statement")
  fn shouldAllowMultilineUfcsChainInAssignmentRhsFollowedByStatement():
    xs = [1, 2, 3]
    flag = xs
        .len() > 0
    next = 1
    expect(flag).toEq(true)
    expect(next).toEq(1)
  @it("should treat a comment line between hops as transparent")
  fn shouldTreatCommentBetweenHopsAsTransparent():
    xs = [1, 2, 3]
    result = xs
        # skip empty
        .iter()
        .toList()
    expect(result).toEq([1, 2, 3])
  @it("should treat multiple consecutive comment lines between hops as transparent")
  fn shouldTreatMultipleCommentsBetweenHopsAsTransparent():
    xs = [1, 2, 3]
    result = xs
        # first comment
        # second comment
        .iter()
        .toList()
    expect(result).toEq([1, 2, 3])
  @it("should treat a comment line between two dot-hops as transparent")
  fn shouldTreatCommentBetweenTwoHopsAsTransparent():
    xs = [1, 2, 3]
    result = xs
        .iter()
        # finalize
        .toList()
    expect(result).toEq([1, 2, 3])
  @it("should support multiline UFCS chain after a CallStmt receiver")
  fn shouldSupportMultilineUfcsChainAfterCallStmtReceiver():
    # #2138: the statement leader is the UFCS CallStmt `xs.sort()`,
    # not a primary expression. Pre-fix this raised "unexpected token"
    # on the continuation `.iter()` line. The chain runs at statement
    # position and its result is discarded — verification is that the
    # body executes to the post-chain expect without parser/runtime
    # error and that `xs` (non-mutated by `sort`) round-trips.
    xs = [3, 1, 2]
    xs.sort()
        .iter()
        .toList()
    expect(xs).toEq([3, 1, 2])
  @it("should support multiline chain after a direct CallStmt leader")
  fn shouldSupportMultilineChainAfterDirectCallStmtLeader():
    # #2138 sibling: the direct-call CallStmt path
    # (src/parser/parser.cpp:1036-1046) shared the same bug; the fix
    # mirrors the UFCS path. Helper `buildList` is a module-global
    # function returning List<int>, so the chain leader is a plain
    # `buildList()` direct call rather than a UFCS receiver.
    buildList()
        .iter()
        .toList()
    expect(buildList()).toEq([1, 2, 3])
  @it("should allow multiline UFCS chain in case statement subject")
  fn shouldAllowMultilineUfcsChainInCaseSubjectStatement():
    # #2311: subject-bearing `case` statement with multiline UFCS subject.
    # Parity with `while`/`if` body openings — the chain absorbs the body's
    # literal Indent, and consumeBlockOpening's #2136 path decrements
    # chain_pending_dedents_ in place of the missing Indent token. Arm
    # column matches the chain continuation column (the issue's repro
    # shape).
    xs = [1, 2, 3]
    matched = 0
    case xs
        .len():
        3:
            matched = 3
        _:
            matched = -1
    expect(matched).toEq(3)
  @it("should allow multiline UFCS chain in case expression subject")
  fn shouldAllowMultilineUfcsChainInCaseSubjectExpression():
    # #2311 expression form. Same accounting path through
    # parseCaseExprWithSubject; verifies end-to-end that the produced
    # CaseExpr binds the matched arm's value.
    xs = [1, 2, 3]
    label = case xs
        .len():
        3 : "three"
        _ : "other"
    expect(label).toEq("three")
  @it("should allow multiline UFCS chain in a case expression arm guard")
  fn shouldAllowMultilineUfcsChainInCaseExprArmGuard():
    # #2311 side-finding: parseCaseExprArmBody hand-rolled the same Indent
    # check that the case body openings did. Triggerable when the arm guard
    # contains a multiline UFCS chain (leaves chain_pending_dedents_>0) and
    # the arm body is block-form. The statement-form sibling is unaffected
    # because its arm body routes through parseBlockOrInline → parseBlock.
    xs = [1, 2, 3]
    r = case 1:
        1 if xs
            .len() > 0:
            100
        _ : 0
    expect(r).toEq(100)
