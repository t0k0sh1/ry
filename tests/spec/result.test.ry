function safe_divide(a: int, b: int) -> Result<int, Error>:
  if b == 0:
    return Err(Error("division by zero"))
  return Ok(a // b)

function divide_and_add(a: int, b: int) -> Result<int, Error>:
  v = safe_divide(a, b)?
  return Ok(v + 1)

function chained(a: int, b: int, c: int) -> Result<int, Error>:
  x = safe_divide(a, b)?
  y = safe_divide(x, c)?
  return Ok(y)

function inline_expr(a: int, b: int) -> Result<int, Error>:
  return Ok(safe_divide(a, b)? + 1)

describe("Result type", ():
  it("should wrap value in Ok", ():
    res = Ok(42)
    expect(res).to_be_ok()
  )
  it("should wrap error in Err", ():
    res = Err(Error("fail"))
    expect(res).to_be_err()
  )
  it("should extract value when Ok", ():
    case safe_divide(10, 2):
      Ok(v):
        expect(v).to_eq(5)
      Err(e):
        fail("unexpected error")
  )
  it("should extract error when Err", ():
    case safe_divide(10, 0):
      Ok(v):
        fail("expected Err but got Ok")
      Err(e):
        expect(e.message).to_eq("division by zero")
  )
  it("should unwrap Ok value with ?", ():
    case divide_and_add(10, 2):
      Ok(v):
        expect(v).to_eq(6)
      Err(e):
        fail("unexpected error")
  )
  it("should propagate Err with ?", ():
    case divide_and_add(10, 0):
      Ok(v):
        fail("expected Err but got Ok")
      Err(e):
        expect(e.message).to_eq("division by zero")
  )
  it("should propagate chained ?", ():
    case chained(100, 10, 2):
      Ok(v):
        expect(v).to_eq(5)
      Err(e):
        fail("unexpected error")
  )
  it("should propagate chained ? from second call", ():
    case chained(100, 10, 0):
      Ok(v):
        fail("expected Err but got Ok")
      Err(e):
        expect(e.message).to_eq("division by zero")
  )
  it("should support ? in expression position with arithmetic", ():
    case inline_expr(10, 2):
      Ok(v):
        expect(v).to_eq(6)
      Err(e):
        fail("unexpected error")
  )
  it("should recognize Ok(0) as Ok", ():
    res = Ok(0)
    expect(res).to_be_ok()
  )
  it("should recognize Ok with empty string as Ok", ():
    res: Result<str, Error> = Ok("")
    expect(res).to_be_ok()
  )
  it("should recognize Err with empty message as Err", ():
    res = Err(Error(""))
    expect(res).to_be_err()
  )
  it("should match Ok with wildcard for Unit result", ():
    function unit_ok() -> Result<Unit, Error>:
      return Ok(0 as u8)
    case unit_ok():
      Ok(_):
        expect(true).to_eq(true)
      Err(e):
        fail("unexpected error")
  )
)
