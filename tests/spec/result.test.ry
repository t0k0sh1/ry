fn safeDivide(a: int, b: int) -> Result<int, Error>:
  if b == 0:
    return Err(Error("division by zero"))
  return Ok(a // b)

fn divideAndAdd(a: int, b: int) -> Result<int, Error>:
  v = safeDivide(a, b)?
  return Ok(v + 1)

fn chained(a: int, b: int, c: int) -> Result<int, Error>:
  x = safeDivide(a, b)?
  y = safeDivide(x, c)?
  return Ok(y)

fn inlineExpr(a: int, b: int) -> Result<int, Error>:
  return Ok(safeDivide(a, b)? + 1)

describe("Result type", ():
  it("should wrap value in Ok", ():
    res = Ok(42)
    expect(res).to_be_ok()
  )
  it("should wrap error in Err", ():
    res = Err(Error("fail"))
    expect(res).to_be_err()
  )
  it("should extract value when Ok", ():
    case safeDivide(10, 2):
      Ok(v):
        expect(v).to_eq(5)
      Err(e):
        fail("unexpected error")
  )
  it("should extract error when Err", ():
    case safeDivide(10, 0):
      Ok(v):
        fail("expected Err but got Ok")
      Err(e):
        expect(e.message).to_eq("division by zero")
  )
  it("should unwrap Ok value with ?", ():
    case divideAndAdd(10, 2):
      Ok(v):
        expect(v).to_eq(6)
      Err(e):
        fail("unexpected error")
  )
  it("should propagate Err with ?", ():
    case divideAndAdd(10, 0):
      Ok(v):
        fail("expected Err but got Ok")
      Err(e):
        expect(e.message).to_eq("division by zero")
  )
  it("should propagate chained ?", ():
    case chained(100, 10, 2):
      Ok(v):
        expect(v).to_eq(5)
      Err(e):
        fail("unexpected error")
  )
  it("should propagate chained ? from second call", ():
    case chained(100, 10, 0):
      Ok(v):
        fail("expected Err but got Ok")
      Err(e):
        expect(e.message).to_eq("division by zero")
  )
  it("should support ? in expression position with arithmetic", ():
    case inlineExpr(10, 2):
      Ok(v):
        expect(v).to_eq(6)
      Err(e):
        fail("unexpected error")
  )
  it("should recognize Ok(0) as Ok", ():
    res = Ok(0)
    expect(res).to_be_ok()
  )
  it("should recognize Ok with empty string as Ok", ():
    res: Result<str, Error> = Ok("")
    expect(res).to_be_ok()
  )
  it("should recognize Err with empty message as Err", ():
    res = Err(Error(""))
    expect(res).to_be_err()
  )
  it("should match Ok with wildcard for Unit result", ():
    fn unitOk() -> Result<Unit, Error>:
      return Ok(0 as u8)
    case unitOk():
      Ok(_):
        expect(true).to_eq(true)
      Err(e):
        fail("unexpected error")
  )
)
