describe("len"):
    it("List"):
        expect(len([1, 2, 3])).to_eq(3)

    it("Map"):
        expect(len({"a": 1, "b": 2})).to_eq(2)

    it("Set"):
        expect(len({1, 2, 3})).to_eq(3)

    it("str"):
        expect(len("hello")).to_eq(5)

describe("range"):
    it("1 arg"):
        let xs = range(3)
        expect(len(xs)).to_eq(3)
        expect(xs[0]).to_eq(0)
        expect(xs[2]).to_eq(2)

    it("2 args"):
        let xs = range(2, 5)
        expect(len(xs)).to_eq(3)
        expect(xs[0]).to_eq(2)
        expect(xs[2]).to_eq(4)

    it("3 args"):
        let xs = range(0, 10, 2)
        expect(len(xs)).to_eq(5)
        expect(xs[0]).to_eq(0)
        expect(xs[4]).to_eq(8)

    it("negative step"):
        let xs = range(10, 0, -3)
        expect(len(xs)).to_eq(4)
        expect(xs[0]).to_eq(10)
        expect(xs[1]).to_eq(7)
        expect(xs[2]).to_eq(4)
        expect(xs[3]).to_eq(1)

describe("Some / Option"):
    it("Some wraps value"):
        let x = Some(42)
        expect(x).to_be_some()

    it("None is none"):
        let x: Option<int> = None
        expect(x).to_be_none()
