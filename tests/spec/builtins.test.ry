describe("length", ():
  it("should return length of List", ():
    expect([1, 2, 3]).toHaveLen(3)
  )
  it("should return length of Map", ():
    expect({"a": 1, "b": 2}).toHaveLen(2)
  )
  it("should return length of Set", ():
    expect({1, 2, 3}).toHaveLen(3)
  )
  it("should return length of str", ():
    expect("hello").toHaveLen(5)
  )
)

describe("range", ():
  it("should work with 1 arg", ():
    xs = range(3)
    expect(xs).toHaveLen(3)
    expect(xs[0]).toEq(0)
    expect(xs[2]).toEq(2)
  )
  it("should work with 2 args", ():
    xs = range(2, 5)
    expect(xs).toHaveLen(3)
    expect(xs[0]).toEq(2)
    expect(xs[2]).toEq(4)
  )
  it("should work with 3 args", ():
    xs = range(0, 10, 2)
    expect(xs).toHaveLen(5)
    expect(xs[0]).toEq(0)
    expect(xs[4]).toEq(8)
  )
  it("should work with negative step", ():
    xs = range(10, 0, -3)
    expect(xs).toHaveLen(4)
    expect(xs[0]).toEq(10)
    expect(xs[1]).toEq(7)
    expect(xs[2]).toEq(4)
    expect(xs[3]).toEq(1)
  )
)

describe("Some / Option", ():
  it("should wrap value with Some", ():
    x = Some(42)
    expect(x).toBeSome()
  )
  it("should recognize None as none", ():
    x: Option<int> = None
    expect(x).toBeNone()
  )
  it("should preserve collection metadata for Option<List<int>>", ():
    x: Option<List<int>> = Some([1, 2, 3])
    case x:
      Some(v):
        expect(v).toHaveLen(3)
        expect(v[0]).toEq(1)
      None:
        fail("expected Some")
  )
  it("should preserve collection metadata for Option<Map<str, int>>", ():
    x: Option<Map<str, int>> = Some({"a": 1, "b": 2})
    case x:
      Some(v):
        expect(v).toHaveLen(2)
        expect(get(v, "a")).toEq(Some(1))
      None:
        fail("expected Some")
  )
  it("should preserve collection metadata for Option<Set<int>>", ():
    x: Option<Set<int>> = Some({1, 2, 3})
    case x:
      Some(v):
        expect(v).toHaveLen(3)
        expect(v).toContain(2)
      None:
        fail("expected Some")
  )
)
