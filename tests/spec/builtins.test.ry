describe("length", function():
  it("List", function():
    expect([1, 2, 3]).to_have_length(3)
  )
  it("Map", function():
    expect({"a": 1, "b": 2}).to_have_length(2)
  )
  it("Set", function():
    expect({1, 2, 3}).to_have_length(3)
  )
  it("str", function():
    expect("hello").to_have_length(5)
  )
)

describe("range", function():
  it("1 arg", function():
    xs = range(3)
    expect(xs).to_have_length(3)
    expect(xs[0]).to_eq(0)
    expect(xs[2]).to_eq(2)
  )
  it("2 args", function():
    xs = range(2, 5)
    expect(xs).to_have_length(3)
    expect(xs[0]).to_eq(2)
    expect(xs[2]).to_eq(4)
  )
  it("3 args", function():
    xs = range(0, 10, 2)
    expect(xs).to_have_length(5)
    expect(xs[0]).to_eq(0)
    expect(xs[4]).to_eq(8)
  )
  it("negative step", function():
    xs = range(10, 0, -3)
    expect(xs).to_have_length(4)
    expect(xs[0]).to_eq(10)
    expect(xs[1]).to_eq(7)
    expect(xs[2]).to_eq(4)
    expect(xs[3]).to_eq(1)
  )
)

describe("Some / Option", function():
  it("Some wraps value", function():
    x = Some(42)
    expect(x).to_be_some()
  )
  it("None is none", function():
    x: Option<int> = None
    expect(x).to_be_none()
  )
)
