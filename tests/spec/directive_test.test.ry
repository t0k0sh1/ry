from testing import it, describe, expect, each, property

# Tests for @it and @describe directive syntax on named functions (#634)

# Basic @it on a named function
@it("should add 1 + 2 = 3")
fn testAdd():
  expect(1 + 2).toEq(3)

@it("should concatenate strings")
fn testStrConcat():
  expect("hello" + " " + "world").toEq("hello world")

@it("should evaluate boolean logic")
fn testBool():
  expect(true and false).toBeFalse()

# @describe wrapping named functions with nested @it
@describe("arithmetic")
fn arithmeticTests():
  @it("should subtract")
  fn testSub():
    expect(10 - 3).toEq(7)

  @it("should multiply")
  fn testMul():
    expect(4 * 5).toEq(20)

# @each with @it on a named function
@each([(1, 2, 3), (0, 0, 0), (-1, 1, 0)])
@it("should add {0} + {1} = {2}")
fn testAddEach(a: int, b: int, expected: int):
  expect(a + b).toEq(expected)

@each([("hello", 5), ("", 0), ("ry", 2)])
@it("should have length of \"{0}\" equal to {1}")
fn testLengthEach(s: str, expected: int):
  expect(len(s)).toEq(expected)

# @property with @it on a named function
@property(count=100)
@it("should verify addition is commutative")
fn testAddCommutative(a: int, b: int):
  expect(a + b).toEq(b + a)

@property(count=50)
@it("should verify double is always even")
fn testDoubleEven(n: int):
  expect(n * 2 % 2).toEq(0)

# @describe with shared setup: variables declared in describe body captured by @it (#635)
@describe("shared setup")
fn sharedSetupTests():
  base = 100
  offset = 5

  @it("should use base value")
  fn testBase():
    expect(base).toEq(100)

  @it("should use both base and offset")
  fn testCombined():
    expect(base + offset).toEq(105)

# Nested @describe indentation (#635)
@describe("outer group")
fn outerGroup():
  @describe("inner group")
  fn innerGroup():
    @it("should pass deeply nested test")
    fn testDeep():
      expect(1 + 1).toEq(2)
