describe("cancel", fn():
  it("cancel on completed task is a no-op", fn():
    fn add(a: int, b: int) -> int:
      return a + b
    t: Task<int> = spawn add(1, 2)
    result = join(t)
    expect(result).to_eq(3)
  )

  it("is_cancelled returns false outside a task", fn():
    expect(is_cancelled()).to_eq(false)
  )

  it("is_cancelled returns true inside a cancelled task", fn():
    async fn poll_cancel() -> bool:
      found = false
      for i in range(100000):
        if is_cancelled():
          found = true
          break
      return found
    t: Task<bool> = poll_cancel()
    cancel(t)
    result = join(t)
    expect(result).to_be_true()
  )

  it("cancel interrupts sleep and join returns zero value", fn():
    async fn long_sleep() -> int:
      sleep(60000)
      return 42
    t: Task<int> = long_sleep()
    sleep(50)
    cancel(t)
    result = join(t)
    expect(result).to_eq(0)
  )
)
