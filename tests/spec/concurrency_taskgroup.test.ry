describe("task_group", fn():
  it("joins all spawned tasks via join", fn():
    fn compute(x: int) -> int:
      return x * 10
    task_group(fn():
      t1 = spawn compute(3)
      t2 = spawn compute(4)
      r = join(t1) + join(t2)
      expect(r).to_eq(70)
    )
  )

  it("auto-joins tasks at scope exit", fn():
    ch: Channel<int> = channel[int](2)
    fn send_value(ch: Channel<int>, v: int) -> int:
      send(ch, v)
      return v
    task_group(fn():
      t1 = spawn send_value(ch, 10)
      t2 = spawn send_value(ch, 20)
    )
    close(ch)
    total = 0
    for x in ch:
      total = total + x
    expect(total).to_eq(30)
  )

  it("works with channels", fn():
    ch: Channel<int> = channel[int](3)
    fn send_to_ch(ch: Channel<int>, v: int) -> int:
      send(ch, v)
      return v
    task_group(fn():
      t1 = spawn send_to_ch(ch, 10)
      t2 = spawn send_to_ch(ch, 20)
      t3 = spawn send_to_ch(ch, 30)
    )
    close(ch)
    total = 0
    for x in ch:
      total = total + x
    expect(total).to_eq(60)
  )
)
