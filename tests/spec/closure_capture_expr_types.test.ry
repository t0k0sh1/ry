describe("closure capture — SetExpr", ():
  it("should capture variable used in set literal element", ():
    fn makeSetBuilder(x: str) -> fn() -> int:
      fn build() -> int:
        s = {x, "b", "c"}
        return s.len()
      return build

    f = makeSetBuilder("a")
    expect(f()).to_eq(3)
  )
)

describe("closure capture — CastExpr", ():
  it("should capture variable used in cast expression", ():
    fn makeCaster(x: int) -> fn() -> float:
      fn castIt() -> float:
        return x as float
      return castIt

    f = makeCaster(42)
    expect(f()).to_eq(42.0)
  )
)

describe("closure capture — WhenCondExpr", ():
  it("should capture variable in when expression condition", ():
    fn makeClassifier(threshold: int) -> fn(int) -> str:
      fn classify(x: int) -> str:
        return case:
          x > threshold : "big"
          _ : "small"
      return classify

    f = makeClassifier(10)
    expect(f(20)).to_eq("big")
    expect(f(5)).to_eq("small")
  )

  it("should capture variable in when expression value", ():
    fn makeLabeler(label: str) -> fn(bool) -> str:
      fn labelize(flag: bool) -> str:
        return case:
          flag : label
          _ : "none"
      return labelize

    f = makeLabeler("yes")
    expect(f(true)).to_eq("yes")
    expect(f(false)).to_eq("none")
  )

  it("should capture variable in when expression else branch", ():
    fn makeFallback(defaultVal: str) -> fn(bool) -> str:
      fn pick(flag: bool) -> str:
        return case:
          flag : "active"
          _ : defaultVal
      return pick

    f = makeFallback("inactive")
    expect(f(false)).to_eq("inactive")
  )
)

describe("closure capture — MatchExpr", ():
  it("should capture variable in match expression arm value", ():
    fn makeMatcher(fallback: str) -> fn(int) -> str:
      fn doMatch(x: int) -> str:
        return case x:
          1 : "one"
          _ : fallback
      return doMatch

    f = makeMatcher("other")
    expect(f(1)).to_eq("one")
    expect(f(99)).to_eq("other")
  )

  it("should capture variable in match expression guard", ():
    fn makeGuardMatcher(limit: int) -> fn(int) -> str:
      fn doMatch(x: int) -> str:
        return case x:
          n if n > limit : "above"
          _ : "below"
      return doMatch

    f = makeGuardMatcher(50)
    expect(f(100)).to_eq("above")
    expect(f(10)).to_eq("below")
  )

  it("should capture variable used as match subject", ():
    fn makeSubjectMatcher(val: int) -> fn() -> str:
      fn doMatch() -> str:
        return case val:
          1 : "one"
          2 : "two"
          _ : "other"
      return doMatch

    f = makeSubjectMatcher(2)
    expect(f()).to_eq("two")
  )
)

describe("closure capture — RangeExpr", ():
  it("should capture variable used as range end bound", ():
    fn makeSummer(n: int) -> fn() -> int:
      fn sumUp() -> int:
        total = 0
        for i in 1..n:
          total = total + i
        return total
      return sumUp

    f = makeSummer(4)
    expect(f()).to_eq(10)
  )

  it("should capture variable used as range start bound", ():
    fn makeRangeSummer(start: int) -> fn() -> int:
      fn sumUp() -> int:
        total = 0
        for i in start..4:
          total = total + i
        return total
      return sumUp

    f = makeRangeSummer(2)
    expect(f()).to_eq(9)
  )
)

describe("closure capture — ErrorPropagateExpr", ():
  fn safeDivide(a: int, b: int) -> Result<int, Error>:
    if b == 0:
      return Err(Error("division by zero"))
    return Ok(a // b)

  it("should capture variable used with ? operator", ():
    fn makeDivider(divisor: int) -> fn(int) -> Result<int, Error>:
      fn doDivide(x: int) -> Result<int, Error>:
        result = safeDivide(x, divisor)?
        return Ok(result)
      return doDivide

    f = makeDivider(2)
    case f(10):
      Ok(v):
        expect(v).to_eq(5)
      Err(e):
        expect(true).to_eq(false)
  )
)

describe("closure capture — WeakExpr", ():
  it("should capture variable used in weak expression", ():
    fn makeWeakener(xs: List<int>) -> fn() -> bool:
      fn weaken() -> bool:
        w: weak List<int> = weak xs
        case w:
          Some(v):
            return true
          None:
            return false
      return weaken

    data = [1, 2, 3]
    f = makeWeakener(data)
    expect(f()).to_eq(true)
  )
)
