from testing import it, describe

@describe("closure capture — SetExpr")
fn closureCaptureSetexprTests():
  @it("should capture variable used in set literal element")
  fn shouldCaptureVariableUsedInSetLiteralElement():
    fn makeSetBuilder(x: str) -> fn() -> int:
      fn build() -> int:
        s = {x, "b", "c"}
        return s.len()
      return build

    f = makeSetBuilder("a")
    expect(f()).toEq(3)

@describe("closure capture — CastExpr")
fn closureCaptureCastexprTests():
  @it("should capture variable used in cast expression")
  fn shouldCaptureVariableUsedInCastExpression():
    fn makeCaster(x: int) -> fn() -> float:
      fn castIt() -> float:
        return x as float
      return castIt

    f = makeCaster(42)
    expect(f()).toEq(42.0)

@describe("closure capture — WhenCondExpr")
fn closureCaptureWhencondexprTests():
  @it("should capture variable in when expression condition")
  fn shouldCaptureVariableInWhenExpressionCondition():
    fn makeClassifier(threshold: int) -> fn(int) -> str:
      fn classify(x: int) -> str:
        return case:
          x > threshold : "big"
          _ : "small"
      return classify

    f = makeClassifier(10)
    expect(f(20)).toEq("big")
    expect(f(5)).toEq("small")

  @it("should capture variable in when expression value")
  fn shouldCaptureVariableInWhenExpressionValue():
    fn makeLabeler(label: str) -> fn(bool) -> str:
      fn labelize(flag: bool) -> str:
        return case:
          flag : label
          _ : "none"
      return labelize

    f = makeLabeler("yes")
    expect(f(true)).toEq("yes")
    expect(f(false)).toEq("none")

  @it("should capture variable in when expression else branch")
  fn shouldCaptureVariableInWhenExpressionElseBranch():
    fn makeFallback(defaultVal: str) -> fn(bool) -> str:
      fn pick(flag: bool) -> str:
        return case:
          flag : "active"
          _ : defaultVal
      return pick

    f = makeFallback("inactive")
    expect(f(false)).toEq("inactive")

@describe("closure capture — MatchExpr")
fn closureCaptureMatchexprTests():
  @it("should capture variable in match expression arm value")
  fn shouldCaptureVariableInMatchExpressionArmValue():
    fn makeMatcher(fallback: str) -> fn(int) -> str:
      fn doMatch(x: int) -> str:
        return case x:
          1 : "one"
          _ : fallback
      return doMatch

    f = makeMatcher("other")
    expect(f(1)).toEq("one")
    expect(f(99)).toEq("other")

  @it("should capture variable in match expression guard")
  fn shouldCaptureVariableInMatchExpressionGuard():
    fn makeGuardMatcher(limit: int) -> fn(int) -> str:
      fn doMatch(x: int) -> str:
        return case x:
          n if n > limit : "above"
          _ : "below"
      return doMatch

    f = makeGuardMatcher(50)
    expect(f(100)).toEq("above")
    expect(f(10)).toEq("below")

  @it("should capture variable used as match subject")
  fn shouldCaptureVariableUsedAsMatchSubject():
    fn makeSubjectMatcher(val: int) -> fn() -> str:
      fn doMatch() -> str:
        return case val:
          1 : "one"
          2 : "two"
          _ : "other"
      return doMatch

    f = makeSubjectMatcher(2)
    expect(f()).toEq("two")

@describe("closure capture — RangeExpr")
fn closureCaptureRangeexprTests():
  @it("should capture variable used as range end bound")
  fn shouldCaptureVariableUsedAsRangeEndBound():
    fn makeSummer(n: int) -> fn() -> int:
      fn sumUp() -> int:
        total = 0
        for i in 1..n:
          total = total + i
        return total
      return sumUp

    f = makeSummer(4)
    expect(f()).toEq(10)

  @it("should capture variable used as range start bound")
  fn shouldCaptureVariableUsedAsRangeStartBound():
    fn makeRangeSummer(start: int) -> fn() -> int:
      fn sumUp() -> int:
        total = 0
        for i in start..4:
          total = total + i
        return total
      return sumUp

    f = makeRangeSummer(2)
    expect(f()).toEq(9)

@describe("closure capture — ErrorPropagateExpr")
fn closureCaptureErrorpropagateexprTests():
  fn safeDivide(a: int, b: int) -> Result<int, Error>:
    if b == 0:
      return Err(Error("division by zero"))
    return Ok(a // b)

  @it("should capture variable used with ? operator")
  fn shouldCaptureVariableUsedWithOperator():
    fn makeDivider(divisor: int) -> fn(int) -> Result<int, Error>:
      fn doDivide(x: int) -> Result<int, Error>:
        result = safeDivide(x, divisor)?
        return Ok(result)
      return doDivide

    f = makeDivider(2)
    case f(10):
      Ok(v):
        expect(v).toEq(5)
      Err(e):
        expect(true).toEq(false)

@describe("closure capture — WeakExpr")
fn closureCaptureWeakexprTests():
  @it("should capture variable used in weak expression")
  fn shouldCaptureVariableUsedInWeakExpression():
    fn makeWeakener(xs: List<int>) -> fn() -> bool:
      fn weaken() -> bool:
        w: weak List<int> = weak xs
        case w:
          Some(v):
            return true
          None:
            return false
      return weaken

    data = [1, 2, 3]
    f = makeWeakener(data)
    expect(f()).toEq(true)
