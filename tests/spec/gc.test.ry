from testing import it, describe, expect

from gc import collect, enable, disable, setThreshold

@describe("Cycle Collector")
fn cycleCollectorTests():
  @it("should return 0 when no cycles exist")
  fn shouldReturn0WhenNoCyclesExist():
    n = collect()
    expect(n).toEq(0)

  @it("should not crash when calling gc.enable and gc.disable")
  fn shouldNotCrashWhenCallingGcEnableAndGcDisable():
    disable()
    enable()
    n = collect()
    expect(n).toEq(0)

  @it("should not crash when calling gc.setThreshold")
  fn shouldNotCrashWhenCallingGcSetthreshold():
    setThreshold(1000)
    setThreshold(700)

  @it("should return int from gc.collect")
  fn shouldReturnIntFromGcCollect():
    result = collect()
    expect(result >= 0).toEq(true)
