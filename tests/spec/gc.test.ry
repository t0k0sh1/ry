from gc import collect, enable, disable, set_threshold

describe("Cycle Collector", fn():
  it("gc.collect returns 0 when no cycles exist", fn():
    n = collect()
    expect(n).to_eq(0)
  )

  it("gc.enable and gc.disable do not crash", fn():
    disable()
    enable()
    n = collect()
    expect(n).to_eq(0)
  )

  it("gc.set_threshold does not crash", fn():
    set_threshold(1000)
    set_threshold(700)
  )

  it("gc.collect returns int", fn():
    result = collect()
    expect(result >= 0).to_eq(true)
  )
)
