from testing import it, describe

@describe("trailing commas")
fn trailingCommasTests():
  @it("list literal - multiple elements with trailing comma")
  fn listLiteralMultipleElementsWithTrailingComma():
    xs = [1, 2, 3,]
    expect(xs).toHaveLen(3)
    expect(xs[0]).toEq(1)
    expect(xs[2]).toEq(3)
  @it("list literal - single element with trailing comma")
  fn listLiteralSingleElementWithTrailingComma():
    xs = [42,]
    expect(xs).toHaveLen(1)
    expect(xs[0]).toEq(42)
  @it("list literal - multi-line with trailing comma")
  fn listLiteralMultiLineWithTrailingComma():
    xs = [
      10,
      20,
      30,
    ]
    expect(xs).toHaveLen(3)
    expect(xs[1]).toEq(20)
  @it("map literal - trailing comma")
  fn mapLiteralTrailingComma():
    m = {"a": 1, "b": 2,}
    expect(m["a"]).toEq(1)
    expect(m["b"]).toEq(2)
  @it("map literal - single entry with trailing comma")
  fn mapLiteralSingleEntryWithTrailingComma():
    m = {"x": 99,}
    expect(m["x"]).toEq(99)
  @it("set literal - trailing comma")
  fn setLiteralTrailingComma():
    s = {1, 2, 3,}
    expect(1 in s).toEq(true)
    expect(3 in s).toEq(true)
    expect(4 in s).toEq(false)
  @it("set literal - single element with trailing comma")
  fn setLiteralSingleElementWithTrailingComma():
    s = {7,}
    expect(7 in s).toEq(true)
  @it("function call - trailing comma")
  fn functionCallTrailingComma():
    fn add(a: int, b: int) -> int:
      return a + b
    result = add(3, 4,)
    expect(result).toEq(7)
  @it("function declaration - trailing comma in params")
  fn functionDeclarationTrailingCommaInParams():
    fn mul(a: int, b: int,) -> int:
      return a * b
    expect(mul(3, 4)).toEq(12)
  @it("lambda - trailing comma in params")
  fn lambdaTrailingCommaInParams():
    f = (a: int, b: int,) => a + b
    expect(f(5, 6)).toEq(11)
  @it("record constructor - trailing comma")
  fn recordConstructorTrailingComma():
    record Point:
      x: int
      y: int
    p = Point(1, 2,)
    expect(p.x).toEq(1)
    expect(p.y).toEq(2)
  @it("ADT enum variant constructor - trailing comma")
  fn adtEnumVariantConstructorTrailingComma():
    enum Shape:
      Circle(float)
      Rect(float, float)
    s = Shape::Circle(5.0,)
    case s:
      Shape::Circle(r):
        expect(r).toEq(5.0)
      Shape::Rect(_, _):
        expect(false).toEq(true)
  @it("tuple - trailing comma still works (regression)")
  fn tupleTrailingCommaStillWorksRegression():
    t = (1, 2, 3,)
    expect(t.0).toEq(1)
    expect(t.2).toEq(3)
