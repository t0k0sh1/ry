from ry.testing import it, describe, expect, fail

@describe("f-string")
fn fStringTests():
  @it("should interpolate int in f-string")
  fn shouldInterpolateIntInFString():
    x = 42
    expect(f"value: {x}").toEq("value: 42")
  @it("should interpolate float in f-string")
  fn shouldInterpolateFloatInFString():
    x = 3.14
    expect(f"pi: {x}").toEq("pi: 3.14")
  @it("should interpolate bool in f-string")
  fn shouldInterpolateBoolInFString():
    x = true
    expect(f"flag: {x}").toEq("flag: true")
  @it("should interpolate expression in f-string")
  fn shouldInterpolateExpressionInFString():
    a = 1
    b = 2
    expect(f"{a} + {b} = {a + b}").toEq("1 + 2 = 3")
  @it("should support escaped braces")
  fn shouldSupportEscapedBraces():
    expect("{braces}").toEq("{braces}")

@describe("string auto concat edge cases")
fn stringAutoConcatEdgeCasesTests():
  @it("should concatenate empty string with int")
  fn shouldConcatenateEmptyStringWithInt():
    expect("" + 0).toEq("0")
  @it("should concatenate empty string with bool")
  fn shouldConcatenateEmptyStringWithBool():
    expect("" + true).toEq("true")
  @it("should concatenate empty string with float")
  fn shouldConcatenateEmptyStringWithFloat():
    expect("" + 3.14).toEq("3.14")

@describe("type cast as")
fn typeCastAsTests():
  @it("should cast int to float")
  fn shouldCastIntToFloat():
    expect(42 as float).toEq(42.0)
  @it("should cast float to int")
  fn shouldCastFloatToInt():
    expect(3.14 as int).toEq(3)
  @it("should cast int to bool")
  fn shouldCastIntToBool():
    expect(1 as bool).toBeTrue()
    expect(0 as bool).toBeFalse()
  @it("should cast int to str")
  fn shouldCastIntToStr():
    expect(42 as str).toEq("42")
  @it("should cast u8 to int")
  fn shouldCastU8ToInt():
    b: u8 = 200
    expect(b as int).toEq(200)
  @it("should cast int to u8 and back to int")
  fn shouldCastIntToU8AndBackToInt():
    b = 255 as u8
    expect(b as int).toEq(255)
  @it("should truncate negative float to int toward zero")
  fn shouldTruncateNegativeFloatToIntTowardZero():
    expect(-3.7 as int).toEq(-3)
  @it("should cast negative half to int")
  fn shouldCastNegativeHalfToInt():
    expect(-0.5 as int).toEq(0)
  @it("should cast zero float to int")
  fn shouldCastZeroFloatToInt():
    expect(0.0 as int).toEq(0)
  @it("should cast one float to int")
  fn shouldCastOneFloatToInt():
    expect(1.0 as int).toEq(1)
  @it("should cast true bool to int")
  fn shouldCastTrueBoolToInt():
    expect(true as int).toEq(1)
  @it("should cast false bool to int")
  fn shouldCastFalseBoolToInt():
    expect(false as int).toEq(0)

@describe("type alias")
fn typeAliasTests():
  @it("should support basic alias")
  fn shouldSupportBasicAlias():
    type Meters = float
    d: Meters = 3.14
    expect(d).toEq(3.14)

  @it("should support primitive union via alias (2 members)")
  fn shouldSupportPrimitiveUnionViaAlias2Members():
    type Pair = int | str
    x: Pair = 42
    expect(str(x)).toEq("42")
    y: Pair = "hello"
    expect(str(y)).toEq("hello")

  @it("should support primitive union via alias (3 members)")
  fn shouldSupportPrimitiveUnionViaAlias3Members():
    type Simple = int | str | bool
    x: Simple = 42
    expect(str(x)).toEq("42")
    y: Simple = "hi"
    expect(str(y)).toEq("hi")
    z: Simple = true
    expect(str(z)).toEq("true")

  @it("should support int | float union via alias")
  fn shouldSupportIntFloatUnionViaAlias():
    type Num = int | float
    x: Num = 10
    expect(str(x)).toEq("10")
    y: Num = 2.5
    expect(str(y)).toEq("2.5")

@describe("nested type alias unions")
fn nestedTypeAliasUnionsTests():
  @it("should flatten a one-level nested alias (A | bool where A = int | str)")
  fn shouldFlattenAOneLevelNestedAliasABoolWhereAIntStr():
    type NA1 = int | str
    type NB1 = NA1 | bool
    x: NB1 = 42
    expect(str(x)).toEq("42")
    y: NB1 = "hello"
    expect(str(y)).toEq("hello")
    z: NB1 = true
    expect(str(z)).toEq("true")

  @it("should flatten a two-level nested alias (C = B | float where B = A | bool)")
  fn shouldFlattenATwoLevelNestedAliasCBFloatWhereBABool():
    type NA2 = int | str
    type NB2 = NA2 | bool
    type NC2 = NB2 | float
    a: NC2 = 1
    expect(str(a)).toEq("1")
    b: NC2 = "x"
    expect(str(b)).toEq("x")
    c: NC2 = false
    expect(str(c)).toEq("false")
    d: NC2 = 3.5
    expect(str(d)).toEq("3.5")

  @it("should dedupe overlapping members when nesting")
  fn shouldDedupeOverlappingMembersWhenNesting():
    type NA3 = int | str
    type NB3 = NA3 | int
    x: NB3 = 7
    expect(str(x)).toEq("7")
    y: NB3 = "dup"
    expect(str(y)).toEq("dup")

  @it("should dedupe a member reached via multiple alias paths")
  fn shouldDedupeAMemberReachedViaMultipleAliasPaths():
    type NA4 = int | str
    type NB4 = NA4 | bool
    type NC4 = NB4 | NA4
    x: NC4 = 42
    expect(str(x)).toEq("42")
    y: NC4 = "hi"
    expect(str(y)).toEq("hi")
    z: NC4 = true
    expect(str(z)).toEq("true")

  @it("should terminate on mutually-cyclic union aliases and flatten reachable leaves")
  fn shouldTerminateOnMutuallyCyclicUnionAliasesAndFlattenReachableLeaves():
    type NcycA = NcycB | int
    type NcycB = NcycA | str
    x: NcycA = 1
    expect(str(x)).toEq("1")
    y: NcycA = "ok"
    expect(str(y)).toEq("ok")

type TaVal = int | str

fn taShow(v: TaVal) -> str:
  return str(v)

fn taChoose(b: bool) -> TaVal:
  if b:
    return 42
  return "zero"

@describe("type alias union in functions")
fn typeAliasUnionInFunctionsTests():
  @it("should support union alias in function parameter")
  fn shouldSupportUnionAliasInFunctionParameter():
    expect(taShow(7)).toEq("7")
    expect(taShow("abc")).toEq("abc")

  @it("should support union alias in function return")
  fn shouldSupportUnionAliasInFunctionReturn():
    expect(str(taChoose(true))).toEq("42")
    expect(str(taChoose(false))).toEq("zero")

record TaPoint:
  x: int
  y: int

record TaName:
  value: str

type TaShape = TaPoint | TaName

@describe("type alias union of records")
fn typeAliasUnionOfRecordsTests():
  @it("should support record union via alias")
  fn shouldSupportRecordUnionViaAlias():
    a: TaShape = TaPoint(1, 2)
    expect(str(a)).toEq("TaPoint(x: 1, y: 2)")
    b: TaShape = TaName("hello")
    expect(str(b)).toEq("TaName(value: \"hello\")")

type NtaInner = int | str
type NtaOuter = NtaInner | bool

fn ntaShow(v: NtaOuter) -> str:
  return str(v)

fn ntaChoose(k: int) -> NtaOuter:
  if k == 0:
    return 42
  if k == 1:
    return "hi"
  return true

@describe("nested type alias union in functions")
fn nestedTypeAliasUnionInFunctionsTests():
  @it("should support nested union alias in function parameter")
  fn shouldSupportNestedUnionAliasInFunctionParameter():
    expect(ntaShow(7)).toEq("7")
    expect(ntaShow("abc")).toEq("abc")
    expect(ntaShow(false)).toEq("false")

  @it("should support nested union alias in function return")
  fn shouldSupportNestedUnionAliasInFunctionReturn():
    expect(str(ntaChoose(0))).toEq("42")
    expect(str(ntaChoose(1))).toEq("hi")
    expect(str(ntaChoose(2))).toEq("true")

record NtRecA:
  x: int

record NtRecB:
  y: str

record NtRecC:
  z: float

type NtrInner = NtRecA | NtRecB
type NtrOuter = NtrInner | NtRecC

@describe("nested type alias union of records")
fn nestedTypeAliasUnionOfRecordsTests():
  @it("should flatten nested record union alias")
  fn shouldFlattenNestedRecordUnionAlias():
    a: NtrOuter = NtRecA(1)
    expect(str(a)).toEq("NtRecA(x: 1)")
    b: NtrOuter = NtRecB("yo")
    expect(str(b)).toEq("NtRecB(y: \"yo\")")
    c: NtrOuter = NtRecC(2.5)
    expect(str(c)).toEq("NtRecC(z: 2.5)")

@describe("Error type")
fn errorTypeTests():
  @it("should construct Error with message")
  fn shouldConstructErrorWithMessage():
    e = Error("something went wrong")
    expect(e.message).toEq("something went wrong")
    expect(e.code).toEq(0)
  @it("should construct Error with code")
  fn shouldConstructErrorWithCode():
    e = Error("not found", 404)
    expect(e.message).toEq("not found")
    expect(e.code).toEq(404)

@describe("Result type")
fn resultTypeTests():
  fn safeDivide(a: int, b: int) -> Result<int, Error>:
    if b == 0:
      return Err(Error("division by zero"))
    return Ok(a // b)
  @it("should return Ok on success")
  fn shouldReturnOkOnSuccess():
    res = safeDivide(10, 2)
    case res:
      Ok(v):
        expect(v).toEq(5)
      Err(e):
        fail("unexpected error: " + e.message)
  @it("should return Err on failure")
  fn shouldReturnErrOnFailure():
    res = safeDivide(10, 0)
    case res:
      Ok(v):
        fail("expected Err but got Ok")
      Err(e):
        expect(e.message).toEq("division by zero")

fn acceptUnion(x: int | str) -> bool:
  return true

@describe("union type")
fn unionTypeTests():
  @it("should accept int")
  fn shouldAcceptInt():
    expect(acceptUnion(42)).toBeTrue()
  @it("should accept str")
  fn shouldAcceptStr():
    expect(acceptUnion("hello")).toBeTrue()
