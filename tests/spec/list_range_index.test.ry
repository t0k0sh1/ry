from testing import it, describe

from runtime_internal import arcLiveCount

@describe("list range-index lst[a..b] (#1184)")
fn listRangeIndexLstAB1184Tests():
  @it("basic inclusive subrange [1..3] on [1,2,3,4,5]")
  fn basicInclusiveSubrange13On12345():
    xs = [1, 2, 3, 4, 5]
    ys = xs[1..3]
    expect(ys).toHaveLen(3)
    expect(ys[0]).toEq(2)
    expect(ys[1]).toEq(3)
    expect(ys[2]).toEq(4)
  @it("single-element [2..2] returns [3]")
  fn singleElement22Returns3():
    xs = [1, 2, 3, 4, 5]
    ys = xs[2..2]
    expect(ys).toHaveLen(1)
    expect(ys[0]).toEq(3)
  @it("full range [0..4] equals copy of list")
  fn fullRange04EqualsCopyOfList():
    xs = [10, 20, 30, 40, 50]
    ys = xs[0..4]
    expect(ys).toHaveLen(5)
    expect(ys[0]).toEq(10)
    expect(ys[4]).toEq(50)
  @it("negative wrap [-3..-1] on [1,2,3,4,5] returns [3,4,5]")
  fn negativeWrap31On12345Returns345():
    xs = [1, 2, 3, 4, 5]
    ys = xs[-3..-1]
    expect(ys).toHaveLen(3)
    expect(ys[0]).toEq(3)
    expect(ys[1]).toEq(4)
    expect(ys[2]).toEq(5)
  @it("mixed negative/positive bounds [-4..3] returns [2,3,4]")
  fn mixedNegativePositiveBounds43Returns234():
    xs = [1, 2, 3, 4, 5]
    ys = xs[-4..3]
    expect(ys).toHaveLen(3)
    expect(ys[0]).toEq(2)
    expect(ys[2]).toEq(4)
  @it("empty range (start > end after wrap) returns []")
  fn emptyRangeStartEndAfterWrapReturns():
    xs = [1, 2, 3, 4, 5]
    ys = xs[3..1]
    expect(ys).toHaveLen(0)
  @it("out-of-bounds upper bound is clamped")
  fn outOfBoundsUpperBoundIsClamped():
    xs = [1, 2, 3]
    ys = xs[1..100]
    expect(ys).toHaveLen(2)
    expect(ys[0]).toEq(2)
    expect(ys[1]).toEq(3)
  @it("out-of-bounds lower bound is clamped to 0")
  fn outOfBoundsLowerBoundIsClampedTo0():
    xs = [1, 2, 3]
    ys = xs[-100..1]
    expect(ys).toHaveLen(2)
    expect(ys[0]).toEq(1)
    expect(ys[1]).toEq(2)
  @it("range over List<str> preserves element type")
  fn rangeOverListStrPreservesElementType():
    xs = ["a", "b", "c", "d"]
    ys = xs[1..2]
    expect(ys).toHaveLen(2)
    expect(ys[0]).toEq("b")
    expect(ys[1]).toEq("c")
  @it("range over List<List<int>> preserves nested element metadata (#1205)")
  fn rangeOverListListIntPreservesNestedElementMetadata1205():
    xs = [[1, 2], [3, 4], [5, 6]]
    ys = xs[0..1]
    expect(ys).toHaveLen(2)
    expect(ys[0][0]).toEq(1)
    expect(ys[1][1]).toEq(4)
  @it("range over List<Map<str,int>> preserves map value access (#1205)")
  fn rangeOverListMapStrIntPreservesMapValueAccess1205():
    xs: List<Map<str, int>> = [{"a": 1}, {"b": 2}, {"c": 3}]
    ys = xs[0..1]
    expect(ys).toHaveLen(2)
    expect(ys[0]["a"]).toEq(1)
    expect(ys[1]["b"]).toEq(2)
  @it("range over List<function> preserves closure invocation (#1205)")
  fn rangeOverListFunctionPreservesClosureInvocation1205():
    xs: List<fn(int) -> int> = [(x: int) => x + 1, (x: int) => x * 2]
    ys = xs[0..0]
    expect(ys).toHaveLen(1)
    f = ys[0]
    expect(f(5)).toEq(6)
  @it("consistency with slice: lst[a..b] == slice(lst, a, b+1) for non-negatives")
  fn consistencyWithSliceLstABSliceLstAB1ForNonNegatives():
    xs = [10, 20, 30, 40, 50]
    a = xs[1..3]
    b = slice(xs, 1, 4)
    expect(a).toHaveLen(3)
    expect(b).toHaveLen(3)
    expect(a[0]).toEq(b[0])
    expect(a[1]).toEq(b[1])
    expect(a[2]).toEq(b[2])

# Dynamic strings ("a" + "b") force heap allocation so the refcount actually
# drops to zero when the source is released — otherwise literal interning
# would mask any missing retain.
@describe("list range-index ARC retain (#1204)")
fn listRangeIndexArcRetain1204Tests():
  @it("List<str> slice retains str elements after source drop")
  fn listStrSliceRetainsStrElementsAfterSourceDrop():
    xs: List<str> = ["alpha" + "x", "beta" + "y", "gamma" + "z"]
    ys = xs[0..1]
    xs = ["dropped"]
    expect(ys[0]).toEq("alphax")
    expect(ys[1]).toEq("betay")

  @it("slice(xs, 0, 2) retains str elements after source drop")
  fn sliceXs02RetainsStrElementsAfterSourceDrop():
    xs: List<str> = ["foo" + "1", "bar" + "2", "baz" + "3"]
    ys = slice(xs, 0, 2)
    xs = ["dropped"]
    expect(ys[0]).toEq("foo1")
    expect(ys[1]).toEq("bar2")

  @it("List<List<int>> slice retains inner lists after source drop")
  fn listListIntSliceRetainsInnerListsAfterSourceDrop():
    xs: List<List<int>> = [[1, 2], [3, 4], [5, 6]]
    ys = xs[0..1]
    xs = [[99]]
    expect(ys).toHaveLen(2)

  @it("List<Map<str, int>> slice retains map values after source drop")
  fn listMapStrIntSliceRetainsMapValuesAfterSourceDrop():
    xs: List<Map<str, int>> = [{"a": 1}, {"b": 2}, {"c": 3}]
    ys = xs[0..1]
    xs = [{"z": 999}]
    expect(len(ys)).toEq(2)

  @it("empty slice of List<str> does not retain anything")
  fn emptySliceOfListStrDoesNotRetainAnything():
    xs: List<str> = ["a", "b", "c"]
    ys = xs[2..1]
    expect(ys).toHaveLen(0)

  # Differential leak test: compares arcLiveCount growth with and without
  # slicing across the same 16-iteration loop shape.  If emitListSlice added a
  # retain without a matching release (e.g. destructor fails to resolve the
  # element type), the overhead would grow roughly 2 headers per iteration
  # (= ~32 at N=16).  Symmetric retain/release keeps overhead a small constant.
  @it("slice does not leak per iteration on List<List<int>>")
  fn sliceDoesNotLeakPerIterationOnListListInt():
    baseBefore = arcLiveCount()
    xsBaseline: List<List<int>> = [[0]]
    i = 0
    while i < 16:
      xsBaseline = [[1, 2], [3, 4], [5, 6]]
      i = i + 1
    baseDelta = arcLiveCount() - baseBefore

    sliceBefore = arcLiveCount()
    xsSlice: List<List<int>> = [[0]]
    ysSlice: List<List<int>> = [[0]]
    j = 0
    while j < 16:
      xsSlice = [[1, 2], [3, 4], [5, 6]]
      ysSlice = xsSlice[0..1]
      j = j + 1
    sliceDelta = arcLiveCount() - sliceBefore

    expect(sliceDelta - baseDelta < 10).toEq(true)
