from testing import it, describe

from runtime_internal import arcLiveCount

# Post-#1576 delta semantics: makeString now contributes +1 per str element to
# arcLiveCount(), and the str-aware destructor releases each str element when
# the List<str> is freed. So `split("abc", "")` contributes +4 to the counter
# (1 list header + 3 str elements), and overwriting the slot releases the
# previous list+strings symmetrically — only the final split's allocations
# remain live. Pre-#1576 baseline of +1 reflected the counter-asymmetric era
# where str allocations were uncounted; both regimes correctly assert
# "no leak from overwrite".

@describe("__ry_split_chars ARC correctness (#1010)")
fn rySplitCharsArcCorrectness1010Tests():
  @it("split(s, \"\") — overwrite releases previous list and its str elements")
  fn splitSOverwriteReleasesPreviousListAndItsStrElements():
    before = arcLiveCount()
    cs: List<str> = split("abc", "")
    cs = split("def", "")
    cs = split("ghi", "")
    cs = split("jkl", "")
    after = arcLiveCount()
    # 1 list + 3 str elements from the final split still live
    expect(after - before).toEq(4)

  @it("split(unicode, \"\") — ARC retain works for multi-byte chars")
  fn splitUnicodeArcRetainWorksForMultiByteChars():
    before = arcLiveCount()
    cs: List<str> = split("あいう", "")
    expect(cs).toHaveLen(3)
    after = arcLiveCount()
    # 1 list + 3 str elements
    expect(after - before).toEq(4)

  # #1576 untyped destructuring regression — `parts = split(...)` with no
  # `List<str>` annotation must still emit str-aware retain on `a, b = parts`
  # (FileCheck-level discriminant). Behavioral leak symmetry: the source
  # rebind releases the previous list and its str elements; the destructure
  # retains str_elem on the loaded values, so `a` and `b` survive.
  @it("split() untyped — destructure + rebind does not leak")
  fn splitUntypedDestructureRebindDoesNotLeak():
    before = arcLiveCount()
    parts = split("aa bb", " ")
    a, b = parts
    parts = split("cc dd", " ")
    after = arcLiveCount()
    # Live ARC headers afterwards:
    #  - new `parts` (1 list + 2 str elements = 3)
    #  - retained `a` and `b` str handles (2)
    # Total: 5
    expect(after - before).toEq(5)
    expect(a).toEq("aa")
    expect(b).toEq("bb")
