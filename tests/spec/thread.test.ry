from thread import thread_spawn, thread_join, lock_new, lock_acquire, lock_release, rwlock_new, rwlock_read_lock, rwlock_write_lock, rwlock_unlock, semaphore_new, semaphore_acquire, semaphore_release, barrier_new, barrier_wait, atomic_int_new, atomic_int_load, atomic_int_store, atomic_int_add, atomic_int_sub, atomic_int_cas, atomic_bool_new, atomic_bool_load, atomic_bool_store

describe("thread_spawn and thread_join", fn():
  it("spawns a thread and joins it", fn():
    counter = atomic_int_new(0)
    t = thread_spawn(fn():
      atomic_int_add(counter, 1)
    )
    result = thread_join(t)
    expect(result).to_be_ok()
    expect(atomic_int_load(counter)).to_eq(1)
  )

  it("spawns multiple threads", fn():
    counter = atomic_int_new(0)
    t1 = thread_spawn(fn():
      atomic_int_add(counter, 10)
    )
    t2 = thread_spawn(fn():
      atomic_int_add(counter, 20)
    )
    thread_join(t1)
    thread_join(t2)
    expect(atomic_int_load(counter)).to_eq(30)
  )
)

describe("Lock", fn():
  it("provides mutual exclusion", fn():
    lock = lock_new()
    counter = atomic_int_new(0)

    t1 = thread_spawn(fn():
      for i in range(100):
        lock_acquire(lock)
        atomic_int_add(counter, 1)
        lock_release(lock)
    )
    t2 = thread_spawn(fn():
      for i in range(100):
        lock_acquire(lock)
        atomic_int_add(counter, 1)
        lock_release(lock)
    )

    thread_join(t1)
    thread_join(t2)
    expect(atomic_int_load(counter)).to_eq(200)
  )
)

describe("RWLock", fn():
  it("allows concurrent reads and exclusive writes", fn():
    rwlock = rwlock_new()
    counter = atomic_int_new(0)

    t1 = thread_spawn(fn():
      rwlock_read_lock(rwlock)
      atomic_int_add(counter, 1)
      rwlock_unlock(rwlock)
    )
    t2 = thread_spawn(fn():
      rwlock_read_lock(rwlock)
      atomic_int_add(counter, 1)
      rwlock_unlock(rwlock)
    )

    thread_join(t1)
    thread_join(t2)
    expect(atomic_int_load(counter)).to_eq(2)
  )
)

describe("Semaphore", fn():
  it("limits concurrent access", fn():
    sem_result = semaphore_new(2)
    expect(sem_result).to_be_ok()
    match sem_result:
      case Ok(sem):
        counter = atomic_int_new(0)

        t1 = thread_spawn(fn():
          semaphore_acquire(sem)
          atomic_int_add(counter, 1)
          semaphore_release(sem)
        )
        t2 = thread_spawn(fn():
          semaphore_acquire(sem)
          atomic_int_add(counter, 1)
          semaphore_release(sem)
        )

        thread_join(t1)
        thread_join(t2)
        expect(atomic_int_load(counter)).to_eq(2)
      case Err(e):
        fail("semaphore_new failed")
  )
)

describe("Barrier", fn():
  it("synchronizes threads", fn():
    barrier_result = barrier_new(2)
    expect(barrier_result).to_be_ok()
    match barrier_result:
      case Ok(barrier):
        counter = atomic_int_new(0)

        t1 = thread_spawn(fn():
          atomic_int_add(counter, 1)
          barrier_wait(barrier)
        )
        t2 = thread_spawn(fn():
          atomic_int_add(counter, 1)
          barrier_wait(barrier)
        )

        thread_join(t1)
        thread_join(t2)
        expect(atomic_int_load(counter)).to_eq(2)
      case Err(e):
        fail("barrier_new failed")
  )
)

describe("AtomicInt", fn():
  it("supports load and store", fn():
    a = atomic_int_new(42)
    expect(atomic_int_load(a)).to_eq(42)
    atomic_int_store(a, 100)
    expect(atomic_int_load(a)).to_eq(100)
  )

  it("supports add and sub", fn():
    a = atomic_int_new(10)
    old = atomic_int_add(a, 5)
    expect(old).to_eq(10)
    expect(atomic_int_load(a)).to_eq(15)
    old = atomic_int_sub(a, 3)
    expect(old).to_eq(15)
    expect(atomic_int_load(a)).to_eq(12)
  )

  it("supports compare-and-swap", fn():
    a = atomic_int_new(10)
    ok = atomic_int_cas(a, 10, 20)
    expect(ok).to_be_true()
    expect(atomic_int_load(a)).to_eq(20)
    ok = atomic_int_cas(a, 10, 30)
    expect(ok).to_be_false()
    expect(atomic_int_load(a)).to_eq(20)
  )

  it("concurrent increment", fn():
    counter = atomic_int_new(0)
    t1 = thread_spawn(fn():
      for i in range(1000):
        atomic_int_add(counter, 1)
    )
    t2 = thread_spawn(fn():
      for i in range(1000):
        atomic_int_add(counter, 1)
    )
    thread_join(t1)
    thread_join(t2)
    expect(atomic_int_load(counter)).to_eq(2000)
  )
)

describe("AtomicBool", fn():
  it("supports load and store", fn():
    b = atomic_bool_new(false)
    expect(atomic_bool_load(b)).to_be_false()
    atomic_bool_store(b, true)
    expect(atomic_bool_load(b)).to_be_true()
  )

  it("works across threads", fn():
    flag = atomic_bool_new(false)
    t = thread_spawn(fn():
      atomic_bool_store(flag, true)
    )
    thread_join(t)
    expect(atomic_bool_load(flag)).to_be_true()
  )
)
