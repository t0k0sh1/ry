from testing import it, describe, expect
from std.math import NAN, INF

@describe("Numeric comparison matchers")
fn numericComparisonMatchersTests():
  @it("should pass toBeGreaterThan with int")
  fn shouldPassTobegreaterthanWithInt():
    expect(5).toBeGreaterThan(3)
    expect(10).toBeGreaterThan(0)
  @it("should pass toBeLessThan with int")
  fn shouldPassTobelessthanWithInt():
    expect(3).toBeLessThan(5)
    expect(-1).toBeLessThan(0)
  @it("should pass toBeGreaterThanOrEq with int")
  fn shouldPassTobegreaterthanoreqWithInt():
    expect(5).toBeGreaterThanOrEq(5)
    expect(6).toBeGreaterThanOrEq(5)
  @it("should pass toBeLessThanOrEq with int")
  fn shouldPassTobelessthanoreqWithInt():
    expect(5).toBeLessThanOrEq(5)
    expect(4).toBeLessThanOrEq(5)
  @it("should pass toBeGreaterThan with float")
  fn shouldPassTobegreaterthanWithFloat():
    expect(3.14).toBeGreaterThan(2.71)
  @it("should pass toBeLessThan with float")
  fn shouldPassTobelessthanWithFloat():
    expect(2.71).toBeLessThan(3.14)
  @it("should pass toBeGreaterThanOrEq with float")
  fn shouldPassTobegreaterthanoreqWithFloat():
    expect(3.14).toBeGreaterThanOrEq(3.14)
    expect(3.15).toBeGreaterThanOrEq(3.14)
  @it("should pass toBeLessThanOrEq with float")
  fn shouldPassTobelessthanoreqWithFloat():
    expect(3.14).toBeLessThanOrEq(3.14)
    expect(3.13).toBeLessThanOrEq(3.14)
  @it("should handle mixed int/float comparison")
  fn shouldHandleMixedIntFloatComparison():
    expect(5).toBeGreaterThan(3.5)
    expect(2.5).toBeLessThan(3)

@describe("Length and empty matchers")
fn lengthAndEmptyMatchersTests():
  @it("should pass toHaveLen with list")
  fn shouldPassTohavelenWithList():
    xs = [1, 2, 3]
    expect(xs).toHaveLen(3)
  @it("should pass toHaveLen with set")
  fn shouldPassTohavelenWithSet():
    s = {1, 2, 3}
    expect(s).toHaveLen(3)
  @it("should pass toHaveLen with map")
  fn shouldPassTohavelenWithMap():
    m = {"a": 1, "b": 2}
    expect(m).toHaveLen(2)
  @it("should pass toHaveLen with str")
  fn shouldPassTohavelenWithStr():
    expect("hello").toHaveLen(5)
  @it("should pass toBeEmpty with empty list")
  fn shouldPassTobeemptyWithEmptyList():
    xs: List<int> = [1]
    ys = filter(xs, (x: int) => x > 10)
    expect(ys).toBeEmpty()
  @it("should pass toBeEmpty with empty string")
  fn shouldPassTobeemptyWithEmptyString():
    expect("").toBeEmpty()

@describe("Containment matchers")
fn containmentMatchersTests():
  @it("should pass toNotContain with list")
  fn shouldPassTonotcontainWithList():
    xs = [1, 2, 3]
    expect(xs).toNotContain(4)
  @it("should pass toNotContain with set")
  fn shouldPassTonotcontainWithSet():
    s = {1, 2, 3}
    expect(s).toNotContain(4)
  @it("should pass toNotContain with string")
  fn shouldPassTonotcontainWithString():
    expect("hello").toNotContain("xyz")
  @it("should pass toContain with map key")
  fn shouldPassTocontainWithMapKey():
    m = {"a": 1, "b": 2}
    expect(m).toContain("a")
    expect(m).toContain("b")
  @it("should pass toNotContain with map key")
  fn shouldPassTonotcontainWithMapKey():
    m = {"a": 1, "b": 2}
    expect(m).toNotContain("c")

record MatcherPoint:
  x: int
  y: int

fn mkOk(v: int) -> Result<int, Error>:
  return Ok(v)
fn mkErr(msg: str) -> Result<int, Error>:
  return Err(Error(msg))

@describe("toEq / toNotEq — collection and complex types (#737)")
fn toeqTonoteqCollectionAndComplexTypes737Tests():
  @it("should pass toEq for equal List<int>")
  fn shouldPassToeqForEqualListInt():
    expect([1, 2, 3]).toEq([1, 2, 3])
  @it("should pass toNotEq for unequal List<int>")
  fn shouldPassTonoteqForUnequalListInt():
    expect([1, 2, 3]).toNotEq([1, 2, 4])
  @it("should pass toEq for equal List<str>")
  fn shouldPassToeqForEqualListStr():
    expect(["a", "b"]).toEq(["a", "b"])
  @it("should pass toNotEq for unequal List<str>")
  fn shouldPassTonoteqForUnequalListStr():
    expect(["a", "b"]).toNotEq(["a", "c"])
  @it("should pass toEq for equal Set<int>")
  fn shouldPassToeqForEqualSetInt():
    a: Set<int> = {1, 2, 3}
    b: Set<int> = {3, 1, 2}
    expect(a).toEq(b)
  @it("should pass toNotEq for unequal Set<int>")
  fn shouldPassTonoteqForUnequalSetInt():
    a: Set<int> = {1, 2}
    b: Set<int> = {1, 3}
    expect(a).toNotEq(b)
  @it("should pass toEq for equal Map<str, int>")
  fn shouldPassToeqForEqualMapStrInt():
    expect({"a": 1, "b": 2}).toEq({"a": 1, "b": 2})
  @it("should pass toNotEq for unequal Map<str, int>")
  fn shouldPassTonoteqForUnequalMapStrInt():
    expect({"a": 1}).toNotEq({"a": 9})
  @it("should pass toEq for equal Ok values")
  fn shouldPassToeqForEqualOkValues():
    expect(mkOk(42)).toEq(mkOk(42))
  @it("should pass toNotEq for unequal Ok values")
  fn shouldPassTonoteqForUnequalOkValues():
    expect(mkOk(1)).toNotEq(mkOk(2))
  @it("should pass toNotEq for Ok vs Err")
  fn shouldPassTonoteqForOkVsErr():
    expect(mkOk(1)).toNotEq(mkErr("e"))
  @it("should pass toEq for equal Err values")
  fn shouldPassToeqForEqualErrValues():
    expect(mkErr("oops")).toEq(mkErr("oops"))
  @it("should pass toEq for equal Option<int> (Some)")
  fn shouldPassToeqForEqualOptionIntSome():
    expect(Some(42)).toEq(Some(42))
  @it("should pass toNotEq for Some vs None")
  fn shouldPassTonoteqForSomeVsNone():
    x: int? = Some(1)
    y: int? = none
    expect(x).toNotEq(y)
  @it("should pass toEq for equal union int|str variants")
  fn shouldPassToeqForEqualUnionIntStrVariants():
    x: int|str = 42
    y: int|str = 42
    expect(x).toEq(y)
  @it("should pass toNotEq for different-tag union variants")
  fn shouldPassTonoteqForDifferentTagUnionVariants():
    x: int|str = 1
    y: int|str = "1"
    expect(x).toNotEq(y)
  @it("should pass toEq for equal record values")
  fn shouldPassToeqForEqualRecordValues():
    expect(MatcherPoint(1, 2)).toEq(MatcherPoint(1, 2))
  @it("should pass toNotEq for unequal record values")
  fn shouldPassTonoteqForUnequalRecordValues():
    expect(MatcherPoint(1, 2)).toNotEq(MatcherPoint(1, 9))
  @it("should pass toEq for equal tuples")
  fn shouldPassToeqForEqualTuples():
    expect((1, "a", true)).toEq((1, "a", true))
  @it("should pass toNotEq for unequal tuples")
  fn shouldPassTonoteqForUnequalTuples():
    expect((1, "a")).toNotEq((1, "b"))

@describe("String matchers")
fn stringMatchersTests():
  @it("should pass toStartWith")
  fn shouldPassTostartwith():
    expect("hello world").toStartWith("hello")
    expect("abc").toStartWith("a")
  @it("should pass toEndWith")
  fn shouldPassToendwith():
    expect("hello world").toEndWith("world")
    expect("abc").toEndWith("c")
  @it("should pass toStartWith with empty prefix")
  fn shouldPassTostartwithWithEmptyPrefix():
    expect("hello").toStartWith("")
  @it("should pass toEndWith with empty suffix")
  fn shouldPassToendwithWithEmptySuffix():
    expect("hello").toEndWith("")
  @it("should pass toStartWith with full string")
  fn shouldPassTostartwithWithFullString():
    expect("hello").toStartWith("hello")
  @it("should pass toEndWith with full string")
  fn shouldPassToendwithWithFullString():
    expect("hello").toEndWith("hello")

@describe("Regex matchers (toMatch)")
fn regexMatchersTomatchTests():
  @it("should pass toMatch with literal substring (unanchored)")
  fn shouldPassTomatchWithLiteralSubstring():
    expect("error at line 42: divide by zero").toMatch("divide by zero")
  @it("should pass toMatch with anchored pattern")
  fn shouldPassTomatchWithAnchoredPattern():
    expect("v1.2.3").toMatch("^v\\d+\\.\\d+\\.\\d+$")
  @it("should pass toMatch with character class")
  fn shouldPassTomatchWithCharacterClass():
    expect("error at line 42").toMatch("line \\d+")
  @it("should pass toMatch with exact match")
  fn shouldPassTomatchWithExactMatch():
    expect("hello").toMatch("hello")
  @it("should pass toMatch with escaped metacharacter")
  fn shouldPassTomatchWithEscapedMetacharacter():
    expect("a.b").toMatch("a\\.b")
  @it("should pass toMatch when pattern matches anywhere in string")
  fn shouldPassTomatchWhenPatternMatchesAnywhereInString():
    expect("xxhelloxx").toMatch("hello")
  @it("should pass toMatch with start anchor only")
  fn shouldPassTomatchWithStartAnchorOnly():
    expect("hello world").toMatch("^hello")
  @it("should pass toMatch with end anchor only")
  fn shouldPassTomatchWithEndAnchorOnly():
    expect("hello world").toMatch("world$")

@describe("Float approximate matchers (toBeCloseTo)")
fn floatApproxMatchers():
  @it("should pass toBeCloseTo for 0.1 + 0.2 vs 0.3 (default decimals=2)")
  fn shouldPassToBeCloseToFloatSum():
    expect(0.1 + 0.2).toBeCloseTo(0.3)
  @it("should pass toBeCloseTo for exact match")
  fn shouldPassToBeCloseToExact():
    expect(1.0).toBeCloseTo(1.0)
  @it("should pass toBeCloseTo with int actual and float expected")
  fn shouldPassToBeCloseToIntActual():
    expect(1).toBeCloseTo(1.0)
  @it("should pass toBeCloseTo with float actual and int expected")
  fn shouldPassToBeCloseToIntExpected():
    expect(1.0).toBeCloseTo(1)
  @it("should pass toBeCloseTo for zero values")
  fn shouldPassToBeCloseToZero():
    expect(0.0).toBeCloseTo(0.0)
  @it("should pass toBeCloseTo with custom decimals=4")
  fn shouldPassToBeCloseToCustomDecimals4():
    expect(1.00001).toBeCloseTo(1.00002, 4)
  @it("should pass toBeCloseTo with decimals=0 (within ±0.5)")
  fn shouldPassToBeCloseToDecimalsZero():
    expect(1.4).toBeCloseTo(1.0, 0)
  @it("should pass toBeCloseTo for negative values")
  fn shouldPassToBeCloseToNegative():
    expect(-0.1 - 0.2).toBeCloseTo(-0.3)
  @it("should pass toBeCloseTo just inside boundary (decimals=2, threshold=0.005)")
  fn shouldPassToBeCloseToJustInsideBoundary():
    expect(1.0).toBeCloseTo(1.004)
  @it("should pass toBeCloseTo for very small differences with high decimals")
  fn shouldPassToBeCloseToHighDecimals():
    expect(1.000000001).toBeCloseTo(1.000000002, 8)

@describe("Float IEEE 754 special-value matchers")
fn floatIeee754Matchers():
  @it("should pass toBeNaN for NAN constant")
  fn shouldPassToBeNaNForConstant():
    expect(NAN).toBeNaN()
  @it("should pass toBeNaN for 0.0 / 0.0")
  fn shouldPassToBeNaNForZeroDivZero():
    expect(0.0 / 0.0).toBeNaN()
  @it("should pass toBeInfinity for positive infinity (1.0 / 0.0)")
  fn shouldPassToBeInfinityForPosInf():
    expect(1.0 / 0.0).toBeInfinity()
  @it("should pass toBeInfinity for negative infinity (-1.0 / 0.0)")
  fn shouldPassToBeInfinityForNegInf():
    expect(-1.0 / 0.0).toBeInfinity()
  @it("should pass toBeInfinity for INF constant")
  fn shouldPassToBeInfinityForConstant():
    expect(INF).toBeInfinity()
  @it("should pass toBeInfinity for negated INF constant")
  fn shouldPassToBeInfinityForNegConstant():
    expect(-INF).toBeInfinity()
  @it("should pass toBeFinite for normal float")
  fn shouldPassToBeFiniteForNormal():
    expect(3.14).toBeFinite()
  @it("should pass toBeFinite for zero")
  fn shouldPassToBeFiniteForZero():
    expect(0.0).toBeFinite()
  @it("should pass toBeFinite for negative zero")
  fn shouldPassToBeFiniteForNegZero():
    expect(-0.0).toBeFinite()
  @it("should pass toBeFinite for very large finite value")
  fn shouldPassToBeFiniteForLargeValue():
    expect(1.0e308).toBeFinite()
  @it("should pass toBeFinite for very small finite value")
  fn shouldPassToBeFiniteForSmallValue():
    expect(-1.0e308).toBeFinite()

@describe("Range matcher (toBeBetween)")
fn rangeMatcherToBeBetween():
  @it("should pass toBeBetween for int strictly inside range")
  fn shouldPassToBeBetweenIntInside():
    expect(5).toBeBetween(1, 10)
  @it("should pass toBeBetween for int equal to lower bound (inclusive)")
  fn shouldPassToBeBetweenIntLowerBound():
    expect(1).toBeBetween(1, 10)
  @it("should pass toBeBetween for int equal to upper bound (inclusive)")
  fn shouldPassToBeBetweenIntUpperBound():
    expect(10).toBeBetween(1, 10)
  @it("should pass toBeBetween for negative int range")
  fn shouldPassToBeBetweenIntNegative():
    expect(-5).toBeBetween(-10, -1)
  @it("should pass toBeBetween for float strictly inside range")
  fn shouldPassToBeBetweenFloatInside():
    expect(2.5).toBeBetween(2.0, 3.0)
  @it("should pass toBeBetween for float equal to bounds")
  fn shouldPassToBeBetweenFloatBoundary():
    expect(0.0).toBeBetween(0.0, 0.0)
  @it("should pass toBeBetween with int actual and float bounds")
  fn shouldPassToBeBetweenIntActualFloatBounds():
    expect(2).toBeBetween(1.5, 2.5)
  @it("should pass toBeBetween with float actual and int bounds")
  fn shouldPassToBeBetweenFloatActualIntBounds():
    expect(1.5).toBeBetween(1, 2)

@describe("Membership matcher (toBeOneOf)")
fn membershipMatcherToBeOneOf():
  @it("should pass toBeOneOf for int matching first element")
  fn shouldPassToBeOneOfIntFirst():
    expect(200).toBeOneOf([200, 201, 204])
  @it("should pass toBeOneOf for int matching middle element")
  fn shouldPassToBeOneOfIntMiddle():
    expect(201).toBeOneOf([200, 201, 204])
  @it("should pass toBeOneOf for int matching last element")
  fn shouldPassToBeOneOfIntLast():
    expect(204).toBeOneOf([200, 201, 204])
  @it("should pass toBeOneOf for str matching element")
  fn shouldPassToBeOneOfStr():
    expect("get").toBeOneOf(["get", "post", "put"])
  @it("should pass toBeOneOf for float matching element")
  fn shouldPassToBeOneOfFloat():
    expect(1.5).toBeOneOf([0.5, 1.5, 2.5])
  @it("should pass toBeOneOf for bool matching element")
  fn shouldPassToBeOneOfBool():
    expect(true).toBeOneOf([true, false])
  @it("should pass toBeOneOf for single-element list")
  fn shouldPassToBeOneOfSingleElement():
    expect(42).toBeOneOf([42])
  @it("should pass toBeOneOf with list bound to variable")
  fn shouldPassToBeOneOfListVariable():
    allowed: List<int> = [1, 2, 3]
    expect(2).toBeOneOf(allowed)
