describe("Numeric comparison matchers", function():
  it("to_be_greater_than with int", function():
    expect(5).to_be_greater_than(3)
    expect(10).to_be_greater_than(0)
  )
  it("to_be_less_than with int", function():
    expect(3).to_be_less_than(5)
    expect(-1).to_be_less_than(0)
  )
  it("to_be_greater_than_or_eq with int", function():
    expect(5).to_be_greater_than_or_eq(5)
    expect(6).to_be_greater_than_or_eq(5)
  )
  it("to_be_less_than_or_eq with int", function():
    expect(5).to_be_less_than_or_eq(5)
    expect(4).to_be_less_than_or_eq(5)
  )
  it("to_be_greater_than with float", function():
    expect(3.14).to_be_greater_than(2.71)
  )
  it("to_be_less_than with float", function():
    expect(2.71).to_be_less_than(3.14)
  )
  it("to_be_greater_than_or_eq with float", function():
    expect(3.14).to_be_greater_than_or_eq(3.14)
    expect(3.15).to_be_greater_than_or_eq(3.14)
  )
  it("to_be_less_than_or_eq with float", function():
    expect(3.14).to_be_less_than_or_eq(3.14)
    expect(3.13).to_be_less_than_or_eq(3.14)
  )
  it("mixed int/float comparison", function():
    expect(5).to_be_greater_than(3.5)
    expect(2.5).to_be_less_than(3)
  )
)

describe("Length and empty matchers", function():
  it("to_have_length with list", function():
    xs = [1, 2, 3]
    expect(xs).to_have_length(3)
  )
  it("to_have_length with set", function():
    s = {1, 2, 3}
    expect(s).to_have_length(3)
  )
  it("to_have_length with map", function():
    m = {"a": 1, "b": 2}
    expect(m).to_have_length(2)
  )
  it("to_have_length with str", function():
    expect("hello").to_have_length(5)
  )
  it("to_be_empty with empty list", function():
    xs: List<int> = [1]
    ys = filter(xs, function(x: int) => x > 10)
    expect(ys).to_be_empty()
  )
  it("to_be_empty with empty string", function():
    expect("").to_be_empty()
  )
)

describe("Containment matchers", function():
  it("to_not_contain with list", function():
    xs = [1, 2, 3]
    expect(xs).to_not_contain(4)
  )
  it("to_not_contain with set", function():
    s = {1, 2, 3}
    expect(s).to_not_contain(4)
  )
  it("to_not_contain with string", function():
    expect("hello").to_not_contain("xyz")
  )
  it("to_contain with map key", function():
    m = {"a": 1, "b": 2}
    expect(m).to_contain("a")
    expect(m).to_contain("b")
  )
  it("to_not_contain with map key", function():
    m = {"a": 1, "b": 2}
    expect(m).to_not_contain("c")
  )
)

describe("String matchers", function():
  it("to_start_with", function():
    expect("hello world").to_start_with("hello")
    expect("abc").to_start_with("a")
  )
  it("to_end_with", function():
    expect("hello world").to_end_with("world")
    expect("abc").to_end_with("c")
  )
  it("to_start_with with empty prefix", function():
    expect("hello").to_start_with("")
  )
  it("to_end_with with empty suffix", function():
    expect("hello").to_end_with("")
  )
  it("to_start_with with full string", function():
    expect("hello").to_start_with("hello")
  )
  it("to_end_with with full string", function():
    expect("hello").to_end_with("hello")
  )
)
