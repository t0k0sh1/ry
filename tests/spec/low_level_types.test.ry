describe("i32 type", ():
  it("should support declaration with annotation", ():
    x: i32 = 42
    expect(x as int).toEq(42)
  )
  it("should handle negative value", ():
    x: i32 = -10
    expect(x as int).toEq(-10)
  )
  it("should handle zero", ():
    x: i32 = 0
    expect(x as int).toEq(0)
  )
  it("should add", ():
    a: i32 = 10
    b: i32 = 20
    c = a + b
    expect(c as int).toEq(30)
  )
  it("should subtract", ():
    a: i32 = 50
    b: i32 = 20
    c = a - b
    expect(c as int).toEq(30)
  )
  it("should multiply", ():
    a: i32 = 3
    b: i32 = 4
    c = a * b
    expect(c as int).toEq(12)
  )
  it("should perform integer division", ():
    a: i32 = 7
    b: i32 = 2
    c = a / b
    expect(c as int).toEq(3)
  )
  it("should perform floor division", ():
    a: i32 = 7
    b: i32 = 2
    c = a // b
    expect(c as int).toEq(3)
  )
  it("should compute modulo", ():
    a: i32 = 10
    b: i32 = 3
    c = a % b
    expect(c as int).toEq(1)
  )
  it("should check comparison equal", ():
    a: i32 = 10
    b: i32 = 10
    expect(a == b).toBeTrue()
  )
  it("should check comparison less than", ():
    a: i32 = 5
    b: i32 = 10
    expect(a < b).toBeTrue()
  )
  it("should check comparison greater than", ():
    a: i32 = 10
    b: i32 = 5
    expect(a > b).toBeTrue()
  )
)

describe("i16 type", ():
  it("should support declaration with annotation", ():
    x: i16 = 100
    expect(x as int).toEq(100)
  )
  it("should handle negative value", ():
    x: i16 = -100
    expect(x as int).toEq(-100)
  )
  it("should add", ():
    a: i16 = 10
    b: i16 = 20
    c = a + b
    expect(c as int).toEq(30)
  )
  it("should check comparison", ():
    a: i16 = 5
    b: i16 = 10
    expect(a < b).toBeTrue()
  )
)

describe("f32 type", ():
  it("should support declaration with annotation", ():
    x: f32 = 3.14
    expect(x as float > 3.13).toBeTrue()
    expect(x as float < 3.15).toBeTrue()
  )
  it("should add", ():
    a: f32 = 1.5
    b: f32 = 2.5
    c = a + b
    expect(c as float).toEq(4.0)
  )
  it("should subtract", ():
    a: f32 = 5.0
    b: f32 = 2.0
    c = a - b
    expect(c as float).toEq(3.0)
  )
  it("should multiply", ():
    a: f32 = 3.0
    b: f32 = 4.0
    c = a * b
    expect(c as float).toEq(12.0)
  )
  it("should divide", ():
    a: f32 = 7.0
    b: f32 = 2.0
    c = a / b
    expect(c as float).toEq(3.5)
  )
  it("should check comparison", ():
    a: f32 = 1.0
    b: f32 = 2.0
    expect(a < b).toBeTrue()
  )
)

describe("as cast with low-level types", ():
  it("should cast i32 to int", ():
    x: i32 = 42
    expect(x as int).toEq(42)
  )
  it("should cast int to i32", ():
    x = 42
    y = x as i32
    expect(y as int).toEq(42)
  )
  it("should cast i32 to i16", ():
    x: i32 = 100
    y = x as i16
    expect(y as int).toEq(100)
  )
  it("should cast i16 to i32", ():
    x: i16 = 100
    y = x as i32
    expect(y as int).toEq(100)
  )
  it("should cast i32 to float", ():
    x: i32 = 42
    expect(x as float).toEq(42.0)
  )
  it("should cast float to f32", ():
    x = 3.14
    y = x as f32
    expect(y as float > 3.13).toBeTrue()
  )
  it("should cast f32 to float", ():
    x: f32 = 2.5
    expect(x as float).toEq(2.5)
  )
  it("should cast i32 to f32", ():
    x: i32 = 42
    y = x as f32
    expect(y as float).toEq(42.0)
  )
  it("should cast f32 to i32", ():
    x: f32 = 3.14
    y = x as i32
    expect(y as int).toEq(3)
  )
  it("should cast signed i8 to f32 preserving sign", ():
    x: i8 = -5
    y = x as f32
    expect(y as float).toEq(-5.0)
  )
  it("should cast unsigned u8 to f32 as positive", ():
    x: u8 = 200
    y = x as f32
    expect(y as float).toEq(200.0)
  )
)

describe("low-level type inference and propagation", ():
  it("should infer i32 for i32 arithmetic result", ():
    a: i32 = 10
    b: i32 = 20
    c = a + b
    expect(c as int).toEq(30)
  )
  it("should allow inferred i32 to be reassigned with i32 expression", ():
    a: i32 = 10
    b: i32 = 20
    c = a + b
    c = a * b
    expect(c as int).toEq(200)
  )
  it("should infer i16 for i16 arithmetic result", ():
    a: i16 = 3
    b: i16 = 7
    c = a + b
    expect(c as int).toEq(10)
  )
  it("should infer f32 for f32 arithmetic result", ():
    a: f32 = 1.5
    b: f32 = 2.5
    c = a + b
    expect(c as float).toEq(4.0)
  )
  it("should preserve type for chained i32 operations", ():
    a: i32 = 2
    b: i32 = 3
    c = a + b
    d = c * a
    expect(d as int).toEq(10)
  )
)

describe("low-level type print", ():
  it("should print i32", ():
    x: i32 = 42
    s = x as str
    expect(s).toEq("42")
  )
  it("should print i16", ():
    x: i16 = 100
    s = x as str
    expect(s).toEq("100")
  )
  it("should print f32", ():
    x: f32 = 2.5
    s = x as str
    expect(s).toEq("2.5")
  )
)

# ===== Phase 2: i8, i64, u8, u16, u32, u64 =====

describe("i8 type", ():
  it("should support declaration with annotation", ():
    x: i8 = 42
    expect(x as int).toEq(42)
  )
  it("should handle negative value", ():
    x: i8 = -10
    expect(x as int).toEq(-10)
  )
  it("should add", ():
    a: i8 = 10
    b: i8 = 20
    c = a + b
    expect(c as int).toEq(30)
  )
  it("should perform signed division", ():
    a: i8 = -7
    b: i8 = 2
    c = a / b
    expect(c as int).toEq(-3)
  )
  it("should perform signed comparison", ():
    a: i8 = -1
    b: i8 = 1
    expect(a < b).toBeTrue()
  )
  it("should convert to string", ():
    x: i8 = -5
    s = x as str
    expect(s).toEq("-5")
  )
)

describe("i64 type", ():
  it("should support declaration with annotation", ():
    x: i64 = 100000
    expect(x as int).toEq(100000)
  )
  it("should handle negative value", ():
    x: i64 = -100000
    expect(x as int).toEq(-100000)
  )
  it("should add", ():
    a: i64 = 1000
    b: i64 = 2000
    c = a + b
    expect(c as int).toEq(3000)
  )
  it("should perform signed division", ():
    a: i64 = -7
    b: i64 = 2
    c = a / b
    expect(c as int).toEq(-3)
  )
  it("should convert to string", ():
    x: i64 = -999
    s = x as str
    expect(s).toEq("-999")
  )
)

describe("u8 type", ():
  it("should support declaration with annotation", ():
    x: u8 = 200
    expect(x as int).toEq(200)
  )
  it("should add", ():
    a: u8 = 100
    b: u8 = 50
    c = a + b
    expect(c as int).toEq(150)
  )
  it("should perform unsigned division", ():
    a: u8 = 200
    b: u8 = 3
    c = a / b
    expect(c as int).toEq(66)
  )
  it("should perform unsigned comparison", ():
    a: u8 = 200
    b: u8 = 100
    expect(a > b).toBeTrue()
  )
  it("should convert to string", ():
    x: u8 = 255
    s = x as str
    expect(s).toEq("255")
  )
)

describe("u16 type", ():
  it("should support declaration with annotation", ():
    x: u16 = 60000
    expect(x as int).toEq(60000)
  )
  it("should add", ():
    a: u16 = 10000
    b: u16 = 20000
    c = a + b
    expect(c as int).toEq(30000)
  )
  it("should perform unsigned division", ():
    a: u16 = 50000
    b: u16 = 3
    c = a / b
    expect(c as int).toEq(16666)
  )
  it("should perform unsigned comparison", ():
    a: u16 = 60000
    b: u16 = 30000
    expect(a > b).toBeTrue()
  )
  it("should convert to string", ():
    x: u16 = 65535
    s = x as str
    expect(s).toEq("65535")
  )
)

describe("u32 type", ():
  it("should support declaration with annotation", ():
    x: u32 = 3000000000
    expect(x as int).toEq(3000000000)
  )
  it("should add", ():
    a: u32 = 1000000
    b: u32 = 2000000
    c = a + b
    expect(c as int).toEq(3000000)
  )
  it("should perform unsigned division", ():
    a: u32 = 3000000000
    b: u32 = 7
    c = a / b
    expect(c as int).toEq(428571428)
  )
  it("should perform unsigned comparison", ():
    a: u32 = 3000000000
    b: u32 = 1000000000
    expect(a > b).toBeTrue()
  )
  it("should convert to string", ():
    x: u32 = 4000000000
    s = x as str
    expect(s).toEq("4000000000")
  )
)

describe("u64 type", ():
  it("should support declaration with annotation", ():
    x: u64 = 1000000
    expect(x as int).toEq(1000000)
  )
  it("should add", ():
    a: u64 = 100000
    b: u64 = 200000
    c = a + b
    expect(c as int).toEq(300000)
  )
  it("should perform unsigned division", ():
    a: u64 = 1000000
    b: u64 = 3
    c = a / b
    expect(c as int).toEq(333333)
  )
  it("should convert to string", ():
    x: u64 = 999999
    s = x as str
    expect(s).toEq("999999")
  )
)

describe("Phase 2 casts", ():
  it("should cast int to i8", ():
    x = 42
    y = x as i8
    expect(y as int).toEq(42)
  )
  it("should cast int to i64", ():
    x = 42
    y = x as i64
    expect(y as int).toEq(42)
  )
  it("should cast int to u8", ():
    x = 200
    y = x as u8
    expect(y as int).toEq(200)
  )
  it("should cast int to u16", ():
    x = 60000
    y = x as u16
    expect(y as int).toEq(60000)
  )
  it("should cast int to u32", ():
    x = 3000000000
    y = x as u32
    expect(y as int).toEq(3000000000)
  )
  it("should cast int to u64", ():
    x = 42
    y = x as u64
    expect(y as int).toEq(42)
  )
  it("should cast u32 to float", ():
    x: u32 = 42
    expect(x as float).toEq(42.0)
  )
  it("should cast u8 to u32", ():
    x: u8 = 200
    y = x as u32
    expect(y as int).toEq(200)
  )
  it("should truncate u32 to u8", ():
    x: u32 = 300
    y = x as u8
    expect(y as int).toEq(44)
  )
  it("should cast i32 to u32", ():
    x: i32 = 42
    y = x as u32
    expect(y as int).toEq(42)
  )
)

describe("Phase 2 function with low-level params", ():
  fn addU32(a: u32, b: u32) -> u32:
    return a + b

  it("should work with function with u32 params and return", ():
    x: u32 = 100
    y: u32 = 200
    z = addU32(x, y)
    expect(z as int).toEq(300)
  )

  fn negateI8(x: i8) -> i8:
    zero: i8 = 0
    return zero - x

  it("should work with function with i8 params and return", ():
    x: i8 = 5
    y = negateI8(x)
    expect(y as int).toEq(-5)
  )
)
