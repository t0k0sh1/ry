from testing import it, describe

@describe("i32 type")
fn i32TypeTests():
  @it("should support declaration with annotation")
  fn shouldSupportDeclarationWithAnnotation():
    x: i32 = 42
    expect(x as int).toEq(42)
  @it("should handle negative value")
  fn shouldHandleNegativeValue():
    x: i32 = -10
    expect(x as int).toEq(-10)
  @it("should handle zero")
  fn shouldHandleZero():
    x: i32 = 0
    expect(x as int).toEq(0)
  @it("should add")
  fn shouldAdd():
    a: i32 = 10
    b: i32 = 20
    c = a + b
    expect(c as int).toEq(30)
  @it("should subtract")
  fn shouldSubtract():
    a: i32 = 50
    b: i32 = 20
    c = a - b
    expect(c as int).toEq(30)
  @it("should multiply")
  fn shouldMultiply():
    a: i32 = 3
    b: i32 = 4
    c = a * b
    expect(c as int).toEq(12)
  @it("should perform integer division")
  fn shouldPerformIntegerDivision():
    a: i32 = 7
    b: i32 = 2
    c = a / b
    expect(c as int).toEq(3)
  @it("should perform floor division")
  fn shouldPerformFloorDivision():
    a: i32 = 7
    b: i32 = 2
    c = a // b
    expect(c as int).toEq(3)
  @it("should compute modulo")
  fn shouldComputeModulo():
    a: i32 = 10
    b: i32 = 3
    c = a % b
    expect(c as int).toEq(1)
  @it("should check comparison equal")
  fn shouldCheckComparisonEqual():
    a: i32 = 10
    b: i32 = 10
    expect(a == b).toBeTrue()
  @it("should check comparison less than")
  fn shouldCheckComparisonLessThan():
    a: i32 = 5
    b: i32 = 10
    expect(a < b).toBeTrue()
  @it("should check comparison greater than")
  fn shouldCheckComparisonGreaterThan():
    a: i32 = 10
    b: i32 = 5
    expect(a > b).toBeTrue()

@describe("i16 type")
fn i16TypeTests():
  @it("should support declaration with annotation")
  fn shouldSupportDeclarationWithAnnotation2():
    x: i16 = 100
    expect(x as int).toEq(100)
  @it("should handle negative value")
  fn shouldHandleNegativeValue2():
    x: i16 = -100
    expect(x as int).toEq(-100)
  @it("should add")
  fn shouldAdd2():
    a: i16 = 10
    b: i16 = 20
    c = a + b
    expect(c as int).toEq(30)
  @it("should check comparison")
  fn shouldCheckComparison():
    a: i16 = 5
    b: i16 = 10
    expect(a < b).toBeTrue()

@describe("f32 type")
fn f32TypeTests():
  @it("should support declaration with annotation")
  fn shouldSupportDeclarationWithAnnotation3():
    x: f32 = 3.14
    expect(x as float > 3.13).toBeTrue()
    expect(x as float < 3.15).toBeTrue()
  @it("should add")
  fn shouldAdd3():
    a: f32 = 1.5
    b: f32 = 2.5
    c = a + b
    expect(c as float).toEq(4.0)
  @it("should subtract")
  fn shouldSubtract2():
    a: f32 = 5.0
    b: f32 = 2.0
    c = a - b
    expect(c as float).toEq(3.0)
  @it("should multiply")
  fn shouldMultiply2():
    a: f32 = 3.0
    b: f32 = 4.0
    c = a * b
    expect(c as float).toEq(12.0)
  @it("should divide")
  fn shouldDivide():
    a: f32 = 7.0
    b: f32 = 2.0
    c = a / b
    expect(c as float).toEq(3.5)
  @it("should check comparison")
  fn shouldCheckComparison2():
    a: f32 = 1.0
    b: f32 = 2.0
    expect(a < b).toBeTrue()

@describe("as cast with low-level types")
fn asCastWithLowLevelTypesTests():
  @it("should cast i32 to int")
  fn shouldCastI32ToInt():
    x: i32 = 42
    expect(x as int).toEq(42)
  @it("should cast int to i32")
  fn shouldCastIntToI32():
    x = 42
    y = x as i32
    expect(y as int).toEq(42)
  @it("should cast i32 to i16")
  fn shouldCastI32ToI16():
    x: i32 = 100
    y = x as i16
    expect(y as int).toEq(100)
  @it("should cast i16 to i32")
  fn shouldCastI16ToI32():
    x: i16 = 100
    y = x as i32
    expect(y as int).toEq(100)
  @it("should cast i32 to float")
  fn shouldCastI32ToFloat():
    x: i32 = 42
    expect(x as float).toEq(42.0)
  @it("should cast float to f32")
  fn shouldCastFloatToF32():
    x = 3.14
    y = x as f32
    expect(y as float > 3.13).toBeTrue()
  @it("should cast f32 to float")
  fn shouldCastF32ToFloat():
    x: f32 = 2.5
    expect(x as float).toEq(2.5)
  @it("should cast i32 to f32")
  fn shouldCastI32ToF32():
    x: i32 = 42
    y = x as f32
    expect(y as float).toEq(42.0)
  @it("should cast f32 to i32")
  fn shouldCastF32ToI32():
    x: f32 = 3.14
    y = x as i32
    expect(y as int).toEq(3)
  @it("should cast signed i8 to f32 preserving sign")
  fn shouldCastSignedI8ToF32PreservingSign():
    x: i8 = -5
    y = x as f32
    expect(y as float).toEq(-5.0)
  @it("should cast unsigned u8 to f32 as positive")
  fn shouldCastUnsignedU8ToF32AsPositive():
    x: u8 = 200
    y = x as f32
    expect(y as float).toEq(200.0)

@describe("low-level type inference and propagation")
fn lowLevelTypeInferenceAndPropagationTests():
  @it("should infer i32 for i32 arithmetic result")
  fn shouldInferI32ForI32ArithmeticResult():
    a: i32 = 10
    b: i32 = 20
    c = a + b
    expect(c as int).toEq(30)
  @it("should allow inferred i32 to be reassigned with i32 expression")
  fn shouldAllowInferredI32ToBeReassignedWithI32Expression():
    a: i32 = 10
    b: i32 = 20
    c = a + b
    c = a * b
    expect(c as int).toEq(200)
  @it("should infer i16 for i16 arithmetic result")
  fn shouldInferI16ForI16ArithmeticResult():
    a: i16 = 3
    b: i16 = 7
    c = a + b
    expect(c as int).toEq(10)
  @it("should infer f32 for f32 arithmetic result")
  fn shouldInferF32ForF32ArithmeticResult():
    a: f32 = 1.5
    b: f32 = 2.5
    c = a + b
    expect(c as float).toEq(4.0)
  @it("should preserve type for chained i32 operations")
  fn shouldPreserveTypeForChainedI32Operations():
    a: i32 = 2
    b: i32 = 3
    c = a + b
    d = c * a
    expect(d as int).toEq(10)

@describe("low-level type print")
fn lowLevelTypePrintTests():
  @it("should print i32")
  fn shouldPrintI32():
    x: i32 = 42
    s = x as str
    expect(s).toEq("42")
  @it("should print i16")
  fn shouldPrintI16():
    x: i16 = 100
    s = x as str
    expect(s).toEq("100")
  @it("should print f32")
  fn shouldPrintF32():
    x: f32 = 2.5
    s = x as str
    expect(s).toEq("2.5")

# ===== Phase 2: i8, i64, u8, u16, u32, u64 =====

@describe("i8 type")
fn i8TypeTests():
  @it("should support declaration with annotation")
  fn shouldSupportDeclarationWithAnnotation4():
    x: i8 = 42
    expect(x as int).toEq(42)
  @it("should handle negative value")
  fn shouldHandleNegativeValue3():
    x: i8 = -10
    expect(x as int).toEq(-10)
  @it("should add")
  fn shouldAdd4():
    a: i8 = 10
    b: i8 = 20
    c = a + b
    expect(c as int).toEq(30)
  @it("should perform signed division")
  fn shouldPerformSignedDivision():
    a: i8 = -7
    b: i8 = 2
    c = a / b
    expect(c as int).toEq(-3)
  @it("should perform signed comparison")
  fn shouldPerformSignedComparison():
    a: i8 = -1
    b: i8 = 1
    expect(a < b).toBeTrue()
  @it("should convert to string")
  fn shouldConvertToString():
    x: i8 = -5
    s = x as str
    expect(s).toEq("-5")

