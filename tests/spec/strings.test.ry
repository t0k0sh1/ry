from testing import it, describe, expect

from io import bytesToStr, toBytes

@describe("search and check")
fn searchAndCheckTests():
  @it("should check contains")
  fn shouldCheckContains():
    expect("hello").toContain("ell")
    expect(contains("hello", "xyz")).toBeFalse()
  @it("should check startsWith")
  fn shouldCheckStartswith():
    expect("hello").toStartWith("hel")
    expect(startsWith("hello", "world")).toBeFalse()
  @it("should check endsWith")
  fn shouldCheckEndswith():
    expect("hello").toEndWith("llo")
    expect(endsWith("hello", "world")).toBeFalse()
  @it("should check contains case-insensitively")
  fn shouldCheckContainsCaseInsensitively():
    expect(contains("Hello World", "hello", true)).toBeTrue()
    expect(contains("Hello World", "WORLD", true)).toBeTrue()
    expect(contains("Hello World", "xyz", true)).toBeFalse()
    expect(contains("Hello", "hello", false)).toBeFalse()
    expect("Hello".contains("hello", true)).toBeTrue()
  @it("should check startsWith case-insensitively")
  fn shouldCheckStartswithCaseInsensitively():
    expect(startsWith("Hello World", "hello", true)).toBeTrue()
    expect(startsWith("Hello World", "HELLO", true)).toBeTrue()
    expect(startsWith("Hello World", "world", true)).toBeFalse()
    expect("Hello".startsWith("hel", true)).toBeTrue()
  @it("should check endsWith case-insensitively")
  fn shouldCheckEndswithCaseInsensitively():
    expect(endsWith("Hello World", "world", true)).toBeTrue()
    expect(endsWith("Hello World", "WORLD", true)).toBeTrue()
    expect(endsWith("Hello World", "hello", true)).toBeFalse()
    expect(endsWith("hi", "HELLO", true)).toBeFalse()
    expect("Hello".endsWith("llo", true)).toBeTrue()
  @it("should find substr")
  fn shouldFindSubstr():
    expect(find("hello world", "world")).toEq(Some(6))
    expect(find("hello", "xyz")).toBeNone()
    expect(find("abcdef", "cd")).toEq(Some(2))
  @it("should return none when finding in empty string")
  fn shouldReturnNoneWhenFindingInEmptyString():
    expect(find("", "x")).toBeNone()
  @it("should find empty needle at position 0")
  fn shouldFindEmptyNeedleAtPosition0():
    expect(find("hello", "")).toEq(Some(0))
  @it("should return true when contains empty needle")
  fn shouldReturnTrueWhenContainsEmptyNeedle():
    expect(contains("hello", "")).toBeTrue()
  @it("should return true when contains empty haystack and needle")
  fn shouldReturnTrueWhenContainsEmptyHaystackAndNeedle():
    expect(contains("", "")).toBeTrue()
  @it("should check substr with in operator")
  fn shouldCheckSubstrWithInOperator():
    expect("world" in "hello world").toBeTrue()
    expect("xyz" in "hello world").toBeFalse()
    expect("hello" in "hello").toBeTrue()
    expect("hello" in "").toBeFalse()
    expect("" in "hello").toBeTrue()
  @it("should check substr with not in operator")
  fn shouldCheckSubstrWithNotInOperator():
    expect("world" not in "hello world").toBeFalse()
    expect("xyz" not in "hello world").toBeTrue()

@describe("count")
fn countTests():
  @it("should count single-char ASCII occurrences")
  fn shouldCountSingleCharAsciiOccurrences():
    expect(count("101", "1")).toEq(2)
    expect(count("hello world", "l")).toEq(3)
    expect("101".count("1")).toEq(2)
  @it("should count multi-char ASCII substrings")
  fn shouldCountMultiCharAsciiSubstrings():
    expect(count("hello", "ll")).toEq(1)
    expect(count("hellohello", "ello")).toEq(2)
  @it("should count non-overlapping occurrences")
  fn shouldCountNonOverlappingOccurrences():
    expect(count("aaaa", "aa")).toEq(2)
    expect(count("aaaaa", "aa")).toEq(2)
    expect(count("ababab", "aba")).toEq(1)
  @it("should return 0 when needle not found")
  fn shouldReturn0WhenNeedleNotFound():
    expect(count("hello", "xyz")).toEq(0)
    expect(count("hi", "hello")).toEq(0)
  @it("should return 0 when haystack is empty and needle is non-empty")
  fn shouldReturn0WhenHaystackIsEmptyAndNeedleIsNonEmpty():
    expect(count("", "x")).toEq(0)
  @it("should return byteLen + 1 for empty needle")
  fn shouldReturnBytelen1ForEmptyNeedle():
    expect(count("abc", "")).toEq(4)
    expect(count("hello", "")).toEq(6)
    expect(count("", "")).toEq(1)
  @it("should count case-insensitively when ignoreCase=true")
  fn shouldCountCaseInsensitivelyWhenIgnorecaseTrue():
    expect(count("Hello", "h")).toEq(0)
    expect(count("Hello", "h", true)).toEq(1)
    expect(count("Hello World", "L", true)).toEq(3)
    expect(count("HELLO hello", "hello", true)).toEq(2)
    expect("Hello".count("HELLO", true)).toEq(1)
  @it("should count substrings crossing embedded NUL bytes (#1571)")
  fn shouldCountSubstringsCrossingEmbeddedNulBytes1571():
    expect(count("a\0b\0c", "\0")).toEq(2)
    expect(count("a\0b\0c\0", "\0")).toEq(3)
    expect(count("a\0a\0a", "\0a")).toEq(2)
  @it("should count ASCII needle in UTF-8 haystack at byte level")
  fn shouldCountAsciiNeedleInUtf8HaystackAtByteLevel():
    expect(count("あa", "a")).toEq(1)
    expect(count("aあa", "a")).toEq(2)
    expect(count("あいうえお", "a")).toEq(0)

@describe("extraction and transformation")
fn extractionAndTransformationTests():
  @it("should extract substr")
  fn shouldExtractSubstr():
    expect(substr("hello world", 0, 5)).toEq("hello")
    expect(substr("abcdef", 1, 4)).toEq("bcd")
  @it("should clamp out-of-bounds substr")
  fn shouldClampOutOfBoundsSubstr():
    expect(substr("abc", 0, 100)).toEq("abc")
    expect(substr("abc", 5, 10)).toEq("")
  @it("should wrap negative substr index Python-style")
  fn shouldWrapNegativeSubstrIndexPythonStyle():
    expect(substr("abc", -1, 3)).toEq("c")
    expect(substr("abc", -2, 3)).toEq("bc")
  @it("should get charAt position")
  fn shouldGetCharatPosition():
    expect(charAt("hello", 0)).toEq("h")
    expect(charAt("abc", 2)).toEq("c")
  @it("should replace substr")
  fn shouldReplaceSubstr():
    expect(replace("hello world", "world", "ry")).toEq("hello ry")
    expect(replace("foo bar foo", "foo", "baz")).toEq("baz bar baz")
  @it("should return original when replace target not found")
  fn shouldReturnOriginalWhenReplaceTargetNotFound():
    expect(replace("hello", "xyz", "abc")).toEq("hello")
  @it("should return input unchanged when pattern is empty (#802)")
  fn shouldReturnInputUnchangedWhenPatternIsEmpty802():
    expect(replace("hello", "", "X")).toEq("hello")
    expect(replace("", "", "X")).toEq("")

@describe("isEmpty on strings (#831)")
fn isemptyOnStrings831Tests():
  @it("should return true for empty string")
  fn shouldReturnTrueForEmptyString():
    expect(isEmpty("")).toEq(true)
  @it("should return false for non-empty string")
  fn shouldReturnFalseForNonEmptyString():
    expect(isEmpty("hello")).toEq(false)
  @it("should work via UFCS on empty string")
  fn shouldWorkViaUfcsOnEmptyString():
    expect("".isEmpty()).toEq(true)
  @it("should work via UFCS on non-empty string")
  fn shouldWorkViaUfcsOnNonEmptyString():
    expect("x".isEmpty()).toEq(false)
  @it("should handle multi-byte UTF-8 empty vs non-empty")
  fn shouldHandleMultiByteUtf8EmptyVsNonEmpty():
    expect(isEmpty("")).toEq(true)
    expect(isEmpty("日本語")).toEq(false)
  @it("should return false for single NUL byte (#1069)")
  fn shouldReturnFalseForSingleNulByte1069():
    expect(isEmpty("\0")).toEq(false)
    expect("\0".isEmpty()).toEq(false)
  @it("should return false for multiple NUL bytes (#1069)")
  fn shouldReturnFalseForMultipleNulBytes1069():
    expect(isEmpty("\0\0")).toEq(false)
  @it("should return false for string starting with NUL (#1069)")
  fn shouldReturnFalseForStringStartingWithNul1069():
    expect(isEmpty("\0abc")).toEq(false)

@describe("case conversion")
fn caseConversionTests():
  @it("should convert to uppercase")
  fn shouldConvertToUppercase():
    expect(toUpper("hello")).toEq("HELLO")
    expect(toUpper("Hello World")).toEq("HELLO WORLD")
  @it("should handle empty string in toUpper")
  fn shouldHandleEmptyStringInToupper():
    expect(toUpper("")).toEq("")
  @it("should convert to lowercase")
  fn shouldConvertToLowercase():
    expect(toLower("HELLO")).toEq("hello")
    expect(toLower("Hello World")).toEq("hello world")
  @it("should handle empty string in toLower")
  fn shouldHandleEmptyStringInTolower():
    expect(toLower("")).toEq("")

@describe("whitespace")
fn whitespaceTests():
  @it("should trim whitespace")
  fn shouldTrimWhitespace():
    expect(trim("  hello  ")).toEq("hello")
    expect(trim("  hi  ")).toEq("hi")
  @it("should trim empty string")
  fn shouldTrimEmptyString():
    expect(trim("")).toEq("")
  @it("should trim start whitespace")
  fn shouldTrimStartWhitespace():
    expect(trimStart("  hello  ")).toEq("hello  ")
    expect(trimStart("  hi")).toEq("hi")
  @it("should trim start of empty string")
  fn shouldTrimStartOfEmptyString():
    expect(trimStart("")).toEq("")
  @it("should trim end whitespace")
  fn shouldTrimEndWhitespace():
    expect(trimEnd("  hello  ")).toEq("  hello")
    expect(trimEnd("hi  ")).toEq("hi")
  @it("should trim end of empty string")
  fn shouldTrimEndOfEmptyString():
    expect(trimEnd("")).toEq("")

@describe("generation")
fn generationTests():
  @it("should repeat string")
  fn shouldRepeatString():
    expect(repeat("ab", 3)).toEq("ababab")
    expect(repeat("ha", 3)).toEq("hahaha")
    expect(repeat("a", 0)).toEq("")
    expect(repeat("a", -1)).toEq("")
    expect(repeat("abc", -100)).toEq("")
    expect(repeat("hello", 1)).toEq("hello")
  @it("should repeat empty string")
  fn shouldRepeatEmptyString():
    expect(repeat("", 5)).toEq("")
  @it("should reverse string")
  fn shouldReverseString():
    expect(reverse("hello")).toEq("olleh")
    expect(reverse("abc")).toEq("cba")
  @it("should reverse empty string")
  fn shouldReverseEmptyString():
    expect(reverse("")).toEq("")

@describe("split and join")
fn splitAndJoinTests():
  @it("should default split delimiter to a single space")
  fn shouldDefaultSplitDelimiterToASingleSpace():
    parts = "1 2 3".split()
    expect(parts).toHaveLen(3)
    expect(parts[0]).toEq("1")
    expect(parts[1]).toEq("2")
    expect(parts[2]).toEq("3")
  @it("should default split delimiter in direct call form")
  fn shouldDefaultSplitDelimiterInDirectCallForm():
    parts = split("1 2 3")
    expect(parts).toHaveLen(3)
    expect(parts[0]).toEq("1")
    expect(parts[1]).toEq("2")
    expect(parts[2]).toEq("3")
  @it("should preserve explicit delimiter split behavior")
  fn shouldPreserveExplicitDelimiterSplitBehavior():
    parts = "a,b,c".split(",")
    expect(parts).toHaveLen(3)
    expect(parts[0]).toEq("a")
    expect(parts[1]).toEq("b")
    expect(parts[2]).toEq("c")
  @it("should split string by delimiter")
  fn shouldSplitStringByDelimiter():
    parts = split("a,b,c", ",")
    expect(parts).toHaveLen(3)
    expect(parts[0]).toEq("a")
    expect(parts[1]).toEq("b")
    expect(parts[2]).toEq("c")
  @it("should split empty string")
  fn shouldSplitEmptyString():
    parts = split("", ",")
    expect(parts).toHaveLen(1)
    expect(parts[0]).toEq("")
  @it("should return whole string when delimiter not found")
  fn shouldReturnWholeStringWhenDelimiterNotFound():
    parts = split("hello", ",")
    expect(parts).toHaveLen(1)
    expect(parts[0]).toEq("hello")
  @it("should split by empty delimiter into characters")
  fn shouldSplitByEmptyDelimiterIntoCharacters():
    parts = split("hello", "")
    expect(parts).toHaveLen(5)
    expect(parts[0]).toEq("h")
    expect(parts[1]).toEq("e")
    expect(parts[2]).toEq("l")
    expect(parts[3]).toEq("l")
    expect(parts[4]).toEq("o")
  @it("should split single char by empty delimiter")
  fn shouldSplitSingleCharByEmptyDelimiter():
    parts = split("x", "")
    expect(parts).toHaveLen(1)
    expect(parts[0]).toEq("x")
  @it("should return empty list when splitting empty string with empty delimiter")
  fn shouldReturnEmptyListWhenSplittingEmptyStringWithEmptyDelimiter():
    parts = split("", "")
    expect(parts).toHaveLen(0)
  @it("should split unicode string by empty delimiter")
  fn shouldSplitUnicodeStringByEmptyDelimiter():
    parts = split("あいう", "")
    expect(parts).toHaveLen(3)
    expect(parts[0]).toEq("あ")
    expect(parts[1]).toEq("い")
    expect(parts[2]).toEq("う")
  @it("should join list with delimiter")
  fn shouldJoinListWithDelimiter():
    parts = ["a", "b", "c"]
    expect(join(parts, ",")).toEq("a,b,c")
    expect(join(parts, "-")).toEq("a-b-c")
  @it("should join empty list")
  fn shouldJoinEmptyList():
    parts: List<str> = ["x"]
    empty = filter(parts, (s: str) => false)
    expect(join(empty, ",")).toEq("")
  @it("should join single element")
  fn shouldJoinSingleElement():
    parts = ["only"]
    expect(join(parts, ",")).toEq("only")
  @it("should join via UFCS string receiver")
  fn shouldJoinViaUfcsStringReceiver():
    parts = ["a", "b", "c"]
    expect(",".join(parts)).toEq("a,b,c")
    expect("-".join(parts)).toEq("a-b-c")
    expect("".join(parts)).toEq("abc")

@describe("UTF-8 support")
fn utf8SupportTests():
  @it("should count characters with length")
  fn shouldCountCharactersWithLength():
    expect("hello").toHaveLen(5)
    expect("あいう").toHaveLen(3)
  @it("should count bytes with byteLen")
  fn shouldCountBytesWithBytelen():
    expect(byteLen("hello")).toEq(5)
    expect(byteLen("あいう")).toEq(9)
  @it("should report length 0 for empty string")
  fn shouldReportLength0ForEmptyString():
    expect("").toHaveLen(0)
  @it("should report byteLen 0 for empty string")
  fn shouldReportBytelen0ForEmptyString():
    expect(byteLen("")).toEq(0)
  @it("should get charAt for UTF-8 string")
  fn shouldGetCharatForUtf8String():
    expect(charAt("あいう", 1)).toEq("い")
  @it("should extract UTF-8 substr")
  fn shouldExtractUtf8Substr():
    expect(substr("あいう", 0, 2)).toEq("あい")
  @it("should reverse UTF-8 string")
  fn shouldReverseUtf8String():
    expect(reverse("あいう")).toEq("ういあ")

@describe("type conversion")
fn typeConversionTests():
  @it("should return Ok for valid toInt input")
  fn shouldReturnOkForValidTointInput():
    case toInt("42"):
      Ok(v):
        expect(v).toEq(42)
      Err(_):
        expect(false).toEq(true)
    case toInt("-7"):
      Ok(v):
        expect(v).toEq(-7)
      Err(_):
        expect(false).toEq(true)
    expect(toInt("123")).toBeOk()
    expect(toInt("0")).toBeOk()
  @it("should return Err for invalid toInt input")
  fn shouldReturnErrForInvalidTointInput():
    expect(toInt("abc")).toBeErr()
    expect(toInt("")).toBeErr()
    expect(toInt("12abc")).toBeErr()
    expect(toInt("9223372036854775808")).toBeErr()
    expect(toInt("-9223372036854775809")).toBeErr()
  @it("should return Result from toInt via UFCS")
  fn shouldReturnResultFromTointViaUfcs():
    case "99".toInt():
      Ok(v):
        expect(v).toEq(99)
      Err(_):
        expect(false).toEq(true)
  @it("should return Ok for valid toFloat input")
  fn shouldReturnOkForValidTofloatInput():
    case toFloat("3.14"):
      Ok(v):
        expect(v).toEq(3.14)
      Err(_):
        expect(false).toEq(true)
    case toFloat("-0.5"):
      Ok(v):
        expect(v).toEq(-0.5)
      Err(_):
        expect(false).toEq(true)
    expect(toFloat("2.5")).toBeOk()
    expect(toFloat("0")).toBeOk()
  @it("should return Err for invalid toFloat input")
  fn shouldReturnErrForInvalidTofloatInput():
    expect(toFloat("xyz")).toBeErr()
    expect(toFloat("")).toBeErr()
    expect(toFloat("1.2abc")).toBeErr()
    expect(toFloat("1e400")).toBeErr()
  @it("should return Result from toFloat via UFCS")
  fn shouldReturnResultFromTofloatViaUfcs():
    case "3.14".toFloat():
      Ok(v):
        expect(v).toEq(3.14)
      Err(_):
        expect(false).toEq(true)
  @it("should convert value to string with toStr")
  fn shouldConvertValueToStringWithTostr():
    expect(toStr(42)).toEq("42")
    expect(toStr(true)).toEq("true")
    expect(toStr(99)).toEq("99")

@describe("parse conversion")
fn parseConversionTests():
  @it("should return Ok for valid parseInt input")
  fn shouldReturnOkForValidParseintInput():
    case parseInt("42"):
      Ok(v):
        expect(v).toEq(42)
      Err(_):
        expect(false).toEq(true)
    case parseInt("-7"):
      Ok(v):
        expect(v).toEq(-7)
      Err(_):
        expect(false).toEq(true)
    expect(parseInt("123")).toBeOk()
    expect(parseInt("0")).toBeOk()
  @it("should return Err for invalid parseInt input")
  fn shouldReturnErrForInvalidParseintInput():
    expect(parseInt("abc")).toBeErr()
    expect(parseInt("")).toBeErr()
    expect(parseInt("12abc")).toBeErr()
    expect(parseInt("9223372036854775808")).toBeErr()
    expect(parseInt("-9223372036854775809")).toBeErr()
  @it("should return Result from parseInt via UFCS")
  fn shouldReturnResultFromParseintViaUfcs():
    case "99".parseInt():
      Ok(v):
        expect(v).toEq(99)
      Err(_):
        expect(false).toEq(true)
  @it("should carry the parseInt prefix in the error message")
  fn shouldCarryTheParseintPrefixInTheErrorMessage():
    case parseInt("abc"):
      Ok(_):
        expect(false).toEq(true)
      Err(e):
        expect(e.message).toContain("parseInt")
  @it("should return Ok for valid parseFloat input")
  fn shouldReturnOkForValidParsefloatInput():
    case parseFloat("3.14"):
      Ok(v):
        expect(v).toEq(3.14)
      Err(_):
        expect(false).toEq(true)
    case parseFloat("-0.5"):
      Ok(v):
        expect(v).toEq(-0.5)
      Err(_):
        expect(false).toEq(true)
    expect(parseFloat("2.5")).toBeOk()
    expect(parseFloat("0")).toBeOk()
  @it("should return Err for invalid parseFloat input")
  fn shouldReturnErrForInvalidParsefloatInput():
    expect(parseFloat("xyz")).toBeErr()
    expect(parseFloat("")).toBeErr()
    expect(parseFloat("1.2abc")).toBeErr()
    expect(parseFloat("1e400")).toBeErr()
  @it("should return Result from parseFloat via UFCS")
  fn shouldReturnResultFromParsefloatViaUfcs():
    case "3.14".parseFloat():
      Ok(v):
        expect(v).toEq(3.14)
      Err(_):
        expect(false).toEq(true)
  @it("should carry the parseFloat prefix in the error message")
  fn shouldCarryTheParsefloatPrefixInTheErrorMessage():
    case parseFloat("xyz"):
      Ok(_):
        expect(false).toEq(true)
      Err(e):
        expect(e.message).toContain("parseFloat")

@describe("NUL byte handling")
fn nulByteHandlingTests():
  @it("byteLen counts embedded NUL bytes")
  fn bytelenCountsEmbeddedNulBytes():
    expect(byteLen("a\0b")).toEq(3)
    expect(byteLen("\0")).toEq(1)
    expect(byteLen("\0\0")).toEq(2)
    expect(byteLen("")).toEq(0)
  @it("length counts all characters including embedded NUL")
  fn lengthCountsAllCharactersIncludingEmbeddedNul():
    expect(len("a\0b")).toEq(3)
    expect(len("\0")).toEq(1)
  @it("equality distinguishes strings with embedded NUL")
  fn equalityDistinguishesStringsWithEmbeddedNul():
    expect("a" == "a\0b").toEq(false)
    expect("a\0b" == "a\0b").toEq(true)
    expect("a\0b" == "a\0c").toEq(false)
    expect("a\0" == "a").toEq(false)
  @it("inequality distinguishes strings with embedded NUL (#1022)")
  fn inequalityDistinguishesStringsWithEmbeddedNul1022():
    expect("a" != "a\0b").toEq(true)
    expect("a\0b" != "a\0b").toEq(false)
    expect("a\0b" != "a\0c").toEq(true)
    expect("a\0" != "a").toEq(true)
  @it("concat preserves embedded NUL bytes")
  fn concatPreservesEmbeddedNulBytes():
    s = "a\0" + "b\0"
    expect(byteLen(s)).toEq(4)
    s2 = "\0" + "\0"
    expect(byteLen(s2)).toEq(2)
    expect(s2 == "\0\0").toEq(true)
  @it("Map<str, T> handles keys with embedded NUL")
  fn mapStrTHandlesKeysWithEmbeddedNul():
    m: Map<str, int> = {"a\0x": 1, "a\0y": 2}
    expect(m["a\0x"]).toEq(1)
    expect(m["a\0y"]).toEq(2)
  @it("bytesToStr round-trips embedded NUL")
  fn bytestostrRoundTripsEmbeddedNul():
    # Use toBytes to get a byte list from a NUL-containing string,
    # then verify bytesToStr recovers the original string.
    orig = "a\0b"
    bs = toBytes(orig)
    expect(len(bs)).toEq(3)
    case bytesToStr(bs):
      Ok(s):
        expect(byteLen(s)).toEq(3)
        expect(s == orig).toEq(true)
      Err(_):
        expect(false).toEq(true)
  @it("contains finds substr crossing embedded NUL (#1047)")
  fn containsFindsSubstrCrossingEmbeddedNul1047():
    expect(contains("a\0b", "\0b")).toEq(true)
    expect(contains("a\0b", "\0c")).toEq(false)
    expect(contains("a\0b", "a\0")).toEq(true)
    expect(contains("a\0b", "b")).toEq(true)
  @it("contains case-insensitive with embedded NUL (#1047)")
  fn containsCaseInsensitiveWithEmbeddedNul1047():
    expect(contains("A\0B", "a\0b", true)).toEq(true)
    expect(contains("A\0B", "a\0c", true)).toEq(false)
  @it("contains finds bare NUL needle (#1022)")
  fn containsFindsBareNulNeedle1022():
    expect(contains("a\0b", "\0")).toEq(true)
    expect(contains("abc", "\0")).toEq(false)
    expect(contains("\0", "\0")).toEq(true)
  @it("startsWith with embedded NUL (#1047)")
  fn startswithWithEmbeddedNul1047():
    expect(startsWith("a\0b", "a\0")).toEq(true)
    expect(startsWith("a\0b", "a\0c")).toEq(false)
    expect(startsWith("a", "a\0")).toEq(false)
  @it("startsWith case-insensitive with embedded NUL (#1047)")
  fn startswithCaseInsensitiveWithEmbeddedNul1047():
    expect(startsWith("A\0B", "a\0", true)).toEq(true)
  @it("endsWith with embedded NUL (#1047)")
  fn endswithWithEmbeddedNul1047():
    expect(endsWith("a\0b", "\0b")).toEq(true)
    expect(endsWith("a\0b", "\0c")).toEq(false)
    expect(endsWith("b", "\0b")).toEq(false)
  @it("endsWith case-insensitive with embedded NUL (#1047)")
  fn endswithCaseInsensitiveWithEmbeddedNul1047():
    expect(endsWith("A\0B", "\0b", true)).toEq(true)
  @it("find returns correct char index for NUL-containing string (#1047)")
  fn findReturnsCorrectCharIndexForNulContainingString1047():
    expect(find("a\0b", "\0")).toEq(Some(1))
    expect(find("a\0b", "\0b")).toEq(Some(1))
    expect(find("a\0b", "b")).toEq(Some(2))
    expect(find("a\0b", "c")).toBeNone()
  @it("find returns first match in multi-NUL haystack (#1022)")
  fn findReturnsFirstMatchInMultiNulHaystack1022():
    expect(find("a\0b\0c", "\0")).toEq(Some(1))
    expect(find("a\0b\0c", "\0c")).toEq(Some(3))
    expect(find("a\0b\0c", "b\0c")).toEq(Some(2))
    expect(find("\0\0\0", "\0")).toEq(Some(0))
  @it("empty needle parity for NUL-containing strings (#1047)")
  fn emptyNeedleParityForNulContainingStrings1047():
    s = "a\0b"
    expect(contains(s, "")).toEq(true)
    expect(startsWith(s, "")).toEq(true)
    expect(endsWith(s, "")).toEq(true)
    expect(find(s, "")).toEq(Some(0))
  @it("substr extracts across embedded NUL (#1049)")
  fn substrExtractsAcrossEmbeddedNul1049():
    expect(substr("a\0b", 0, 3) == "a\0b").toEq(true)
    expect(substr("a\0b", 0, 2) == "a\0").toEq(true)
    expect(substr("a\0b", 1, 3) == "\0b").toEq(true)
    expect(substr("a\0b", 1, 2) == "\0").toEq(true)
    expect(substr("a\0b", 2, 3)).toEq("b")
  @it("substr NUL-only string (#1049)")
  fn substrNulOnlyString1049():
    expect(substr("\0\0\0", 0, 3) == "\0\0\0").toEq(true)
    expect(substr("\0\0\0", 1, 2) == "\0").toEq(true)
  @it("charAt returns correct char for NUL-containing string (#1049)")
  fn charatReturnsCorrectCharForNulContainingString1049():
    expect(charAt("a\0b", 0)).toEq("a")
    expect(charAt("a\0b", 1) == "\0").toEq(true)
    expect(charAt("a\0b", 2)).toEq("b")
  @it("reverse NUL-containing string preserves bytes (#1049)")
  fn reverseNulContainingStringPreservesBytes1049():
    r = reverse("a\0b")
    expect(byteLen(r)).toEq(3)
    expect(r == "b\0a").toEq(true)
    r2 = reverse("\0ab")
    expect(r2 == "ba\0").toEq(true)
  @it("split by empty delimiter on NUL-containing string (#1049)")
  fn splitByEmptyDelimiterOnNulContainingString1049():
    parts = split("a\0b", "")
    expect(parts).toHaveLen(3)
    expect(parts[0]).toEq("a")
    expect(byteLen(parts[1])).toEq(1)
    expect(parts[1] == "\0").toEq(true)
    expect(parts[2]).toEq("b")
  @it("for c in str iterates all chars including NUL (#1049)")
  fn forCInStrIteratesAllCharsIncludingNul1049():
    s = "a\0b"
    count = 0
    for c in s:
      count = count + 1
    expect(count).toEq(3)
  @it("enumerate on NUL-containing string gives correct count (#1049)")
  fn enumerateOnNulContainingStringGivesCorrectCount1049():
    s = "a\0b"
    count = 0
    for i, c in enumerate(s):
      count = count + 1
    expect(count).toEq(3)
    expect(count).toEq(len(s))

  @it("replace finds and rewrites NUL needle (#1048)")
  fn replaceFindsAndRewritesNulNeedle1048():
    expect(replace("a\0b\0a", "\0", "-")).toEq("a-b-a")
    expect(replace("\0\0\0", "\0", "X")).toEq("XXX")

  @it("replace preserves NUL bytes in haystack tail (#1048)")
  fn replacePreservesNulBytesInHaystackTail1048():
    expect(replace("a\0b\0a", "a", "X") == "X\0b\0X").toEq(true)
    expect(replace("foo\0bar\0foo", "foo", "Y") == "Y\0bar\0Y").toEq(true)

  @it("replace handles NUL inside multi-byte needle (#1048)")
  fn replaceHandlesNulInsideMultiByteNeedle1048():
    expect(replace("xx\0yy\0xx", "\0y", "Z") == "xxZy\0xx").toEq(true)

  @it("replace empty needle returns input unchanged (NUL parity #1048)")
  fn replaceEmptyNeedleReturnsInputUnchangedNulParity1048():
    expect(replace("a\0b", "", "X") == "a\0b").toEq(true)

  @it("replace inserts NUL bytes from replacement (#1048)")
  fn replaceInsertsNulBytesFromReplacement1048():
    expect(replace("ab", "a", "x\0y") == "x\0yb").toEq(true)
    expect(replace("aa", "a", "\0") == "\0\0").toEq(true)

  @it("toUpper preserves embedded NUL (#1050)")
  fn toupperPreservesEmbeddedNul1050():
    expect(toUpper("a\0B") == "A\0B").toEq(true)
    expect(byteLen(toUpper("a\0B"))).toEq(3)
    expect(toUpper("\0") == "\0").toEq(true)
    expect(byteLen(toUpper("\0"))).toEq(1)
  @it("toLower preserves embedded NUL (#1050)")
  fn tolowerPreservesEmbeddedNul1050():
    expect(toLower("A\0b") == "a\0b").toEq(true)
    expect(byteLen(toLower("A\0b"))).toEq(3)
    expect(toLower("\0") == "\0").toEq(true)
    expect(byteLen(toLower("\0"))).toEq(1)
  @it("trim preserves interior NUL (#1050)")
  fn trimPreservesInteriorNul1050():
    expect(trim("  a\0b  ") == "a\0b").toEq(true)
    expect(byteLen(trim("  a\0b  "))).toEq(3)
    expect(trim("  \0  ") == "\0").toEq(true)
  @it("trimStart preserves interior NUL (#1050)")
  fn trimstartPreservesInteriorNul1050():
    expect(trimStart("  a\0b") == "a\0b").toEq(true)
    expect(byteLen(trimStart("  a\0b"))).toEq(3)
  @it("trimEnd preserves interior NUL (#1050)")
  fn trimendPreservesInteriorNul1050():
    expect(trimEnd("a\0b  ") == "a\0b").toEq(true)
    expect(byteLen(trimEnd("a\0b  "))).toEq(3)

  @it("join preserves embedded NUL in elements and sep (#1051)")
  fn joinPreservesEmbeddedNulInElementsAndSep1051():
    result = join(["a\0x", "b\0y"], "\0,")
    expected = "a\0x\0,b\0y"
    expect(result == expected).toEq(true)
    expect(byteLen(result)).toEq(8)
  @it("repeat preserves embedded NUL (#1051)")
  fn repeatPreservesEmbeddedNul1051():
    result = "\0a".repeat(3)
    expected = "\0a\0a\0a"
    expect(result == expected).toEq(true)
    expect(byteLen(result)).toEq(6)
  @it("* operator preserves embedded NUL (#1051)")
  fn operatorPreservesEmbeddedNul1051():
    result = "a\0" * 2
    expected = "a\0a\0"
    expect(result == expected).toEq(true)
    expect(byteLen(result)).toEq(4)

  @it("split preserves embedded NUL in string with non-empty delim (#1051)")
  fn splitPreservesEmbeddedNulInStringWithNonEmptyDelim1051():
    parts = split("a\0b,c\0d", ",")
    expect(parts).toHaveLen(2)
    expect(parts[0] == "a\0b").toEq(true)
    expect(parts[1] == "c\0d").toEq(true)
    expect(byteLen(parts[0])).toEq(3)
    expect(byteLen(parts[1])).toEq(3)
  @it("split matches delimiter containing NUL (#1051)")
  fn splitMatchesDelimiterContainingNul1051():
    parts = split("x\0|y\0|z", "\0|")
    expect(parts).toHaveLen(3)
    expect(parts[0]).toEq("x")
    expect(parts[1]).toEq("y")
    expect(parts[2]).toEq("z")
  @it("split where delim is single NUL (#1051)")
  fn splitWhereDelimIsSingleNul1051():
    parts = split("a\0b\0c", "\0")
    expect(parts).toHaveLen(3)
    expect(parts[0]).toEq("a")
    expect(parts[1]).toEq("b")
    expect(parts[2]).toEq("c")
  @it("split with delim not found preserves NUL subject (#1051)")
  fn splitWithDelimNotFoundPreservesNulSubject1051():
    parts = split("a\0b", "|")
    expect(parts).toHaveLen(1)
    expect(parts[0] == "a\0b").toEq(true)
    expect(byteLen(parts[0])).toEq(3)
