from io import bytes_to_str, to_bytes

describe("search and check", ():
  it("should check contains", ():
    expect("hello").to_contain("ell")
    expect(contains("hello", "xyz")).to_be_false()
  )
  it("should check starts_with", ():
    expect("hello").to_start_with("hel")
    expect(starts_with("hello", "world")).to_be_false()
  )
  it("should check ends_with", ():
    expect("hello").to_end_with("llo")
    expect(ends_with("hello", "world")).to_be_false()
  )
  it("should check contains case-insensitively", ():
    expect(contains("Hello World", "hello", true)).to_be_true()
    expect(contains("Hello World", "WORLD", true)).to_be_true()
    expect(contains("Hello World", "xyz", true)).to_be_false()
    expect(contains("Hello", "hello", false)).to_be_false()
    expect("Hello".contains("hello", true)).to_be_true()
  )
  it("should check starts_with case-insensitively", ():
    expect(starts_with("Hello World", "hello", true)).to_be_true()
    expect(starts_with("Hello World", "HELLO", true)).to_be_true()
    expect(starts_with("Hello World", "world", true)).to_be_false()
    expect("Hello".starts_with("hel", true)).to_be_true()
  )
  it("should check ends_with case-insensitively", ():
    expect(ends_with("Hello World", "world", true)).to_be_true()
    expect(ends_with("Hello World", "WORLD", true)).to_be_true()
    expect(ends_with("Hello World", "hello", true)).to_be_false()
    expect(ends_with("hi", "HELLO", true)).to_be_false()
    expect("Hello".ends_with("llo", true)).to_be_true()
  )
  it("should find substring", ():
    expect(find("hello world", "world")).to_eq(Some(6))
    expect(find("hello", "xyz")).to_be_none()
    expect(find("abcdef", "cd")).to_eq(Some(2))
  )
  it("should return none when finding in empty string", ():
    expect(find("", "x")).to_be_none()
  )
  it("should find empty needle at position 0", ():
    expect(find("hello", "")).to_eq(Some(0))
  )
  it("should return true when contains empty needle", ():
    expect(contains("hello", "")).to_be_true()
  )
  it("should return true when contains empty haystack and needle", ():
    expect(contains("", "")).to_be_true()
  )
)

describe("extraction and transformation", ():
  it("should extract substring", ():
    expect(substring("hello world", 0, 5)).to_eq("hello")
    expect(substring("abcdef", 1, 4)).to_eq("bcd")
  )
  it("should clamp out-of-bounds substring", ():
    expect(substring("abc", 0, 100)).to_eq("abc")
    expect(substring("abc", 5, 10)).to_eq("")
  )
  it("should clamp negative substring index to zero", ():
    expect(substring("abc", -1, 2)).to_eq("ab")
  )
  it("should get char_at position", ():
    expect(char_at("hello", 0)).to_eq("h")
    expect(char_at("abc", 2)).to_eq("c")
  )
  it("should replace substring", ():
    expect(replace("hello world", "world", "ry")).to_eq("hello ry")
    expect(replace("foo bar foo", "foo", "baz")).to_eq("baz bar baz")
  )
  it("should return original when replace target not found", ():
    expect(replace("hello", "xyz", "abc")).to_eq("hello")
  )
  it("should return input unchanged when pattern is empty (#802)", ():
    expect(replace("hello", "", "X")).to_eq("hello")
    expect(replace("", "", "X")).to_eq("")
  )
)

describe("is_empty on strings (#831)", ():
  it("should return true for empty string", ():
    expect(is_empty("")).to_eq(true)
  )
  it("should return false for non-empty string", ():
    expect(is_empty("hello")).to_eq(false)
  )
  it("should work via UFCS on empty string", ():
    expect("".is_empty()).to_eq(true)
  )
  it("should work via UFCS on non-empty string", ():
    expect("x".is_empty()).to_eq(false)
  )
  it("should handle multi-byte UTF-8 empty vs non-empty", ():
    expect(is_empty("")).to_eq(true)
    expect(is_empty("日本語")).to_eq(false)
  )
)

describe("case conversion", ():
  it("should convert to uppercase", ():
    expect(to_upper("hello")).to_eq("HELLO")
    expect(to_upper("Hello World")).to_eq("HELLO WORLD")
  )
  it("should handle empty string in to_upper", ():
    expect(to_upper("")).to_eq("")
  )
  it("should convert to lowercase", ():
    expect(to_lower("HELLO")).to_eq("hello")
    expect(to_lower("Hello World")).to_eq("hello world")
  )
  it("should handle empty string in to_lower", ():
    expect(to_lower("")).to_eq("")
  )
)

describe("whitespace", ():
  it("should trim whitespace", ():
    expect(trim("  hello  ")).to_eq("hello")
    expect(trim("  hi  ")).to_eq("hi")
  )
  it("should trim empty string", ():
    expect(trim("")).to_eq("")
  )
  it("should trim start whitespace", ():
    expect(trim_start("  hello  ")).to_eq("hello  ")
    expect(trim_start("  hi")).to_eq("hi")
  )
  it("should trim start of empty string", ():
    expect(trim_start("")).to_eq("")
  )
  it("should trim end whitespace", ():
    expect(trim_end("  hello  ")).to_eq("  hello")
    expect(trim_end("hi  ")).to_eq("hi")
  )
  it("should trim end of empty string", ():
    expect(trim_end("")).to_eq("")
  )
)

describe("generation", ():
  it("should repeat string", ():
    expect(repeat("ab", 3)).to_eq("ababab")
    expect(repeat("ha", 3)).to_eq("hahaha")
    expect(repeat("a", 0)).to_eq("")
    expect(repeat("a", -1)).to_eq("")
    expect(repeat("abc", -100)).to_eq("")
    expect(repeat("hello", 1)).to_eq("hello")
  )
  it("should repeat empty string", ():
    expect(repeat("", 5)).to_eq("")
  )
  it("should reverse string", ():
    expect(reverse("hello")).to_eq("olleh")
    expect(reverse("abc")).to_eq("cba")
  )
  it("should reverse empty string", ():
    expect(reverse("")).to_eq("")
  )
)

describe("split and join", ():
  it("should split string by delimiter", ():
    parts = split("a,b,c", ",")
    expect(parts).to_have_length(3)
    expect(parts[0]).to_eq("a")
    expect(parts[1]).to_eq("b")
    expect(parts[2]).to_eq("c")
  )
  it("should split empty string", ():
    parts = split("", ",")
    expect(parts).to_have_length(1)
    expect(parts[0]).to_eq("")
  )
  it("should return whole string when delimiter not found", ():
    parts = split("hello", ",")
    expect(parts).to_have_length(1)
    expect(parts[0]).to_eq("hello")
  )
  it("should split by empty delimiter into characters", ():
    parts = split("hello", "")
    expect(parts).to_have_length(5)
    expect(parts[0]).to_eq("h")
    expect(parts[1]).to_eq("e")
    expect(parts[2]).to_eq("l")
    expect(parts[3]).to_eq("l")
    expect(parts[4]).to_eq("o")
  )
  it("should split single char by empty delimiter", ():
    parts = split("x", "")
    expect(parts).to_have_length(1)
    expect(parts[0]).to_eq("x")
  )
  it("should return empty list when splitting empty string with empty delimiter", ():
    parts = split("", "")
    expect(parts).to_have_length(0)
  )
  it("should split unicode string by empty delimiter", ():
    parts = split("あいう", "")
    expect(parts).to_have_length(3)
    expect(parts[0]).to_eq("あ")
    expect(parts[1]).to_eq("い")
    expect(parts[2]).to_eq("う")
  )
  it("should join list with delimiter", ():
    parts = ["a", "b", "c"]
    expect(join(parts, ",")).to_eq("a,b,c")
    expect(join(parts, "-")).to_eq("a-b-c")
  )
  it("should join empty list", ():
    parts: List<str> = ["x"]
    empty = filter(parts, (s: str) => false)
    expect(join(empty, ",")).to_eq("")
  )
  it("should join single element", ():
    parts = ["only"]
    expect(join(parts, ",")).to_eq("only")
  )
  it("should join via UFCS string receiver", ():
    parts = ["a", "b", "c"]
    expect(",".join(parts)).to_eq("a,b,c")
    expect("-".join(parts)).to_eq("a-b-c")
    expect("".join(parts)).to_eq("abc")
  )
)

describe("UTF-8 support", ():
  it("should count characters with length", ():
    expect("hello").to_have_length(5)
    expect("あいう").to_have_length(3)
  )
  it("should count bytes with byte_len", ():
    expect(byte_len("hello")).to_eq(5)
    expect(byte_len("あいう")).to_eq(9)
  )
  it("should report length 0 for empty string", ():
    expect("").to_have_length(0)
  )
  it("should report byte_len 0 for empty string", ():
    expect(byte_len("")).to_eq(0)
  )
  it("should get char_at for UTF-8 string", ():
    expect(char_at("あいう", 1)).to_eq("い")
  )
  it("should extract UTF-8 substring", ():
    expect(substring("あいう", 0, 2)).to_eq("あい")
  )
  it("should reverse UTF-8 string", ():
    expect(reverse("あいう")).to_eq("ういあ")
  )
)

describe("type conversion", ():
  it("should return Ok for valid to_int input", ():
    case to_int("42"):
      Ok(v):
        expect(v).to_eq(42)
      Err(_):
        expect(false).to_eq(true)
    case to_int("-7"):
      Ok(v):
        expect(v).to_eq(-7)
      Err(_):
        expect(false).to_eq(true)
    expect(to_int("123")).to_be_ok()
    expect(to_int("0")).to_be_ok()
  )
  it("should return Err for invalid to_int input", ():
    expect(to_int("abc")).to_be_err()
    expect(to_int("")).to_be_err()
    expect(to_int("12abc")).to_be_err()
    expect(to_int("9223372036854775808")).to_be_err()
    expect(to_int("-9223372036854775809")).to_be_err()
  )
  it("should return Result from to_int via UFCS", ():
    case "99".to_int():
      Ok(v):
        expect(v).to_eq(99)
      Err(_):
        expect(false).to_eq(true)
  )
  it("should return Ok for valid to_float input", ():
    case to_float("3.14"):
      Ok(v):
        expect(v).to_eq(3.14)
      Err(_):
        expect(false).to_eq(true)
    case to_float("-0.5"):
      Ok(v):
        expect(v).to_eq(-0.5)
      Err(_):
        expect(false).to_eq(true)
    expect(to_float("2.5")).to_be_ok()
    expect(to_float("0")).to_be_ok()
  )
  it("should return Err for invalid to_float input", ():
    expect(to_float("xyz")).to_be_err()
    expect(to_float("")).to_be_err()
    expect(to_float("1.2abc")).to_be_err()
    expect(to_float("1e400")).to_be_err()
  )
  it("should return Result from to_float via UFCS", ():
    case "3.14".to_float():
      Ok(v):
        expect(v).to_eq(3.14)
      Err(_):
        expect(false).to_eq(true)
  )
  it("should convert value to string with to_str", ():
    expect(to_str(42)).to_eq("42")
    expect(to_str(true)).to_eq("true")
    expect(to_str(99)).to_eq("99")
  )
)

describe("NUL byte handling", ():
  it("byte_len counts embedded NUL bytes", ():
    expect(byte_len("a\0b")).to_eq(3)
    expect(byte_len("\0")).to_eq(1)
    expect(byte_len("\0\0")).to_eq(2)
    expect(byte_len("")).to_eq(0)
  )
  it("length counts all characters including embedded NUL", ():
    expect(length("a\0b")).to_eq(3)
    expect(length("\0")).to_eq(1)
  )
  it("equality distinguishes strings with embedded NUL", ():
    expect("a" == "a\0b").to_eq(false)
    expect("a\0b" == "a\0b").to_eq(true)
    expect("a\0b" == "a\0c").to_eq(false)
    expect("a\0" == "a").to_eq(false)
  )
  it("concat preserves embedded NUL bytes", ():
    s = "a\0" + "b\0"
    expect(byte_len(s)).to_eq(4)
    s2 = "\0" + "\0"
    expect(byte_len(s2)).to_eq(2)
    expect(s2 == "\0\0").to_eq(true)
  )
  it("Map<str, T> handles keys with embedded NUL", ():
    m: Map<str, int> = {"a\0x": 1, "a\0y": 2}
    expect(m["a\0x"]).to_eq(1)
    expect(m["a\0y"]).to_eq(2)
  )
  it("bytes_to_str round-trips embedded NUL", ():
    # Use to_bytes to get a byte list from a NUL-containing string,
    # then verify bytes_to_str recovers the original string.
    orig = "a\0b"
    bs = to_bytes(orig)
    expect(length(bs)).to_eq(3)
    case bytes_to_str(bs):
      Ok(s):
        expect(byte_len(s)).to_eq(3)
        expect(s == orig).to_eq(true)
      Err(_):
        expect(false).to_eq(true)
  )
  it("contains finds substring crossing embedded NUL (#1047)", ():
    expect(contains("a\0b", "\0b")).to_eq(true)
    expect(contains("a\0b", "\0c")).to_eq(false)
    expect(contains("a\0b", "a\0")).to_eq(true)
    expect(contains("a\0b", "b")).to_eq(true)
  )
  it("contains case-insensitive with embedded NUL (#1047)", ():
    expect(contains("A\0B", "a\0b", true)).to_eq(true)
    expect(contains("A\0B", "a\0c", true)).to_eq(false)
  )
  it("starts_with with embedded NUL (#1047)", ():
    expect(starts_with("a\0b", "a\0")).to_eq(true)
    expect(starts_with("a\0b", "a\0c")).to_eq(false)
    expect(starts_with("a", "a\0")).to_eq(false)
  )
  it("starts_with case-insensitive with embedded NUL (#1047)", ():
    expect(starts_with("A\0B", "a\0", true)).to_eq(true)
  )
  it("ends_with with embedded NUL (#1047)", ():
    expect(ends_with("a\0b", "\0b")).to_eq(true)
    expect(ends_with("a\0b", "\0c")).to_eq(false)
    expect(ends_with("b", "\0b")).to_eq(false)
  )
  it("ends_with case-insensitive with embedded NUL (#1047)", ():
    expect(ends_with("A\0B", "\0b", true)).to_eq(true)
  )
  it("find returns correct char index for NUL-containing string (#1047)", ():
    expect(find("a\0b", "\0")).to_eq(Some(1))
    expect(find("a\0b", "\0b")).to_eq(Some(1))
    expect(find("a\0b", "b")).to_eq(Some(2))
    expect(find("a\0b", "c")).to_be_none()
  )
  it("empty needle parity for NUL-containing strings (#1047)", ():
    s = "a\0b"
    expect(contains(s, "")).to_eq(true)
    expect(starts_with(s, "")).to_eq(true)
    expect(ends_with(s, "")).to_eq(true)
    expect(find(s, "")).to_eq(Some(0))
  )
  it("substring extracts across embedded NUL (#1049)", ():
    expect(substring("a\0b", 0, 3) == "a\0b").to_eq(true)
    expect(substring("a\0b", 0, 2) == "a\0").to_eq(true)
    expect(substring("a\0b", 1, 3) == "\0b").to_eq(true)
    expect(substring("a\0b", 1, 2) == "\0").to_eq(true)
    expect(substring("a\0b", 2, 3)).to_eq("b")
  )
  it("substring NUL-only string (#1049)", ():
    expect(substring("\0\0\0", 0, 3) == "\0\0\0").to_eq(true)
    expect(substring("\0\0\0", 1, 2) == "\0").to_eq(true)
  )
  it("char_at returns correct char for NUL-containing string (#1049)", ():
    expect(char_at("a\0b", 0)).to_eq("a")
    expect(char_at("a\0b", 1) == "\0").to_eq(true)
    expect(char_at("a\0b", 2)).to_eq("b")
  )
  it("reverse NUL-containing string preserves bytes (#1049)", ():
    r = reverse("a\0b")
    expect(byte_len(r)).to_eq(3)
    expect(r == "b\0a").to_eq(true)
    r2 = reverse("\0ab")
    expect(r2 == "ba\0").to_eq(true)
  )
  it("split by empty delimiter on NUL-containing string (#1049)", ():
    parts = split("a\0b", "")
    expect(parts).to_have_length(3)
    expect(parts[0]).to_eq("a")
    expect(byte_len(parts[1])).to_eq(1)
    expect(parts[1] == "\0").to_eq(true)
    expect(parts[2]).to_eq("b")
  )
  it("for c in str iterates all chars including NUL (#1049)", ():
    s = "a\0b"
    count = 0
    for c in s:
      count = count + 1
    expect(count).to_eq(3)
  )
  it("enumerate on NUL-containing string gives correct count (#1049)", ():
    s = "a\0b"
    count = 0
    for i, c in enumerate(s):
      count = count + 1
    expect(count).to_eq(3)
    expect(count).to_eq(length(s))
  )

  it("replace finds and rewrites NUL needle (#1048)", ():
    expect(replace("a\0b\0a", "\0", "-")).to_eq("a-b-a")
    expect(replace("\0\0\0", "\0", "X")).to_eq("XXX")
  )

  it("replace preserves NUL bytes in haystack tail (#1048)", ():
    expect(replace("a\0b\0a", "a", "X") == "X\0b\0X").to_eq(true)
    expect(replace("foo\0bar\0foo", "foo", "Y") == "Y\0bar\0Y").to_eq(true)
  )

  it("replace handles NUL inside multi-byte needle (#1048)", ():
    expect(replace("xx\0yy\0xx", "\0y", "Z") == "xxZy\0xx").to_eq(true)
  )

  it("replace empty needle returns input unchanged (NUL parity #1048)", ():
    expect(replace("a\0b", "", "X") == "a\0b").to_eq(true)
  )

  it("replace inserts NUL bytes from replacement (#1048)", ():
    expect(replace("ab", "a", "x\0y") == "x\0yb").to_eq(true)
    expect(replace("aa", "a", "\0") == "\0\0").to_eq(true)
  )

  it("to_upper preserves embedded NUL (#1050)", ():
    expect(to_upper("a\0B") == "A\0B").to_eq(true)
    expect(byte_len(to_upper("a\0B"))).to_eq(3)
    expect(to_upper("\0") == "\0").to_eq(true)
    expect(byte_len(to_upper("\0"))).to_eq(1)
  )
  it("to_lower preserves embedded NUL (#1050)", ():
    expect(to_lower("A\0b") == "a\0b").to_eq(true)
    expect(byte_len(to_lower("A\0b"))).to_eq(3)
    expect(to_lower("\0") == "\0").to_eq(true)
    expect(byte_len(to_lower("\0"))).to_eq(1)
  )
  it("trim preserves interior NUL (#1050)", ():
    expect(trim("  a\0b  ") == "a\0b").to_eq(true)
    expect(byte_len(trim("  a\0b  "))).to_eq(3)
    expect(trim("  \0  ") == "\0").to_eq(true)
  )
  it("trim_start preserves interior NUL (#1050)", ():
    expect(trim_start("  a\0b") == "a\0b").to_eq(true)
    expect(byte_len(trim_start("  a\0b"))).to_eq(3)
  )
  it("trim_end preserves interior NUL (#1050)", ():
    expect(trim_end("a\0b  ") == "a\0b").to_eq(true)
    expect(byte_len(trim_end("a\0b  "))).to_eq(3)
  )

  it("join preserves embedded NUL in elements and sep (#1051)", ():
    result = join(["a\0x", "b\0y"], "\0,")
    expected = "a\0x\0,b\0y"
    expect(result == expected).to_eq(true)
    expect(byte_len(result)).to_eq(8)
  )
  it("repeat preserves embedded NUL (#1051)", ():
    result = "\0a".repeat(3)
    expected = "\0a\0a\0a"
    expect(result == expected).to_eq(true)
    expect(byte_len(result)).to_eq(6)
  )
  it("* operator preserves embedded NUL (#1051)", ():
    result = "a\0" * 2
    expected = "a\0a\0"
    expect(result == expected).to_eq(true)
    expect(byte_len(result)).to_eq(4)
  )

  it("split preserves embedded NUL in string with non-empty delim (#1051)", ():
    parts = split("a\0b,c\0d", ",")
    expect(parts).to_have_length(2)
    expect(parts[0] == "a\0b").to_eq(true)
    expect(parts[1] == "c\0d").to_eq(true)
    expect(byte_len(parts[0])).to_eq(3)
    expect(byte_len(parts[1])).to_eq(3)
  )
  it("split matches delimiter containing NUL (#1051)", ():
    parts = split("x\0|y\0|z", "\0|")
    expect(parts).to_have_length(3)
    expect(parts[0]).to_eq("x")
    expect(parts[1]).to_eq("y")
    expect(parts[2]).to_eq("z")
  )
  it("split where delim is single NUL (#1051)", ():
    parts = split("a\0b\0c", "\0")
    expect(parts).to_have_length(3)
    expect(parts[0]).to_eq("a")
    expect(parts[1]).to_eq("b")
    expect(parts[2]).to_eq("c")
  )
  it("split with delim not found preserves NUL subject (#1051)", ():
    parts = split("a\0b", "|")
    expect(parts).to_have_length(1)
    expect(parts[0] == "a\0b").to_eq(true)
    expect(byte_len(parts[0])).to_eq(3)
  )
)
