from testing import it, describe, expect

@describe("lambda returning list literal")
fn lambdaReturningListLiteralTests():
  @it("should return list with correct length")
  fn shouldReturnListWithCorrectLength():
    f = (x: int) => [x, x * 2, x * 3]
    result = f(5)
    expect(result.len()).toEq(3)

  @it("should return list with correct elements")
  fn shouldReturnListWithCorrectElements():
    f = (x: int) => [x, x * 2, x * 3]
    result = f(5)
    expect(result[0]).toEq(5)
    expect(result[1]).toEq(10)
    expect(result[2]).toEq(15)

  @it("should return string list")
  fn shouldReturnStringList():
    f = (a: str, b: str) => [a, b]
    result = f("hello", "world")
    expect(result.len()).toEq(2)
    expect(result[0]).toEq("hello")
    expect(result[1]).toEq("world")

@describe("lambda returning map literal")
fn lambdaReturningMapLiteralTests():
  @it("should return map with correct length")
  fn shouldReturnMapWithCorrectLength():
    f = (x: int) => {"a": x, "b": x * 2}
    result = f(5)
    expect(result.len()).toEq(2)

  @it("should return map with correct values")
  fn shouldReturnMapWithCorrectValues():
    f = (x: int) => {"a": x, "b": x * 2}
    result = f(5)
    expect(result["a"]).toEq(5)
    expect(result["b"]).toEq(10)

@describe("lambda returning set literal")
fn lambdaReturningSetLiteralTests():
  @it("should return set with correct length")
  fn shouldReturnSetWithCorrectLength():
    f = (x: int) => {x, x * 2, x * 3}
    result = f(5)
    expect(result.len()).toEq(3)

@describe("lambda returning list with explicit type annotation")
fn lambdaReturningListWithExplicitTypeAnnotationTests():
  @it("should return list with correct length")
  fn shouldReturnListWithCorrectLength2():
    f = (x: int) -> List<int> => [x, x * 2, x * 3]
    result = f(5)
    expect(result.len()).toEq(3)
    expect(result[0]).toEq(5)

@describe("lambda returning nested list")
fn lambdaReturningNestedListTests():
  @it("should return nested list with correct structure")
  fn shouldReturnNestedListWithCorrectStructure():
    f = () => [[1, 2], [3, 4]]
    result = f()
    expect(result.len()).toEq(2)
    expect(result[0].len()).toEq(2)
    expect(result[1][0]).toEq(3)

@describe("block-bodied lambda returning list literal")
fn blockBodiedLambdaReturningListLiteralTests():
  @it("should return list with correct length")
  fn shouldReturnListWithCorrectLength3():
    f = (x: int):
      return [x, x * 2, x * 3]
    result = f(5)
    expect(result.len()).toEq(3)

  @it("should return list with correct elements")
  fn shouldReturnListWithCorrectElements2():
    f = (x: int):
      return [x, x * 2, x * 3]
    result = f(5)
    expect(result[0]).toEq(5)
    expect(result[1]).toEq(10)
    expect(result[2]).toEq(15)

  @it("should return string list")
  fn shouldReturnStringList2():
    f = (a: str, b: str):
      return [a, b]
    result = f("hello", "world")
    expect(result.len()).toEq(2)
    expect(result[0]).toEq("hello")
    expect(result[1]).toEq("world")

@describe("block-bodied lambda returning map literal")
fn blockBodiedLambdaReturningMapLiteralTests():
