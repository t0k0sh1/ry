fn add(a: int, b: int) -> int:
  return a + b

fn factorial(n: int) -> int:
  if n <= 1:
    return 1
  return n * factorial(n - 1)

fn area(side: int) -> int:
  return side * side

fn area(w: int, h: int) -> int:
  return w * h

fn apply(f: fn(int) -> int, x: int) -> int:
  return f(x)

fn double(x: int) -> int:
  return x * 2

fn addOne(x: int) -> int:
  return x + 1

record Vec2:
  x: float
  y: float

fn operator+(a: Vec2, b: Vec2) -> Vec2:
  return Vec2(a.x + b.x, a.y + b.y)

fn operator==(a: Vec2, b: Vec2) -> bool:
  return a.x == b.x and a.y == b.y

fn operator+=(a: Vec2, b: Vec2) -> Vec2:
  return Vec2(a.x + b.x, a.y + b.y)

describe("basic function", ():
  it("should call function", ():
    expect(add(1, 2)).to_eq(3)
  )
)

describe("recursion", ():
  it("should compute factorial recursively", ():
    expect(factorial(5)).to_eq(120)
  )
)

describe("overloading", ():
  it("should work with 1 arg", ():
    expect(area(5)).to_eq(25)
  )
  it("should work with 2 args", ():
    expect(area(3, 4)).to_eq(12)
  )
)

describe("lambda", ():
  it("should support single expression lambda", ():
    double = (x: int) => x * 2
    expect(double(5)).to_eq(10)
  )
  it("should support multi-line lambda", ():
    abs_val = (x: int):
      if x < 0:
        return -x
      return x
    expect(abs_val(-5)).to_eq(5)
  )
)

describe("closure", ():
  it("should capture by value", ():
    base = 10
    add_base = (x: int) => x + base
    base = 99
    expect(add_base(5)).to_eq(15)
  )
  it("should capture bool", ():
    flag = true
    check = () => flag
    expect(check()).to_be_true()
  )
)

describe("higher-order function", ():
  it("should pass function as argument", ():
    res = apply((x: int) => x * 3, 5)
    expect(res).to_eq(15)
  )
  it("should pass named function as argument", ():
    expect(apply(double, 5)).to_eq(10)
  )
)

describe("UFCS", ():
  it("should support method-style call", ():
    expect(double(5)).to_eq(10)
  )
  it("should support UFCS chaining", ():
    expect(5.double().addOne()).to_eq(11)
  )
)

fn inferInt():
  return 42

fn inferFloat():
  return 3.14

fn inferStr():
  return "hello"

fn inferBool():
  return true

fn inferUnit():
  print("")

fn inferUnion(flag: bool):
  if flag:
    return 42
  return 3.14

record InferPoint:
  x: int
  y: int

fn inferStruct():
  return InferPoint(3, 4)

describe("return type inference", ():
  it("should infer int return type", ():
    expect(inferInt()).to_eq(42)
  )
  it("should infer float return type", ():
    expect(inferFloat()).to_eq(3.14)
  )
  it("should infer str return type", ():
    expect(inferStr()).to_eq("hello")
  )
  it("should infer bool return type", ():
    expect(inferBool()).to_be_true()
  )
  it("should infer union type from mixed returns", ():
    x = inferUnion(true)
    y = inferUnion(false)
    expect(true).to_be_true()
  )
  it("should infer struct return type", ():
    p = inferStruct()
    expect(p.x).to_eq(3)
    expect(p.y).to_eq(4)
  )
  it("should infer struct return type from lambda", ():
    makePoint = (a: int, b: int):
      return InferPoint(a, b)
    p = makePoint(5, 6)
    expect(p.x).to_eq(5)
    expect(p.y).to_eq(6)
  )
)

describe("operator overloading", ():
  it("should overload binary +", ():
    v1 = Vec2(1.0, 2.0)
    v2 = Vec2(3.0, 4.0)
    v3 = v1 + v2
    expect(v3.x).to_eq(4.0)
    expect(v3.y).to_eq(6.0)
  )
  it("should overload == comparison", ():
    v1 = Vec2(1.0, 2.0)
    v2 = Vec2(1.0, 2.0)
    expect(v1 == v2).to_be_true()
  )
  it("should call operator+= for compound +=", ():
    v = Vec2(1.0, 2.0)
    v += Vec2(3.0, 4.0)
    expect(v.x).to_eq(4.0)
    expect(v.y).to_eq(6.0)
  )
)

fn sumTo(n: int, acc: int) -> int:
  if n <= 0:
    return acc
  return sumTo(n - 1, acc + n)

fn getValue() -> int:
  return 42

describe("zero arg function", ():
  it("should return value from zero arg function", ():
    expect(getValue()).to_eq(42)
  )
)

describe("tail call optimization", ():
  it("should not overflow with self-recursive tail call", ():
    expect(sumTo(1000000, 0)).to_eq(500000500000)
  )
)

# --- Return type inference for local variables (#770) ---

fn computeAndReturn(r: float):
  v = 4.0 * 3.14 * r * r * r / 3.0
  return v

fn transitiveLocal(x: int):
  a = x * 2
  b = a + 1
  return b

fn localFloat(x: float):
  result = x + 1.0
  return result

describe("return type inference for local variables", ():
  it("should infer return type from local variable", ():
    expect(computeAndReturn(1.0)).to_eq(4.0 * 3.14 / 3.0)
  )
  it("should infer return type through transitive locals", ():
    expect(transitiveLocal(5)).to_eq(11)
  )
  it("should infer float return type from local", ():
    expect(localFloat(2.5)).to_eq(3.5)
  )
  it("should infer return type for block-bodied lambda local", ():
    f = (x: int):
      y = x + 1
      return y
    expect(f(2)).to_eq(3)
  )
)
