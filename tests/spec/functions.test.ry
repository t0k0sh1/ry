function add(a: int, b: int) -> int:
  return a + b

function factorial(n: int) -> int:
  if n <= 1:
    return 1
  return n * factorial(n - 1)

function area(side: int) -> int:
  return side * side

function area(w: int, h: int) -> int:
  return w * h

function apply(f: function(int) -> int, x: int) -> int:
  return f(x)

function double(x: int) -> int:
  return x * 2

function add_one(x: int) -> int:
  return x + 1

record Vec2:
  x: float
  y: float

function operator+(a: Vec2, b: Vec2) -> Vec2:
  return Vec2(a.x + b.x, a.y + b.y)

function operator==(a: Vec2, b: Vec2) -> bool:
  return a.x == b.x and a.y == b.y

function operator+=(a: Vec2, b: Vec2) -> Vec2:
  return Vec2(a.x + b.x, a.y + b.y)

describe("basic function", ():
  it("call", ():
    expect(add(1, 2)).to_eq(3)
  )
)

describe("recursion", ():
  it("factorial", ():
    expect(factorial(5)).to_eq(120)
  )
)

describe("overloading", ():
  it("1 arg", ():
    expect(area(5)).to_eq(25)
  )
  it("2 args", ():
    expect(area(3, 4)).to_eq(12)
  )
)

describe("lambda", ():
  it("single expression", ():
    double = (x: int): x * 2
    expect(double(5)).to_eq(10)
  )
  it("multi-line", ():
    abs_val = (x: int):
      if x < 0:
        return -x
      return x
    expect(abs_val(-5)).to_eq(5)
  )
)

describe("closure", ():
  it("captures by value", ():
    base = 10
    add_base = (x: int): x + base
    base = 99
    expect(add_base(5)).to_eq(15)
  )
  it("captures bool", ():
    flag = true
    check = (): flag
    expect(check()).to_be_true()
  )
)

describe("higher-order function", ():
  it("function as argument", ():
    res = apply((x: int): x * 3, 5)
    expect(res).to_eq(15)
  )
  it("named function as argument", ():
    expect(apply(double, 5)).to_eq(10)
  )
)

describe("UFCS", ():
  it("method-style call", ():
    expect(double(5)).to_eq(10)
  )
  it("chaining", ():
    expect(add_one(double(5))).to_eq(11)
  )
)

function infer_int():
  return 42

function infer_float():
  return 3.14

function infer_str():
  return "hello"

function infer_bool():
  return true

function infer_unit():
  print("")

function infer_union(flag: bool):
  if flag:
    return 42
  return 3.14

describe("return type inference", ():
  it("infers int", ():
    expect(infer_int()).to_eq(42)
  )
  it("infers float", ():
    expect(infer_float()).to_eq(3.14)
  )
  it("infers str", ():
    expect(infer_str()).to_eq("hello")
  )
  it("infers bool", ():
    expect(infer_bool()).to_be_true()
  )
  it("infers union type from mixed returns", ():
    x = infer_union(true)
    y = infer_union(false)
    expect(true).to_be_true()
  )
)

describe("operator overloading", ():
  it("binary +", ():
    v1 = Vec2(1.0, 2.0)
    v2 = Vec2(3.0, 4.0)
    v3 = v1 + v2
    expect(v3.x).to_eq(4.0)
    expect(v3.y).to_eq(6.0)
  )
  it("== comparison", ():
    v1 = Vec2(1.0, 2.0)
    v2 = Vec2(1.0, 2.0)
    expect(v1 == v2).to_be_true()
  )
  it("compound += calls operator+=", ():
    v = Vec2(1.0, 2.0)
    v += Vec2(3.0, 4.0)
    expect(v.x).to_eq(4.0)
    expect(v.y).to_eq(6.0)
  )
)

function sum_to(n: int, acc: int) -> int:
  if n <= 0:
    return acc
  return sum_to(n - 1, acc + n)

function get_value() -> int:
  return 42

describe("zero arg function", ():
  it("returns value", ():
    expect(get_value()).to_eq(42)
  )
)

describe("tail call optimization", ():
  it("self-recursive tail call does not overflow", ():
    expect(sum_to(1000000, 0)).to_eq(500000500000)
  )
)
