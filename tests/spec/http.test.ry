from testing import it, describe

from net import bind, listen, accept, connect, listenerPort
from io import toBytes, bytesToStr

@describe("HTTP Server API")
fn httpServerApiTests():
  @it("should respond with 200 OK for matching path")
  fn shouldRespondWith200OkForMatchingPath():
    async fn server200(server: TcpListener) -> str:
      case accept(server):
        Ok(conn):
          case receive(conn, 4096):
            Ok(data):
              responseStr = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 6\r\n\r\nHello!"
              case send(conn, toBytes(responseStr)):
                Ok(_):
                  ...
                Err(e):
                  ...
            Err(e):
              ...
          close(conn)
        Err(e):
          ...
      close(server)
      return "done"
    case bind("127.0.0.1", 0):
      Ok(server):
        case listen(server, 1):
          Ok(_):
            port = listenerPort(server)
            t = server200(server)
            case connect("127.0.0.1", port):
              Ok(conn):
                case send(conn, toBytes("GET /hello HTTP/1.1\r\nHost: localhost\r\n\r\n")):
                  Ok(_):
                    ...
                  Err(e):
                    ...
                case receive(conn, 4096):
                  Ok(resp):
                    case bytesToStr(resp):
                      Ok(msg):
                        expect(contains(msg, "200 OK")).toEq(true)
                        expect(contains(msg, "Hello!")).toEq(true)
                      Err(e):
                        fail("unexpected error")
                  Err(e):
                    fail("unexpected error")
                close(conn)
              Err(e):
                fail("unexpected error")
            blockOn(t)
          Err(e):
            fail("unexpected error")
      Err(e):
        fail("unexpected error")
  @it("should respond with 404 Not Found")
  fn shouldRespondWith404NotFound():
    async fn server404(server: TcpListener) -> str:
      case accept(server):
        Ok(conn):
          case receive(conn, 4096):
            Ok(data):
              responseStr = "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 9\r\n\r\nNot Found"
              case send(conn, toBytes(responseStr)):
                Ok(_):
                  ...
                Err(e):
                  ...
            Err(e):
              ...
          close(conn)
        Err(e):
          ...
      close(server)
      return "done"
    case bind("127.0.0.1", 0):
      Ok(server):
        case listen(server, 1):
          Ok(_):
            port = listenerPort(server)
            t = server404(server)
            case connect("127.0.0.1", port):
              Ok(conn):
                case send(conn, toBytes("GET /missing HTTP/1.1\r\nHost: localhost\r\n\r\n")):
                  Ok(_):
                    ...
                  Err(e):
                    ...
                case receive(conn, 4096):
                  Ok(resp):
                    case bytesToStr(resp):
                      Ok(msg):
                        expect(contains(msg, "404 Not Found")).toEq(true)
                      Err(e):
                        fail("unexpected error")
                  Err(e):
                    fail("unexpected error")
                close(conn)
              Err(e):
                fail("unexpected error")
            blockOn(t)
          Err(e):
            fail("unexpected error")
      Err(e):
        fail("unexpected error")
