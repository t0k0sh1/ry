from std.http import http_listen, http_method, http_path, http_header, http_body, http_response
from std.net import bind, listen, accept, connect
from std.io import str_to_bytes, bytes_to_str

describe("HTTP Server API", fn():
    it("responds with 200 OK for matching path", fn():
        fn server_200(port: int) -> str:
            http_listen("127.0.0.1", port, fn(req: HttpRequest) -> HttpResponse:
                path = http_path(req)
                if path == "/hello":
                    return http_response(200, {"Content-Type": "text/plain"}, "Hello!")
                return http_response(404, {"Content-Type": "text/plain"}, "Not Found")
            )
            return "done"

        t: Task<str> = spawn server_200(18200)

        connected = false
        response_msg = ""
        attempt = 0
        while attempt < 500 and not connected:
            match connect("127.0.0.1", 18200):
                case Some(conn):
                    send(conn, str_to_bytes("GET /hello HTTP/1.1\r\nHost: localhost\r\n\r\n"))
                    resp: List<byte> = recv(conn, 4096)
                    response_msg = bytes_to_str(resp)
                    close(conn)
                    connected = true
                case None:
                    attempt = attempt + 1

        expect(contains(response_msg, "200 OK")).to_eq(true)
        expect(contains(response_msg, "Hello!")).to_eq(true)

    )
    it("returns method and path in response body", fn():
        fn server_method(port: int) -> str:
            http_listen("127.0.0.1", port, fn(req: HttpRequest) -> HttpResponse:
                method = http_method(req)
                path = http_path(req)
                return http_response(200, {"Content-Type": "text/plain"}, method + ":" + path)
            )
            return "done"

        t: Task<str> = spawn server_method(18201)

        connected = false
        response_msg = ""
        attempt = 0
        while attempt < 500 and not connected:
            match connect("127.0.0.1", 18201):
                case Some(conn):
                    send(conn, str_to_bytes("POST /api/data HTTP/1.1\r\nHost: localhost\r\n\r\n"))
                    resp: List<byte> = recv(conn, 4096)
                    response_msg = bytes_to_str(resp)
                    close(conn)
                    connected = true
                case None:
                    attempt = attempt + 1

        expect(contains(response_msg, "POST:/api/data")).to_eq(true)

    )
    it("returns header value via http_header", fn():
        fn server_header(port: int) -> str:
            http_listen("127.0.0.1", port, fn(req: HttpRequest) -> HttpResponse:
                match http_header(req, "X-Custom"):
                    case Some(val):
                        return http_response(200, {"Content-Type": "text/plain"}, "header:" + val)
                    case None:
                        return http_response(200, {"Content-Type": "text/plain"}, "no-header")
            )
            return "done"

        t: Task<str> = spawn server_header(18202)

        connected = false
        response_msg = ""
        attempt = 0
        while attempt < 500 and not connected:
            match connect("127.0.0.1", 18202):
                case Some(conn):
                    send(conn, str_to_bytes("GET / HTTP/1.1\r\nHost: localhost\r\nX-Custom: test-value\r\n\r\n"))
                    resp: List<byte> = recv(conn, 4096)
                    response_msg = bytes_to_str(resp)
                    close(conn)
                    connected = true
                case None:
                    attempt = attempt + 1

        expect(contains(response_msg, "header:test-value")).to_eq(true)

    )
    it("responds with 404 Not Found", fn():
        fn server_404(port: int) -> str:
            http_listen("127.0.0.1", port, fn(req: HttpRequest) -> HttpResponse:
                return http_response(404, {"Content-Type": "text/plain"}, "Not Found")
            )
            return "done"

        t: Task<str> = spawn server_404(18203)

        connected = false
        response_msg = ""
        attempt = 0
        while attempt < 500 and not connected:
            match connect("127.0.0.1", 18203):
                case Some(conn):
                    send(conn, str_to_bytes("GET /missing HTTP/1.1\r\nHost: localhost\r\n\r\n"))
                    resp: List<byte> = recv(conn, 4096)
                    response_msg = bytes_to_str(resp)
                    close(conn)
                    connected = true
                case None:
                    attempt = attempt + 1

        expect(contains(response_msg, "404 Not Found")).to_eq(true)

    )
)
