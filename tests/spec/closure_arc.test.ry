from ry.testing import it, describe, expect

@describe("closure ARC — basic lifecycle")
fn closureArcBasicLifecycleTests():
  @it("should support closure with captured int")
  fn shouldSupportClosureWithCapturedInt():
    base = 10
    addBase = (x: int) => x + base
    expect(addBase(5)).toEq(15)

  @it("should support closure copy (g = f)")
  fn shouldSupportClosureCopyGF():
    base = 100
    f = (x: int) => x + base
    g = f
    expect(f(1)).toEq(101)
    expect(g(2)).toEq(102)

  @it("should support no-capture lambda")
  fn shouldSupportNoCaptureLambda():
    f = (x: int) => x * 2
    expect(f(5)).toEq(10)

  @it("should support multiple captures")
  fn shouldSupportMultipleCaptures():
    a = 10
    b = 20
    f = (x: int) => x + a + b
    expect(f(5)).toEq(35)

  @it("should capture string")
  fn shouldCaptureString():
    prefix = "hello "
    greet = (name: str) => prefix + name
    expect(greet("world")).toEq("hello world")

@describe("closure ARC — escaping closures")
fn closureArcEscapingClosuresTests():
  @it("should escape defining scope via higher-order function")
  fn shouldEscapeDefiningScopeViaHigherOrderFunction():
    xs = [10, 20, 30]
    f = (x: int) => x > 15
    ys = filter(xs, f)
    expect(ys).toHaveLen(2)

  @it("should capture dynamic string")
  fn shouldCaptureDynamicString():
    name = "Alice"
    greeting = "Hello, " + name
    f = (suffix: str) => greeting + suffix
    expect(f("!")).toEq("Hello, Alice!")

@describe("closure ARC — higher-order patterns")
fn closureArcHigherOrderPatternsTests():
  @it("should filter with closure")
  fn shouldFilterWithClosure():
    threshold = 3
    xs = [1, 2, 3, 4, 5]
    ys = filter(xs, (x: int) => x > threshold)
    expect(ys).toHaveLen(2)

  @it("should map with closure")
  fn shouldMapWithClosure():
    factor = 10
    xs = [1, 2, 3]
    ys = map(xs, (x: int) => x * factor)
    expect(ys).toEq([10, 20, 30])

  @it("should pass closure as named variable to higher-order function")
  fn shouldPassClosureAsNamedVariableToHigherOrderFunction():
    base = 7
    f = (x: int) => x * base
    xs = [1, 2, 3]
    ys = map(xs, f)
    expect(ys).toEq([7, 14, 21])

  @it("should reduce with closure")
  fn shouldReduceWithClosure():
    init = 100
    xs = [1, 2, 3]
    result = reduce(xs, (acc: int, x: int) => acc + x + init)
    expect(result).toEq(Some(206))
