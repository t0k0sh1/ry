describe("closure ARC — basic lifecycle", function():
  it("closure with captured int", function():
    base = 10
    add_base = function(x: int) => x + base
    expect(add_base(5)).to_eq(15)
  )

  it("closure copy (g = f)", function():
    base = 100
    f = function(x: int) => x + base
    g = f
    expect(f(1)).to_eq(101)
    expect(g(2)).to_eq(102)
  )

  it("no-capture lambda", function():
    f = function(x: int) => x * 2
    expect(f(5)).to_eq(10)
  )

  it("multiple captures", function():
    a = 10
    b = 20
    f = function(x: int) => x + a + b
    expect(f(5)).to_eq(35)
  )

  it("capture string", function():
    prefix = "hello "
    greet = function(name: str) => prefix + name
    expect(greet("world")).to_eq("hello world")
  )
)

describe("closure ARC — escaping closures", function():
  it("closure escapes defining scope via higher-order", function():
    xs = [10, 20, 30]
    f = function(x: int) => x > 15
    ys = filter(xs, f)
    expect(ys).to_have_length(2)
  )

  it("closure captures dynamic string", function():
    name = "Alice"
    greeting = "Hello, " + name
    f = function(suffix: str) => greeting + suffix
    expect(f("!")).to_eq("Hello, Alice!")
  )
)

describe("closure ARC — higher-order patterns", function():
  it("filter with closure", function():
    threshold = 3
    xs = [1, 2, 3, 4, 5]
    ys = filter(xs, function(x: int) => x > threshold)
    expect(ys).to_have_length(2)
  )

  it("map with closure", function():
    factor = 10
    xs = [1, 2, 3]
    ys = map(xs, function(x: int) => x * factor)
    expect(ys).to_eq([10, 20, 30])
  )

  it("closure as named variable to higher-order", function():
    base = 7
    f = function(x: int) => x * base
    xs = [1, 2, 3]
    ys = map(xs, f)
    expect(ys).to_eq([7, 14, 21])
  )

  it("reduce with closure", function():
    init = 100
    xs = [1, 2, 3]
    result = reduce(xs, function(acc: int, x: int) => acc + x + init)
    expect(result).to_eq(206)
  )
)
