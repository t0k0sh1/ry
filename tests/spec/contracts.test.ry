fn deposit(amount: int, balance: int) -> int:
    require:
        amount > 0
        balance >= 0
    return balance + amount

fn abs_val(x: int) -> int:
    ensure:
        result >= 0
    if x < 0:
        return -x
    return x

fn increment(x: int) -> int:
    ensure:
        result == old(x) + 1
    return x + 1

record BankAccount:
    balance: int
    min_balance: int
    invariant:
        balance >= min_balance

describe("require"):
    it("passes when precondition met"):
        let res = deposit(100, 50)
        expect(res).to_eq(150)

describe("ensure"):
    it("passes when postcondition met"):
        expect(abs_val(-5)).to_eq(5)
        expect(abs_val(3)).to_eq(3)

describe("old expression"):
    it("captures value at entry"):
        expect(increment(10)).to_eq(11)
        expect(increment(0)).to_eq(1)

describe("struct invariant"):
    it("passes when invariant holds"):
        let a = BankAccount(100, 0)
        expect(a.balance).to_eq(100)
        expect(a.min_balance).to_eq(0)
