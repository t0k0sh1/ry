from testing import it, describe

fn deposit(amount: int, balance: int) -> int:
  require:
    amount > 0
    balance >= 0
  return balance + amount

fn absVal(x: int) -> int:
  ensure v:
    v >= 0
  if x < 0:
    return -x
  return x

fn increment(x: int) -> int:
  ensure v:
    v == x + 1
  return x + 1

record BankAccount:
  balance: int
  minBalance: int
  invariant:
    balance >= minBalance

@describe("require")
fn requireTests():
  @it("should pass when precondition met")
  fn shouldPassWhenPreconditionMet():
    res = deposit(100, 50)
    expect(res).toEq(150)

@describe("ensure")
fn ensureTests():
  @it("should pass when postcondition met")
  fn shouldPassWhenPostconditionMet():
    expect(absVal(-5)).toEq(5)
    expect(absVal(3)).toEq(3)

@describe("ensure with arg reference")
fn ensureWithArgReferenceTests():
  @it("should capture value correctly")
  fn shouldCaptureValueCorrectly():
    expect(increment(10)).toEq(11)
    expect(increment(0)).toEq(1)

@describe("struct invariant")
fn structInvariantTests():
  @it("should pass when struct invariant holds")
  fn shouldPassWhenStructInvariantHolds():
    a = BankAccount(100, 0)
    expect(a.balance).toEq(100)
    expect(a.minBalance).toEq(0)

@describe("result as identifier")
fn resultAsIdentifierTests():
  @it("should allow result to be used as a variable name")
  fn shouldAllowResultToBeUsedAsAVariableName():
    result: int = 42
    expect(result).toEq(42)
