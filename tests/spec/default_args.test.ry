# --- helper functions ---

from testing import it, describe, expect

fn greet(name: str, greeting: str = "Hello") -> str:
  return greeting + ", " + name

fn connect(host: str, port: int = 8080, timeout: int = 30) -> str:
  return host + ":" + toStr(port) + ":" + toStr(timeout)

fn withFloat(x: float, scale: float = 1.0) -> float:
  return x * scale

fn withBool(msg: str, loud: bool = false) -> str:
  if loud:
    return msg + "!"
  return msg

fn withNone(name: str, title: str? = None) -> str:
  return name + ":" + (title ?? "none")

# overload: different arity, no conflict
fn area(s: int) -> int:
  return s * s

fn area(w: int, h: int) -> int:
  return w * h

# widening + default args
fn calc(x: float, precision: int = 6) -> float:
  return x

# --- tests ---

@describe("basic default arguments")
fn basicDefaultArgumentsTests():
  @it("should use default when arg is omitted")
  fn shouldUseDefaultWhenArgIsOmitted():
    expect(greet("Alice")).toEq("Hello, Alice")

  @it("should override default when arg is provided")
  fn shouldOverrideDefaultWhenArgIsProvided():
    expect(greet("Alice", "Hi")).toEq("Hi, Alice")

@describe("multiple default arguments")
fn multipleDefaultArgumentsTests():
  @it("should use all defaults when args are omitted")
  fn shouldUseAllDefaultsWhenArgsAreOmitted():
    expect(connect("localhost")).toEq("localhost:8080:30")

  @it("should override first default")
  fn shouldOverrideFirstDefault():
    expect(connect("localhost", 3000)).toEq("localhost:3000:30")

  @it("should work when all args are provided")
  fn shouldWorkWhenAllArgsAreProvided():
    expect(connect("localhost", 3000, 10000)).toEq("localhost:3000:10000")

@describe("default value types")
fn defaultValueTypesTests():
  @it("should use float default")
  fn shouldUseFloatDefault():
    expect(withFloat(5.0)).toEq(5.0)
    expect(withFloat(5.0, 2.0)).toEq(10.0)

  @it("should use bool default")
  fn shouldUseBoolDefault():
    expect(withBool("hello")).toEq("hello")
    expect(withBool("hello", true)).toEq("hello!")

  @it("should use None as default for optional param")
  fn shouldUseNoneAsDefaultForOptionalParam():
    expect(withNone("Alice")).toEq("Alice:none")

@describe("coexistence with overloading")
fn coexistenceWithOverloadingTests():
  @it("should support different arity overloads alongside defaults")
  fn shouldSupportDifferentArityOverloadsAlongsideDefaults():
    expect(area(5)).toEq(25)
    expect(area(3, 4)).toEq(12)

@describe("widening with default args")
fn wideningWithDefaultArgsTests():
  @it("should widen int to float with default arg")
  fn shouldWidenIntToFloatWithDefaultArg():
    expect(calc(3)).toEq(3.0)
