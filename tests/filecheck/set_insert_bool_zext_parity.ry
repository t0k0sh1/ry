# FileCheck golden: Set<bool>.add — `coerceHashKey`'s only firing case
# (i1 → i64 ZExt before `__ry_hash_i64`). Pins the SSA name
# `hash_key_hash_zext` so a botched `emitZExt` migration that changes the
# name suffix would surface as a non-empty diff (#2193). Non-constant
# operand (function parameter bool + Set) avoids #2092 fold.
#
# CHECK-LABEL: define i64 @addBool(
# CHECK:         %hash_key_hash_zext = zext i1 {{.*}} to i64
# CHECK:         %hash_val = call i64 @__ry_hash_i64(i64 %hash_key_hash_zext)
# CHECK:         %bp_field = getelementptr {{.*}}, i32 0, i32 4
# CHECK:         call void @__ry_ht_insert(ptr
# CHECK:         %need_rehash = icmp sgt i64
# CHECK:         br i1 %need_rehash, label %rehash, label %rehash.done
# CHECK:       rehash:
# CHECK:         %new_buckets = call ptr @__ry_ht_rehash_i64(ptr
# CHECK:       rehash.done:

fn addBool(s: Set<bool>, x: bool) -> int:
    add(s, x)
    return s.len()

fn main():
    s: Set<bool> = {true}
    print(addBool(s, false))
